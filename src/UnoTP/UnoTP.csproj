<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- All data comes from the backend API (UnoTP.Backend). The mock stands in for
       it while Backend:BaseUrl is blank. -->
  <ItemGroup>
    <ProjectReference Include="..\UnoTP.Backend\UnoTP.Backend.csproj" />
    <ProjectReference Include="..\UnoTP.Backend.Mock\UnoTP.Backend.Mock.csproj" />
  </ItemGroup>


  <!-- Every figure and list a page shows comes from the backend. Only Program.cs
       may name the mock, to wire it in when no backend URL is set. -->
  <Target Name="GuardMockBackend" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_PageSource Include="**/*.cs;**/*.cshtml" Exclude="Program.cs;bin/**;obj/**" />
      <_MockUse Include="@(_PageSource)" Condition="$([System.IO.File]::ReadAllText('%(_PageSource.FullPath)').Contains('UnoTP.Backend.Mock'))" />
    </ItemGroup>
    <Error Condition="'@(_MockUse)' != ''" Text="Pages read the backend, never the mock: @(_MockUse) names UnoTP.Backend.Mock." />
  </Target>
</Project>

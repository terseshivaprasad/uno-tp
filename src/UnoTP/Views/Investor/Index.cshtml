@model InvestorViewModel
@{
    ViewData["Title"] = "Investor Information";

    var reference = Model.Docs.Ref;
    var lists = new DropdownLists(reference.IncomeBands, reference.Occupations, reference.SubOccupations, reference.MaritalStatuses);
    var relations = reference.NomineeRelations;
    var appNo = Model.Docs.AppNo;
    var banner = Model.Docs.Shown?.Banner;

    var investor = Model.Docs.Investor;
    var investorGender = Model.Docs.HolderGender;
    var investorPhoto = Model.Docs.State.Docs.GetValueOrDefault(investor.Key("photo"));

    // Every joint holder's upload attempts; the investor's own are on Upload Documents.
    var jointLog = Model.Docs.State.Log.Where(e => e.Holder is UnoTP.Backend.HolderType.Second or UnoTP.Backend.HolderType.Third).ToList();

    // Proceed asks about a nominee until one is added or the question is skipped.
    var nomineeAnswered = Model.State.Nominee || Model.Value("NomineeSkipped") == "yes";
}
@* Investor Information: a card for the investor, one for each joint holder added, and
   one for the nominee, down one column. The page is one form, and every button posts all
   of it, so nothing typed is lost to a post about something else (see InvestorController). *@

@functions {
#pragma warning disable CS1998 // Razor makes these helpers async; there is nothing to await in them.

    // What the drop-downs offer.
    private sealed record DropdownLists(IReadOnlyList<string> Incomes, IReadOnlyList<string> Occupations, IReadOnlyList<string> SubOccupations, IReadOnlyList<string> MaritalStatuses);

    private const string BinIcon = "<path d=\"M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13\"></path>";
    private const string CopyIcon = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";
    private const string RemoveLabel = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">" + BinIcon + "</svg> Remove";
    private const string PlusIcon = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"></path></svg> ";

    // A button that posts the page's form to one of the page's actions.
    private async Task PostButton(string action, object? route, string css, string labelHtml, string? loader = null)
    {
        <button type="submit" class="@css" formaction="@Url.Action(action, route)" formnovalidate data-loader="@loader">@Html.Raw(labelHtml)</button>
    }

    // The error Proceed left on a field, under it.
    private async Task FieldError(string name, string id)
    {
        var error = Model.ErrorOf(name);
        if (error is not null)
        {
            <p class="field-error" id="@(id)Error" role="alert">@error</p>
        }
    }

    // The attributes a field with an error carries.
    private string? Invalid(string name) => Model.ErrorOf(name) is null ? null : "is-invalid";
    private string? InvalidControl(string name) => Model.ErrorOf(name) is null ? null : "investor-control--error";
    private string? AriaInvalid(string name) => Model.ErrorOf(name) is null ? null : "true";
    private string? DescribedBy(string name, string id) => Model.ErrorOf(name) is null ? null : id + "Error";

    // A value, or a dash when there is none.
    private static string OrDash(string value) => value.Length > 0 ? value : "—";

    // A labelled drop-down holding what was posted.
    private async Task Select(string id, string name, string label, IEnumerable<string> options, string opening = "", string? required = null)
    {
        var selected = Model.Value(name, opening);
        <div class="doc-column">
            <label class="field-label" for="@id">@label</label>
            <div class="doc-select">
                <select class="field-input @Invalid(name)" id="@id" name="@name" aria-invalid="@AriaInvalid(name)" aria-describedby="@DescribedBy(name, id)" data-required="@required">
                    <option value="" selected="@(selected.Length == 0)">Select</option>
                    @foreach (var option in options)
                    {
                        <option selected="@(option == selected)">@option</option>
                    }
                </select>
            </div>
            @{ await FieldError(name, id); }
        </div>
    }

    // The sub occupation, which goes with the occupation: every sub occupation is drawn
    // with the occupations that list it (data-occupations, a | between; none means all),
    // and investor.js offers only those for the occupation chosen. Where the occupation
    // offers none, the field says so and asks for nothing.
    private async Task SubOccupationSelect(string id, string name, string occupationId, string occupation)
    {
        var reference = Model.Docs.Ref;
        var selected = Model.Value(name);
        var offered = reference.SubOccupationsFor(occupation);
        var asksNothing = occupation.Length > 0 && offered.Count == 0;
        <div class="doc-column">
            <label class="field-label" for="@id">Sub Occupation</label>
            <div class="doc-select">
                <select class="field-input @Invalid(name)" id="@id" name="@name" data-sub-occupation-of="@occupationId" aria-invalid="@AriaInvalid(name)" aria-describedby="@DescribedBy(name, id)" data-required="Select the sub occupation">
                    <option value="" selected="@(selected.Length == 0)">@(asksNothing ? "Not applicable" : "Select")</option>
                    @foreach (var sub in reference.SubOccupations)
                    {
                        var listedBy = (reference.OccupationsWithSubs ?? []).Where(o => o.SubOccupations.Contains(sub)).Select(o => o.Name).ToList();
                        var applies = occupation.Length == 0 || offered.Contains(sub);
                        <option value="@sub" selected="@(sub == selected)" data-occupations="@string.Join("|", listedBy)" hidden="@(!applies)" disabled="@(!applies)">@sub</option>
                    }
                </select>
            </div>
            @{ await FieldError(name, id); }
        </div>
    }

    // "More Information", which every holder gives; on the investor's card the FATCA
    // questions too, which are asked once for every holder.
    private async Task MoreInformation(int holder, DropdownLists lists)
    {
        var prefix = $"Holder{holder}";
        var id = $"investor{holder}";
        <h3 class="section-title">More Information</h3>
        <div class="doc-grid">
            @{ await Select($"{id}Income", $"{prefix}.AnnualIncome", "Annual Income", lists.Incomes, required: "Select the annual income"); }
            @{ await Select($"{id}Occupation", $"{prefix}.Occupation", "Occupation", lists.Occupations, required: "Select the occupation"); }
            @{ await SubOccupationSelect($"{id}SubOccupation", $"{prefix}.SubOccupation", $"{id}Occupation", Model.Value($"{prefix}.Occupation")); }
            @{ await Select($"{id}Marital", $"{prefix}.MaritalStatus", "Marital Status", lists.MaritalStatuses, required: "Select the marital status"); }
            <div class="doc-column">
                <label class="field-label" for="@(id)Mobile">Mobile Number</label>
                <input class="field-input @Invalid($"{prefix}.Mobile")" id="@(id)Mobile" name="@(prefix).Mobile" value="@Model.Value($"{prefix}.Mobile")" inputmode="numeric" maxlength="10" autocomplete="off" data-required="Enter the mobile number" data-check="mobile" aria-invalid="@AriaInvalid($"{prefix}.Mobile")" aria-describedby="@DescribedBy($"{prefix}.Mobile", id + "Mobile")">
                @{ await FieldError($"{prefix}.Mobile", id + "Mobile"); }
            </div>
            <div class="doc-column">
                <label class="field-label" for="@(id)Email">E-Mail</label>
                <input class="field-input field-input--caps @Invalid($"{prefix}.Email")" id="@(id)Email" name="@(prefix).Email" maxlength="50" value="@Model.Value($"{prefix}.Email")" type="email" autocomplete="off" data-required="Enter the e-mail" data-check="email" aria-invalid="@AriaInvalid($"{prefix}.Email")" aria-describedby="@DescribedBy($"{prefix}.Email", id + "Email")">
                @{ await FieldError($"{prefix}.Email", id + "Email"); }
            </div>
        </div>

        if (holder == 1)
        {
            <h3 class="section-title">Investor's @Glossary.Term("FATCA") Details</h3>
            <div class="investor-switches">
                <label class="investor-switch-row"><span>Are you/joint holder a tax resident of a country other than India?</span><input type="checkbox" class="investor-switch" name="@(prefix).FatcaTaxResident" checked="@Model.On($"{prefix}.FatcaTaxResident")"></label>
                <label class="investor-switch-row"><span>Are you/joint holder a permanent resident of a foreign country?</span><input type="checkbox" class="investor-switch" name="@(prefix).FatcaPermanentResident" checked="@Model.On($"{prefix}.FatcaPermanentResident")"></label>
            </div>
        }
    }

    // The drop-down a proof's type is chosen from, above its card (used when document
    // identification is off). field is "poaType" or "mailType".
    private async Task ProofTypePicker(DocumentsViewModel.DocHolder h, string field, string label, bool used, string type)
    {
        var key = h.Key(field);
        var error = Model.Docs.Shown?.Errors.GetValueOrDefault(key);
        var invalid = error is null ? null : "is-invalid";
        var slotKey = field == "poaType" ? DocumentsViewModel.PoaSlot.Key : DocumentsViewModel.MailSlot.Key;
        var opening = used ? "Select" : "Not Applicable";

        <label class="field-label" for="@key">@label</label>
        <div class="doc-select">
            <select class="field-input @invalid" id="@key" name="@key" disabled="@(!used)" data-submit="refresh-@h.Code">
                <option value="">@opening</option>
                @foreach (var proof in Model.Docs.ProofsFor(slotKey))
                {
                    <option value="@proof" selected="@(type == proof)">@proof</option>
                }
            </select>
        </div>
        if (error is not null)
        {
            <p class="field-error" id="@(key)Error" role="alert">@error</p>
        }
    }

    // A joint holder's documents, asked for and checked the same way as the investor's on
    // Upload Documents: the PAN copy, the photograph, the proof of address and, where post
    // goes elsewhere, the communication address proof. The Update button is what a choice
    // posts through; it is shown only without a script.
    private async Task JointHolderDocuments(int holder, DocumentsViewModel.DocHolder h)
    {
        var docs = Model.Docs;
        var upload = Url.Action("JointUpload", new { n = holder })!;
        var pan = docs.View(DocumentsViewModel.PanSlot, h);
        var photo = docs.View(DocumentsViewModel.PhotoSlot, h);
        var poa = docs.View(DocumentsViewModel.PoaSlot, h);
        var mail = docs.View(DocumentsViewModel.MailSlot, h);
        var panReads = new ReadCardsBlock(docs.PanReadsOf(h), Url.Action("JointNsdl", new { n = holder }));
        var mailDifferent = docs.MailDifferentOf(h);
        var mailCanDiffer = docs.MailCanDiffer(h);
        var mailingLabelId = $"investor{holder}MailingLabel";
        (string Value, string Label)[] mailingOptions = [("same", "Same as Permanent"), ("different", "Different from Permanent")];

        // The card's label heads it; where the proof's type is chosen first, the label and its
        // picker stand above the card instead (no Label).
        string? poaLabel = null;
        string? mailLabel = null;
        string? poaType = null;
        string? mailType = null;
        if (docs.AutoProofType)
        {
            poaLabel = "Proof of address";
            mailLabel = "Communication address proof";
            if (poa.Used) poaType = docs.PoaTypeOf(h);
            if (mail.Used) mailType = docs.MailTypeOf(h);
        }

        <button type="submit" class="identify-check-button doc-refresh" id="refresh-@h.Code" name="refresh" value="" formaction="@Url.Action("JointRefresh", new { n = holder })" formnovalidate>Update</button>
        <div class="investor-docs-head">
            <h3 class="investor-docs-head__title">Documents</h3>
            <div class="doc-app-type__group">
                <span class="field-label" id="@mailingLabelId">Communication Address</span>
                <div class="choice-toggle" role="radiogroup" aria-labelledby="@mailingLabelId">
                    @foreach (var option in mailingOptions)
                    {
                        var isDifferent = option.Value == "different";
                        var isOn = mailDifferent == isDifferent;
                        var disabled = isDifferent && !mailCanDiffer;
                        string? title = disabled ? mail.NotApplicable : null;
                        // Going back to "same" with a proof filed asks first, because the proof is taken off.
                        var asksBeforeDroppingProof = option.Value == "same" && !isOn && mail.Doc is not null;
                        string? confirm = asksBeforeDroppingProof ? DocumentsViewModel.MailDropAsk : null;
                        <label class="choice-toggle__option" title="@title">
                            <input class="visually-hidden" type="radio" name="@h.Key("mailing")" id="@h.Key("mailing")-@option.Value" value="@option.Value" checked="@isOn" disabled="@disabled" data-submit="refresh-@h.Code" data-confirm="@confirm">@option.Label
                        </label>
                    }
                </div>
            </div>
        </div>
        <div class="doc-grid doc-grid--docs">
            <div class="doc-column">
                <partial name="_DocSlot" model="@(new DocSlotBlock(pan, upload, Label: "PAN", LabelOptional: pan.Optional))" />
            </div>
            @* NSDL asking for the name printed on the PAN: a row straight under the PAN's card. *@
            @if (panReads.AsksName)
            {
                <div class="doc-retry-row"><partial name="_NsdlRetry" model="@panReads" /></div>
            }
            <div class="doc-column">
                <partial name="_DocSlot" model="@(new DocSlotBlock(photo, upload, Label: "Photo"))" />
            </div>
            <div class="doc-column">
                @if (!docs.AutoProofType)
                {
                    <div class="doc-column__head">@{ await ProofTypePicker(h, "poaType", "Proof of address", poa.Used, docs.PoaTypeOf(h)); }</div>
                }
                <partial name="_DocSlot" model="@(new DocSlotBlock(poa, upload, Label: poaLabel, ShowsProofType: docs.AutoProofType, ProofType: poaType))" />
            </div>
            @if (docs.CommProofUpload)
            {
                <div class="doc-column">
                    @if (!docs.AutoProofType)
                    {
                        <div class="doc-column__head">@{ await ProofTypePicker(h, "mailType", "Communication address proof", mail.Used, docs.MailTypeOf(h)); }</div>
                    }
                    <partial name="_DocSlot" model="@(new DocSlotBlock(mail, upload, Label: mailLabel, ShowsProofType: docs.AutoProofType, ProofType: mailType))" />
                </div>
            }
            @* An Aadhaar is filed but OCR could not read its number: it is typed here for the PAN-Aadhaar link. *@
            @if (docs.AsksAadhaarNumber(h))
            {
                var (aadhaarField, aadhaarError) = docs.AadhaarNumberField(h);
                <div class="doc-retry-row doc-retry-row--end"><partial name="_AadhaarNumber" model="@(new AadhaarNumberBlock(aadhaarField, Url.Action("JointAadhaarNumber", new { n = holder })!, aadhaarError))" /></div>
            }
        </div>

        @* Only the PAN's checks stand here (the addresses are in the panel above), and only
           for a holder with no folio: one on a folio is not checked again. *@
        if (docs.PanChecksShown(h))
        {
            <section class="doc-read-result">
                <h2 class="doc-read-result__title">What the PAN was checked with</h2>
                <partial name="_ReadCards" model="@panReads" />
            </section>
        }
    }

    // A joint holder's card. Until they are added: the search by PAN and date of birth.
    // Once added: their record read-only, their documents, what has to be typed, More
    // Information and the PEP questions. FATCA is asked once, on the investor's card.
    private async Task JointHolder(int index, DropdownLists lists)
    {
        var holder = index + 2;
        var state = Model.State.Joint[index];
        var search = Model.Joint[index];
        var who = InvestorViewModel.Ordinal(holder) + " Holder";
        DocumentsViewModel.DocHolder? h = null;
        if (state.Added) h = Model.Docs.JointHolder(InvestorViewModel.CodeOf(holder));

        <section class="page-card section-card" id="holder-@holder">
            @if (h is null)
            {
                <div class="page-head">
                    <h2 class="page-title">@who Details</h2>
                    <span class="identify-status">Not added</span>
                    @{ await RemoveButton(holder); }
                </div>
                if (Model.Unfinished == holder)
                {
                    <div class="alert alert-danger page-missing-items investor-unfinished" role="alert">
                        <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                        <div class="page-missing-items__body">
                            <div class="page-missing-items__title">This holder is not added yet</div>
                            <p>Check the @who.ToLowerInvariant()&rsquo;s record to add them &mdash; or remove them &mdash; before you proceed.</p>
                        </div>
                    </div>
                }
                <div class="investor-identify">
                    <partial name="_HolderIdentification" model="@(new HolderIdentificationBlock(search, $"j{holder}", step => Url.Action("Joint" + step, new { n = holder })!, Prefix: $"Joint{holder}.", FolioSearch: false, Locked: true))" />
                </div>
            }
            else
            {
                @* A complete card folds to one line and opens on a click, on an error in it,
                   or when the last post was about it. Its fields post folded or not. *@
                var (complete, standingLine) = Model.HolderStanding(holder, h);
                var folded = complete && !Model.About(holder, h);
                <details class="investor-folded-holder" open="@(!folded)">
                    <summary class="page-head">
                        <h2 class="page-title">@who Details</h2>
                        <span class="identify-status identify-status--ok">Added</span>
                        <svg class="investor-folded-holder__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                        <span class="investor-folded-holder__line">@standingLine</span>
                    </summary>
                    <div class="investor-folded-holder__tools">@{ await RemoveButton(holder); }</div>
                    @{ await JointHolderRecord(h, search.Record); }
                    @{ await JointHolderDocuments(holder, h); }
                    @{ await ManualEntries(holder, h, search.Record?.Gender ?? ""); }
                    @{ await MoreInformation(holder, lists); }
                    @{ await PepQuestions(holder, h); }
                </details>
            }
        </section>
    }

    // Remove, for the last holder only: the second cannot go while there is a third.
    private async Task RemoveButton(int holder)
    {
        var isLastHolder = holder == Model.State.Joint.Count + 1;
        if (isLastHolder)
        {
            await PostButton("JointRemove", new { n = holder }, "investor-remove", RemoveLabel);
        }
        else
        {
            <button type="button" class="investor-remove" disabled title="Remove the third holder first">@Html.Raw(RemoveLabel)</button>
        }
    }

    // An added joint holder's record, read-only: who they are and where they live.
    private async Task JointHolderRecord(DocumentsViewModel.DocHolder h, NewApplicationViewModel.Holder? record)
    {
        var docs = Model.Docs;
        var gender = record?.Gender ?? "";
        var photo = docs.State.Docs.GetValueOrDefault(h.Key("photo"));
        var onFolio = h.Who.Folio.Length > 0;
        var photoUsed = docs.View(DocumentsViewModel.PhotoSlot, h).Used;
        var photoNote = photoUsed ? "upload below" : "on the folio";
        var source = onFolio ? $"From folio {h.Who.Folio}" : "From the search and the PAN copy";

        var nameClass = h.Who.Name.Length == 0 ? "investor-key-value__value--unread" : null;
        var nameText = h.Who.Name.Length > 0 ? h.Who.Name : "Read off the PAN copy once filed";
        var genderClass = gender.Length == 0 ? "investor-key-value__value--unread" : null;
        var genderText = gender.Length > 0 ? gender : "Not read — enter below";
        var folioClass = onFolio ? null : "investor-key-value__value--unread";
        var folioText = onFolio ? h.Who.Folio : "Opens with this application";

        <div class="investor-record">
            <div class="investor-panel investor-ckyc">
                @if (photo is { Before: false })
                {
                    <img class="investor-ckyc__photo investor-ckyc__photo--img" src="@Url.Action("Copy", "Documents", new { slot = h.Key("photo"), v = photo.GetHashCode() })" alt="@(h.Who.Name)'s photograph">
                }
                else
                {
                    <div class="investor-ckyc__photo">Photo<br />@photoNote</div>
                }
                <div style="flex:1;min-width:0">
                    <div class="investor-panel__label" style="padding-bottom:10px">@source &middot; read-only</div>
                    <div class="investor-key-value-grid">
                        <div class="investor-key-value"><div class="investor-key-value__key">Applicant Name</div><div class="investor-key-value__value @nameClass">@nameText</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">DOB</div><div class="investor-key-value__value">@Dates.Show(h.Who.Dob)</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">Gender</div><div class="investor-key-value__value @genderClass">@genderText</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">Father Name</div><div class="investor-key-value__value investor-key-value__value--unread">Not read &mdash; enter below</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">PAN</div><div class="investor-key-value__value">@DocumentsViewModel.MaskPan(h.Who.Pan)</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">Folio</div><div class="investor-key-value__value @folioClass">@folioText</div></div>
                    </div>
                    @{ await AddressPanel(h); }
                </div>
            </div>
        </div>
    }

    // A holder's addresses, under their record: the permanent address and its proof, then
    // where post goes - the same, or what its proof was read to say. An address typed by
    // hand has its own box under the panel (CommunicationAddressEntry).
    private async Task AddressPanel(DocumentsViewModel.DocHolder h)
    {
        var docs = Model.Docs;
        var poa = docs.ReadsOf(h)[0].Card;
        var proofSource = h.Joint ? "documents below" : "documents on Upload Documents";
        var expiryText = "—";
        if (poa.Expiry.Length > 0) expiryText = Dates.Show(poa.Expiry);

        <div class="investor-panel__part">
            <div class="investor-section-head" style="padding-bottom:10px">
                <div class="investor-panel__label" style="flex:1;min-width:0">Permanent address &amp; proof &middot; from the folio and the @proofSource</div>
                @if (!h.Joint)
                {
                    <a class="investor-panel__action" asp-controller="Documents" asp-action="Index">Open documents</a>
                }
            </div>
            <div class="investor-key-value-grid">
                <div class="investor-key-value investor-key-value--wide"><div class="investor-key-value__key">Permanent address</div><div class="investor-key-value__value">@poa.Lines</div></div>
                <div class="investor-key-value"><div class="investor-key-value__key">@Glossary.Term("POA") type</div><div class="investor-key-value__value">@OrDash(docs.PoaTypeOf(h))</div></div>
                <div class="investor-key-value"><div class="investor-key-value__key">@Glossary.Term("POA") reference number</div><div class="investor-key-value__value">@OrDash(poa.Number)</div></div>
                <div class="investor-key-value"><div class="investor-key-value__key">@Glossary.Term("POA") expiry date</div><div class="investor-key-value__value">@expiryText</div></div>
                <div class="investor-key-value"><div class="investor-key-value__key">Verification</div><div class="investor-key-value__value">@poa.State</div></div>
            </div>
        </div>
        @if (!docs.MailTyped(h))
        {
            <div class="investor-panel__part">
                <div class="investor-panel__label" style="padding-bottom:10px">Communication address</div>
                <div class="investor-key-value-grid">
                    @if (docs.MailDifferentOf(h))
                    {
                        var mail = docs.MailReadOf(h);
                        <div class="investor-key-value investor-key-value--wide"><div class="investor-key-value__key">Where post goes</div><div class="investor-key-value__value">@mail.Lines</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">Proof</div><div class="investor-key-value__value">@OrDash(docs.MailTypeOf(h)) &middot; @mail.State</div></div>
                    }
                    else
                    {
                        <div class="investor-key-value investor-key-value--wide"><div class="investor-key-value__key">Where post goes</div><div class="investor-key-value__value">Same as permanent address</div></div>
                    }
                </div>
            </div>
        }
    }

    // What a holder types by hand, in one card: the communication address when post
    // goes elsewhere and no proof of it is uploaded, and what nothing read - the gender
    // when the record holds none, and the father's, mother's or spouse's name, which
    // OCR does not read.
    private async Task ManualEntries(int holder, DocumentsViewModel.DocHolder h, string gender)
    {
        <div class="investor-record">
            <div class="investor-manual">
                <div class="investor-section-head">
                    <div class="investor-manual__title">Typed by hand for this holder</div>
                    <span class="investor-manual__badge">Manual entry</span>
                </div>
                <div class="investor-manual__text">Type each exactly as the holder gives it &mdash; everything that was read stays read-only above.</div>
                @{ await CommunicationAddressPart(holder, h); }
                @{ await UnreadFieldsPart(holder, gender); }
            </div>
        </div>
    }

    // The gender when the record holds none, and the father's, mother's or spouse's name.
    private async Task UnreadFieldsPart(int holder, string gender)
    {
        var prefix = $"Holder{holder}";
        var genderUnread = gender.Length == 0;
        var subtitle = genderUnread ? "Gender, and the father's, mother's or spouse's name" : "Father's, mother's or spouse's name";
        var whatIsMissing = genderUnread ? "Neither the record nor OCR gives a gender or a parent or spouse name" : "OCR does not read a parent or spouse name";
        var nameTypes = Model.Docs.Ref.NameTypes;
        var nameTypeSelected = Model.Value($"{prefix}.NameType", nameTypes.FirstOrDefault() ?? "");
        var genderSelected = Model.Value($"{prefix}.Gender");

        <div class="investor-manual__part" id="h@(holder)-manual">
            <div class="investor-manual__subtitle">@subtitle</div>
            <div class="investor-manual__text">@whatIsMissing for this holder.</div>
                <div class="investor-grid">
                @if (genderUnread)
                {
                    <div class="investor-field investor-field--sm">
                        <label for="h@(holder)-gender">Gender</label>
                        <select id="h@(holder)-gender" name="@(prefix).Gender" class="investor-control @InvalidControl($"{prefix}.Gender")" required data-required="Select the gender" aria-invalid="@AriaInvalid($"{prefix}.Gender")" aria-describedby="@DescribedBy($"{prefix}.Gender", $"h{holder}-gender")">
                            <option value="">Select</option>
                            @foreach (var option in Model.Docs.Ref.Genders)
                            {
                                if (option == genderSelected)
                                {
                                    <option selected>@option</option>
                                }
                                else
                                {
                                    <option>@option</option>
                                }
                            }
                        </select>
                        @{ await FieldError($"{prefix}.Gender", $"h{holder}-gender"); }
                    </div>
                }
                <div class="investor-field investor-field--sm">
                    <label for="h@(holder)-nametype">Name type</label>
                    <select id="h@(holder)-nametype" name="@(prefix).NameType" class="investor-control investor-control--strong @InvalidControl($"{prefix}.NameType")" required aria-describedby="@DescribedBy($"{prefix}.NameType", $"h{holder}-nametype")">
                        @foreach (var option in nameTypes)
                        {
                            if (option == nameTypeSelected)
                            {
                                <option selected>@option</option>
                            }
                            else
                            {
                                <option>@option</option>
                            }
                        }
                    </select>
                    @{ await FieldError($"{prefix}.NameType", $"h{holder}-nametype"); }
                </div>
                <div class="investor-field investor-field--sm">
                    <label for="h@(holder)-parent">Father / Mother / Spouse name</label>
                    <input id="h@(holder)-parent" name="@(prefix).ParentName" maxlength="50" class="investor-control @InvalidControl($"{prefix}.ParentName")" value="@Model.Value($"{prefix}.ParentName")" required data-required="Enter the father's, mother's or spouse's name" data-check="name" aria-invalid="@AriaInvalid($"{prefix}.ParentName")" aria-describedby="@DescribedBy($"{prefix}.ParentName", $"h{holder}-parent")" />
                    @{ await FieldError($"{prefix}.ParentName", $"h{holder}-parent"); }
                </div>
            </div>
        </div>
    }

    // The communication address typed by hand, for a holder whose post goes elsewhere while
    // no proof of it is uploaded (CommProofUpload off). Three lines, the city and the PIN
    // code; the district and state come from the PIN code (investor.js, and the backend on post).
    private async Task CommunicationAddressPart(int holder, DocumentsViewModel.DocHolder h)
    {
        if (!Model.Docs.MailTyped(h)) return;

        var prefix = $"Holder{holder}.{InvestorDetailsForm.Comm}";
        var id = $"h{holder}-comm";
        var pinField = prefix + "PinCode";
        var pin = Model.Value(pinField).Trim();
        var place = Model.Places.GetValueOrDefault(pin);

        var district = "—";
        var stateName = "—";
        if (place is not null)
        {
            district = place.District;
            stateName = place.State;
        }
        else if (InvestorViewModel.IsPin(pin))
        {
            district = "Not found for this PIN code";
        }
        string? placedPin = place is not null ? pin : null;

        (string Field, string Suffix, string Label, string? Required)[] lines =
        [
            ("Line1", "1", "Address Line 1", "Enter the first line of the address"),
            ("Line2", "2", "Address Line 2", null),
            ("Line3", "3", "Address Line 3", null),
            ("City", "city", "City", "Enter the city"),
        ];

        <div class="investor-manual__part" id="@id">
            <div class="investor-manual__subtitle">Communication address &middot; different from permanent</div>
            <div class="investor-manual__text">Post goes here, not to the permanent address above; the district and state come from the PIN code.</div>
                <div class="investor-grid">
                    @foreach (var line in lines)
                    {
                        var name = prefix + line.Field;
                        var optionalClass = line.Required is null ? "investor-field--optional" : null;
                        var check = line.Field == "City" ? "name" : "text";
                        <div class="investor-field investor-field--sm @optionalClass">
                            <label for="@(id)@line.Suffix">@line.Label @if (line.Required is null) { <span class="doc-optional">(Non-mandatory)</span> }</label>
                            <input class="investor-control @InvalidControl(name)" id="@(id)@line.Suffix" name="@name" value="@Model.Value(name)" maxlength="@(line.Field == "City" ? InputRules.MaxField : InputRules.MaxAddressLine)" autocomplete="off" data-required="@line.Required" data-check="@check" aria-invalid="@AriaInvalid(name)" aria-describedby="@DescribedBy(name, id + line.Suffix)">
                            @{ await FieldError(name, id + line.Suffix); }
                        </div>
                    }
                    <div class="investor-field investor-field--sm">
                        <label for="@(id)pin">PIN Code</label>
                        <input class="investor-control @InvalidControl(pinField)" id="@(id)pin" name="@pinField" value="@pin" inputmode="numeric" maxlength="6" autocomplete="off" data-required="Enter the PIN code" data-check="pin"
                               data-pin-url="@Url.Action("PinCode", new { pin = "PIN" })" data-placed="@placedPin" aria-invalid="@AriaInvalid(pinField)" aria-describedby="@DescribedBy(pinField, id + "pin")">
                        @{ await FieldError(pinField, id + "pin"); }
                    </div>
                    <div class="investor-district-state" data-place-for="@(id)pin" aria-live="polite">
                        <div class="investor-key-value"><div class="investor-key-value__key">District</div><div class="investor-key-value__value" data-place="district">@district</div></div>
                        <div class="investor-key-value"><div class="investor-key-value__key">State</div><div class="investor-key-value__value" data-place="state">@stateName</div></div>
                    </div>
                </div>
        </div>
    }

    // Whether the holder is, or is related to, a politically exposed person. Asked of every
    // holder with no folio; a holder on a folio has answered already.
    private async Task PepQuestions(int holder, DocumentsViewModel.DocHolder h)
    {
        if (!InvestorViewModel.PepAsked(h)) return;
        <div class="investor-pep">
            @foreach (var (field, question) in InvestorViewModel.PepQuestions)
            {
                var name = $"Holder{holder}.{field}";
                var answer = Model.Value(name);
                var missing = Model.ErrorOf(name) is not null;
                var rowClass = missing ? "is-invalid" : null;
                <div class="investor-pep__row @rowClass" id="pep-@name" tabindex="-1" role="radiogroup" aria-labelledby="pep-@(name)-q">
                    <span class="investor-pep__question" id="pep-@(name)-q">@question</span>
                    <div class="investor-pep__answers">
                        <label class="investor-pep__answer">Yes <input type="radio" name="@name" value="yes" checked="@(answer == "yes")"></label>
                        <label class="investor-pep__answer">No <input type="radio" name="@name" value="no" checked="@(answer == "no")"></label>
                    </div>
                    @if (missing)
                    {
                        <p class="field-error investor-pep__error" role="alert">Choose Yes or No</p>
                    }
                </div>
            }
        </div>
    }

    // "Would you like to add …?" with the button that adds it.
    private async Task AddSection(string id, string question, string action, string label)
    {
        <section class="page-card investor-question" id="@id">
            <p class="investor-question__question">@question</p>
            @if (id == "investorAddNominee")
            {
                await NomineesOnRecordList();
            }
            @{ await PostButton(action, null, "investor-add", PlusIcon + label); }
        </section>
    }

    // The nominees named on the folio's earlier deposits, each with Use, which fills
    // the nominee's fields from it: under the question, in the open card and in the
    // Proceed dialog. Nothing for an investor without a folio.
    private async Task NomineesOnRecordList()
    {
        if (Model.NomineesOnRecord.Count == 0) return;
        <div class="on-record">
            <div class="on-record__title">Nominees on this folio</div>
            <ul class="on-record__list">
                @for (var i = 0; i < Model.NomineesOnRecord.Count; i++)
                {
                    var nominee = Model.NomineesOnRecord[i];
                    var born = nominee.Dob.Length > 0 ? nominee.Dob.Replace("-", "/") : "date of birth to be entered";
                    @* One line: the name, the date of birth and the relation. Use fills the guardian too, where there is one. *@
                    <li class="on-record__row">
                        <span class="on-record__main">@nominee.Name · @born · @nominee.Relation</span>
                        <button type="submit" form="investorInfoForm" class="btn btn-outline-primary btn-sm on-record__use" formaction="@Url.Action("NomineeUse", new { n = i })" formnovalidate data-loader="Filling the nominee&rsquo;s details&hellip;">Use</button>
                    </li>
                }
            </ul>
        </div>
    }
}

@* Once the investor's card head has scrolled away, this strip keeps who the step is for
   and the application number in view (sticky-app-strip.js). *@
<div class="app-sticky-strip" id="docsPin" hidden>
    <div class="app-sticky-strip__inner">
        <span class="app-sticky-strip__who">@Model.Docs.HolderName</span>
        <span class="app-sticky-strip__pan">PAN @Model.Docs.HolderPan</span>
        <span class="app-sticky-strip__app">
            <span class="app-sticky-strip__label">Application</span>
            @appNo
            <button type="button" class="doc-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyIcon)</svg>
            </button>
        </span>
    </div>
</div>

<div class="page-layout">
    <partial name="_ClassicSteps" model="2" />

    <form class="page-main" id="investorInfoForm" data-guard method="post" asp-action="Proceed" enctype="multipart/form-data" data-partial novalidate data-partial-focus="@Model.Focus">

        @if (banner is not null)
        {
            <div class="alert alert-success doc-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <span>@banner</span>
            </div>
        }

        @* The category on Upload Documents does not fit the applicant's gender: Proceed
           stops here until it is corrected there. *@
        @if (Model.CategoryConflict is not null)
        {
            <div class="alert alert-danger page-missing-items investor-unfinished" role="alert">
                <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="page-missing-items__body">
                    <div class="page-missing-items__title">The deposit category does not fit the applicant</div>
                    <p>@Model.CategoryConflict <a asp-controller="Documents" asp-action="Index" data-loader="Going to Upload Documents">Go to Upload Documents</a></p>
                </div>
            </div>
        }

        @* Name screening does not allow a holder to invest online: Proceed stops here. *@
        @if (Model.ScreeningNotAllowed is not null)
        {
            <div class="alert alert-danger page-missing-items investor-unfinished" role="alert">
                <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="page-missing-items__body">
                    <div class="page-missing-items__title">Not allowed to invest online</div>
                    <p>@InvestorViewModel.ScreeningOffline(Model.ScreeningNotAllowed)</p>
                </div>
            </div>
        }

        @* ===== The investor ===== *@
        <section class="page-card section-card" id="holder-1">
            @* A holder who is a tax or permanent resident of another country invests offline:
               Proceed stops and says so here, over the top of the card. *@
            <div class="page-alert" id="investorFatcaAlert" role="alert" tabindex="-1" hidden="@(!Model.Offline)">
                <svg class="page-alert__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5L2.5 20h19z"></path><path d="M12 10v4.5"></path><circle cx="12" cy="17.3" r=".6" fill="currentColor"></circle></svg>
                <p class="page-alert__text">@InvestorViewModel.FatcaOffline</p>
                <button type="button" class="page-alert__close btn-reset" data-investor-close="investorFatcaAlert" aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="page-head" data-pin-head>
                <h1 class="page-title">Investor Details</h1>
                @* Clear All asks first: it takes the joint holders and the nominee off too. *@
                <button type="submit" form="investorInfoForm" class="link-button link-button--muted investor-clear" formaction="@Url.Action("Clear")" formnovalidate
                        data-confirm="Clear everything typed on this step, and remove the joint holders and the nominee?">Clear All</button>
                <span class="page-app-number">Application No: <strong>@appNo</strong>
                    <button type="button" class="doc-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyIcon)</svg>
                    </button>
                </span>
            </div>
            @{
                var investorNameClass = investor.Who.Name.Length == 0 ? "investor-key-value__value--unread" : null;
                var investorNameText = investor.Who.Name.Length > 0 ? investor.Who.Name : "Read off the PAN copy once filed";
                var investorGenderClass = investorGender.Length == 0 ? "investor-key-value__value--unread" : null;
                var investorGenderText = investorGender.Length > 0 ? investorGender : "Not read — enter below";
                var investorPhotoUsed = Model.Docs.View(DocumentsViewModel.PhotoSlot, investor).Used;
                var investorPhotoNote = investorPhotoUsed ? "not uploaded" : "on the folio";
            }
            <div class="investor-record">
                <div class="investor-panel investor-ckyc">
                    @* The photograph filed on Upload Documents. *@
                    @if (investorPhoto is { Before: false })
                    {
                        <img class="investor-ckyc__photo investor-ckyc__photo--img" src="@Url.Action("Copy", "Documents", new { slot = investor.Key("photo"), v = investorPhoto.GetHashCode() })" alt="@(investor.Who.Name)'s photograph">
                    }
                    else
                    {
                        <div class="investor-ckyc__photo">Photo<br />@investorPhotoNote</div>
                    }
                    <div style="flex:1;min-width:0">
                        <div class="investor-panel__label" style="padding-bottom:10px">From the application &middot; read-only</div>
                        <div class="investor-key-value-grid">
                            <div class="investor-key-value"><div class="investor-key-value__key">Applicant Name</div><div class="investor-key-value__value @investorNameClass">@investorNameText</div></div>
                            <div class="investor-key-value"><div class="investor-key-value__key">DOB</div><div class="investor-key-value__value">@Model.Docs.HolderDob</div></div>
                            <div class="investor-key-value"><div class="investor-key-value__key">Gender</div><div class="investor-key-value__value @investorGenderClass">@investorGenderText</div></div>
                            <div class="investor-key-value"><div class="investor-key-value__key">PAN</div><div class="investor-key-value__value">@Model.Docs.HolderPan</div></div>
                            <div class="investor-key-value"><div class="investor-key-value__key">Folio</div><div class="investor-key-value__value">@Model.Docs.HolderFolio</div></div>
                        </div>
                        @{ await AddressPanel(investor); }
                    </div>
                </div>
            </div>
            @{ await ManualEntries(1, investor, investorGender); }
            @{ await MoreInformation(1, lists); }
            @{ await PepQuestions(1, investor); }
        </section>

        @* ===== Joint holders, one at a time: the third only once the second is added ===== *@
        @for (var i = 0; i < Model.State.Joint.Count; i++)
        {
            await JointHolder(i, lists);
        }
        @if (Model.CanAddJoint)
        {
            await AddSection("investorAddHolder", "Would you like to add Joint Account Holder?", "JointAdd", "Add Joint Holder");
        }

        @* ===== The nominee, once for the application ===== *@
        @if (!Model.State.Nominee)
        {
            await AddSection("investorAddNominee", "Would you like to add Nominee Details?", "NomineeAdd", "Add Nominee");
        }
        else
        {
            <section class="page-card section-card" id="nominee">
                <div class="page-head">
                    <h2 class="page-title">Nominee Details</h2>
                    @{ await PostButton("NomineeRemove", null, "investor-remove", RemoveLabel); }
                </div>
                @{ await NomineesOnRecordList(); }
                <div class="doc-grid">
                    <div class="doc-column">
                        <label class="field-label" for="investorNomineeName">Name</label>
                        <input class="field-input @Invalid("Nominee.Name")" id="investorNomineeName" name="Nominee.Name" maxlength="50" value="@Model.Value("Nominee.Name")" autocomplete="off" data-required="Enter the nominee's name" data-check="name" aria-invalid="@AriaInvalid("Nominee.Name")" aria-describedby="@DescribedBy("Nominee.Name", "investorNomineeName")">
                        @{ await FieldError("Nominee.Name", "investorNomineeName"); }
                    </div>
                    <div class="doc-column">
                        <span class="field-label" id="investorNomineeDobLabel">Date Of Birth</span>
                        <div class="date-input @Invalid("Nominee.Dob")" role="group" aria-labelledby="investorNomineeDobLabel" aria-describedby="@DescribedBy("Nominee.Dob", "investorNomineeDd")"
                             data-required="Enter the nominee's date of birth" data-check="date" data-error-id="investorNomineeDdError">
                            <input class="date-input__part" id="investorNomineeDd" name="Nominee.Dd" value="@Model.Value("Nominee.Dd")" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off">
                            <span class="date-input__sep">/</span>
                            <input class="date-input__part" name="Nominee.Mm" value="@Model.Value("Nominee.Mm")" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                            <span class="date-input__sep">/</span>
                            <input class="date-input__part date-input__part--year" name="Nominee.Yyyy" value="@Model.Value("Nominee.Yyyy")" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                        </div>
                        @{ await FieldError("Nominee.Dob", "investorNomineeDd"); }
                    </div>
                    @{ await Select("investorNomineeRelation", "Nominee.Relation", "Relation with primary holder", relations, required: "Select the relation with the primary holder"); }
                </div>

                @* Only a minor nominee has a guardian. The section always stands, disabled until
                   the date of birth typed makes the nominee a minor; disabled, its fields are not
                   posted, so nothing typed for a guardian is kept against an adult nominee. *@
                <fieldset class="investor-guardian" id="investorGuardian" data-investor-guardian data-minor-under="@Model.MinorUnder" disabled="@(!Model.NomineeMinor)">
                <h3 class="section-title">Guardian Details</h3>
                <p class="page-note investor-guardian__minor">The nominee is under @Model.MinorUnder, so a guardian acts for them.</p>
                <p class="page-note investor-guardian__when">Needed only for a nominee under @Model.MinorUnder: filled in once the nominee's date of birth makes them one.</p>
                <div class="doc-grid">
                    <div class="doc-column">
                        <label class="field-label" for="investorNomineeGuardian">Guardian Name</label>
                        <input class="field-input @Invalid("Nominee.GuardianName")" id="investorNomineeGuardian" name="Nominee.GuardianName" maxlength="50" value="@Model.Value("Nominee.GuardianName")" autocomplete="off" data-required="Enter the guardian's name" data-check="name" aria-invalid="@AriaInvalid("Nominee.GuardianName")" aria-describedby="@DescribedBy("Nominee.GuardianName", "investorNomineeGuardian")">
                        @{ await FieldError("Nominee.GuardianName", "investorNomineeGuardian"); }
                    </div>
                </div>
                <div class="doc-grid">
                    <div class="doc-column">
                        <label class="field-label" for="investorGuardian1">Address Line 1</label>
                        <input class="field-input @Invalid("Nominee.GuardianAddress.Line1")" id="investorGuardian1" name="Nominee.GuardianAddress.Line1" maxlength="40" value="@Model.Value("Nominee.GuardianAddress.Line1")" data-required="Enter the first line of the address" data-check="text" aria-invalid="@AriaInvalid("Nominee.GuardianAddress.Line1")" aria-describedby="@DescribedBy("Nominee.GuardianAddress.Line1", "investorGuardian1")">
                        @{ await FieldError("Nominee.GuardianAddress.Line1", "investorGuardian1"); }
                    </div>
                    <div class="doc-column">
                        <label class="field-label" for="investorGuardian2">Address Line 2 (Non-mandatory)</label>
                        <input class="field-input" id="investorGuardian2" name="Nominee.GuardianAddress.Line2" maxlength="40" value="@Model.Value("Nominee.GuardianAddress.Line2")" data-check="text">
                    </div>
                    <div class="doc-column">
                        <label class="field-label" for="investorGuardian3">Address Line 3 (Non-mandatory)</label>
                        <input class="field-input" id="investorGuardian3" name="Nominee.GuardianAddress.Line3" maxlength="40" value="@Model.Value("Nominee.GuardianAddress.Line3")" data-check="text">
                    </div>
                    <div class="doc-column">
                        <label class="field-label" for="investorGuardianPin">Pin Code</label>
                        <input class="field-input @Invalid("Nominee.GuardianAddress.PinCode")" id="investorGuardianPin" name="Nominee.GuardianAddress.PinCode" value="@Model.Value("Nominee.GuardianAddress.PinCode")" inputmode="numeric" maxlength="6" data-required="Enter the PIN code" data-check="pin" aria-invalid="@AriaInvalid("Nominee.GuardianAddress.PinCode")" aria-describedby="@DescribedBy("Nominee.GuardianAddress.PinCode", "investorGuardianPin")">
                        @{ await FieldError("Nominee.GuardianAddress.PinCode", "investorGuardianPin"); }
                    </div>
                    <div class="doc-column">
                        <label class="field-label" for="investorGuardianCity">City</label>
                        <input class="field-input @Invalid("Nominee.GuardianAddress.City")" id="investorGuardianCity" name="Nominee.GuardianAddress.City" maxlength="50" value="@Model.Value("Nominee.GuardianAddress.City")" data-required="Enter the city" data-check="name" aria-invalid="@AriaInvalid("Nominee.GuardianAddress.City")" aria-describedby="@DescribedBy("Nominee.GuardianAddress.City", "investorGuardianCity")">
                        @{ await FieldError("Nominee.GuardianAddress.City", "investorGuardianCity"); }
                    </div>
                </div>
                <p class="page-note">District- , State-</p>
                </fieldset>
            </section>
        }

        @if (!Model.State.Nominee)
        {
            @* Skipping the nominee is kept with the form, so the question is asked once. *@
            <input type="hidden" name="NomineeSkipped" id="investorNomineeSkipped" value="@Model.Value("NomineeSkipped")">
        }

        @if (jointLog.Count > 0)
        {
            <section class="page-card doc-history" id="investorLog">
                <h2 class="doc-section__title">Joint holders&rsquo; upload, @Glossary.Term("OCR") and verification history</h2>
                <p class="doc-history__sub">Every joint holder&rsquo;s attempt, newest first. Three refusals in a row send a document to Operations.</p>
                <partial name="_DocLog" model="@jointLog" />
            </section>
        }
    </form>

    @if (!Model.State.Nominee)
    {
        @* Proceed with no nominee named asks first. Skip goes on; Add opens the nominee's card. *@
        <div class="doc-sheet doc-ckyc-pop" id="investorNomineeAsk" popover role="dialog" aria-modal="true" aria-labelledby="investorNomineeAskTitle">
            <div class="doc-ckyc__sheet">
                <header class="doc-ckyc__head">
                    <span class="doc-ckyc__mark" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                    </span>
                    <h2 class="doc-ckyc__title" id="investorNomineeAskTitle">No nominee is named</h2>
                    <button type="button" class="doc-preview__close" popovertarget="investorNomineeAsk" popovertargetaction="hide" aria-label="Close">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
                    </button>
                </header>
                <div class="doc-ckyc__body">
                    <p><strong>We strongly advise adding a nominee.</strong> With one named, the deposit is paid to them directly; without one, it passes to the legal heirs only after succession is settled.</p>
                    @{ await NomineesOnRecordList(); }
                </div>
                <footer class="doc-ckyc__foot">
                    <button type="button" class="btn btn-outline-primary" data-nominee-skip>Skip</button>
                    <button type="submit" form="investorInfoForm" class="btn btn-primary" formaction="@Url.Action("NomineeAdd")" formnovalidate data-loader="Opening the nominee&rsquo;s card&hellip;">Add nominee</button>
                </footer>
            </div>
        </div>
    }
</div>

<footer class="page-action-bar">
    <div class="page-action-bar__inner">
        <a class="btn btn-outline-primary" asp-controller="Documents" asp-action="Index" data-loader="Going back to Upload Documents">Back</a>
        <p class="page-action-bar__hint">Add any joint holders and the nominee, then proceed to <strong>Bank Details &amp; Payment</strong></p>
        <div class="page-action-bar__right">
            <button type="submit" form="investorInfoForm" class="btn btn-outline-primary" formaction="@Url.Action("Save")" formnovalidate data-toast="Draft saved">Save draft</button>
            <button type="submit" form="investorInfoForm" class="btn btn-primary" data-validate="form"
                    data-ask-nominee="@(nomineeAnswered ? null : "yes")">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/pages/investor.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/investor.css" asp-append-version="true" />
}

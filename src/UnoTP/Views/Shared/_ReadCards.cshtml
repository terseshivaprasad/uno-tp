@model ReadCardsBlock
@* What copies were read to say, and who confirmed it: a card per thing read, all
   of one size. Where NSDL holds a PAN against another name, the name printed on
   the card is asked for by _NsdlRetry, under the PAN's own row of documents. *@
<div class="cud-read__cards">
    @foreach (var item in Model.Items)
    {
        <partial name="_ReadCard" model="@(new ReadCardBlock(item))" />
    }
</div>

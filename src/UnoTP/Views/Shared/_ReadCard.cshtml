@model ReadCardBlock
@* One card of what a copy was read to say, and who confirmed it. Every card is
   the same size: what does not fit is there in full on hover. *@
@{
    var item = Model.Item;
    var card = item.Card;
}
@* What a card explains stays written out only where something failed - it says
   what is wrong and what follows. Otherwise it is behind the info mark by the
   card's title, and the card says only what was read and where it stands. *@
@{ var explainInline = card.Kind == "is-failed" && card.From.Length > 0; }
<article class="cud-read__card @card.Kind" id="@(item.Id is null ? null : "read-" + item.Id)" tabindex="@(item.Id is null ? null : "-1")">
    <header class="cud-read__head">
        <h3 class="cud-read__kind">@item.Kind
            @if (!explainInline && card.From.Length > 0)
            {
                <span class="tip tip--info tip--mark" tabindex="0" data-tip="@card.From"><span class="visually-hidden">@card.From</span></span>
            }
        </h3>
        <span class="cud-read__state">@card.State</span>
    </header>
    <p class="cud-read__lines" title="@card.Lines">@card.Lines</p>
    @if (explainInline)
    {
        <p class="cud-read__from" title="@card.From">@card.From</p>
    }
</article>

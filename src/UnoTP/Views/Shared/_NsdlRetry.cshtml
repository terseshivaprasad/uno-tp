@model ReadCardsBlock
@* NSDL holds the PAN against another name: the name printed on the card, typed
   and put to NSDL again. The page places it in its document grid, across the row
   straight under the PAN's box (.doc-retry-row), where the PAN was just filed. *@
@foreach (var item in Model.Items.Where(i => i.Retry is not null && Model.RetryUrl is not null))
{
    var retry = item.Retry!;
    <div class="doc-retry @(retry.Error is null ? null : "is-invalid")" role="group" aria-labelledby="@(retry.Field)Label">
        <div class="doc-retry__say">
            <span class="doc-retry__title" id="@(retry.Field)Label">@Glossary.Term("NSDL") did not match the name</span>
            <span class="doc-retry__text">Type the name exactly as printed on the PAN card, and NSDL is asked again.</span>
        </div>
        <div class="doc-retry__ask">
            <input class="field-input field-input--caps @(retry.Error is null ? null : "is-invalid")" id="@retry.Field" name="@retry.Field" data-check="name" value="@retry.Value"
                   maxlength="60" autocomplete="off" spellcheck="false" aria-label="Name exactly as printed on the PAN" aria-describedby="@(retry.Field)Error">
            <button type="submit" class="btn btn-primary" formaction="@Model.RetryUrl" formnovalidate data-loader="Asking NSDL again&hellip;">Retry NSDL</button>
        </div>
        @if (retry.Error is not null)
        {
            <p class="field-error doc-retry__error" id="@(retry.Field)Error" role="alert">@retry.Error</p>
        }
    </div>
}

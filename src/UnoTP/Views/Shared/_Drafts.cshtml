@model DraftsBlock
@* The partner's own applications, opened and not yet submitted, the one touched
   last first: the same table on Investor Identification and on the dashboard.
   Continue picks one up on Upload Documents under the number it was opened with;
   only the number is posted, and the server checks it is one of this partner's. *@
<p class="cii-note">@Model.Total opened and not submitted, the one touched last first &middot; identifiers are masked &middot; kept for @((await Lookups.ConfigAsync()).DraftDays) days</p>
<table class="su-table">
    <thead>
        <tr>
            <th scope="col">Application</th>
            <th scope="col">Name</th>
            <th scope="col">PAN</th>
            <th scope="col">Date of birth</th>
            <th scope="col">Amount</th>
            <th scope="col"><span class="visually-hidden">Action</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Shown)
        {
            <tr>
                <td data-label="Application"><strong>@d.AppNo</strong></td>
                <td data-label="Name">@if (d.Name.Length > 0) { @d.Name } else { <span class="text-muted">PAN not read yet</span> }</td>
                <td data-label="PAN">@d.Pan</td>
                <td data-label="Date of birth">@d.Dob</td>
                <td data-label="Amount">@PayInSlipsViewModel.Rupees(d.Amount)</td>
                <td class="su-table__act">
                    <form method="post" asp-controller="NewApplication" asp-action="Continue" data-partial="@(Model.Partial ? "" : null)">
                        <input type="hidden" name="draft" value="@d.AppNo">
                        <button type="submit" class="csi-link btn-reset" data-loader="Opening Upload Documents…" data-loader-hint="Application @d.AppNo">Continue <span aria-hidden="true">&rsaquo;</span></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@model DocSlotBlock
@* One document card: the investor's on Upload Documents, or a joint holder's on
   Investor Information.
   Empty: the box is a label over the file picker, so a click or a dropped file picks a
   copy, and the form posts through the card's Upload button. Filed: the box opens the
   copy, and Replace picks another. A card standing outside its form names the form
   (Model.Form), so its picker still posts with it. *@
@{
    var slot = Model.View;
    var form = Model.Form;
    var key = slot.Key;
    var filed = slot.Doc is not null;
    var tools = SlotToolbar.For(slot);
    var held = tools.Held;

    // A photo is made smaller before it is uploaded (image-shrink.js), but never the
    // application form: OCR has to read its small print in full.
    var isApplicationForm = slot.Def.Key == DocumentsViewModel.FormSlot.Key;
    string? shrinkTo = isApplicationForm ? null : "2560";

    var cardClass = "doc-slot";
    if (slot.Error is not null) cardClass += " is-invalid";
    if (slot.Unconfirmed) cardClass += " is-unconfirmed";
    if (Model.IsNext) cardClass += " is-next";

    // An alternate card (another choice's) carries no id, so the real card keeps its anchor.
    string? cardId = Model.Alternate ? null : "slot-" + key;
}
<div class="@cardClass" id="@cardId" tabindex="-1">
    @* The header: the label at the left and, at the right, always in this order, the
       (i) mark, View, and the action (Upload, Replace, Newer proof, or a lock). What cannot
       be done now is shown disabled with its reason, so the toolbar keeps its shape. *@
    <div class="doc-slot__bar">
    @if (Model.Label is not null)
    {
        <div class="doc-slot__head">
            <span class="field-label">@Model.Label @if (Model.LabelOptional) { <span class="doc-optional">(Non-mandatory)</span> }@if (Model.ShowsProofType) { <partial name="_ProofType" model="@Model.ProofType" /> }</span>
        </div>
    }
    <div class="doc-slot__tools">
        <span class="hover-hint hover-hint--info hover-hint--mark @tools.InfoTone" tabindex="0" data-tip="@tools.Info"><span class="visually-hidden">About this document: @tools.Info</span></span>

        @if (tools.CanView)
        {
            <button type="button" class="doc-tool" popovertarget="preview-@key" title="View @slot.Def.Label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span>View</span>
            </button>
        }
        else
        {
            <span class="doc-tool hover-hint" aria-disabled="true" tabindex="0" data-tip="@tools.NoViewReason">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span>View</span><span class="visually-hidden">: @tools.NoViewReason</span>
            </span>
        }

        @if (slot.Final is not null)
        {
            @* A PAN copy NSDL has verified is final: a lock stands where Replace would. *@
            <span class="doc-tool doc-tool--final hover-hint" tabindex="0" data-tip="@slot.Final">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="1.6"></rect><path d="M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7"></path></svg>
                <span>Final</span><span class="visually-hidden">: @slot.Final</span>
            </span>
        }
        else if (tools.ActionBlockedReason is not null)
        {
            <span class="doc-tool hover-hint" aria-disabled="true" tabindex="0" data-tip="@tools.ActionBlockedReason">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                <span>@tools.ActionLabel</span><span class="visually-hidden">: @tools.ActionBlockedReason</span>
            </span>
        }
        else if (filed || held is not null)
        {
            @* Replace a filed copy, or file a newer proof over the address on record. The picker
               is up here because the box below shows what is filed. *@
            var titleVerb = filed ? "Replace" : "File a newer";
            <label class="doc-tool" for="file-@key" title="@titleVerb @slot.Def.Label">
                @if (filed)
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 12a8.5 8.5 0 0 1-14.6 5.9"></path><path d="M3.5 12a8.5 8.5 0 0 1 14.6-5.9"></path><path d="M18.5 2.5V7H14"></path><path d="M5.5 21.5V17H10"></path></svg>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                }
                <span>@tools.ActionLabel</span>
            </label>
            <input type="file" id="file-@key" name="file_@key" accept="@slot.Def.Accepts.Mime" hidden data-submit="upload-@key" form="@form" data-shrink="@shrinkTo">
        }
        else
        {
            @* Empty: the box below is the picker; this opens it too. *@
            <label class="doc-tool" for="file-@key" title="Upload @slot.Def.Label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                <span>Upload</span>
            </label>
        }
    </div>
    </div>

    <div class="doc-slot__frame">
        @if (held is not null)
        {
            @* An address the folio already holds, standing where its proof would be: on record,
               so ticked, but nothing on this step confirmed it. *@
            var (heldBody, heldPin) = DocumentsViewModel.SplitPin(held.Lines);
            var heldPinClass = heldPin.Length == 0 ? "is-missing" : null;
            var heldPinText = heldPin.Length > 0 ? "PIN " + heldPin : "PIN not on record";
            <div class="doc-drop is-filled is-held">
                <span class="doc-drop__done">
                    <span class="doc-drop__check" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    </span>
                    <span class="doc-on-file__tag">@held.State</span>
                    <span class="doc-on-file__lines" title="@held.Lines">@heldBody</span>
                    <span class="doc-on-file__pin @heldPinClass">@heldPinText</span>
                    <span class="doc-on-file__from" title="@held.From">@held.From</span>
                </span>
            </div>
        }
        else if (!slot.Used)
        {
            @* A slot the application has no use for says so, and why. *@
            <span class="doc-slot__na">
                <span class="doc-slot__na-mark" aria-hidden="true"></span>
                <span class="doc-slot__na-text">
                    <span class="doc-slot__na-title">Not applicable</span>
                    <span class="doc-slot__na-why">@slot.NotApplicable</span>
                </span>
            </span>
        }
        else if (filed)
        {
            // A proof of address or a PAN copy says in its box what it was read to say.
            var isAddressProof = slot.Def.Key == "poa" || slot.Def.Key == "mail";
            var addressRead = isAddressProof ? slot.Read : null;
            var panRead = slot.Def.Key == "pan" ? slot.Read : null;
            var whatWasRead = addressRead ?? panRead;

            string? readClass = null;
            string? tickClass = null;
            if (whatWasRead is not null)
            {
                readClass = "is-read";
                // The tick takes the colour of what was read: matched, warned or failed.
                if (whatWasRead.Kind.Length > 0) tickClass = whatWasRead.Kind;
            }

            <button type="button" class="doc-drop is-filled @readClass" popovertarget="preview-@key">
                <span class="doc-drop__done">
                    <span class="doc-drop__check @tickClass" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    </span>
                    @if (addressRead is not null)
                    {
                        @* The address as read, its PIN code on a line of its own, and the proof's number and expiry. *@
                        var (body, pin) = DocumentsViewModel.SplitPin(addressRead.Lines);
                        var pinClass = pin.Length == 0 ? "is-missing" : null;
                        var pinText = pin.Length > 0 ? "PIN " + pin : "PIN not read";
                        <span class="doc-on-file__tag @addressRead.Kind">@addressRead.State</span>
                        <span class="doc-on-file__lines" title="@addressRead.Lines">@body</span>
                        <span class="doc-on-file__pin @pinClass">@pinText</span>
                        @if (addressRead.Number.Length > 0)
                        {
                            var expired = DocumentsViewModel.Expired(addressRead.Expiry);
                            var expiredClass = expired ? "doc-on-file__expired" : null;
                            var expiryWord = expired ? "expired" : "valid till";
                            <span class="doc-on-file__id">
                                @addressRead.Number@if (addressRead.Expiry.Length > 0) { <span class="@expiredClass"> &middot; @expiryWord @Dates.Show(addressRead.Expiry)</span> }
                            </span>
                        }
                    }
                    else if (panRead is not null)
                    {
                        <span class="doc-on-file__tag @panRead.Kind">@panRead.State</span>
                        <span class="doc-on-file__lines doc-on-file__lines--one" title="@panRead.Lines">@panRead.Lines</span>
                        <span class="doc-on-file__id">@panRead.Number</span>
                    }
                    else
                    {
                        @* The box says what is filed, not what the file was called. *@
                        var titleCapitalised = char.ToUpperInvariant(slot.Title[0]) + slot.Title[1..];
                        var sizeText = slot.Doc!.Before ? "already on the application" : DocumentsViewModel.SizeOf(slot.Doc.Size);
                        <span class="doc-drop__file">@titleCapitalised filed</span>
                        <span class="doc-drop__size">@sizeText</span>
                    }
                </span>
            </button>
        }
        else
        {
            var boxClass = "doc-drop";
            if (slot.Locked is not null) boxClass += " is-locked";
            if (slot.Spent) boxClass += " is-spent";
            var pickerDisabled = slot.Locked is not null || slot.Spent;

            <label class="@boxClass" for="file-@key">
                @if (slot.Locked is not null)
                {
                    @* Nothing can be picked here yet, and what is in the way. *@
                    <span class="doc-drop__locked">
                        <span class="doc-drop__lock" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="1.6"></rect><path d="M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7"></path></svg>
                        </span>
                        <span class="doc-drop__title">@slot.Locked</span>
                        <span class="doc-drop__hint">@(slot.LockedHint ?? "The type decides what the copy is checked as, and with whom.")</span>
                    </span>
                }
                else
                {
                    <span class="doc-drop__idle">
                        <span class="doc-drop__icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                        </span>
                        <span class="doc-drop__title">Click to upload @slot.Title</span>
                        <span class="doc-drop__hint">Supported format: @slot.Def.Accepts.Label (max. @(slot.Def.Accepts.MaxMb) MB)</span>
                        @if (slot.Must is not null)
                        {
                            <span class="doc-drop__must">@slot.Must</span>
                        }
                        @if (slot.With is not null)
                        {
                            <span class="doc-drop__with">@slot.With</span>
                        }
                    </span>
                }
                @* The picker covers the whole box, so a click opens it and a dropped file lands in it. *@
                <input class="doc-drop__input" type="file" id="file-@key" name="file_@key" accept="@slot.Def.Accepts.Mime"
                       data-shrink="@shrinkTo"
                       disabled="@pickerDisabled" aria-describedby="@(key)Error" data-submit="upload-@key" form="@form">
            </label>
        }

        @* Shown only without a script; with one, picking a file presses it. *@
        @if (slot.Used && !slot.Spent)
        {
            <button type="submit" class="identify-check-button doc-upload" id="upload-@key" name="slot" value="@key" formaction="@Model.UploadUrl" form="@form"
                    data-loader="Checking the @slot.Def.Label&hellip;" data-loader-hint="Identified, read by OCR, then checked with whoever stands behind it">Upload</button>
        }
    </div>

    @* Under the box: only what asks something of the partner - an error, a failed check
       that wants a new copy, and the tries left. *@
    <div class="doc-slot__notes">
        @if (slot.Error is not null)
        {
            <p class="field-error" id="@(key)Error" role="alert">
                @slot.Error
                @if (slot.ErrorLog is not null)
                {
                    <a class="doc-refusal-link" href="#log-@slot.ErrorLog">See the history</a>
                }
            </p>
        }
        @if (filed && slot.Doc!.CheckKind == "bad" && slot.Doc.Check.Length > 0)
        {
            <p class="doc-slot__check is-bad">@slot.Doc.Check</p>
        }
        @if (slot.Tries is not null)
        {
            var triesClass = slot.Spent ? "is-spent" : null;
            <p class="doc-slot__tries @triesClass">@slot.Tries</p>
        }
    </div>
</div>

@if (filed)
{
    @* The copy itself, in a pop-up. *@
    var doc = slot.Doc!;
    var metaText = doc.Before ? "Already on the application" : $"{DocumentsViewModel.SizeOf(doc.Size)} · {doc.ContentType}";
    <div class="doc-sheet doc-preview-pop" id="preview-@key" popover role="dialog" aria-modal="true" aria-labelledby="preview-@(key)-title">
        <div class="doc-preview__sheet">
            <header class="doc-preview__head">
                <div>
                    <p class="doc-preview__kind">@slot.Def.Label</p>
                    <h2 class="doc-preview__title" id="preview-@(key)-title">@doc.FileName</h2>
                </div>
                <button type="button" class="doc-preview__close" popovertarget="preview-@key" popovertargetaction="hide" aria-label="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </header>
            <div class="doc-preview__body">
                @if (doc.Before)
                {
                    <p class="doc-preview__none">This copy was filed before this step, so there is nothing here to show.</p>
                }
                else
                {
                    var copyUrl = Url.Action("Copy", "Documents", new { slot = key, v = doc.GetHashCode() });
                    if (doc.ContentType.StartsWith("image/"))
                    {
                        <img src="@copyUrl" alt="@slot.Def.Label" loading="lazy">
                    }
                    else
                    {
                        <iframe src="@copyUrl" title="@slot.Def.Label" loading="lazy"></iframe>
                    }
                }
            </div>
            <footer class="doc-preview__foot">
                <span class="doc-preview__meta">@metaText</span>
            </footer>
        </div>
    </div>
}

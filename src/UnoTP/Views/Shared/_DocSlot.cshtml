@model DocSlotBlock
@using M = UnoTP.ViewModels.DocumentsViewModel
@*
    One document slot, the investor's on Upload Documents or a joint holder's on
    Investor Information. Empty, the box is a label over the file picker, so a
    click or a dropped file picks it; picked, the form posts through the slot's
    Upload button. Filed, the box opens the copy and Replace picks another. A slot
    standing outside its form names it, so its picker still posts with it.
*@
@{
    var v = Model.View;
    var form = Model.Form;
    var key = v.Key;
    var filed = v.Doc is not null;
}
<div class="doc-slot @(v.Error is not null ? "is-invalid" : null) @(v.Unconfirmed ? "is-unconfirmed" : null) @(Model.IsNext ? "is-next" : null)" id="@(Model.Alternate ? null : "slot-" + key)" tabindex="-1">
    @* The card's header: its label at the left and, at the right, on every card
       and always in this order, what the checks are (or said), View, and the
       action - Upload, Replace, Newer proof, or a lock. What cannot be done now is
       shown disabled with the reason on it, never left out, so the toolbar stands
       still as the card changes. Out of the box, so every box keeps one height. *@
    @{
        var held = !filed ? v.Read : null;
        var info = !v.Used ? v.NotApplicable ?? "Not asked for on this application."
            : filed ? (v.Doc!.Check.Length > 0 ? v.Doc.Check : "Filed.")
            : held is not null ? $"{held.State}. {held.From}"
            : v.With ?? M.NoCheckOf(v.Def.Key);
        var infoTone = filed ? v.Doc!.CheckKind switch { "warn" => "is-warn", "bad" => "is-bad", _ => null } : null;
        var canView = filed && !v.Doc!.Before;
        var noView = !v.Used ? "Not applicable to this application."
            : filed ? "Filed before this step: there is no copy here to show."
            : held is not null ? "Held on record: there is no copy on this application to show."
            : "Nothing uploaded yet.";
        // The action: what it says, and why not when it cannot be done now.
        var (act, why) = !v.Used ? ("Upload", v.NotApplicable ?? "Not applicable to this application.")
            : v.Final is not null ? ("Final", v.Final)
            : v.Spent ? ("No tries left", v.Tries ?? "Refused too many times in a row: this document now goes to Operations.")
            : filed ? ("Replace", (string?)null)
            : v.Locked is not null ? ("Upload", v.Locked)
            : held is not null ? ("Newer proof", null)
            : ("Upload", null);
    }
    <div class="doc-slot__bar">
    @if (Model.Head is not null)
    {
        <div class="doc-slot__head">@Model.Head(null)</div>
    }
    <div class="doc-slot__tools">
        <span class="hover-hint hover-hint--info hover-hint--mark @infoTone" tabindex="0" data-tip="@info"><span class="visually-hidden">About this document: @info</span></span>
        @if (canView)
        {
            <button type="button" class="doc-tool" popovertarget="preview-@key" title="View @v.Def.Label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span>View</span>
            </button>
        }
        else
        {
            <span class="doc-tool hover-hint" aria-disabled="true" tabindex="0" data-tip="@noView">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <span>View</span><span class="visually-hidden">: @noView</span>
            </span>
        }
        @if (v.Final is not null)
        {
            @* A PAN copy NSDL verified is final: the lock stands where Replace would. *@
            <span class="doc-tool doc-tool--final hover-hint" tabindex="0" data-tip="@v.Final">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="1.6"></rect><path d="M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7"></path></svg>
                <span>Final</span><span class="visually-hidden">: @v.Final</span>
            </span>
        }
        else if (why is not null)
        {
            <span class="doc-tool hover-hint" aria-disabled="true" tabindex="0" data-tip="@why">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                <span>@act</span><span class="visually-hidden">: @why</span>
            </span>
        }
        else if (filed || held is not null)
        {
            @* Replace, or a newer proof over the address on record: the picker is here, as the box shows what is filed. *@
            <label class="doc-tool" for="file-@key" title="@(filed ? "Replace" : "File a newer") @v.Def.Label">
                @if (filed)
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 12a8.5 8.5 0 0 1-14.6 5.9"></path><path d="M3.5 12a8.5 8.5 0 0 1 14.6-5.9"></path><path d="M18.5 2.5V7H14"></path><path d="M5.5 21.5V17H10"></path></svg>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                }
                <span>@act</span>
            </label>
            <input type="file" id="file-@key" name="file_@key" accept="@v.Def.Accepts.Mime" hidden data-submit="upload-@key" form="@form"
                   data-shrink="@(v.Def.Key == DocumentsViewModel.FormSlot.Key ? null : "2560")">
        }
        else
        {
            @* Empty: the box below is the picker, and this opens it too. *@
            <label class="doc-tool" for="file-@key" title="Upload @v.Def.Label">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                <span>Upload</span>
            </label>
        }
    </div>
    </div>
    <div class="doc-slot__frame">
        @if (held is not null)
        {
            @* An address the folio already holds stands where its proof would be:
               on record, so ticked, but nothing on this step confirmed it. Where a
               newer proof may be filed, the tool over the box takes it. *@
            <div class="doc-drop is-filled is-held">
                <span class="doc-drop__done">
                    <span class="doc-drop__check" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    </span>
                    <span class="doc-on-file__tag">@held.State</span>
                    @{ var (heldBody, heldPin) = M.SplitPin(held.Lines); }
                    <span class="doc-on-file__lines" title="@held.Lines">@heldBody</span>
                    <span class="doc-on-file__pin @(heldPin.Length == 0 ? "is-missing" : null)">@(heldPin.Length > 0 ? "PIN " + heldPin : "PIN not on record")</span>
                    <span class="doc-on-file__from" title="@held.From">@held.From</span>
                </span>
            </div>
        }
        else if (!v.Used)
        {
            @* A slot the application has no use for says so, and says why. *@
            <span class="doc-slot__na">
                <span class="doc-slot__na-mark" aria-hidden="true"></span>
                <span class="doc-slot__na-text">
                    <span class="doc-slot__na-title">Not applicable</span>
                    <span class="doc-slot__na-why">@v.NotApplicable</span>
                </span>
            </span>
        }
        else if (filed)
        {
            // A proof of address or a PAN copy says in its box what it was read to say.
            var address = v.Def.Key is "poa" or "mail" ? v.Read : null;
            var panRead = v.Def.Key == "pan" ? v.Read : null;
            var readKind = (address ?? panRead)?.Kind;
            <button type="button" class="doc-drop is-filled @(address is not null || panRead is not null ? "is-read" : null)" popovertarget="preview-@key">
                <span class="doc-drop__done">
                    @* A box that says what was read takes its tick's colour from that. *@
                    <span class="doc-drop__check @(readKind is { Length: > 0 } ? readKind : null)" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    </span>
                    @if (address is not null)
                    {
                        @* A proof of address says, in its own box, what it was read to
                           say and who confirmed it - not what the file was called. *@
                        <span class="doc-on-file__tag @address.Kind">@address.State</span>
                        var (body, pin) = M.SplitPin(address.Lines);
                        <span class="doc-on-file__lines" title="@address.Lines">@body</span>
                        <span class="doc-on-file__pin @(pin.Length == 0 ? "is-missing" : null)">@(pin.Length > 0 ? "PIN " + pin : "PIN not read")</span>
                        @if (address.Number.Length > 0)
                        {
                            var expired = M.Expired(address.Expiry);
                            <span class="doc-on-file__id">
                                @address.Number@if (address.Expiry.Length > 0) { <span class="@(expired ? "doc-on-file__expired" : null)"> &middot; @(expired ? "expired" : "valid till") @Dates.Show(address.Expiry)</span> }
                            </span>
                        }
                    }
                    else if (panRead is not null)
                    {
                        <span class="doc-on-file__tag @panRead.Kind">@panRead.State</span>
                        <span class="doc-on-file__lines doc-on-file__lines--one" title="@panRead.Lines">@panRead.Lines</span>
                        <span class="doc-on-file__id">@panRead.Number</span>
                    }
                    else
                    {
                        @* The box says what is filed, not what the file was called. *@
                        <span class="doc-drop__file">@(char.ToUpperInvariant(v.Title[0]) + v.Title[1..]) filed</span>
                        <span class="doc-drop__size">@(v.Doc!.Before ? "already on the application" : M.SizeOf(v.Doc.Size))</span>
                    }
                </span>
            </button>
        }
        else
        {
            <label class="doc-drop @(v.Locked is not null ? "is-locked" : null) @(v.Spent ? "is-spent" : null)" for="file-@key">
                @if (v.Locked is not null)
                {
                    @* Nothing can be picked here yet, and what is in the way. *@
                    <span class="doc-drop__locked">
                        <span class="doc-drop__lock" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="1.6"></rect><path d="M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7"></path></svg>
                        </span>
                        <span class="doc-drop__title">@v.Locked</span>
                        <span class="doc-drop__hint">@(v.LockedHint ?? "The type decides what the copy is checked as, and with whom.")</span>
                    </span>
                }
                else
                {
                    <span class="doc-drop__idle">
                        <span class="doc-drop__icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                        </span>
                        <span class="doc-drop__title">Click to upload @v.Title</span>
                        <span class="doc-drop__hint">Supported format: @v.Def.Accepts.Label (max. @(v.Def.Accepts.MaxMb) MB)</span>
                        @if (v.Must is not null)
                        {
                            <span class="doc-drop__must">@v.Must</span>
                        }
                        @if (v.With is not null)
                        {
                            <span class="doc-drop__with">@v.With</span>
                        }
                    </span>
                }
                @* Over the whole box, so a click opens the picker and a file dropped on it lands in it. *@
                @* A photo is made smaller before it goes (image-shrink.js) - but never the
                   application form, a page of small print OCR has to read in full. *@
                <input class="doc-drop__input" type="file" id="file-@key" name="file_@key" accept="@v.Def.Accepts.Mime"
                       data-shrink="@(v.Def.Key == DocumentsViewModel.FormSlot.Key ? null : "2560")"
                       disabled="@(v.Locked is not null || v.Spent)" aria-describedby="@(key)Error" data-submit="upload-@key" form="@form">
            </label>
        }
        @* Shown only without a script; with one, picking a file presses it. *@
        @if (v.Used && !v.Spent)
        {
            <button type="submit" class="identify-check-button doc-upload" id="upload-@key" name="slot" value="@key" formaction="@Model.UploadUrl" form="@form"
                    data-loader="Checking the @v.Def.Label&hellip;" data-loader-hint="Identified, read by OCR, then checked with whoever stands behind it">Upload</button>
        }
    </div>
    @* Under the box: what went wrong, what the checks made of the copy, the tries
       left. One part, so the page's grid lines the boxes of a row up above it. *@
    <div class="doc-slot__notes">
        @if (v.Error is not null)
        {
            <p class="field-error" id="@(key)Error" role="alert">
                @v.Error
                @if (v.ErrorLog is not null)
                {
                    @* The history holds what the checks said, and the page is long. *@
                    <a class="doc-refusal-link" href="#log-@v.ErrorLog">See the history</a>
                }
            </p>
        }
        @* Only what asks something of the partner stands under the box: an error, a
           check that failed and wants a new copy, the tries left. How a copy was
           checked otherwise is behind the info mark over the box, and what was read
           is in the box and the cards below. *@
        @if (filed && v.Doc!.CheckKind == "bad" && v.Doc.Check.Length > 0)
        {
            <p class="doc-slot__check is-bad">@v.Doc.Check</p>
        }
        @if (v.Tries is not null)
        {
            <p class="doc-slot__tries @(v.Spent ? "is-spent" : null)">@v.Tries</p>
        }
    </div>
</div>

@if (filed)
{
    @* The copy itself, where the browser can show it. *@
    <div class="doc-sheet doc-preview-pop" id="preview-@key" popover role="dialog" aria-modal="true" aria-labelledby="preview-@(key)-title">
        <div class="doc-preview__sheet">
            <header class="doc-preview__head">
                <div>
                    <p class="doc-preview__kind">@v.Def.Label</p>
                    <h2 class="doc-preview__title" id="preview-@(key)-title">@v.Doc!.FileName</h2>
                </div>
                <button type="button" class="doc-preview__close" popovertarget="preview-@key" popovertargetaction="hide" aria-label="Close">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </header>
            <div class="doc-preview__body">
                @if (v.Doc.Before)
                {
                    <p class="doc-preview__none">This copy was filed before this step, so there is nothing here to show.</p>
                }
                else
                {
                    var src = Url.Action("Copy", "Documents", new { slot = key, v = v.Doc.GetHashCode() });
                    if (v.Doc.ContentType.StartsWith("image/"))
                    {
                        <img src="@src" alt="@v.Def.Label" loading="lazy">
                    }
                    else
                    {
                        <iframe src="@src" title="@v.Def.Label" loading="lazy"></iframe>
                    }
                }
            </div>
            <footer class="doc-preview__foot">
                <span class="doc-preview__meta">@(v.Doc.Before ? "Already on the application" : $"{M.SizeOf(v.Doc.Size)} · {v.Doc.ContentType}")</span>
            </footer>
        </div>
    </div>
}

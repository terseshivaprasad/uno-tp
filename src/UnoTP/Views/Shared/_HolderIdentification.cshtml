@model HolderIdentificationBlock
@* The search and result for one holder: the primary holder on Investor Identification,
   and each joint holder on Investor Information. Every step posts to the server, which
   checks the holder against the register (see HolderSearch). A PAN with no folio goes
   on as it stands: its PAN copy is read and put to NSDL once it is filed. *@
@{
    var search = Model.Search;
    var idPrefix = Model.Ids;
    var record = search.Record;
    var isNewPan = record is not null && record.Folio.Length == 0;

    // The field that needs looking at first takes the caret when the page comes back.
    string? focus = null;
    if (search.PanError is not null) focus = idPrefix + "Pan";
    else if (search.DobError is not null) focus = idPrefix + "Dd";
    else if (search.FolioError is not null) focus = idPrefix + "Folio";
}

@functions {
#pragma warning disable CS1998 // Razor makes these helpers async; there is nothing to await in them.

    // A button that posts one step of the search. Inside a bigger form (Embedded) it names
    // the step's URL; on its own it posts its own form. A button that checks the search
    // fields first (field-checks.js) sends nothing while one is wrong.
    private async Task StepButton(string step, string css, string labelHtml, string? loader = null, bool checksFieldsFirst = false)
    {
        string? checks = checksFieldsFirst ? ".page-search" : null;
        if (Model.Embedded)
        {
            <button type="submit" class="@css" formaction="@Model.Url(step)" formnovalidate data-loader="@loader" data-validate="@checks">@Html.Raw(labelHtml)</button>
        }
        else
        {
            <button type="submit" class="@css" data-loader="@loader" data-validate="@checks">@Html.Raw(labelHtml)</button>
        }
    }

    // "Search again": a form of its own, or a button inside the page's form. Not offered
    // for a holder that is locked to its record.
    private async Task SearchAgainButton(string css, string labelHtml)
    {
        if (Model.Locked) return;
        if (Model.Embedded)
        {
            await StepButton("Again", css, labelHtml);
        }
        else
        {
            <form method="post" action="@Model.Url("Again")" asp-antiforgery="true" data-partial>
                @{ await StepButton("Again", css, labelHtml); }
            </form>
        }
    }

    // The search fields: PAN and date of birth, or a folio number, and the Check record button.
    private async Task SearchFields(NewApplicationViewModel search, string idPrefix, string? focus)
    {
        var panInvalid = search.PanError is not null ? "is-invalid" : null;
        var dobInvalid = search.DobError is not null ? "is-invalid" : null;
        var folioInvalid = search.FolioError is not null ? "is-invalid" : null;

        if (Model.FolioSearch)
        {
            <fieldset class="search-by">
                <legend class="field-label">Search By</legend>
                <label class="radio-option">
                    <input type="radio" name="@Model.Name("By")" value="pan" checked="@(search.By != "folio")">
                    <span>PAN &amp; Date of Birth</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="@Model.Name("By")" value="folio" checked="@(search.By == "folio")">
                    <span>Folio Number</span>
                </label>
            </fieldset>
        }
        else
        {
            <input type="hidden" name="@Model.Name("By")" value="pan">
        }

        <div class="field-grid">
            <div class="form-field" data-for="pan">
                <label class="field-label" for="@(idPrefix)Pan">Enter PAN</label>
                <input class="field-input field-input--caps @panInvalid" id="@(idPrefix)Pan" maxlength="10" name="@Model.Name("Pan")" value="@search.Pan"
                       maxlength="10" autocomplete="off" spellcheck="false" aria-describedby="@(idPrefix)PanError"
                       data-required="Enter the PAN" data-check="pan"
                       aria-invalid="@(search.PanError is not null ? "true" : null)" autofocus="@(focus == idPrefix + "Pan")">
                <p class="field-error" id="@(idPrefix)PanError" hidden="@(search.PanError is null)">@search.PanError</p>
            </div>

            <div class="form-field" data-for="pan">
                <span class="field-label" id="@(idPrefix)DobLabel">Date Of Birth</span>
                <div class="date-input @dobInvalid" role="group" aria-labelledby="@(idPrefix)DobLabel" aria-describedby="@(idPrefix)DobError"
                     data-required="Enter the date of birth" data-check="date" data-error-id="@(idPrefix)DobError">
                    <input class="date-input__part" id="@(idPrefix)Dd" name="@Model.Name("Dd")" value="@search.Dd" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" autofocus="@(focus == idPrefix + "Dd")">
                    <span class="date-input__sep">/</span>
                    <input class="date-input__part" name="@Model.Name("Mm")" value="@search.Mm" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                    <span class="date-input__sep">/</span>
                    <input class="date-input__part date-input__part--year" name="@Model.Name("Yyyy")" value="@search.Yyyy" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                </div>
                <p class="field-error" id="@(idPrefix)DobError" hidden="@(search.DobError is null)">@search.DobError</p>
            </div>

            @if (Model.FolioSearch)
            {
                <div class="form-field" data-for="folio">
                    <label class="field-label" for="@(idPrefix)Folio">Enter Folio Number</label>
                    <input class="field-input field-input--caps @folioInvalid" id="@(idPrefix)Folio" maxlength="20" name="@Model.Name("Folio")" data-chars="code" value="@search.Folio"
                           maxlength="16" autocomplete="off" spellcheck="false" aria-describedby="@(idPrefix)FolioError"
                           data-required="Enter the folio number"
                           aria-invalid="@(search.FolioError is not null ? "true" : null)" autofocus="@(focus == idPrefix + "Folio")">
                    <p class="field-error" id="@(idPrefix)FolioError" hidden="@(search.FolioError is null)">@search.FolioError</p>
                </div>
            }

            <div class="form-field form-field--check">
                @{ await StepButton("Check", "identify-check-button", "Check record <span aria-hidden=\"true\">&rsaquo;</span>", checksFieldsFirst: true); }
            </div>
        </div>

        @if (search.OpsError is not null)
        {
            @* Nothing the partner can type fixes this, so it says who can. *@
            <div class="alert alert-danger page-missing-items identify-actions" role="alert">
                <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M18.5 4.5l2 2M20.5 4.5l-2 2"></path></svg>
                <div class="page-missing-items__body">
                    <div class="page-missing-items__title">Connect with the Operations team</div>
                    <p>@search.OpsError</p>
                </div>
            </div>
        }

        <p class="field-hint" data-for="pan">Both fields are required &mdash; a PAN-only search is not permitted.</p>
        @if (Model.FolioSearch)
        {
            <p class="field-hint" data-for="folio">The folio number alone is enough &mdash; it returns the same record as the PAN search.</p>
        }
    }
}

@if (record is null)
{
    @if (Model.Embedded)
    {
        <div class="page-search">
            @{ await SearchFields(search, idPrefix, focus); }
        </div>
    }
    else
    {
        <form class="page-search" method="post" action="@Model.Url("Check")" asp-antiforgery="true" data-partial novalidate>
            @{ await SearchFields(search, idPrefix, focus); }
        </form>
    }
}
else
{
    @* The record found, as one read-only panel. *@
    var heading = record.Heading;
    if (Model.KnownName is { Length: > 0 }) heading = Model.KnownName;

    // A folio found is an existing customer; a new investor, or one not identified, gets
    // a note under the record saying what happens next.
    string? note = null;
    if (isNewPan) note = Model.NewPanNote;
    else if (record.Folio.Length == 0) note = search.Detail;

    var newTagText = isNewPan ? "New investor" : search.Kind;

    <div class="investor-panel identify-result">
        <div class="identify-result__head">
            <span class="identify-result__name">@heading</span>
            @if (record.Folio.Length > 0)
            {
                <span class="identify-result__tag">Folio @record.Folio</span>
            }
            else
            {
                <span class="identify-result__tag identify-result__tag--new">@newTagText</span>
            }
            @{ await SearchAgainButton("identify-check-button identify-result__again", "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"M15.5 15.5L20 20\"></path></svg> Search again"); }
        </div>
        <div class="investor-key-value-grid">
            <div class="investor-key-value"><div class="investor-key-value__key">PAN</div><div class="investor-key-value__value">@record.MaskedPan</div></div>
            <div class="investor-key-value"><div class="investor-key-value__key">Date of birth</div><div class="investor-key-value__value">@record.MaskedDob</div></div>
            @if (record.Gender.Length > 0)
            {
                @* Gender is held against the folio and is not the partner's to change here. *@
                <div class="investor-key-value">
                    <div class="investor-key-value__key">Gender</div>
                    <div class="investor-key-value__value">@record.Gender</div>
                    <div class="investor-key-value__note">Held on the folio &mdash; Operations can correct it</div>
                </div>
            }
        </div>
        @if (note is { Length: > 0 })
        {
            <p class="identify-result__said">@note</p>
        }

        @if (search.Identified || isNewPan)
        {
            @* What the register holds against this record, item by item. Anything missing is
               asked for during entry. A new investor has no record yet, so every item is
               listed as collected during entry. *@
            var onRecordClass = record.Missing == 0 ? "page-on-record--complete" : null;
            <div class="investor-panel__part page-on-record @onRecordClass">
                <div class="page-on-record__label">@record.OnRecordTitle</div>
                <ul class="page-on-record__list">
                    @foreach (var item in record.OnRecord)
                    {
                        var itemClass = item.Held ? null : "page-on-record__item--missing";
                        var spoken = "not available with us";
                        if (item.Held) spoken = "available with us";
                        else if (isNewPan) spoken = "collected during entry";
                        <li class="page-on-record__item @itemClass">
                            @if (item.Held)
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
                            }
                            else
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 6v7"></path><circle cx="12" cy="18" r=".6" fill="currentColor"></circle></svg>
                            }
                            <span>@item.Label</span>
                            <span class="visually-hidden">, @spoken</span>
                        </li>
                    }
                </ul>
                <p class="page-on-record__foot">@record.OnRecordFoot</p>
            </div>
        }
    </div>
}

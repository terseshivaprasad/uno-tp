@model HolderIdentificationBlock
@using Stage = UnoTP.ViewModels.InvestorIdentificationViewModel.Stage
@* Investor Identification's search and result for one holder: the primary on
   Investor Identification, and each joint holder on Investor Information. Every
   step posts to the server, which checks the holder against the register (see
   HolderSearch). A PAN with no folio goes on as it stands: its PAN copy is read and
   put to NSDL once it is filed with the holder's documents. *@
@{
    var m = Model.Search;
    var ids = Model.Ids;
    var r = m.Record;
    var newPan = r is not null && r.Folio.Length == 0;

    // The field that needs looking at first takes the caret when the page comes back.
    var focus = m.PanError is not null ? ids + "Pan"
        : m.DobError is not null ? ids + "Dd"
        : m.FolioError is not null ? ids + "Folio"
        : null;
}

@functions {
    // A button that posts one step: through the step's own form, or the page's form.
    private async Task Step(string step, string css, string label, string? loader = null)
    {
        if (Model.Embedded)
        {
            <button type="submit" class="@css" formaction="@Model.Url(step)" formnovalidate data-loader="@loader">@Html.Raw(label)</button>
        }
        else
        {
            <button type="submit" class="@css" data-loader="@loader">@Html.Raw(label)</button>
        }
        await Task.CompletedTask;
    }

    // Search again: a form of its own, or a button in the page's form.
    private async Task Again(string css, string label)
    {
        if (Model.Locked) return;
        if (Model.Embedded)
        {
            await Step("Again", css, label);
        }
        else
        {
            <form method="post" action="@Model.Url("Again")" asp-antiforgery="true" data-partial>
                @{ await Step("Again", css, label); }
            </form>
        }
    }

    private async Task SearchFields(InvestorIdentificationViewModel m, string ids, string? focus)
    {
        if (Model.FolioSearch)
        {
            <fieldset class="csi-searchby">
                <legend class="csi-label">Search By</legend>
                <label class="csi-radio">
                    <input type="radio" name="@Model.Name("By")" value="pan" checked="@(m.By != "folio")">
                    <span>PAN &amp; Date of Birth</span>
                </label>
                <label class="csi-radio">
                    <input type="radio" name="@Model.Name("By")" value="folio" checked="@(m.By == "folio")">
                    <span>Folio Number</span>
                </label>
            </fieldset>
        }
        else
        {
            <input type="hidden" name="@Model.Name("By")" value="pan">
        }

        <div class="csi-fields">
            <div class="csi-field" data-for="pan">
                <label class="csi-label" for="@(ids)Pan">Enter PAN</label>
                <input class="csi-control csi-control--caps @(m.PanError is not null ? "is-invalid" : null)" id="@(ids)Pan" name="@Model.Name("Pan")" value="@m.Pan"
                       maxlength="10" autocomplete="off" spellcheck="false" aria-describedby="@(ids)PanError"
                       aria-invalid="@(m.PanError is not null ? "true" : null)" autofocus="@(focus == ids + "Pan")">
                <p class="csi-error" id="@(ids)PanError" hidden="@(m.PanError is null)">@m.PanError</p>
            </div>

            <div class="csi-field" data-for="pan">
                <span class="csi-label" id="@(ids)DobLabel">Date Of Birth</span>
                @* Three boxes with slashes between, like the old jq-dte control. *@
                <div class="csi-date @(m.DobError is not null ? "is-invalid" : null)" role="group" aria-labelledby="@(ids)DobLabel" aria-describedby="@(ids)DobError">
                    <input class="csi-date__part" id="@(ids)Dd" name="@Model.Name("Dd")" value="@m.Dd" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" autofocus="@(focus == ids + "Dd")">
                    <span class="csi-date__sep">-</span>
                    <input class="csi-date__part" name="@Model.Name("Mm")" value="@m.Mm" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                    <span class="csi-date__sep">-</span>
                    <input class="csi-date__part csi-date__part--year" name="@Model.Name("Yyyy")" value="@m.Yyyy" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                </div>
                <p class="csi-error" id="@(ids)DobError" hidden="@(m.DobError is null)">@m.DobError</p>
            </div>

            @if (Model.FolioSearch)
            {
                <div class="csi-field" data-for="folio">
                    <label class="csi-label" for="@(ids)Folio">Enter Folio Number</label>
                    <input class="csi-control csi-control--caps @(m.FolioError is not null ? "is-invalid" : null)" id="@(ids)Folio" name="@Model.Name("Folio")" value="@m.Folio"
                           maxlength="16" autocomplete="off" spellcheck="false" aria-describedby="@(ids)FolioError"
                           aria-invalid="@(m.FolioError is not null ? "true" : null)" autofocus="@(focus == ids + "Folio")">
                    <p class="csi-error" id="@(ids)FolioError" hidden="@(m.FolioError is null)">@m.FolioError</p>
                </div>
            }

            <div class="csi-field csi-field--check">
                @{ await Step("Check", "csi-check", "Check record <span aria-hidden=\"true\">&rsaquo;</span>"); }
            </div>
        </div>

        @if (m.OpsError is not null)
        {
            @* Nothing the partner can type fixes this, so it says who can. *@
            <div class="csi-gap csi-gap--alert csi-ops" role="alert">
                <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M18.5 4.5l2 2M20.5 4.5l-2 2"></path></svg>
                <div class="csi-gap__body">
                    <div class="csi-gap__title">Connect with the Operations team</div>
                    <p>@m.OpsError</p>
                </div>
            </div>
        }

        <p class="csi-hint" data-for="pan">Both fields are required &mdash; a PAN-only search is not permitted.</p>
        @if (Model.FolioSearch)
        {
            <p class="csi-hint" data-for="folio">The folio number alone is enough &mdash; it returns the same record as the PAN search.</p>
        }
    }
}

@if (r is null)
{
    @if (Model.Embedded)
    {
        <div class="csi-search">
            @{ await SearchFields(m, ids, focus); }
        </div>
    }
    else
    {
        <form class="csi-search" method="post" action="@Model.Url("Check")" asp-antiforgery="true" data-partial novalidate>
            @{ await SearchFields(m, ids, focus); }
        </form>
    }
}
else
{
    @* The record, laid out on the page. The old site put the match behind a
       "Please make a selection" dialog. *@
    <div class="csi-result">
        <div class="csi-result__head">
            <span class="csi-avatar @(r.Initials.Length > 0 ? "csi-avatar--initials" : null)" aria-hidden="true">
                <svg class="csi-avatar__figure" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"></circle><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0"></path></svg>
                <span class="csi-avatar__initials">@r.Initials</span>
            </span>
            <div class="csi-result__who">
                <div class="csi-result__name">@(Model.KnownName is { Length: > 0 } known ? known : r.Heading)</div>
                <div class="csi-result__meta">
                    @if (r.Id is not null)
                    {
                        <span class="csi-result__id">@r.Id</span>
                    }
                    @{
                        var kind = newPan ? "New investor" : m.Kind;
                    }
                    <span class="csi-chip @(kind switch { "Existing customer" => "csi-chip--success", "New investor" => "csi-chip--new", _ => null })">@kind</span>
                    <span class="csi-result__detail">@(newPan ? Model.NewPanNote : m.Detail)</span>
                </div>
            </div>
            @* Back to the fields, still holding what was typed. *@
            @{ await Again("csi-again", "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"></circle><path d=\"M15.5 15.5L20 20\"></path></svg> Search again"); }
        </div>

        <dl class="csi-record">
            <div class="csi-record__item"><dt>PAN</dt><dd>@r.MaskedPan</dd></div>
            <div class="csi-record__item"><dt>Date of birth</dt><dd>@r.MaskedDob</dd></div>
            @* Gender is held against the folio and is not the partner's to change
               here, so the card says where a correction comes from. *@
            @if (r.Gender.Length > 0)
            {
                <div class="csi-record__item">
                    <dt>
                        Gender
                        <svg class="csi-record__lock" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9.5" rx="1.5"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                    </dt>
                    <dd>@r.Gender</dd>
                    <p class="csi-record__hint">Held on the folio &mdash; Operations can correct it</p>
                </div>
            }
            @if (r.Note.Length > 0)
            {
                <div class="csi-record__item"><dt>KYC</dt><dd>@r.Note</dd></div>
            }
        </dl>

        @if (m.Identified)
        {
            @* What the register holds against this record, item by item. Anything
               missing is asked for again during entry, so it is said here rather
               than left for the upload step to spring. *@
            <div class="csi-onrecord @(r.Missing == 0 ? "csi-onrecord--complete" : null)">
                <div class="csi-onrecord__label">@r.OnRecordTitle</div>
                <ul class="csi-onrecord__list">
                    @foreach (var item in r.OnRecord)
                    {
                        <li class="csi-onrecord__item @(item.Held ? null : "csi-onrecord__item--missing")">
                            @if (item.Held)
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"></path></svg>
                            }
                            else
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 6v7"></path><circle cx="12" cy="18" r=".6" fill="currentColor"></circle></svg>
                            }
                            <span>@item.Label</span>
                            <span class="visually-hidden">, @(item.Held ? "available with us" : "not available with us")</span>
                        </li>
                    }
                </ul>
                <p class="csi-onrecord__foot">@r.OnRecordFoot</p>
            </div>
        }
    </div>
}

@inject UnoTP.Models.ConsoleState Console
@{
    var upcoming = (await Console.BoardAsync()).Bell();
}
@* The bell in the top bar: what is coming that the partner cannot control -
   rate changes, downtime and maintenance - with the soonest first. *@
<div class="notices">
    <button type="button" class="notices__bell" id="noticesBell" aria-expanded="false" aria-controls="noticesPanel" aria-label="@upcoming.Count scheduled notices">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6.5 9.5a5.5 5.5 0 0 1 11 0c0 4.5 1.8 5.5 1.8 5.5H4.7s1.8-1 1.8-5.5z"></path>
            <path d="M10.2 18.5a2 2 0 0 0 3.6 0"></path>
        </svg>
        <span class="notices__count">@upcoming.Count</span>
    </button>

    <div class="notices__panel" id="noticesPanel" role="dialog" aria-label="Scheduled notices" hidden>
        <div class="notices__head">
            <div>
                <h2 class="notices__title">What is coming</h2>
                <p class="notices__sub">Scheduled changes and outages &middot; nothing to do now</p>
            </div>
            <button type="button" class="notices__close btn-reset" id="noticesClose" aria-label="Close">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
            </button>
        </div>

        <ul class="notices__list">
            @foreach (var n in upcoming)
            {
                <li class="notice" data-notice="@n.Id" data-at="@(n.At?.ToString("s"))">
                    <div class="notice__top">
                        <span class="notice__kind @n.Tone">@n.Kind</span>
                        <span class="notice__away">@n.Away</span>
                    </div>
                    <div class="notice__title">@n.Title</div>
                    <div class="notice__when">@n.When</div>
                    <p class="notice__detail">@n.Detail</p>
                </li>
            }
        </ul>
    </div>
</div>

@model BankDetailsViewModel
@{
    ViewData["Title"] = "Bank Details & Payment";

    // The fourth classic step, in the frame Upload Documents and Investor
    // Information draw: the account the deposit is paid from, then the account
    // interest and the maturity amount are paid into. Only a cheque is drawn on an
    // account, so the first card - and "same as the payment account" - is there
    // only when the deposit is paid by cheque; paid online or by RTGS, the
    // repayment account is all the step asks for.
    var f = Model.Form;
    var same = Model.SameAsPayment;
    var appNo = Model.Docs.AppNo;
    var banner = Model.Problem("banner");

    // What Proceed found, in page order; the first takes the caret.
    var ids = new Dictionary<string, string>
    {
        ["Payment.Ifsc"] = "pay-ifsc",
        ["Payment.AccountNumber"] = "pay-account",
        ["Payment.AccountNumberConfirm"] = "pay-account-confirm",
        ["Cheque.Number"] = "cheque-number",
        ["Cheque.Date"] = "cheque-date",
        ["Cheque.CmsLocation"] = "cms-location",
        ["Repayment.Ifsc"] = "repay-ifsc",
        ["Repayment.AccountNumber"] = "repay-account",
        ["Repayment.AccountNumberConfirm"] = "repay-account-confirm",
    };
    var focus = ids.FirstOrDefault(i => Model.Problem(i.Key) is not null).Value;
    var problems = Model.Problems.Count(p => p.Key != "banner");
}

@functions {
    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    // The attributes a control Proceed found wanting carries.
    private string? Invalid(string key) => Model.Problem(key) is null ? null : "is-invalid";
    private string? InvalidAria(string key) => Model.Problem(key) is null ? null : "true";
    private string? DescribedBy(string key, string id) => Model.Problem(key) is null ? null : id + "Error";

    // What Proceed said about a field, under it.
    private async Task FieldError(string key, string id)
    {
        if (Model.Problem(key) is { } message)
        {
            <p class="csi-error" id="@(id)Error" role="alert">@message</p>
        }
        await Task.CompletedTask;
    }

    // The card's head: its title, and on the first card the application number,
    // which the strip keeps in view once it scrolls off.
    private async Task Head(string title, bool first)
    {
        <div class="cii-head" data-pin-head="@(first ? "" : null)">
            <h2 class="cii-title">@title</h2>
            @if (first)
            {
                <span class="cii-app">Application No: <strong>@Model.Docs.AppNo</strong>
                    <button type="button" class="cud-copy" data-copy="@Model.Docs.AppNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
                    </button>
                </span>
            }
        </div>
        await Task.CompletedTask;
    }

    // An account's IFSC and number, typed twice, as the backend keeps it.
    // The bank is searched for by any part of its name, the branch, the IFSC or
    // the MICR (bank-search.js); the branch picked leaves its IFSC in the field.
    private async Task Account(string key, string id, AccountForm account)
    {
        <div class="cud-grid">
            <div class="cud-col bank-search">
                <label class="csi-label" for="@(id)-ifsc">Bank &mdash; search by name, branch, IFSC or MICR</label>
                <input class="csi-control @Invalid(key + ".Ifsc")" id="@(id)-ifsc" name="@(key).Ifsc" value="@account.Ifsc" maxlength="60" autocomplete="off" spellcheck="false" placeholder="e.g. HDFC Andheri or HDFC0000521"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="@(id)-suggest"
                       data-bank-search="@Url.Action("Branches")" data-find="bank-find-@(key.ToLowerInvariant())"
                       aria-invalid="@InvalidAria(key + ".Ifsc")" aria-describedby="@DescribedBy(key + ".Ifsc", id + "-ifsc")">
                <ul class="bank-suggest" id="@(id)-suggest" role="listbox" aria-label="Branches found" hidden></ul>
                @{ await FieldError(key + ".Ifsc", id + "-ifsc"); }
            </div>
            <div class="cud-col">
                <label class="csi-label" for="@(id)-account">Account Number</label>
                <input class="csi-control @Invalid(key + ".AccountNumber")" id="@(id)-account" name="@(key).AccountNumber" value="@account.AccountNumber" inputmode="numeric" maxlength="18" autocomplete="off" aria-invalid="@InvalidAria(key + ".AccountNumber")" aria-describedby="@DescribedBy(key + ".AccountNumber", id + "-account")">
                @{ await FieldError(key + ".AccountNumber", id + "-account"); }
            </div>
            <div class="cud-col">
                <label class="csi-label" for="@(id)-account-confirm">Re-enter Account Number</label>
                @* Masked as it is typed, so the number is typed again rather than copied from the first box. *@
                <input class="csi-control csi-control--masked @Invalid(key + ".AccountNumberConfirm")" id="@(id)-account-confirm" name="@(key).AccountNumberConfirm" value="@account.AccountNumberConfirm" inputmode="numeric" maxlength="18" autocomplete="off" spellcheck="false" aria-invalid="@InvalidAria(key + ".AccountNumberConfirm")" aria-describedby="@DescribedBy(key + ".AccountNumberConfirm", id + "-account-confirm")">
                @{ await FieldError(key + ".AccountNumberConfirm", id + "-account-confirm"); }
            </div>
        </div>
        await Task.CompletedTask;
    }

    // The bank an IFSC names, read-only, as Investor Information shows what was read.
    private async Task Branch(BankBranch? branch, string ifsc, string id)
    {
        <div class="inv-panel bank-branch" id="@id">
            <div class="inv-panel__label" style="padding-bottom:10px">Bank and branch &middot; from the IFSC</div>
            <div class="inv-kv-grid">
                @if (branch is not null)
                {
                    <div class="inv-kv"><div class="inv-kv__k">Bank name</div><div class="inv-kv__v">@branch.Bank</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">Branch name</div><div class="inv-kv__v">@branch.Branch</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">IFSC &middot; MICR</div><div class="inv-kv__v">@branch.Ifsc &middot; @branch.Micr</div></div>
                }
                else
                {
                    <div class="inv-kv inv-kv--wide"><div class="inv-kv__v inv-kv__v--unread">@(ifsc.Length == 0 ? "Found once a branch is picked from the search" : "No branch has this IFSC — pick one from the search, or check it against the cheque")</div></div>
                }
            </div>
        </div>
        await Task.CompletedTask;
    }
}

@* Once the first card's head has scrolled off, this keeps who the step is for
   and which application it is in view, as the steps before it do. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@Model.Docs.HolderName</span>
        <span class="cud-pin__pan">PAN @Model.Docs.HolderPan</span>
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @appNo
            <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="3" />

    <form class="csi-main" id="bankDetailsForm" method="post" data-partial novalidate data-partial-focus="@focus">
        @* Enter in an IFSC looks it up: the first submit button in the form. *@
        @if (Model.ByCheque)
        {
            <button type="submit" class="visually-hidden" id="bank-find-payment" name="Find" value="payment" formnovalidate tabindex="-1">Find the payment branch</button>
        }
        <button type="submit" class="visually-hidden" id="bank-find-repayment" name="Find" value="repayment" formnovalidate tabindex="-1">Find the repayment branch</button>

        @if (banner is not null)
        {
            <div class="cud-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <span>@banner</span>
            </div>
        }

        @* ── The account the cheque is drawn on ──────────────────────────────── *@
        @if (Model.ByCheque)
        {
            <section class="csi-card cii-card" id="payment">
                @{ await Head("Payment Bank Details", first: true); }
                <p class="cii-note">The account the cheque is drawn on &middot; paid by @Model.PayMode</p>
                @{ await Account("Payment", "pay", f.Payment); }
                <div class="bank-after">@{ await Branch(Model.PaymentBranch, f.Payment.CleanIfsc, "pay-lookup"); }</div>

                <h3 class="cii-section">Cheque Details</h3>
                <div class="cud-grid">
                    <div class="cud-col">
                        <label class="csi-label" for="cheque-number">Cheque Number</label>
                        <input class="csi-control @Invalid("Cheque.Number")" id="cheque-number" name="Cheque.Number" value="@f.Cheque.Number" inputmode="numeric" maxlength="6" autocomplete="off" aria-invalid="@InvalidAria("Cheque.Number")" aria-describedby="@DescribedBy("Cheque.Number", "cheque-number")">
                        @{ await FieldError("Cheque.Number", "cheque-number"); }
                    </div>
                    <div class="cud-col">
                        <label class="csi-label" for="cheque-date">Cheque Date</label>
                        <input class="csi-control @Invalid("Cheque.Date")" id="cheque-date" name="Cheque.Date" value="@f.Cheque.Date" placeholder="DD / MM / YYYY" inputmode="numeric" autocomplete="off" aria-invalid="@InvalidAria("Cheque.Date")" aria-describedby="@DescribedBy("Cheque.Date", "cheque-date")">
                        @{ await FieldError("Cheque.Date", "cheque-date"); }
                    </div>
                    <div class="cud-col">
                        <label class="csi-label" for="cms-location">Axis CMS Branch</label>
                        @* Typed, with the backend's branches offered as the browser's own suggestions. *@
                        <input class="csi-control @Invalid("Cheque.CmsLocation")" id="cms-location" name="Cheque.CmsLocation" value="@f.Cheque.CmsLocation" list="cms-locations" placeholder="Start typing a branch" autocomplete="off" spellcheck="false" aria-invalid="@InvalidAria("Cheque.CmsLocation")" aria-describedby="@(DescribedBy("Cheque.CmsLocation", "cms-location") ?? "cms-location-hint")">
                        <datalist id="cms-locations">
                            @foreach (var location in Model.CmsLocations) { <option value="@location"></option> }
                        </datalist>
                        @{ await FieldError("Cheque.CmsLocation", "cms-location"); }
                        <p class="csi-hint" id="cms-location-hint">The Axis branch the cheque is presented at &mdash; the one nearest the investor</p>
                    </div>
                </div>

                @if (Model.ChequeRead is { } cheque)
                {
                    @* What Upload Documents read off the cheque, to type the account against. *@
                    <div class="bank-verified bank-after">
                        <svg class="bank-verified__tick" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
                        <div class="bank-verified__text"><strong>@cheque.State.</strong> Read off the cheque filed on <a asp-controller="UploadDocuments" asp-action="Index">Upload Documents</a>: @cheque.Lines</div>
                    </div>
                }
            </section>
        }

        @* ── The account interest and the maturity amount go to ──────────────── *@
        <section class="csi-card cii-card" id="repayment">
            @{ await Head("Repayment Bank Details", first: !Model.ByCheque); }
            <p class="cii-note">Interest and the maturity amount are paid into this account@(Model.ByCheque ? "" : $" · paid by {(Model.PayMode.Length > 0 ? Model.PayMode : "the mode chosen on Upload Documents")}")</p>

            @if (Model.ByCheque)
            {
                <div class="cii-switches">
                    <label class="inv-switch-row" for="repay-same">
                        <span>Same as the payment account</span>
                        @* The hidden false goes after the box, so an unticked box still posts, and a ticked one binds first. *@
                        <input type="checkbox" id="repay-same" name="Repayment.SameAsPayment" value="true" class="inv-switch" checked="@same" data-submit="bank-find-repayment">
                        <input type="hidden" name="Repayment.SameAsPayment" value="false">
                    </label>
                </div>
            }

            @if (!same)
            {
                await Account("Repayment", "repay", f.Repayment);
                <div class="bank-after">@{ await Branch(Model.RepaymentBranch, f.Repayment.CleanIfsc, "repay-lookup"); }</div>
            }

            <div class="bank-note bank-after">
                <strong>The account must belong to a holder on this application.</strong> A third-party account is rejected by Operations.
                @(same ? "Interest and the maturity amount go back to the account the cheque is drawn on." : null)
            </div>
        </section>

        @* The test branches, while test data is on: what the bank search finds. *@
        @if (Model.Demo is { } demo)
        {
            <section class="csi-demo" aria-labelledby="bank-demo-title">
                <h2 class="csi-demo__title" id="bank-demo-title">Test banks</h2>
                <p class="csi-demo__sub">@demo.Branches.Count branches the bank search finds &middot; test records only</p>
                <table class="csi-demo__table">
                    <thead>
                        <tr>
                            <th scope="col">IFSC</th>
                            <th scope="col">Bank</th>
                            <th scope="col">Branch</th>
                            <th scope="col">MICR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in demo.Branches)
                        {
                            <tr>
                                <td data-label="IFSC"><code>@b.Ifsc</code></td>
                                <td data-label="Bank">@b.Bank</td>
                                <td data-label="Branch">@b.Branch</td>
                                <td data-label="MICR"><code>@b.Micr</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <ul class="csi-demo__notes">
                    @foreach (var note in demo.Notes) { <li>@note</li> }
                </ul>
            </section>
        }
    </form>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="InvestorInfo" asp-action="Index" data-loader="Going back to Investor Information">Back</a>
        <p class="csi-bar__hint">
            @if (problems > 0)
            {
                @($"{problems} thing{(problems == 1 ? "" : "s")} still to fix on this step")
            }
            else
            {
                <text>Enter the @(Model.ByCheque ? "accounts and the cheque" : "repayment account"), then proceed to <strong>FD Configuration</strong></text>
            }
        </p>
        <div class="csi-bar__right">
            <button type="submit" form="bankDetailsForm" class="csi-btn csi-btn--primary" id="bank-proceed" data-loader="Saving the accounts&hellip;">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/partial-forms.js" asp-append-version="true"></script>
    <script src="~/js/classic-pin.js" asp-append-version="true"></script>
    <script src="~/js/bank-search.js" asp-append-version="true"></script>
}

@model BankDetailsViewModel
@{
    ViewData["Title"] = "Bank Details & Payment";
    Layout = "_WizardLayout";
    ViewData["WizardStep"] = "bank";

    // The accounts and the cheque as the backend holds them for this application,
    // the branch each IFSC names, and the cheque as Upload Documents read it.
    var f = Model.Form;
    var same = f.Repayment.SameAsPayment;
    var banner = Model.Problem("banner");
    string? Error(string key) => Model.Problem(key);
    string? Invalid(string key) => Error(key) is null ? null : "inv-control--error";
}

@functions {
    // The bank a looked-up IFSC names, or why there is none to show.
    private async Task Branch(BankBranch? branch, string ifsc, string id)
    {
        <div class="bank-lookup" id="@id">
            @if (branch is not null)
            {
                <div class="inv-kv"><div class="inv-kv__k">Bank name</div><div class="inv-kv__v">@branch.Bank</div></div>
                <div class="inv-kv"><div class="inv-kv__k">Branch name</div><div class="inv-kv__v">@branch.Branch</div></div>
                <div class="inv-kv"><div class="inv-kv__k">IFSC</div><div class="inv-kv__v">@branch.Ifsc</div></div>
                <div class="inv-kv"><div class="inv-kv__k">MICR</div><div class="inv-kv__v">@branch.Micr</div></div>
            }
            else
            {
                <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Bank and branch</div><div class="inv-kv__v inv-kv__v--unread">@(ifsc.Length == 0 ? "Found once the IFSC is entered" : "No branch has this IFSC — check it against the cheque")</div></div>
            }
        </div>
        await Task.CompletedTask;
    }

    private async Task FieldError(string key)
    {
        if (Model.Problem(key) is { } message)
        {
            <div class="inv-field__hint inv-field__hint--error" role="alert">@message</div>
        }
        await Task.CompletedTask;
    }
}

<div class="inv-page-head">
    <div style="flex:1;min-width:0">
        <div class="inv-title">Payment Bank Details</div>
        <div style="font-size:12px;color:var(--muted);padding-top:4px">The account the deposit is paid from &middot; paid by @(Model.PayMode.Length > 0 ? Model.PayMode : "the mode chosen on Upload Documents")</div>
    </div>
    <div style="font-size:12.5px;color:var(--muted);flex:none">Application No: <span style="font-weight:600;color:var(--ink)">@Model.Docs.AppNo</span></div>
</div>

@if (banner is not null)
{
    <div class="cud-banner" role="status"><span>@banner</span></div>
}

<form method="post" id="bankDetailsForm" class="inv-form" data-partial novalidate>

    @* ── Payment account ──────────────────────────────────────────────────── *@
    <div class="bank-grid">
        <div class="inv-field">
            <label for="pay-ifsc">IFSC of the paying account <span class="required">*</span></label>
            <input id="pay-ifsc" name="Payment.Ifsc" class="inv-control @Invalid("Payment.Ifsc")" value="@f.Payment.Ifsc" maxlength="11" autocomplete="off" data-submit="bank-find-payment" />
            @{ await FieldError("Payment.Ifsc"); }
            <button type="submit" class="csi-link btn-reset" id="bank-find-payment" name="Find" value="payment" formnovalidate>Find the branch</button>
        </div>
        <div class="inv-field">
            <label for="pay-account">Account Number <span class="required">*</span></label>
            <input id="pay-account" name="Payment.AccountNumber" class="inv-control @Invalid("Payment.AccountNumber")" value="@f.Payment.AccountNumber" inputmode="numeric" autocomplete="off" />
            @{ await FieldError("Payment.AccountNumber"); }
        </div>
        <div class="inv-field">
            <label for="pay-account-confirm">Re-enter Account Number <span class="required">*</span></label>
            <input id="pay-account-confirm" name="Payment.AccountNumberConfirm" class="inv-control @Invalid("Payment.AccountNumberConfirm")" value="@f.Payment.AccountNumberConfirm" inputmode="numeric" autocomplete="off" />
            @{ await FieldError("Payment.AccountNumberConfirm"); }
        </div>
        @if (Model.ByCheque)
        {
            <div class="inv-field">
                <label for="cheque-date">Cheque Date <span class="required">*</span></label>
                <input id="cheque-date" name="Cheque.Date" class="inv-control @Invalid("Cheque.Date")" value="@f.Cheque.Date" placeholder="DD / MM / YYYY" />
                @{ await FieldError("Cheque.Date"); }
            </div>
            <div class="inv-field">
                <label for="cheque-number">Cheque Number <span class="required">*</span></label>
                <input id="cheque-number" name="Cheque.Number" class="inv-control @Invalid("Cheque.Number")" value="@f.Cheque.Number" inputmode="numeric" maxlength="6" />
                @{ await FieldError("Cheque.Number"); }
            </div>
            <div class="inv-field">
                <label for="cms-location">Axis CMS Location <span class="required">*</span></label>
                <select id="cms-location" name="Cheque.CmsLocation" class="inv-control @Invalid("Cheque.CmsLocation")">
                    <option value="">Select</option>
                    @foreach (var location in Model.CmsLocations)
                    {
                        <option value="@location" selected="@(f.Cheque.CmsLocation == location)">@location</option>
                    }
                </select>
                @{ await FieldError("Cheque.CmsLocation"); }
                <div class="inv-field__hint">the Axis branch the cheque is presented at &mdash; pick the one nearest the investor</div>
            </div>
        }
    </div>

    @{ await Branch(Model.PaymentBranch, f.Payment.CleanIfsc, "pay-lookup"); }

    @if (Model.ChequeRead is { } cheque)
    {
        @* What Upload Documents read off the cheque, to type the account against. *@
        <div class="bank-verified">
            <div class="bank-verified__tick">&check;</div>
            <div class="bank-verified__text"><strong>@cheque.State.</strong> Read off the cheque filed on <a asp-controller="UploadDocuments" asp-action="Index">Upload Documents</a>: @cheque.Lines</div>
        </div>
    }

    @* ── Repayment account ────────────────────────────────────────────────── *@
    <section class="bank-repayment">
        <div class="bank-repayment__head">
            <div style="min-width:0;flex:1">
                <div class="inv-title">Repayment Bank Details</div>
                <div style="font-size:12px;color:var(--muted);padding-top:4px">Paid to the investor &mdash; the account must belong to a holder on this application</div>
            </div>
            <label class="bank-same" for="repay-same">
                <span>Same as the payment account</span>
                @* The hidden false goes after the box, so an unticked box still posts, and a ticked one binds first. *@
                <input type="checkbox" id="repay-same" name="Repayment.SameAsPayment" value="true" class="inv-switch" aria-label="Same as the payment account" checked="@same" data-submit="bank-find-repayment" />
                <input type="hidden" name="Repayment.SameAsPayment" value="false" />
            </label>
        </div>

        @if (!same)
        {
            <div class="bank-grid">
                <div class="inv-field">
                    <label for="repay-ifsc">IFSC of the repayment account <span class="required">*</span></label>
                    <input id="repay-ifsc" name="Repayment.Ifsc" class="inv-control @Invalid("Repayment.Ifsc")" value="@f.Repayment.Ifsc" maxlength="11" autocomplete="off" data-submit="bank-find-repayment" />
                    @{ await FieldError("Repayment.Ifsc"); }
                </div>
                <div class="inv-field">
                    <label for="repay-account">Account Number <span class="required">*</span></label>
                    <input id="repay-account" name="Repayment.AccountNumber" class="inv-control @Invalid("Repayment.AccountNumber")" value="@f.Repayment.AccountNumber" inputmode="numeric" autocomplete="off" />
                    @{ await FieldError("Repayment.AccountNumber"); }
                </div>
                <div class="inv-field">
                    <label for="repay-account-confirm">Re-enter Account Number <span class="required">*</span></label>
                    <input id="repay-account-confirm" name="Repayment.AccountNumberConfirm" class="inv-control @Invalid("Repayment.AccountNumberConfirm")" value="@f.Repayment.AccountNumberConfirm" inputmode="numeric" autocomplete="off" />
                    @{ await FieldError("Repayment.AccountNumberConfirm"); }
                </div>
            </div>
            await Branch(Model.RepaymentBranch, f.Repayment.CleanIfsc, "repay-lookup");
        }
        <button type="submit" class="visually-hidden" id="bank-find-repayment" name="Find" value="repayment" formnovalidate tabindex="-1">Find the repayment branch</button>

        <div class="bank-note">
            <strong>Both the payment and the repayment account must belong to a holder on this application.</strong> A third-party account is rejected by Operations at either end.
            @(same ? "Interest and the maturity amount are paid to the account the deposit is paid from." : "Interest and the maturity amount are paid to the account above.")
        </div>
    </section>
</form>

@section Footer {
    @* The classic wizard's bar, as Upload Documents has it. *@
    <footer class="csi-bar">
        <div class="csi-bar__inner">
            <a class="csi-btn csi-btn--back" asp-controller="InvestorInfo" asp-action="Index" data-loader="Going back to Investor Information">Back</a>
            <p class="csi-bar__hint">@(Model.Problems.Count(p => p.Key != "banner") is var n && n > 0 ? $"{n} thing{(n == 1 ? "" : "s")} still to fix on this step" : "Saved as you go · Proceed checks the accounts")</p>
            <div class="csi-bar__right">
                <button type="submit" form="bankDetailsForm" class="csi-btn csi-btn--primary" id="bank-proceed" data-loader="Saving the accounts&hellip;">Proceed</button>
            </div>
        </div>
    </footer>
}

@section Scripts {
    <script src="~/js/partial-forms.js" asp-append-version="true"></script>
}

@model ReviewViewModel
@{
    ViewData["Title"] = "Application Submitted";
    Layout = "_Layout";

    // The application as the backend has it once submitted: when, where the
    // payment link went and until when, and the deposit it carries.
    var sub = Model.App.Submitted!;
    var d = Model.Deposit;
    var q = Model.Quote;
    var hours = Model.PaymentLinkHours;
    var payout = Model.Payout;
    var nextSteps = new[]
    {
        (Lead: "Investor pays the link", Detail: $" — from any account in a holder’s name. Within {hours} hours."),
        (Lead: "Rate locks on realisation", Detail: " and the FD is booked from that date — not from today."),
        (Lead: "Operations verifies the documents", Detail: " — the e-receipt is e-mailed to the investor once booked."),
    };
}

<div class="sub-page">
    <div class="sub-main">
        <div class="sub-title-row">
            <div class="sub-tick" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
            </div>
            <div>
                <h1 class="sub-title">Application submitted</h1>
                <div class="sub-meta">@Money.Day(sub.At) &middot; @Model.Docs.AppNo</div>
            </div>
        </div>

        @if (Model.Refused is { } refused)
        {
            <div class="cud-banner" role="alert"><span>@refused</span></div>
        }

        <div class="sub-pending">
            <div class="sub-pending__head">
                <div class="sub-pending__title">Waiting on the investor&rsquo;s payment</div>
                <div class="sub-pending__tag">@(sub.Status == "payment-pending" ? "Payment pending" : sub.Status)</div>
            </div>
            <div class="sub-pending__text">The link was sent by SMS to <strong>@sub.LinkSentTo</strong>@if (sub.LinkEmailedTo.Length > 0) {<text> and by e-mail to <strong>@sub.LinkEmailedTo</strong></text>}, and expires <strong>@Money.Day(sub.LinkValidUntil)</strong>. Submitted is not booked &mdash; the deposit and its rate are held only until then.</div>
        </div>

        <div class="sub-box">
            <div class="sub-box__label">What happens next</div>
            <ol class="sub-steps">
                @for (var i = 0; i < nextSteps.Length; i++)
                {
                    <li class="sub-step @(i == 0 ? "sub-step--current" : "")">
                        <span class="sub-step__num">@(i + 1)</span>
                        <span class="sub-step__text"><strong>@nextSteps[i].Lead</strong>@nextSteps[i].Detail</span>
                    </li>
                }
            </ol>
        </div>

        <form method="post" asp-action="Resend" class="sub-actions">
            <button type="submit" class="btn btn-primary sub-actions__primary" disabled="@(sub.ResendsLeft == 0)" data-loader="Sending the link again&hellip;">@(sub.ResendsLeft == 0 ? "Payment link resent" : "Resend payment link")</button>
            <a class="sub-actions__link sub-actions__link--plain" asp-controller="Dashboard" asp-action="Index">Back to home</a>
        </form>
        <div class="sub-note">@(sub.ResendsLeft == 0 ? $"No resends left. The link still expires {Money.Day(sub.LinkValidUntil)}." : $"{sub.ResendsLeft} resend{(sub.ResendsLeft == 1 ? " is" : "s are")} available.")</div>
    </div>

    <div class="sub-side">
        <section class="sub-card">
            <div class="sub-card__head">
                <div class="sub-card__title">Deposit summary</div>
            </div>
            @if (d is not null)
            {
                <div class="sub-kv-grid">
                    <div><div class="sub-kv__k">Invested amount</div><div class="sub-kv__v sub-kv__v--lg">@Money.Rupees(d.Amount)</div></div>
                    <div><div class="sub-kv__k">Rate of interest</div><div class="sub-kv__v sub-kv__v--lg sub-kv__v--green">@(q is null ? "—" : $"{q.Rate:0.00}% p.a.")</div></div>
                    <div><div class="sub-kv__k">Tenure</div><div class="sub-kv__v">@d.TenureMonths months</div></div>
                    <div><div class="sub-kv__k">Scheme</div><div class="sub-kv__v">@(payout?.PerYear == 0 ? "Cumulative" : "Non-cumulative") &middot; @Model.Docs.CategoryName(Model.Docs.State.Category)</div></div>
                    <div><div class="sub-kv__k">Interest payout</div><div class="sub-kv__v">@(payout?.Name ?? d.Payout)</div></div>
                    <div><div class="sub-kv__k">Maturity value</div><div class="sub-kv__v">@(q is null ? "—" : Money.Rupees(q.MaturityAmount))</div></div>
                    <div><div class="sub-kv__k">Auto renewal</div><div class="sub-kv__v">@(d.AutoRenewal ? $"On · {Model.Option(Model.Ref.RenewInstructions, d.RenewInstruction)}" : "Off")</div></div>
                    <div><div class="sub-kv__k">TDS</div><div class="sub-kv__v">@(d.NoTds ? "Not deducted" : "Deducted")</div></div>
                    <div><div class="sub-kv__k">Delivery</div><div class="sub-kv__v">@Model.Option(Model.Ref.DeliveryTypes, d.DeliveryType)</div></div>
                </div>
            }
            <div class="sub-holders">
                <div class="sub-holders__label">Holders</div>
                <div class="sub-holders__names">
                    @for (var i = 0; i < Model.Holders.Count; i++)
                    {
                        var h = Model.Holders[i];
                        @(i > 0 ? " · " : "")@h.Holder.Who.Name @if (!h.Holder.Joint) { <span class="sub-holders__role">primary</span> }
                    }
                </div>
            </div>
        </section>

        <section class="sub-card sub-card--padded">
            <div class="sub-card__title">Start another</div>
            <div class="sub-tiles">
                <a class="sub-tile" asp-controller="InvestorIdentification" asp-action="Index">
                    <span class="sub-tile__title">New application</span>
                    <span class="sub-tile__text">A different investor, from the search step.</span>
                </a>
                <a class="sub-tile" asp-controller="ViewApplication" asp-action="Index">
                    <span class="sub-tile__title">Track this application</span>
                    <span class="sub-tile__text">Find it among the partner&rsquo;s applications.</span>
                </a>
            </div>
        </section>
    </div>
</div>

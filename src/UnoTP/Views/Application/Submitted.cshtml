@model ReviewViewModel
@{
    ViewData["Title"] = "Application Submitted";

    // The application as the backend has it once submitted, in the frame the
    // steps before it draw, every step behind it: when, where the payment link
    // went and until when, and the deposit it carries.
    var sub = Model.App.Submitted!;
    var d = Model.Deposit;
    var q = Model.Quote;
    var hours = Model.PaymentLinkHours;
    var payout = Model.Payout;
    var appNo = Model.Docs.AppNo;
    var nextSteps = new[]
    {
        (Lead: "Investor pays the link", Detail: $" — from any account in a holder’s name. Within {hours} hours."),
        (Lead: "Rate locks on realisation", Detail: " and the FD is booked from that date — not from today."),
        (Lead: "Operations verifies the documents", Detail: " — the e-receipt is e-mailed to the investor once booked."),
    };
}

@functions {
    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    private async Task Kv(string key, string value)
    {
        <div class="inv-kv"><div class="inv-kv__k">@key</div><div class="inv-kv__v">@value</div></div>
        await Task.CompletedTask;
    }
}

<div class="csi">
    <partial name="_ClassicSteps" model="@InvestorIdentificationViewModel.Steps.Length" />

    <div class="csi-main">
        @if (Model.Refused is { } refused)
        {
            <div class="csi-gap csi-gap--alert" role="alert">
                <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="csi-gap__body"><p>@refused</p></div>
            </div>
        }

        @* ── Submitted, and waiting on the investor ─────────────────────────── *@
        <section class="csi-card cii-card" id="submitted">
            <div class="cii-head">
                <h2 class="cii-title">Application Submitted</h2>
                <span class="cii-app">Application No: <strong>@appNo</strong>
                    <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
                    </button>
                </span>
            </div>
            <p class="cii-note">Submitted @Money.Day(sub.At)</p>

            <div class="cud-banner bank-after" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
                <span><strong>@(sub.Status == "payment-pending" ? "Waiting on the investor’s payment." : sub.Status)</strong>
                    The link was sent by SMS to <strong>@sub.LinkSentTo</strong>@if (sub.LinkEmailedTo.Length > 0) {<text> and by e-mail to <strong>@sub.LinkEmailedTo</strong></text>}, and expires <strong>@Money.Day(sub.LinkValidUntil)</strong>. Submitted is not booked &mdash; the deposit and its rate are held only until then.</span>
            </div>

            <h3 class="cii-section">What Happens Next</h3>
            <ol class="sub-steps">
                @for (var i = 0; i < nextSteps.Length; i++)
                {
                    <li class="sub-step @(i == 0 ? "sub-step--current" : "")">
                        <span class="sub-step__num">@(i + 1)</span>
                        <span class="sub-step__text"><strong>@nextSteps[i].Lead</strong>@nextSteps[i].Detail</span>
                    </li>
                }
            </ol>

            <form method="post" asp-action="Resend" class="sub-resend">
                <button type="submit" class="csi-check" disabled="@(sub.ResendsLeft == 0)" data-loader="Sending the link again&hellip;">@(sub.ResendsLeft == 0 ? "Payment link resent" : "Resend payment link")</button>
                <span class="csi-hint">@(sub.ResendsLeft == 0 ? $"No resends left. The link still expires {Money.Day(sub.LinkValidUntil)}." : $"{sub.ResendsLeft} resend{(sub.ResendsLeft == 1 ? " is" : "s are")} available.")</span>
            </form>
        </section>

        @* ── The deposit it carries ─────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="submitted-deposit">
            <div class="cii-head"><h2 class="cii-title">Deposit Summary</h2></div>
            <div class="cii-record">
                <div class="inv-panel inv-panel--stack">
                    @if (d is not null)
                    {
                        <div class="inv-kv-grid">
                            @{
                                await Kv("Invested amount", Money.Rupees(d.Amount));
                                await Kv("Rate of interest", q is null ? "—" : $"{q.Rate:0.00}% p.a.");
                                await Kv("Tenure", $"{d.TenureMonths} months");
                                await Kv("Scheme", $"{(payout?.PerYear == 0 ? "Cumulative" : "Non-cumulative")} · {Model.Docs.CategoryName(Model.Docs.State.Category)}");
                                await Kv("Interest payout", payout?.Name ?? d.Payout);
                                await Kv("Maturity value", q is null ? "—" : Money.Rupees(q.MaturityAmount));
                                await Kv("Auto renewal", d.AutoRenewal ? $"On · {Model.Option(Model.Ref.RenewInstructions, d.RenewInstruction)}" : "Off");
                                await Kv("TDS", d.NoTds ? "Not deducted" : "Deducted");
                                await Kv("Delivery", Model.Option(Model.Ref.DeliveryTypes, d.DeliveryType));
                            }
                        </div>
                    }
                    <div class="inv-kv-grid @(d is not null ? "inv-kv-grid--divided" : null)">
                        <div class="inv-kv inv-kv--wide">
                            <div class="inv-kv__k">Holders</div>
                            <div class="inv-kv__v">@string.Join(" · ", Model.Holders.Select(h => h.Holder.Joint ? h.Holder.Who.Name : $"{h.Holder.Who.Name} (primary)"))</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="Dashboard" asp-action="Index">Home</a>
        <p class="csi-bar__hint"><a class="csi-link" asp-controller="ViewApplication" asp-action="Index">Track this application</a> among the partner&rsquo;s applications</p>
        <div class="csi-bar__right">
            <a class="csi-btn csi-btn--primary" asp-controller="InvestorIdentification" asp-action="Index">New Application</a>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/classic-pin.js" asp-append-version="true"></script>
}

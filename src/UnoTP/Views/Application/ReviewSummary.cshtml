    <div class="rv-split laptop-only">
        @* ── Consent ────────────────────────────────────────────────────────── *@
        <section class="rv-section">
            <div class="rv-head">
                <div class="rv-head__text">
                    <div class="rv-head__title">Consent &middot; DPDP</div>
                    <div class="rv-head__desc">Every holder consents before their data is processed</div>

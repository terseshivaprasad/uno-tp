            <div class="rv-phone__title rv-phone__head">Other details</div>
            <div class="rv-phone__text">Sub broker SB-100002225-14 &middot; purchase &middot; physical application no not entered</div>
            <div class="rv-phone__ok">Nominee captured &mdash; A&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull; &middot; daughter &middot; minor, guardian on file</div>
        </section>
    </div>

    @* ── Declarations ─────────────────────────────────────────────────────────── *@
    <form class="rv-declarations" id="reviewForm" novalidate>
        <div class="rv-head__title">Declarations</div>
        @for (var i = 0; i < declarations.Length; i++)
        {
            <label class="rv-declaration">
                <input type="checkbox" name="Declarations" value="@i" class="rv-declaration__box" checked="@declarations[i].Signed" />
                <span class="rv-declaration__text">@declarations[i].Text <span class="rv-required">Required</span></span>
            </label>
        }
    </form>
</div>

@section Footer {
    @* The classic wizard's bar, as Upload Documents has it. *@
    <footer class="csi-bar">
        <div class="csi-bar__inner">
            <a class="csi-btn csi-btn--back" asp-controller="Application" asp-action="FdConfiguration" data-loader="Going back to FD Configuration">Back</a>
            <p class="csi-bar__hint" id="rv-footer-hint">Every control point passed &middot; 26 of 26 fields, nominee captured, all proofs verified against source &mdash; <strong>sign the last declaration to submit</strong></p>
            <div class="csi-bar__right">
                <button type="button" class="csi-link btn-reset">Download summary</button>
                <button type="reset" form="reviewForm" class="csi-link btn-reset">Clear All</button>
                <button type="button" class="csi-btn csi-btn--primary" id="openPaymentLinkModal" disabled>Submit application</button>
            </div>
        </div>
    </footer>
}

@* 11A: Submit / payment link dialog. Overlay on top of Review Summary (11), per the mockup
   ("11A — Submit · payment link dialog") — not a separate routed page. *@
<div class="modal-overlay pl-overlay" id="paymentLinkModal" hidden>
    <div class="modal-dialog pl-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentLinkTitle" aria-describedby="paymentLinkIntro">
        <div class="pl-head">
            <svg class="pl-head__icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
            <h2 class="pl-head__title" id="paymentLinkTitle">Send the payment link</h2>
        </div>
        <div class="pl-body">
            <p class="pl-intro pl-intro--short">Already clear of blockers and funded online. <strong>The deposit is not booked until the investor pays.</strong></p>
            <p class="pl-intro pl-intro--long" id="paymentLinkIntro">Everything on this review summary is already clear, which is why Submit is open at all. The investor pays from their own device, so on Proceed the application is submitted and a payment link is sent: <strong>the deposit is not booked until the investor pays it</strong>.</p>

            <dl class="pl-terms">
                <div><dt>Sent to</dt><dd>8779712676</dd><dd class="pl-terms__note">primary holder&rsquo;s mobile, captured at search</dd></div>
                <div><dt>Amount</dt><dd>&#8377; 5,00,000<span class="pl-short"> &middot; fixed</span></dd><dd class="pl-terms__note">fixed &mdash; the investor cannot change it</dd></div>
                <div><dt>Valid for</dt><dd>48 hours<span class="pl-short"> &middot; to 16 Sep, 5:04 PM</span></dd><dd class="pl-terms__note">expires 16 Sep 2026, 5:04 PM</dd></div>
                <div><dt>Paid from</dt><dd>Any account in a holder&rsquo;s name</dd><dd class="pl-terms__note">the payer&rsquo;s name is matched on receipt &middot; a third-party payment is refunded, not booked</dd></div>
            </dl>

            <div class="pl-lapse pl-lapse--short"><strong>Unpaid after 48 hours the application lapses</strong> and the rate re-prices on the day payment lands. One resend from the dashboard.</div>
            <div class="pl-lapse pl-lapse--long"><strong>If the link is not paid in 48 hours the application lapses to Payment pending</strong> and the rate is no longer held &mdash; it re-prices at the card rate on the day payment is received. You can resend the link from the dashboard once, after which the application must be re-submitted.</div>

            <div class="pl-source"><strong>Where the repayment account came from.</strong> It was typed on <a asp-controller="Application" asp-action="BankDetails">09</a> &mdash; IFSC search resolving bank, branch and MICR, account number confirmed by re-entry &mdash; and matched against the payment cheque, holder name included. Interest and maturity are paid only to an account in the primary holder&rsquo;s name.</div>

            <p class="pl-foot">Try later keeps everything on this page saved and leaves the application unsubmitted &mdash; nothing is sent to the investor.</p>
        </div>
        <form method="post" asp-action="Send" class="pl-actions">
            <button type="button" class="pl-actions__later" id="closePaymentLinkModal">Try later</button>
            <button type="submit" class="btn btn-primary pl-actions__send">Submit &amp; send link</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('reviewForm');
            var boxes = form.querySelectorAll('.rv-declaration__box');
            var hint = document.getElementById('rv-footer-hint');
            var modal = document.getElementById('paymentLinkModal');
            var submit = document.getElementById('openPaymentLinkModal');
            var closeBtn = document.getElementById('closePaymentLinkModal');
            var WORDS = ['', 'the last declaration', 'two declarations', 'all three declarations'];

            // Submit holds until every declaration is signed; unsigned ones carry "Required".
            function sync() {
                var unsigned = 0;
                boxes.forEach(function (box) {
                    box.closest('.rv-declaration').classList.toggle('rv-declaration--unsigned', !box.checked);
                    if (!box.checked) unsigned++;
                });
                hint.innerHTML = 'Every control point passed &middot; 26 of 26 fields, nominee captured, all proofs verified against source &mdash; '
                    + (unsigned ? '<strong>sign ' + WORDS[unsigned] + ' to submit</strong>' : '<strong>declarations signed &middot; ready to submit</strong>');
                submit.disabled = unsigned > 0;
            }

            form.addEventListener('change', sync);
            form.addEventListener('reset', function () {
                // The reset event fires before the values are restored.
                setTimeout(sync);
            });
            function openDialog() {
                modal.hidden = false;
                document.body.style.overflow = 'hidden';
                closeBtn.focus();
            }
            // Try later, Escape and a click on the backdrop all leave the application unsubmitted.
            function closeDialog() {
                modal.hidden = true;
                document.body.style.overflow = '';
                submit.focus();
            }
            submit.addEventListener('click', function () { if (!submit.disabled) openDialog(); });
            closeBtn.addEventListener('click', closeDialog);
            modal.addEventListener('click', function (e) { if (e.target === modal) closeDialog(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeDialog(); });
            sync();
        })();
    </script>
}

@model ReviewViewModel
@{
    ViewData["Title"] = "Review Summary";

    // The last classic step, in the frame the steps before it draw: everything the
    // application holds, as the backend has it - what each step saved, the
    // documents filed, and the backend's quote for the deposit - one card a step,
    // read-only as Investor Information shows what was read, each with its Edit.
    var d = Model.Deposit;
    var q = Model.Quote;
    var payment = Model.Payment;
    var docs = Model.Docs;
    var appNo = docs.AppNo;
    var blockers = Model.Blockers;
    var mode = docs.ModeOf(docs.State.Sourcing);
    var sourceName = docs.Resolved(mode, sub: false);
    var byCheque = docs.State.PayMode.Length > 0 && docs.DocumentOf(docs.State.PayMode) is not null;
    string Or(string value, string empty = "Not entered") => value.Length > 0 ? value : empty;
    string Account(BankAccount? a, BankBranch? b) => a is null || a.AccountNumber.Length == 0 ? "Not entered"
        : $"{b?.Bank ?? a.Ifsc} {Money.MaskAccount(a.AccountNumber)}";
}

@functions {
    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    // A read-only value, with what it rests on under it.
    private async Task Kv(string key, string value, string? note = null, bool wide = false, bool unread = false)
    {
        <div class="inv-kv @(wide ? "inv-kv--wide" : null)">
            <div class="inv-kv__k">@key</div>
            <div class="inv-kv__v @(unread ? "inv-kv__v--unread" : null)">@value</div>
            @if (note is { Length: > 0 })
            {
                <div class="inv-kv__note">@note</div>
            }
        </div>
        await Task.CompletedTask;
    }

    // A card's head: its title, the step's Edit, and on the first card the
    // application number the strip keeps in view once it scrolls off.
    private async Task Head(string title, string controller, string action, bool first = false)
    {
        <div class="cii-head" data-pin-head="@(first ? "" : null)">
            <h2 class="cii-title">@title</h2>
            @if (first)
            {
                <span class="cii-app">Application No: <strong>@Model.Docs.AppNo</strong>
                    <button type="button" class="cud-copy" data-copy="@Model.Docs.AppNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
                    </button>
                </span>
            }
            <a class="csi-link rv-edit" href="@Url.Action(action, controller)" aria-label="Edit @title">Edit</a>
        </div>
        await Task.CompletedTask;
    }
}

@* Once the first card's head has scrolled off, this keeps who the application is
   for and which it is in view, as the steps before it do. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@docs.HolderName</span>
        <span class="cud-pin__pan">PAN @docs.HolderPan</span>
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @appNo
            <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="5" />

    <div class="csi-main">
        @if (Model.Refused is { } refused)
        {
            <div class="csi-gap csi-gap--alert" role="alert">
                <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="csi-gap__body"><p>@refused</p></div>
            </div>
        }

        @if (blockers.Count == 0)
        {
            <div class="cud-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
                <span><strong>Nothing is missing.</strong> Every step is complete &mdash; sign the declarations at the foot of the page to submit.</span>
            </div>
        }
        else
        {
            <div class="csi-gap csi-gap--alert" role="alert">
                <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="csi-gap__body">
                    <div class="csi-gap__title">@blockers.Count thing@(blockers.Count == 1 ? " is" : "s are") still missing before this can be submitted</div>
                    <p>@string.Join("; ", blockers.Select(b => $"{b.What} ({b.Step})")).</p>
                </div>
            </div>
        }

        @* ── Fixed deposit ─────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-deposit">
            @{ await Head("Fixed Deposit", "Application", "FdConfiguration", first: true); }
            <p class="cii-note">@(q is null ? "Quoted once the deposit is configured" : $"Card rate as on {Money.Day(q.RateAsOn)} · locked when the application is submitted")</p>
            <div class="cii-record">
                <div class="inv-panel">
                    @if (d is null || d.Amount == 0)
                    {
                        <div class="inv-kv__v inv-kv__v--unread">Not configured yet</div>
                    }
                    else
                    {
                        <div class="inv-kv-grid">
                            @{
                                await Kv("Invested amount", Money.Rupees(d.Amount), Money.InWords(d.Amount).ToLowerInvariant());
                                await Kv("Rate of interest", q is null ? "—" : $"{q.Rate:0.00}% p.a.");
                                await Kv("Tenure", $"{d.TenureMonths} months");
                                await Kv("Interest payout", Model.Payout?.Name ?? d.Payout, q is not null && q.InterestEach > 0 ? $"{Money.Rupees(q.InterestEach)} each {Model.Payout?.Each}" : null);
                                await Kv("Scheme", Model.Payout?.PerYear == 0 ? "Cumulative" : "Non-cumulative");
                                await Kv("Category", docs.State.Category.Length > 0 ? docs.CategoryName(docs.State.Category) : "Not chosen");
                                await Kv("Maturity value", q is null ? "—" : Money.Rupees(q.MaturityAmount));
                                await Kv("Matures on", q is null ? "—" : Money.Day(q.MaturesOn));
                                await Kv("Maturity instruction", "Credit to the repayment account", payment?.Repayment is { AccountNumber.Length: > 0 } r ? Account(r, Model.RepaymentBranch) : null);
                            }
                        </div>
                        <div class="inv-kv-grid inv-kv-grid--divided">
                            @{
                                await Kv("Auto renewal", d.AutoRenewal ? $"On · {Model.Option(Model.Ref.RenewInstructions, d.RenewInstruction)}" : "Off");
                                await Kv("TDS", d.NoTds ? "Not deducted — exemption claimed" : "Deducted at the applicable rate");
                                await Kv("Delivery type", Model.Option(Model.Ref.DeliveryTypes, d.DeliveryType), Or(Model.DetailsOf(docs.Investor).Email, ""));
                            }
                        </div>
                    }
                </div>
            </div>
        </section>

        @* ── Holders ───────────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-holders">
            @{ await Head("Holders", "InvestorInfo", "Index"); }
            <p class="cii-note">@(Model.Holders.Count == 1 ? "One holder" : $"{Model.Holders.Count} holders") &middot; everything captured for each</p>
            <div class="cii-record">
                @foreach (var h in Model.Holders)
                {
                    var who = h.Holder.Who;
                    var det = h.Details;
                    var gender = det.Gender.Length > 0 ? det.Gender : who.Gender;
                    <div class="inv-panel inv-panel--stack">
                        <div class="inv-panel__label">@(h.Holder.Joint ? "Joint holder" : "Primary holder") &middot; @Or(who.Name, "name not verified yet")</div>
                        <div class="inv-kv-grid">
                            @{
                                await Kv("PAN", UploadDocumentsViewModel.Mask(who.Pan));
                                await Kv("DOB", UploadDocumentsViewModel.MaskDate(who.Dob));
                                await Kv("Gender", Or(gender), unread: gender.Length == 0);
                                await Kv(Or(det.NameType, "Father / Mother / Spouse") + " name", Or(det.ParentName), unread: det.ParentName.Length == 0);
                                await Kv("Folio", Or(who.Folio, "Opens with this application"));
                                await Kv("Mobile", Or(det.Mobile), unread: det.Mobile.Length == 0);
                                await Kv("E-mail", Or(det.Email), unread: det.Email.Length == 0);
                                await Kv("Annual income", Or(det.AnnualIncome), unread: det.AnnualIncome.Length == 0);
                                await Kv("Occupation", Or(det.Occupation), Or(det.SubOccupation, ""), unread: det.Occupation.Length == 0);
                                await Kv("Marital status", Or(det.MaritalStatus), unread: det.MaritalStatus.Length == 0);
                                if (!h.Holder.Joint)
                                {
                                    await Kv("FATCA · tax resident elsewhere", det.FatcaTaxResident ? "Yes" : "No");
                                    await Kv("FATCA · foreign resident", det.FatcaPermanentResident ? "Yes" : "No");
                                }
                            }
                        </div>
                        <div class="inv-kv-grid inv-kv-grid--divided">
                            @{
                                await Kv("Permanent address", h.Permanent.Lines, wide: true);
                                await Kv("Verification", h.Permanent.State);
                                await Kv("POA type", Or(h.PoaType, "—"));
                                await Kv("POA reference number", Or(h.Permanent.Number, "—"));
                                await Kv("POA expiry date", Or(h.Permanent.Expiry, "—"));
                                await Kv("Communication address", h.Mailing, h.MailingState, wide: true);
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ── Nominee ───────────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-nominee">
            @{ await Head("Nominee", "InvestorInfo", "Index"); }
            <p class="cii-note">Asked once for the application, not per holder</p>
            <div class="cii-record">
                <div class="inv-panel">
                    @if (Model.Nominee is { } n)
                    {
                        <div class="inv-kv-grid">
                            @{
                                await Kv("Name", Or(n.Name));
                                await Kv("Date of birth", Or(n.Dob));
                                await Kv("Relation with primary holder", Or(n.Relation));
                                await Kv("Guardian", Or(n.GuardianName, "Not needed"));
                            }
                        </div>
                    }
                    else
                    {
                        <div class="inv-kv__v inv-kv__v--unread">No nominee named</div>
                    }
                </div>
            </div>
        </section>

        @* ── Bank & payment ────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-bank">
            @{ await Head("Bank Details & Payment", "Application", "BankDetails"); }
            <p class="cii-note">Paid by @Or(docs.State.PayMode, "a mode not chosen yet")</p>
            <div class="cii-record">
                <div class="inv-panel">
                    <div class="inv-kv-grid">
                        @{
                            // Only a cheque is drawn on an account the deposit is paid from.
                            if (byCheque)
                            {
                                await Kv("Payment account", Account(payment?.Payment, Model.PaymentBranch), Model.PaymentBranch is { } pb ? $"{pb.Branch} · IFSC {pb.Ifsc} · MICR {pb.Micr}" : null);
                            }
                            await Kv("Repayment account", payment is null ? "Not entered" : payment.RepaymentSameAsPayment ? "Same as the payment account" : Account(payment.Repayment, Model.RepaymentBranch), "Interest and maturity paid to the investor");
                            if (payment?.Cheque is { } c)
                            {
                                await Kv("Cheque", $"{Or(c.Number)} · {Or(c.Date)}");
                                await Kv("Axis CMS branch", Or(c.CmsLocation), "Where the cheque is presented");
                            }
                        }
                    </div>
                </div>
            </div>
        </section>

        @* ── Documents ─────────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-documents">
            @{ await Head("Documents", "UploadDocuments", "Index"); }
            <p class="cii-note">Every document the application carries</p>
            <ul class="rv-checks">
                @foreach (var doc in Model.Documents)
                {
                    <li class="rv-check">
                        <span class="rv-check__mark @(doc.Done ? "" : "rv-check__mark--na")" aria-hidden="true">@(doc.Done ? "✓" : "–")</span>
                        <div class="rv-check__body"><div class="rv-check__title">@doc.Title</div><div class="rv-check__detail">@doc.Detail</div></div>
                    </li>
                }
            </ul>
        </section>

        @* ── Other details ─────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-other">
            @{ await Head("Other Details", "UploadDocuments", "Index"); }
            <p class="cii-note">How the application is sourced, from Upload Documents</p>
            <div class="cii-record">
                <div class="inv-panel">
                    <div class="inv-kv-grid">
                        @{
                            await Kv("Sourcing mode", mode?.Name ?? "Not chosen");
                            await Kv(mode?.CodeLabel ?? "Code", Or(docs.State.SourceCode), sourceName?.Text);
                            await Kv("Sub broker code", Or(docs.State.SubBroker));
                            await Kv("Application type", Model.Option(Model.Ref.ApplicationTypes, docs.State.AppType), docs.State.AppType == UploadDocumentsViewModel.Physical ? $"Form no {Or(docs.State.TypedFormNo)}" : null);
                            await Kv("Sourced by", $"{docs.Partner.Name} · {docs.Partner.Code}");
                        }
                    </div>
                </div>
            </div>
        </section>

        @* ── Declarations ──────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="rv-declarations">
            <div class="cii-head"><h2 class="cii-title">Declarations</h2><span class="csi-status">Every one required</span></div>
            <form method="post" asp-action="Send" class="rv-declarations" id="reviewForm" novalidate>
                @for (var i = 0; i < Model.Ref.Declarations.Count; i++)
                {
                    <label class="rv-declaration">
                        <input type="checkbox" name="declarations" value="@i" class="rv-declaration__box" />
                        <span class="rv-declaration__text">@Model.Ref.Declarations[i]</span>
                    </label>
                }
            </form>
        </section>
    </div>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="Application" asp-action="FdConfiguration" data-loader="Going back to FD Configuration">Back</a>
        <p class="csi-bar__hint" id="rv-footer-hint">@(Model.Ready ? "Nothing missing · sign every declaration to submit" : $"{blockers.Count} thing{(blockers.Count == 1 ? "" : "s")} still missing before submitting")</p>
        <div class="csi-bar__right">
            <button type="button" class="csi-btn csi-btn--primary" id="openPaymentLinkModal" disabled>Submit Application</button>
        </div>
    </div>
</footer>

@* The submit dialog: what is sent to the investor once the application is submitted. *@
<div class="modal-overlay pl-overlay" id="paymentLinkModal" hidden>
    <div class="modal-dialog pl-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentLinkTitle" aria-describedby="paymentLinkIntro">
        <div class="pl-head">
            <h2 class="pl-head__title" id="paymentLinkTitle">Send the payment link</h2>
        </div>
        <div class="pl-body">
            <p class="pl-intro pl-intro--long" id="paymentLinkIntro">On Submit the application is submitted and a payment link is sent to the investor: <strong>the deposit is not booked until the investor pays it</strong>.</p>
            <dl class="pl-terms">
                <div><dt>SMS to</dt><dd>@Or(Model.InvestorMobile)</dd><dd class="pl-terms__note">the primary holder&rsquo;s mobile, from Investor Information</dd></div>
                <div><dt>E-mail to</dt><dd class="pl-terms__email">@Or(Model.InvestorEmail.ToLowerInvariant())</dd><dd class="pl-terms__note">the primary holder&rsquo;s e-mail, from Investor Information</dd></div>
                <div><dt>Amount</dt><dd>@(d is null ? "—" : Money.Rupees(d.Amount))</dd><dd class="pl-terms__note">fixed &mdash; the investor cannot change it</dd></div>
                <div><dt>Valid for</dt><dd>@Model.PaymentLinkHours hours</dd><dd class="pl-terms__note">from when it is sent</dd></div>
            </dl>
            <div class="pl-lapse pl-lapse--long"><strong>If the link is not paid in @Model.PaymentLinkHours hours the application lapses</strong> and the rate is no longer held.</div>
            <p class="pl-foot">Try later keeps everything saved and leaves the application unsubmitted &mdash; nothing is sent to the investor.</p>
        </div>
        <div class="pl-actions">
            <button type="button" class="pl-actions__later" id="closePaymentLinkModal">Try later</button>
            <button type="submit" form="reviewForm" class="btn btn-primary pl-actions__send" data-loader="Submitting&hellip;">Submit &amp; send link</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/classic-pin.js" asp-append-version="true"></script>
    <script>
        (function () {
            var form = document.getElementById('reviewForm');
            var boxes = form.querySelectorAll('.rv-declaration__box');
            var modal = document.getElementById('paymentLinkModal');
            var submit = document.getElementById('openPaymentLinkModal');
            var closeBtn = document.getElementById('closePaymentLinkModal');
            var ready = @(Model.Ready ? "true" : "false");

            // Submit holds until nothing is missing and every declaration is signed.
            function sync() {
                var unsigned = 0;
                boxes.forEach(function (box) {
                    box.closest('.rv-declaration').classList.toggle('rv-declaration--unsigned', !box.checked);
                    if (!box.checked) unsigned++;
                });
                submit.disabled = !ready || unsigned > 0;
            }
            function openDialog() { modal.hidden = false; document.body.style.overflow = 'hidden'; closeBtn.focus(); }
            function closeDialog() { modal.hidden = true; document.body.style.overflow = ''; submit.focus(); }
            form.addEventListener('change', sync);
            submit.addEventListener('click', function () { if (!submit.disabled) openDialog(); });
            closeBtn.addEventListener('click', closeDialog);
            modal.addEventListener('click', function (e) { if (e.target === modal) closeDialog(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeDialog(); });
            sync();
        })();
    </script>
}

                                <div class="rv-holder__bar"><div></div></div>
                            </div>
                            <div class="rv-holder__consent">@h.Consent</div>
                        </div>
                    </div>
                    <div class="rv-holder__col">
                        <div class="rv-holder__col-head"><div class="rv-holder__col-label">Contact &middot; from search</div></div>
                        <div class="rv-mini-grid rv-mini-grid--1">
                            <div><div class="rv-mini__k">Mobile</div><div class="rv-mini__v">@h.Mobile</div></div>
                            <div><div class="rv-mini__k">E-mail</div><div class="rv-mini__v">@h.Email</div></div>
                        </div>
                    </div>
                    <div class="rv-holder__col">
                        <div class="rv-holder__col-head"><div class="rv-holder__col-label">More information &middot; broker</div></div>
                        <div class="rv-mini-grid">
                            <div><div class="rv-mini__k">Annual income</div><div class="rv-mini__v">@h.Income</div></div>
                            <div><div class="rv-mini__k">Occupation</div><div class="rv-mini__v">@h.Occupation</div></div>
                            <div><div class="rv-mini__k">Sub occupation</div><div class="rv-mini__v">@h.SubOccupation</div></div>
                            <div><div class="rv-mini__k">Marital status</div><div class="rv-mini__v">@h.Marital</div></div>
                            <div><div class="rv-mini__k">FATCA &middot; tax resident elsewhere</div><div class="rv-mini__v">No</div></div>
                            <div><div class="rv-mini__k">FATCA &middot; foreign resident</div><div class="rv-mini__v">No</div></div>
                        </div>
                    </div>
                    @* A holder whose mailing address carries its own proof is flagged in pink. *@
                    <div class="rv-holder__col rv-holder__col--poa @(h.MailingSame ? "" : "rv-holder__col--flag")">
                        <div class="rv-holder__col-head">
                            <div class="rv-holder__col-label">Address &amp; proof of address &middot; from 07</div>
                            <div class="rv-verified">Verified</div>
                        </div>
                        <div class="rv-mini-grid">
                            <div class="rv-mini--wide"><div class="rv-mini__k">Permanent address</div><div class="rv-mini__v">@h.Permanent</div></div>
                            <div class="rv-mini--wide"><div class="rv-mini__k">Mailing address</div><div class="rv-mini__v @(h.MailingSame ? "rv-mini__v--muted" : "")">@h.Mailing</div></div>
                            <div><div class="rv-mini__k">POA type</div><div class="rv-mini__v">@h.PoaType</div></div>
                            <div><div class="rv-mini__k">POA reference</div><div class="rv-mini__v">@h.PoaRef</div></div>
                            <div><div class="rv-mini__k">POA expiry</div><div class="rv-mini__v">@h.PoaExpiry</div></div>
                        </div>
                        <div class="rv-holder__poa-note">@h.PoaNote</div>
                    </div>
                </div>
            }
        </div>
        <div class="rv-callout">
            <div class="rv-callout__text"><strong>Holder 1&rsquo;s mailing address differs from the permanent address</strong> &mdash; 14 Sai Chambers, Andheri East, Mumbai 400069 &mdash; so a second proof of address was required for it; that proof is uploaded and verified. No holder is tagged as disabled, so no additional certificate is required.</div>

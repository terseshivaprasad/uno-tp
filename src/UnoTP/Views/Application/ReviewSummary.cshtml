@model ReviewViewModel
@{
    ViewData["Title"] = "Review Summary";
    Layout = "_WizardLayout";
    ViewData["WizardStep"] = "review";

    // Everything the application holds, as the backend has it: what each step
    // saved, the documents filed, and the backend's quote for the deposit.
    var d = Model.Deposit;
    var q = Model.Quote;
    var payment = Model.Payment;
    var docs = Model.Docs;
    var blockers = Model.Blockers;
    var mode = docs.ModeOf(docs.State.Sourcing);
    var sourceName = docs.Resolved(mode, sub: false);
    var holdersText = Model.Holders.Count == 1 ? "One holder" : $"{Model.Holders.Count} holders";
    string Or(string value, string empty = "Not entered") => value.Length > 0 ? value : empty;
    string Account(BankAccount? a, BankBranch? b) => a is null || a.AccountNumber.Length == 0 ? "Not entered"
        : $"{b?.Bank ?? a.Ifsc} {Money.MaskAccount(a.AccountNumber)}";
}

@functions {
    private async Task Kv(string key, string value, string? note = null, string? css = null)
    {
        <div><div class="rv-kv__k">@key</div><div class="rv-kv__v @css">@value</div>@if (note is not null) { <div class="rv-kv__note">@note</div> }</div>
        await Task.CompletedTask;
    }
}

<div class="rv-page">
    <div class="inv-page-head">
        <div style="flex:1;min-width:0">
            <div class="inv-title">Review Summary</div>
            <div style="font-size:12px;color:var(--muted);padding-top:4px">Everything captured across the steps &middot; check before submission</div>
        </div>
        <div style="font-size:12.5px;color:var(--muted);flex:none">Application No: <span style="font-weight:600;color:var(--ink)">@docs.AppNo</span></div>
    </div>

    @if (Model.Refused is { } refused)
    {
        <div class="cud-banner" role="alert"><span>@refused</span></div>
    }

    @if (blockers.Count == 0)
    {
        <div class="rv-ready">
            <div class="rv-ready__text"><strong>Nothing is missing.</strong> Every step is complete. <span class="rv-em">The declarations below are the only thing left.</span></div>
            <div class="rv-ready__status">Ready to submit</div>
        </div>
    }
    else
    {
        <div class="rv-callout">
            <div class="rv-callout__text">
                <strong>@blockers.Count thing@(blockers.Count == 1 ? " is" : "s are") still missing before this can be submitted:</strong>
                @string.Join("; ", blockers.Select(b => $"{b.What} ({b.Step})")).
            </div>
        </div>
    }

    @* ── Fixed deposit ────────────────────────────────────────────────────────── *@
    <section class="rv-section">
        <div class="rv-head">
            <div class="rv-head__text">
                <div class="rv-head__title">Fixed deposit</div>
                <div class="rv-head__desc">@(q is null ? "Quoted once the deposit is configured" : $"Card rate as on {Money.Day(q.RateAsOn)} · locked when the application is submitted")</div>
            </div>
            <a class="rv-head__action" asp-controller="Application" asp-action="FdConfiguration">Edit</a>
        </div>
        @if (d is null || d.Amount == 0)
        {
            <p class="rv-kv__v rv-kv__v--empty">Not configured yet.</p>
        }
        else
        {
            <div class="rv-grid-4">
                @{ await Kv("Invested amount", Money.Rupees(d.Amount), Money.InWords(d.Amount).ToLowerInvariant(), "rv-kv__v--lg"); }
                @{ await Kv("Category", docs.State.Category.Length > 0 ? docs.CategoryName(docs.State.Category) : "Not chosen", null, "rv-kv__v--lg"); }
                @{ await Kv("Scheme", Model.Payout?.PerYear == 0 ? "Cumulative" : "Non-cumulative", null, "rv-kv__v--lg"); }
                @{ await Kv("Rate of interest", q is null ? "—" : $"{q.Rate:0.00}% p.a.", null, "rv-kv__v--lg rv-kv__v--green"); }
                @{ await Kv("Tenure", $"{d.TenureMonths} months", null, "rv-kv__v--lg"); }
                @{ await Kv("Interest payout", Model.Payout?.Name ?? d.Payout, q is not null && q.InterestEach > 0 ? $"{Money.Rupees(q.InterestEach)} each {Model.Payout?.Each}" : null, "rv-kv__v--lg"); }
                @{ await Kv("Maturity value", q is null ? "—" : Money.Rupees(q.MaturityAmount), null, "rv-kv__v--lg"); }
                @{ await Kv("Matures on", q is null ? "—" : Money.Day(q.MaturesOn), null, "rv-kv__v--lg"); }
            </div>
            <div class="rv-grid-4 rv-grid-4--divided">
                @{ await Kv("Auto renewal", d.AutoRenewal ? $"On · {Model.Option(Model.Ref.RenewInstructions, d.RenewInstruction)}" : "Off"); }
                @{ await Kv("TDS", d.NoTds ? "Not deducted — exemption claimed" : "Deducted at the applicable rate", null, d.NoTds ? "rv-kv__v--amber" : null); }
                @{ await Kv("Delivery type", Model.Option(Model.Ref.DeliveryTypes, d.DeliveryType), Or(Model.DetailsOf(docs.Investor).Email, "")); }
                @{ await Kv("Maturity instruction", "Credit to the repayment account", payment?.Repayment is { AccountNumber.Length: > 0 } r ? Account(r, Model.RepaymentBranch) : null); }
            </div>
        }
    </section>

    @* ── Holders ──────────────────────────────────────────────────────────────── *@
    <section class="rv-section">
        <div class="rv-head">
            <div class="rv-head__text">
                <div class="rv-head__title">Holders</div>
                <div class="rv-head__desc">@holdersText &middot; one row per holder, carrying everything captured so far</div>
            </div>
            <a class="rv-head__action" asp-controller="InvestorInfo" asp-action="Index">Edit</a>
        </div>
        <div class="rv-holders">
            @foreach (var h in Model.Holders)
            {
                var who = h.Holder.Who;
                var det = h.Details;
                var gender = det.Gender.Length > 0 ? det.Gender : who.Gender;
                <div class="rv-holder">
                    <div class="rv-holder__id">
                        <div class="rv-holder__id-body">
                            <div class="rv-holder__name-row">
                                <div class="rv-holder__name">@Or(who.Name, "Name not verified yet")</div>
                                <div class="rv-role @(h.Holder.Joint ? "" : "rv-role--primary")">@(h.Holder.Joint ? "Joint" : "Primary")</div>
                            </div>
                            <div class="rv-holder__meta">PAN @UploadDocumentsViewModel.Mask(who.Pan)<br />@UploadDocumentsViewModel.MaskDate(who.Dob) &middot; @Or(gender, "gender not entered")</div>
                            <div class="rv-holder__meta">@Or(det.NameType, "Parent") @Or(det.ParentName)</div>
                            <div class="rv-holder__meta">Folio @Or(who.Folio, "opens with this application")</div>
                        </div>
                    </div>
                    <div class="rv-holder__col">
                        <div class="rv-holder__col-head"><div class="rv-holder__col-label">Contact</div></div>
                        <div class="rv-mini-grid rv-mini-grid--1">
                            <div><div class="rv-mini__k">Mobile</div><div class="rv-mini__v">@Or(det.Mobile)</div></div>
                            <div><div class="rv-mini__k">E-mail</div><div class="rv-mini__v">@Or(det.Email)</div></div>
                        </div>
                    </div>
                    <div class="rv-holder__col">
                        <div class="rv-holder__col-head"><div class="rv-holder__col-label">More information</div></div>
                        <div class="rv-mini-grid">
                            <div><div class="rv-mini__k">Annual income</div><div class="rv-mini__v">@Or(det.AnnualIncome)</div></div>
                            <div><div class="rv-mini__k">Occupation</div><div class="rv-mini__v">@Or(det.Occupation)</div></div>
                            <div><div class="rv-mini__k">Sub occupation</div><div class="rv-mini__v">@Or(det.SubOccupation)</div></div>
                            <div><div class="rv-mini__k">Marital status</div><div class="rv-mini__v">@Or(det.MaritalStatus)</div></div>
                            @if (!h.Holder.Joint)
                            {
                                <div><div class="rv-mini__k">FATCA &middot; tax resident elsewhere</div><div class="rv-mini__v">@(det.FatcaTaxResident ? "Yes" : "No")</div></div>
                                <div><div class="rv-mini__k">FATCA &middot; foreign resident</div><div class="rv-mini__v">@(det.FatcaPermanentResident ? "Yes" : "No")</div></div>
                            }
                        </div>
                    </div>
                    <div class="rv-holder__col rv-holder__col--poa @(h.Mailing == "Same as permanent" ? "" : "rv-holder__col--flag")">
                        <div class="rv-holder__col-head">
                            <div class="rv-holder__col-label">Address &amp; proof of address</div>
                            <div class="rv-verified">@h.Permanent.State</div>
                        </div>
                        <div class="rv-mini-grid">
                            <div class="rv-mini--wide"><div class="rv-mini__k">Permanent address</div><div class="rv-mini__v">@h.Permanent.Lines</div></div>
                            <div class="rv-mini--wide"><div class="rv-mini__k">Mailing address</div><div class="rv-mini__v">@h.Mailing @(h.MailingState.Length > 0 ? $"· {h.MailingState}" : "")</div></div>
                            <div><div class="rv-mini__k">POA type</div><div class="rv-mini__v">@Or(h.PoaType, "—")</div></div>
                            <div><div class="rv-mini__k">POA reference</div><div class="rv-mini__v">@Or(h.Permanent.Number, "—")</div></div>
                            <div><div class="rv-mini__k">POA expiry</div><div class="rv-mini__v">@Or(h.Permanent.Expiry, "—")</div></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    @* ── Nominee ──────────────────────────────────────────────────────────────── *@
    <section class="rv-section">
        <div class="rv-head">
            <div class="rv-head__text">
                <div class="rv-head__title">Nominee</div>
                <div class="rv-head__desc">Asked once for the application, not per holder</div>
            </div>
            <a class="rv-head__action" asp-controller="InvestorInfo" asp-action="Index">Edit</a>
        </div>
        @if (Model.Nominee is { } n)
        {
            <div class="rv-grid-4">
                @{ await Kv("Name", Or(n.Name)); }
                @{ await Kv("Date of birth", Or(n.Dob)); }
                @{ await Kv("Relation with primary holder", Or(n.Relation)); }
                @{ await Kv("Guardian", Or(n.GuardianName, "Not needed")); }
            </div>
        }
        else
        {
            <p class="rv-kv__v rv-kv__v--empty">No nominee named.</p>
        }
    </section>

    <div class="rv-split rv-split--wide-left">
        @* ── Bank & payment ─────────────────────────────────────────────────── *@
        <section class="rv-section">
            <div class="rv-head">
                <div class="rv-head__text">
                    <div class="rv-head__title">Bank &amp; payment</div>
                    <div class="rv-head__desc">Paid by @Or(docs.State.PayMode, "a mode not chosen yet")</div>
                </div>
                <a class="rv-head__action" asp-controller="Application" asp-action="BankDetails">Edit</a>
            </div>
            <div class="rv-grid-2">
                @{ await Kv("Payment account", Account(payment?.Payment, Model.PaymentBranch), Model.PaymentBranch is { } pb ? $"{pb.Branch} · IFSC {pb.Ifsc} · MICR {pb.Micr}" : null, "rv-kv__v--lg"); }
                @{ await Kv("Repayment account", payment is null ? "Not entered" : payment.RepaymentSameAsPayment ? "Same account" : Account(payment.Repayment, Model.RepaymentBranch), "interest and maturity paid to the investor", "rv-kv__v--lg"); }
                @if (payment?.Cheque is { } c)
                {
                    await Kv("Cheque", $"{Or(c.Number)} · {Or(c.Date)}");
                    await Kv("Axis CMS location", Or(c.CmsLocation), "where the cheque is presented");
                }
            </div>
        </section>

        @* ── Documents ──────────────────────────────────────────────────────── *@
        <section class="rv-section">
            <div class="rv-head">
                <div class="rv-head__text">
                    <div class="rv-head__title">Documents</div>
                    <div class="rv-head__desc">Every document the application carries</div>
                </div>
                <a class="rv-head__action" asp-controller="UploadDocuments" asp-action="Index">Edit</a>
            </div>
            <ul class="rv-checks">
                @foreach (var doc in Model.Documents)
                {
                    <li class="rv-check">
                        <span class="rv-check__mark @(doc.Done ? "" : "rv-check__mark--na")" aria-hidden="true">@(doc.Done ? "✓" : "–")</span>
                        <div class="rv-check__body"><div class="rv-check__title">@doc.Title</div><div class="rv-check__detail">@doc.Detail</div></div>
                    </li>
                }
            </ul>
        </section>
    </div>

    @* ── Other details ──────────────────────────────────────────────────────── *@
    <section class="rv-section">
        <div class="rv-head">
            <div class="rv-head__text">
                <div class="rv-head__title">Other details</div>
                <div class="rv-head__desc">How the application is sourced, from Upload Documents</div>
            </div>
            <a class="rv-head__action" asp-controller="UploadDocuments" asp-action="Index">Edit</a>
        </div>
        <div class="rv-grid-4">
            @{ await Kv("Sourcing mode", mode?.Name ?? "Not chosen"); }
            @{ await Kv(mode?.CodeLabel ?? "Code", Or(docs.State.SourceCode), sourceName?.Text); }
            @{ await Kv("Sub broker code", Or(docs.State.SubBroker)); }
            @{ await Kv("Application type", Model.Option(Model.Ref.ApplicationTypes, docs.State.AppType), docs.State.AppType == UploadDocumentsViewModel.Physical ? $"form no {Or(docs.State.TypedFormNo)}" : null); }
            @{ await Kv("Sourced by", $"{docs.Partner.Name} · {docs.Partner.Code}"); }
        </div>
    </section>

    @* ── Declarations ─────────────────────────────────────────────────────────── *@
    <form method="post" asp-action="Send" class="rv-declarations" id="reviewForm" novalidate>
        <div class="rv-head__title">Declarations</div>
        @for (var i = 0; i < Model.Ref.Declarations.Count; i++)
        {
            <label class="rv-declaration">
                <input type="checkbox" name="declarations" value="@i" class="rv-declaration__box" />
                <span class="rv-declaration__text">@Model.Ref.Declarations[i] <span class="rv-required">Required</span></span>
            </label>
        }
    </form>
</div>

@section Footer {
    <footer class="csi-bar">
        <div class="csi-bar__inner">
            <a class="csi-btn csi-btn--back" asp-controller="Application" asp-action="FdConfiguration" data-loader="Going back to FD Configuration">Back</a>
            <p class="csi-bar__hint" id="rv-footer-hint">@(Model.Ready ? "Nothing missing · sign every declaration to submit" : $"{blockers.Count} thing{(blockers.Count == 1 ? "" : "s")} still missing before submitting")</p>
            <div class="csi-bar__right">
                <button type="button" class="csi-btn csi-btn--primary" id="openPaymentLinkModal" disabled>Submit application</button>
            </div>
        </div>
    </footer>
}

@* The submit dialog: what is sent to the investor once the application is submitted. *@
<div class="modal-overlay pl-overlay" id="paymentLinkModal" hidden>
    <div class="modal-dialog pl-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentLinkTitle" aria-describedby="paymentLinkIntro">
        <div class="pl-head">
            <h2 class="pl-head__title" id="paymentLinkTitle">Send the payment link</h2>
        </div>
        <div class="pl-body">
            <p class="pl-intro pl-intro--long" id="paymentLinkIntro">On Submit the application is submitted and a payment link is sent to the investor: <strong>the deposit is not booked until the investor pays it</strong>.</p>
            <dl class="pl-terms">
                <div><dt>Sent to</dt><dd>@Or(Model.InvestorMobile)</dd><dd class="pl-terms__note">the primary holder&rsquo;s mobile, from Investor Information</dd></div>
                <div><dt>Amount</dt><dd>@(d is null ? "—" : Money.Rupees(d.Amount))</dd><dd class="pl-terms__note">fixed &mdash; the investor cannot change it</dd></div>
                <div><dt>Valid for</dt><dd>@Model.PaymentLinkHours hours</dd><dd class="pl-terms__note">from when it is sent</dd></div>
            </dl>
            <div class="pl-lapse pl-lapse--long"><strong>If the link is not paid in @Model.PaymentLinkHours hours the application lapses</strong> and the rate is no longer held.</div>
            <p class="pl-foot">Try later keeps everything saved and leaves the application unsubmitted &mdash; nothing is sent to the investor.</p>
        </div>
        <div class="pl-actions">
            <button type="button" class="pl-actions__later" id="closePaymentLinkModal">Try later</button>
            <button type="submit" form="reviewForm" class="btn btn-primary pl-actions__send" data-loader="Submitting&hellip;">Submit &amp; send link</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('reviewForm');
            var boxes = form.querySelectorAll('.rv-declaration__box');
            var modal = document.getElementById('paymentLinkModal');
            var submit = document.getElementById('openPaymentLinkModal');
            var closeBtn = document.getElementById('closePaymentLinkModal');
            var ready = @(Model.Ready ? "true" : "false");

            // Submit holds until nothing is missing and every declaration is signed.
            function sync() {
                var unsigned = 0;
                boxes.forEach(function (box) {
                    box.closest('.rv-declaration').classList.toggle('rv-declaration--unsigned', !box.checked);
                    if (!box.checked) unsigned++;
                });
                submit.disabled = !ready || unsigned > 0;
            }
            function openDialog() { modal.hidden = false; document.body.style.overflow = 'hidden'; closeBtn.focus(); }
            function closeDialog() { modal.hidden = true; document.body.style.overflow = ''; submit.focus(); }
            form.addEventListener('change', sync);
            submit.addEventListener('click', function () { if (!submit.disabled) openDialog(); });
            closeBtn.addEventListener('click', closeDialog);
            modal.addEventListener('click', function (e) { if (e.target === modal) closeDialog(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) closeDialog(); });
            sync();
        })();
    </script>
}

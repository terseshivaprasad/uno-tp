            </div>
            <a class="rv-head__action" asp-controller="InvestorInfo" asp-action="Index">Edit on 08</a>
        </div>
        <div class="rv-holders">
            @foreach (var h in holders)
            {
                <div class="rv-holder">
                    <div class="rv-holder__id">
                        <div class="rv-holder__photo">PHOTO</div>

        <section class="rv-phone__card">
            <div class="rv-phone__head"><div class="rv-phone__title">Holders</div><a asp-controller="InvestorInfo" asp-action="Index">3 &middot; edit on 08</a></div>
            <div class="rv-phone__holder"><div class="rv-phone__holder-name">R&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull; &middot; Primary</div><div class="rv-phone__muted">PAN BISPM4465N &middot; DOB 10-06-1992 &middot; gender and parent name typed and matched &middot; salaried</div><div class="rv-phone__ok">Passport POA verified &middot; mailing POA verified</div></div>
            <div class="rv-phone__holder"><div class="rv-phone__holder-name">S&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull; &middot; Joint</div><div class="rv-phone__muted">PAN AXKPT8891L &middot; DOB 22-01-1990 &middot; DL MH12 2019 0034471 exp 08/2031</div><div class="rv-phone__ok">Verified &middot; all seven fields</div></div>
            <div class="rv-phone__holder"><div class="rv-phone__holder-name">P&bull;&bull;&bull;&bull; N&bull;&bull;&bull; &middot; Joint</div><div class="rv-phone__muted">PAN CDEPN2290F &middot; DOB 03-11-1996 &middot; Aadhaar XXXX XXXX 4417</div><div class="rv-phone__ok">Verified &middot; all seven fields</div></div>

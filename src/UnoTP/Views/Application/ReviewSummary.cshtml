                <div><div class="deposit-card__k">Category</div><div class="deposit-card__v">Public</div></div>
                <div><div class="deposit-card__k">Maturity</div><div class="deposit-card__v">&#8377; 6,29,300</div></div>
                <div><div class="deposit-card__k">Matures on</div><div class="deposit-card__v">14 Sep 29</div></div>
                <div><div class="deposit-card__k">Payout</div><div class="deposit-card__v">On maturity</div></div>

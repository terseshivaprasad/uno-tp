    @* ── Board 11 - Mobile: the same review, condensed to one card per topic ── *@
    <div class="rv-phone phone-only">
        <div class="rv-phone__pass">
            <div class="rv-phone__pass-title">Every control point passed</div>
            <div class="rv-phone__pass-text">26 of 26 fields &middot; nominee captured &middot; all proofs verified against source &middot; face match and consent complete for all three holders.</div>
        </div>

        <div class="deposit-card">
            <div class="deposit-card__top">
                <div><div class="deposit-card__k">Invested amount</div><div class="deposit-card__amount">&#8377; 5,00,000</div></div>
                <div class="deposit-card__rate"><div class="deposit-card__k">Rate</div><div class="deposit-card__rate-v">7.85%</div></div>
            </div>

@{
    ViewData["Title"] = "Fixed Deposit Configuration";
    Layout = "_WizardLayout";
    ViewData["WizardStep"] = "fdconfig";
    ViewData["PhoneTitle"] = "FD Configuration";

    var tenures = new[] { 12, 18, 24, 30, 36, 42, 48, 60 };
    var payouts = new[] { ("maturity", "On maturity"), ("yearly", "Yearly"), ("halfyearly", "Half yearly"), ("quarterly", "Quarterly"), ("monthly", "Monthly") };
}

<div class="inv-page-head">
    <div style="flex:1;min-width:0">
        <div class="inv-title">Fixed Deposit Configuration</div>
        <div style="font-size:12px;color:var(--muted);padding-top:4px">Rate, category and scheme follow from the choices below</div>
    </div>
    <div style="font-size:12.5px;color:var(--muted);flex:none">Application No: <span style="font-weight:600;color:var(--ink)">FBBMFL26F99AAC1</span></div>
</div>

@* Board 10 - Mobile leads with this read-out in place of the "This deposit" panel. *@
<div class="phone-only">
    <div class="deposit-card" aria-live="polite">
        <div class="deposit-card__top">
            <div><div class="deposit-card__k">Amount</div><div class="deposit-card__amount" id="m-amount">&#8377; 5,00,000</div></div>
            <div class="deposit-card__rate"><div class="deposit-card__k">Rate</div><div class="deposit-card__rate-v" id="m-rate">7.85%</div></div>
        </div>
        <div class="deposit-card__grid">
            <div><div class="deposit-card__k">Tenure</div><div class="deposit-card__v" id="m-tenure">36 mo</div></div>
            <div><div class="deposit-card__k">Payout</div><div class="deposit-card__v" id="m-payout">On maturity</div></div>
            <div><div class="deposit-card__k">Maturity</div><div class="deposit-card__v" id="m-maturity">&#8377; 6,29,927</div></div>
        </div>
    </div>
</div>

<form method="post" id="fdConfigForm" class="fd-layout" novalidate>
    <div class="fd-main">

        @* ── Amount ───────────────────────────────────────────────────────────── *@
        <div class="fd-group">
            <div class="inv-section-head">
                <label class="fd-label" for="fd-amount">Amount <span class="required">*</span></label>
                <div class="fd-aside">&#8377; 5,000 minimum &middot; &#8377; 2,00,00,000 maximum</div>
            </div>
            <div class="fd-amount" id="fd-amount-box">
                <span class="fd-amount__currency">&#8377;</span>
                <input id="fd-amount" name="Amount" class="fd-amount__input" value="5,00,000" inputmode="numeric" autocomplete="off" />
                <button type="button" class="fd-amount__clear" id="fd-amount-clear" aria-label="Clear the amount">&#10005;</button>
            </div>
            <div class="fd-hint" id="fd-amount-hint">Five lakh rupees &middot; in multiples of &#8377; 1,000</div>
        </div>

        @* ── Tenure ───────────────────────────────────────────────────────────── *@
        <div class="fd-group" role="radiogroup" aria-labelledby="fd-tenure-label">
            <div class="inv-section-head">
                <div class="fd-label" id="fd-tenure-label">Tenure &middot; months <span class="required">*</span></div>
                <div class="fd-aside">longer tenures carry a higher rate</div>
            </div>
            <div class="fd-options fd-options--tenure">
                @foreach (var t in tenures)
                {
                    <label class="fd-option">
                        <input type="radio" name="TenureMonths" value="@t" checked="@(t == 36)" />
                        <span class="fd-option__face">@t</span>
                    </label>
                }
            </div>
        </div>

        @* ── Interest payout ──────────────────────────────────────────────────── *@
        <div class="fd-group" role="radiogroup" aria-labelledby="fd-payout-label">
            <div class="inv-section-head">
                <div class="fd-label" id="fd-payout-label">Interest payout <span class="required">*</span></div>
                <div class="fd-aside">&ldquo;On maturity&rdquo; makes the deposit cumulative</div>
            </div>
            <div class="fd-options fd-options--payout">
                @foreach (var (value, label) in payouts)
                {
                    <label class="fd-option">
                        <input type="radio" name="InterestPayout" value="@value" checked="@(value == "maturity")" />
                        <span class="fd-option__face">@label</span>
                    </label>
                }
            </div>
        </div>

        @* ── Auto renewal ─────────────────────────────────────────────────────── *@
        <section class="fd-section">
            <label class="fd-toggle" for="fd-renew-on">
                <span class="fd-toggle__text">
                    <span class="fd-toggle__title">Auto renewal</span>
                    <span class="fd-toggle__desc">Renews automatically on maturity unless the investor instructs otherwise</span>
                </span>
                <input type="checkbox" id="fd-renew-on" name="AutoRenewal" value="true" class="inv-switch" checked />
            </label>
            <div class="fd-grid-2" id="fd-renew-fields">
                <div class="inv-field">
                    <label for="fd-renew">Renew <span class="required">*</span></label>
                    <select id="fd-renew" name="RenewInstruction" class="inv-control">
                        <option value="" selected>Select</option>
                        <option value="principal">Principal only</option>
                        <option value="principal-interest">Principal and interest</option>
                    </select>
                    <div class="inv-field__hint" id="fd-renew-hint">Required &mdash; principal only, or principal and interest</div>
                </div>
                <div class="inv-field laptop-only">
                    <label for="fd-renew-for">Renew for</label>
                    <input id="fd-renew-for" class="inv-control" value="Same tenure &mdash; 36 months" readonly tabindex="-1" />
                    <div class="inv-field__hint">at the card rate on the renewal date, not today&rsquo;s</div>
                </div>
            </div>
        </section>

        @* ── TDS exemption ────────────────────────────────────────────────────── *@
        <section class="fd-section fd-section--tight">
            <label class="fd-toggle" for="fd-no-tds">
                <span class="fd-toggle__text">
                    <span class="fd-toggle__title">Do not deduct tax at source</span>
                    <span class="fd-toggle__desc">Only where the investor is eligible &mdash; Form 15G under 60, Form 15H at 60 and above</span>
                </span>
                <input type="checkbox" id="fd-no-tds" name="NoTds" value="true" class="inv-switch" checked />
            </label>
            <div class="fd-note" id="fd-tds-note">
                <div class="fd-note__text"><strong>Form 15G is now a mandatory document for the primary holder.</strong> It is uploaded with everything else on <a asp-controller="UploadDocuments" asp-action="Index">07</a>, not here, so one screen holds every document. Turning this off removes the requirement; TDS is then deducted at the applicable rate.</div>
                <a class="fd-note__action" asp-controller="UploadDocuments" asp-action="Index">Go to documents</a>
            </div>
        </section>

        @* ── Delivery ─────────────────────────────────────────────────────────── *@
        <section class="fd-section fd-grid-2">
            <div class="inv-field">
                <label for="fd-delivery">Delivery type <span class="required">*</span></label>
                <select id="fd-delivery" name="DeliveryType" class="inv-control">
                    <option value="ereceipt" selected>E-receipt</option>
                    <option value="physical">Physical</option>
                </select>
                <div class="inv-field__hint" id="fd-delivery-hint">emailed to TERSESHIVAPRASAD@ICLOUD.COM &middot; a physical receipt posts to the mailing address</div>
            </div>
        </section>
    </div>

    @* ── This deposit ─────────────────────────────────────────────────────────── *@
    <aside class="fd-summary laptop-only" aria-live="polite">
        <div class="fd-summary__label">This deposit</div>
        <div>
            <div class="fd-kv__k">Amount</div>
            <div class="fd-summary__amount" id="sum-amount">&#8377; 5,00,000</div>
        </div>
        <div class="fd-summary__grid">
            <div><div class="fd-kv__k">Interest rate</div><div class="fd-kv__v fd-kv__v--rate" id="sum-rate">7.85%</div></div>
            <div><div class="fd-kv__k">Tenure</div><div class="fd-kv__v" id="sum-tenure">36 months</div></div>
            <div><div class="fd-kv__k">Payout</div><div class="fd-kv__v" id="sum-payout">On maturity</div></div>
            <div><div class="fd-kv__k">Category</div><div class="fd-kv__v">Public</div></div>
        </div>
        <div class="fd-summary__block">
            <div><div class="fd-kv__k">Scheme</div><div class="fd-kv__v" id="sum-scheme">Cumulative</div></div>
            <div id="sum-interest-row" hidden><div class="fd-kv__k" id="sum-interest-label">Interest each month</div><div class="fd-kv__v" id="sum-interest"></div></div>
            <div><div class="fd-kv__k">Maturity value</div><div class="fd-kv__v" id="sum-maturity">&#8377; 6,29,927</div></div>
            <div><div class="fd-kv__k">Matures on</div><div class="fd-kv__v" id="sum-date">14 Sep 2029</div></div>
        </div>
        <div class="fd-summary__note" id="sum-note">Rate is the card rate for a 36-month public deposit as on 14 Sep 2026 and is locked when the application is submitted. Maturity value assumes no TDS, on the exemption claimed above.</div>
    </aside>
</form>

@section Footer {
    @* The classic wizard's bar, as Upload Documents has it. *@
    <footer class="csi-bar">
        <div class="csi-bar__inner">
            <a class="csi-btn csi-btn--back" asp-controller="Application" asp-action="BankDetails" data-loader="Going back to Bank Details &amp; Payment">Back</a>
            <p class="csi-bar__hint" id="fd-footer-hint">Two items outstanding &mdash; <strong>choose what auto renewal renews, and upload Form 15G on 07</strong></p>
            <div class="csi-bar__right">
                <button type="reset" form="fdConfigForm" class="csi-link btn-reset">Clear All</button>
                <button type="submit" form="fdConfigForm" class="csi-btn csi-btn--primary" id="fd-proceed" disabled>Proceed</button>
            </div>
        </div>
    </footer>
}

@section Scripts {
    <script>
        (function () {
            var MIN = 5000, MAX = 20000000, STEP = 1000;
            // Card rates for a public deposit, by tenure in months, as on the start date below.
            var RATES = { 12: 7.25, 18: 7.40, 24: 7.60, 30: 7.70, 36: 7.85, 42: 7.90, 48: 8.00, 60: 8.10 };
            var START = new Date(Date.UTC(2026, 8, 14));
            var PAYOUTS = {
                maturity:   { label: 'On maturity', perYear: 0 },
                yearly:     { label: 'Yearly',      perYear: 1,  each: 'year' },
                halfyearly: { label: 'Half yearly', perYear: 2,  each: 'half year' },
                quarterly:  { label: 'Quarterly',   perYear: 4,  each: 'quarter' },
                monthly:    { label: 'Monthly',     perYear: 12, each: 'month' }
            };
            var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

            var form = document.getElementById('fdConfigForm');
            var amount = document.getElementById('fd-amount');
            var amountBox = document.getElementById('fd-amount-box');
            var amountHint = document.getElementById('fd-amount-hint');
            var renewOn = document.getElementById('fd-renew-on');
            var renewFields = document.getElementById('fd-renew-fields');
            var renew = document.getElementById('fd-renew');
            var renewHint = document.getElementById('fd-renew-hint');
            var renewFor = document.getElementById('fd-renew-for');
            var noTds = document.getElementById('fd-no-tds');
            var tdsNote = document.getElementById('fd-tds-note');
            var delivery = document.getElementById('fd-delivery');
            var deliveryHint = document.getElementById('fd-delivery-hint');
            var footerHint = document.getElementById('fd-footer-hint');
            var proceed = document.getElementById('fd-proceed');
            var $ = function (id) { return document.getElementById(id); };

            function rupees(n) { return '₹ ' + Math.round(n).toLocaleString('en-IN'); }

            var ONES = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve',
                'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
            var TENS = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
            function below100(n) { return n < 20 ? ONES[n] : TENS[Math.floor(n / 10)] + (n % 10 ? '-' + ONES[n % 10] : ''); }
            // Indian grouping: crore, lakh, thousand, hundred.
            function inWords(n) {
                var parts = [];
                [[10000000, 'crore'], [100000, 'lakh'], [1000, 'thousand'], [100, 'hundred']].forEach(function (unit) {
                    var q = Math.floor(n / unit[0]);
                    if (q) { parts.push(below100(q) + ' ' + unit[1]); n %= unit[0]; }
                });
                if (n) parts.push(below100(n));
                var s = parts.join(' ');
                return s.charAt(0).toUpperCase() + s.slice(1) + ' rupees';
            }

            function selected(name) { return form.querySelector('input[name="' + name + '"]:checked').value; }

            function readAmount() { return parseInt(amount.value.replace(/[^\d]/g, ''), 10) || 0; }

            // Returns what is wrong with the amount, or '' when it is valid.
            function amountProblem(n) {
                if (!n) return 'Required — enter the deposit amount';
                if (n < MIN) return 'Below the ₹ 5,000 minimum';
                if (n > MAX) return 'Above the ₹ 2,00,00,000 maximum';
                if (n % STEP) return 'Not a multiple of ₹ 1,000 — ' + inWords(n).toLowerCase();
                return '';
            }

            function maturesOn(months) {
                var d = new Date(START.getTime());
                d.setUTCMonth(d.getUTCMonth() + months);
                return d.getUTCDate() + ' ' + MONTHS[d.getUTCMonth()] + ' ' + d.getUTCFullYear();
            }

            function sync() {
                var n = readAmount();
                var problem = amountProblem(n);
                var tenure = parseInt(selected('TenureMonths'), 10);
                var payout = PAYOUTS[selected('InterestPayout')];
                var rate = RATES[tenure];
                var cumulative = payout.perYear === 0;

                amountBox.classList.toggle('fd-amount--error', !!problem);
                amountHint.classList.toggle('fd-hint--error', !!problem);
                amountHint.textContent = problem || inWords(n) + ' · in multiples of ₹ 1,000';

                renewFields.hidden = !renewOn.checked;
                var renewMissing = renewOn.checked && !renew.value;
                renew.classList.toggle('inv-control--error', renewMissing);
                renewHint.classList.toggle('inv-field__hint--error', renewMissing);
                renewHint.textContent = renewMissing ? 'Required — principal only, or principal and interest'
                    : renew.value === 'principal' ? 'interest is paid out; the principal is redeposited'
                    : 'principal and interest are redeposited together';
                renewFor.value = 'Same tenure — ' + tenure + ' months';

                tdsNote.hidden = !noTds.checked;
                deliveryHint.textContent = delivery.value === 'physical'
                    ? 'posted to the mailing address · a copy is emailed to TERSESHIVAPRASAD@ICLOUD.COM'
                    : 'emailed to TERSESHIVAPRASAD@ICLOUD.COM · a physical receipt posts to the mailing address';

                // Cumulative deposits compound half-yearly; the others pay simple interest each period.
                $('sum-amount').textContent = problem ? '—' : rupees(n);
                $('sum-rate').textContent = rate.toFixed(2) + '%';
                $('sum-tenure').textContent = tenure + ' months';
                $('sum-payout').textContent = payout.label;
                $('sum-scheme').textContent = cumulative ? 'Cumulative' : 'Non-cumulative';
                $('sum-interest-row').hidden = cumulative;
                if (!cumulative) {
                    $('sum-interest-label').textContent = 'Interest each ' + payout.each;
                    $('sum-interest').textContent = problem ? '—' : rupees(n * rate / 100 / payout.perYear);
                }
                $('sum-maturity').textContent = problem ? '—'
                    : rupees(cumulative ? n * Math.pow(1 + rate / 200, tenure / 6) : n);
                $('sum-date').textContent = maturesOn(tenure);
                $('m-amount').textContent = $('sum-amount').textContent;
                $('m-rate').textContent = $('sum-rate').textContent;
                $('m-tenure').textContent = tenure + ' mo';
                $('m-payout').textContent = payout.label;
                $('m-maturity').textContent = $('sum-maturity').textContent;
                $('sum-note').textContent = 'Rate is the card rate for a ' + tenure + '-month public deposit as on '
                    + maturesOn(0) + ' and is locked when the application is submitted. '
                    + (noTds.checked
                        ? (cumulative ? 'Maturity value assumes' : 'Interest assumes') + ' no TDS, on the exemption claimed above.'
                        : (cumulative ? 'Maturity value is' : 'Interest is') + ' shown before TDS at the applicable rate.');

                var outstanding = [];
                if (problem) outstanding.push('enter a valid amount');
                if (renewMissing) outstanding.push('choose what auto renewal renews');
                if (noTds.checked) outstanding.push('upload Form 15G on 07');
                var count = ['', 'One item', 'Two items', 'Three items'][outstanding.length];
                var list = outstanding.length > 1
                    ? outstanding.slice(0, -1).join(', ') + ', and ' + outstanding[outstanding.length - 1]
                    : outstanding[0];
                footerHint.innerHTML = outstanding.length
                    ? count + ' outstanding &mdash; <strong>' + list + '</strong>'
                    : 'Deposit configured &middot; <strong>nothing outstanding on this step</strong>';
                proceed.disabled = outstanding.length > 0;
            }

            // The amount is regrouped Indian-style as it is typed.
            amount.addEventListener('input', function () {
                var n = readAmount();
                amount.value = n ? n.toLocaleString('en-IN') : '';
                sync();
            });
            document.getElementById('fd-amount-clear').addEventListener('click', function () {
                amount.value = '';
                amount.focus();
                sync();
            });
            form.addEventListener('change', sync);
            form.addEventListener('reset', function () {
                // The reset event fires before the values are restored.
                setTimeout(sync);
            });
            sync();
        })();
    </script>
}

@model FdConfigViewModel
@{
    ViewData["Title"] = "FD Configuration";

    // The fifth classic step, in the frame the steps before it draw. The deposit
    // as the backend holds it, and what the backend quotes for it: every change
    // posts, is saved, and the page comes back with the new quote above the choices.
    var f = Model.Form;
    var q = Model.Quote;
    var payout = Model.Payout;
    var appNo = Model.Docs.AppNo;
    var banner = Model.Problem("banner");

    // What Proceed found, in page order; the first takes the caret.
    var ids = new Dictionary<string, string>
    {
        ["Amount"] = "fd-amount",
        ["TenureMonths"] = "fd-tenure-" + (Model.Ref.Tenures.FirstOrDefault()),
        ["InterestPayout"] = "fd-payout-" + (Model.Ref.Payouts.FirstOrDefault()?.Code ?? ""),
        ["RenewInstruction"] = "fd-renew",
        ["DeliveryType"] = "fd-delivery",
    };
    var focus = ids.FirstOrDefault(i => Model.Problem(i.Key) is not null).Value;
    var problems = Model.Problems.Count(p => p.Key != "banner");
}

@functions {
    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    private string? Invalid(string key) => Model.Problem(key) is null ? null : "is-invalid";
    private string? InvalidAria(string key) => Model.Problem(key) is null ? null : "true";

    // What Proceed said about a field, under it.
    private async Task FieldError(string key, string id)
    {
        if (Model.Problem(key) is { } message)
        {
            <p class="csi-error" id="@(id)Error" role="alert">@message</p>
        }
        await Task.CompletedTask;
    }

    private async Task Kv(string key, string value, bool unread = false)
    {
        <div class="inv-kv"><div class="inv-kv__k">@key</div><div class="inv-kv__v @(unread ? "inv-kv__v--unread" : null)">@value</div></div>
        await Task.CompletedTask;
    }
}

@* Once the card's head has scrolled off, this keeps who the step is for and
   which application it is in view, as the steps before it do. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@Model.Docs.HolderName</span>
        <span class="cud-pin__pan">PAN @Model.Docs.HolderPan</span>
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @appNo
            <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="4" />

    <form class="csi-main" id="fdConfigForm" method="post" data-partial novalidate data-partial-focus="@focus">
        @* Pressed for the partner whenever a choice changes: the deposit is saved and redrawn. *@
        <button type="submit" class="visually-hidden" id="fdRefresh" name="refresh" value="" formnovalidate tabindex="-1">Update</button>

        @if (banner is not null)
        {
            <div class="cud-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <span>@banner</span>
            </div>
        }

        <section class="csi-card cii-card" id="deposit">
            <div class="cii-head" data-pin-head>
                <h2 class="cii-title">Fixed Deposit Configuration</h2>
                <span class="cii-app">Application No: <strong>@appNo</strong>
                    <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
                    </button>
                </span>
            </div>

            @* ── What the backend quotes for the choices below ─────────────────── *@
            <div class="cii-record">
                <div class="inv-panel" aria-live="polite">
                    <div class="inv-panel__label" style="padding-bottom:10px">This deposit &middot; quoted by the backend</div>
                    <div class="inv-kv-grid">
                        @{
                            await Kv("Amount", f.AmountValue > 0 ? Money.Rupees(f.AmountValue) : "Not entered", f.AmountValue == 0);
                            await Kv("Interest rate", q is null ? "Quoted once the amount is valid" : $"{q.Rate:0.00}% p.a.", q is null);
                            await Kv("Tenure", $"{f.TenureMonths} months");
                            await Kv("Interest payout", payout?.Name ?? "—");
                            await Kv("Scheme", Model.Cumulative ? "Cumulative" : "Non-cumulative");
                            await Kv("Category", Model.Category);
                            if (!Model.Cumulative && q is not null && payout is not null) await Kv($"Interest each {payout.Each}", Money.Rupees(q.InterestEach));
                            await Kv("Maturity value", q is null ? "—" : Money.Rupees(q.MaturityAmount), q is null);
                            await Kv("Matures on", q is null ? "—" : Money.Day(q.MaturesOn), q is null);
                        }
                    </div>
                    <p class="cii-note">
                        @if (q is null)
                        {
                            @:The rate and the returns are quoted once a valid amount is entered.
                        }
                        else
                        {
                            @:The card rate for a @f.TenureMonths-month deposit as on @Money.Day(q.RateAsOn), locked when the application is submitted. @(f.NoTds ? "Returns assume no TDS, on the exemption claimed below." : "Returns are shown before TDS at the applicable rate.")
                        }
                    </p>
                </div>
            </div>

            @* ── Amount ───────────────────────────────────────────────────────── *@
            <div class="cud-grid">
                <div class="cud-col">
                    <label class="csi-label" for="fd-amount">Amount (&#8377;)</label>
                    <input class="csi-control @Invalid("Amount")" id="fd-amount" name="Amount" value="@f.Amount" inputmode="numeric" autocomplete="off" data-submit="fdRefresh" aria-invalid="@InvalidAria("Amount")" aria-describedby="@(Model.Problem("Amount") is null ? "fd-amount-hint" : "fd-amountError")">
                    @{ await FieldError("Amount", "fd-amount"); }
                    <p class="csi-hint" id="fd-amount-hint">@(f.AmountValue > 0 && Model.Problem("Amount") is null ? Model.AmountHint : $"{Money.Rupees(Model.Config.MinAmount)} to {Money.Rupees(Model.Config.MaxAmount)}, in multiples of {Money.Rupees(Model.Config.AmountStep)}")</p>
                </div>
                <div class="cud-col">
                    <label class="csi-label" for="fd-delivery">Delivery Type</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("DeliveryType")" id="fd-delivery" name="DeliveryType" data-submit="fdRefresh" aria-invalid="@InvalidAria("DeliveryType")">
                            @foreach (var d in Model.Ref.DeliveryTypes)
                            {
                                <option value="@d.Code" selected="@(d.Code == f.DeliveryType)">@d.Name</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("DeliveryType", "fd-delivery"); }
                    <p class="csi-hint">@(Model.Email.Length > 0 ? $"The receipt is e-mailed to {Model.Email}" : "The receipt is e-mailed to the investor's e-mail on Investor Information")</p>
                </div>
            </div>

            @* ── Tenure ───────────────────────────────────────────────────────── *@
            <h3 class="cii-section" id="fd-tenure-label">Tenure &middot; months</h3>
            <div class="fd-radios" role="radiogroup" aria-labelledby="fd-tenure-label">
                @foreach (var t in Model.Ref.Tenures)
                {
                    <label class="csi-radio"><input type="radio" id="fd-tenure-@t" name="TenureMonths" value="@t" checked="@(t == f.TenureMonths)" data-submit="fdRefresh"> @t</label>
                }
            </div>
            @{ await FieldError("TenureMonths", "fd-tenure"); }

            @* ── Interest payout ──────────────────────────────────────────────── *@
            <h3 class="cii-section" id="fd-payout-label">Interest Payout</h3>
            <div class="fd-radios" role="radiogroup" aria-labelledby="fd-payout-label">
                @foreach (var p in Model.Ref.Payouts)
                {
                    <label class="csi-radio"><input type="radio" id="fd-payout-@p.Code" name="InterestPayout" value="@p.Code" checked="@(p.Code == f.InterestPayout)" data-submit="fdRefresh"> @p.Name</label>
                }
            </div>
            @{ await FieldError("InterestPayout", "fd-payout"); }
            <p class="csi-hint">A payout on maturity makes the deposit cumulative</p>

            @* ── Renewal and tax ──────────────────────────────────────────────── *@
            <h3 class="cii-section">Renewal &amp; Tax</h3>
            <div class="cii-switches">
                <label class="inv-switch-row" for="fd-renew-on">
                    <span>Renew automatically on maturity, unless the investor instructs otherwise</span>
                    <input type="checkbox" id="fd-renew-on" name="AutoRenewal" value="true" class="inv-switch" checked="@f.AutoRenewal" data-submit="fdRefresh">
                    <input type="hidden" name="AutoRenewal" value="false">
                </label>
            </div>
            @if (f.AutoRenewal)
            {
                <div class="cud-grid">
                    <div class="cud-col">
                        <label class="csi-label" for="fd-renew">Renew</label>
                        <div class="cud-select">
                            <select class="csi-control @Invalid("RenewInstruction")" id="fd-renew" name="RenewInstruction" data-submit="fdRefresh" aria-invalid="@InvalidAria("RenewInstruction")">
                                <option value="" selected="@(f.RenewInstruction.Length == 0)">Select</option>
                                @foreach (var r in Model.Ref.RenewInstructions)
                                {
                                    <option value="@r.Code" selected="@(r.Code == f.RenewInstruction)">@r.Name</option>
                                }
                            </select>
                        </div>
                        @{ await FieldError("RenewInstruction", "fd-renew"); }
                    </div>
                    <div class="cud-col">
                        <label class="csi-label" for="fd-renew-for">Renew For</label>
                        <input class="csi-control" id="fd-renew-for" value="Same tenure — @f.TenureMonths months" readonly tabindex="-1">
                        <p class="csi-hint">At the card rate on the renewal date, not today&rsquo;s</p>
                    </div>
                </div>
            }
            <div class="cii-switches">
                <label class="inv-switch-row" for="fd-no-tds">
                    <span>Do not deduct tax at source &mdash; only where the investor is eligible: Form 15G under @Model.Config.SeniorAge, Form 15H at @Model.Config.SeniorAge and above</span>
                    <input type="checkbox" id="fd-no-tds" name="NoTds" value="true" class="inv-switch" checked="@f.NoTds" data-submit="fdRefresh">
                    <input type="hidden" name="NoTds" value="false">
                </label>
            </div>
            @if (f.NoTds)
            {
                <div class="bank-note bank-after">
                    <strong>@Model.TdsForm is needed for the primary holder</strong>, by the investor&rsquo;s date of birth. Turning this off removes the requirement; TDS is then deducted at the applicable rate.
                </div>
            }
        </section>
    </form>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="Application" asp-action="BankDetails" data-loader="Going back to Bank Details &amp; Payment">Back</a>
        <p class="csi-bar__hint">
            @if (problems > 0)
            {
                @($"{problems} thing{(problems == 1 ? "" : "s")} still to fix on this step")
            }
            else
            {
                <text>Saved as you go, then proceed to <strong>Review Summary</strong></text>
            }
        </p>
        <div class="csi-bar__right">
            <button type="submit" form="fdConfigForm" class="csi-btn csi-btn--primary" data-loader="Saving the deposit&hellip;">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/partial-forms.js" asp-append-version="true"></script>
    <script src="~/js/classic-pin.js" asp-append-version="true"></script>
}

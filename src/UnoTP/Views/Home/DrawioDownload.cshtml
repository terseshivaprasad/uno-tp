@{
    Layout = null;
    var fileName = "Unotp Search page.drawio";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Download Drawio File</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            background: #f5f5f5;
        }
        .card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 2rem 2.5rem;
            text-align: center;
        }
        .card h1 {
            font-size: 1.25rem;
            margin-bottom: 1rem;
        }
        .card a.button {
            display: inline-block;
            margin-top: 1rem;
            padding: 0.6rem 1.5rem;
            background: #d0021b;
            color: #fff;
            text-decoration: none;
            border-radius: 4px;
            font-weight: 600;
        }
        .card a.button:hover {
            background: #a80116;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>@fileName</h1>
        <a class="button" href="~/Unotp%20Search%20page.drawio" download>Download</a>
    </div>
</body>
</html>

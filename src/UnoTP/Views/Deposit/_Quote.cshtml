@model DepositViewModel
@* What the backend quotes for the deposit as it stands: drawn with FD Configuration,
   and alone, in answer to Quote, each time a choice changes (deposit-quote.js). It
   carries what the amount field says under it, for the script to put there. *@
@{
    var f = Model.Form;
    var q = Model.Quote;
    var payout = Model.Payout;
    var amountProblem = !Model.AmountFixed && f.Amount.Length > 0 ? f.AmountProblem(Model.Config) : null;
    var amountHint = f.AmountValue > 0 && amountProblem is null ? Model.AmountHint
        : $"in multiples of {Money.Rupees(Model.Config.AmountStep)}";
}

@{
    string Rate() => q is null ? "—" : $"{q.Rate:0.00}%";
    string Maturity() => q is null ? "—" : Money.Rupees(q.MaturityAmount);
}

<div class="deposit-summary__label">This deposit</div>
<div>
    <div class="deposit-key-value__key">Amount</div>
    <div class="deposit-summary__amount">@(f.AmountValue > 0 ? Money.Rupees(f.AmountValue) : "—")</div>
</div>
<div class="deposit-summary__grid">
    <div><div class="deposit-key-value__key">Interest rate</div><div class="deposit-key-value__value deposit-key-value__value--rate">@Rate()</div></div>
    <div><div class="deposit-key-value__key">Tenure</div><div class="deposit-key-value__value">@f.TenureMonths months</div></div>
    <div><div class="deposit-key-value__key">Payout</div><div class="deposit-key-value__value">@(payout?.Name ?? "—")</div></div>
    <div><div class="deposit-key-value__key">Category</div><div class="deposit-key-value__value">@Model.Category</div></div>
</div>
<div class="deposit-summary__block">
    <div><div class="deposit-key-value__key">Scheme</div><div class="deposit-key-value__value">@(Model.Cumulative ? "Cumulative" : "Non-cumulative")</div></div>
    @if (!Model.Cumulative && q is not null && payout is not null)
    {
        <div><div class="deposit-key-value__key">Interest each @payout.Each</div><div class="deposit-key-value__value">@Money.Rupees(q.InterestEach)</div></div>
    }
    <div><div class="deposit-key-value__key">Maturity value</div><div class="deposit-key-value__value">@Maturity()</div></div>
    <div><div class="deposit-key-value__key">Matures on</div><div class="deposit-key-value__value">@(q is null ? "—" : Money.Day(q.MaturesOn))</div></div>
</div>
<div class="deposit-summary__note">
    @if (q is null)
    {
        @:The rate and the returns are quoted once a valid amount is entered.
    }
    else
    {
        @:Rate is the card rate for a @f.TenureMonths-month deposit as on @Money.Day(q.RateAsOn), and is locked when the application is submitted. @(f.NoTds ? "Returns assume no TDS, on the exemption claimed." : "Returns are shown before TDS at the applicable rate.")
    }
</div>
<p hidden data-deposit-amount data-problem="@amountProblem" data-hint="@amountHint"></p>

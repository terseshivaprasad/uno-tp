@model DepositViewModel
@* What the backend quotes for the deposit as it stands. Drawn with FD Configuration, and
   on its own in answer to Quote each time a choice changes (deposit.js). The rate comes
   off the card as soon as the page opens, at the standing amount until one is entered;
   the returns once the amount is valid. The hidden lines at the end carry, for the
   script, what the amount field should say under it and which tenures and payouts the
   card offers at the amount. *@
@{
    var form = Model.Form;
    var quote = Model.Quote;
    var payout = Model.Payout;

    string? amountProblem = null;
    if (!Model.AmountFixed && form.Amount.Length > 0) amountProblem = form.AmountProblem(Model.Config);

    var amountHint = $"in multiples of {Money.Rupees(Model.Config.AmountStep)}";
    if (form.AmountValue > 0 && amountProblem is null) amountHint = Model.AmountHint;

    var amountText = form.AmountValue > 0 ? Money.Rupees(form.AmountValue) : "—";
    var payoutName = payout?.Name ?? "—";
    var schemeText = Model.Scheme;

    var rateText = "—";
    if (Model.Row is not null) rateText = $"{Model.Row.Rate:0.00}%";

    var maturityText = "—";
    var maturesOnText = "—";
    if (quote is not null)
    {
        rateText = $"{quote.Rate:0.00}%";
        maturityText = Money.Rupees(quote.MaturityAmount);
        maturesOnText = Money.Day(quote.MaturesOn);
    }

    var showsInterestEach = !Model.Cumulative && quote is not null && payout is not null;
    var tdsNote = form.NoTds ? "Returns assume no TDS, on the exemption claimed." : "Returns are shown before TDS at the applicable rate.";
}

<div class="deposit-summary__label">This deposit</div>
<div>
    <div class="deposit-key-value__key">Amount</div>
    <div class="deposit-summary__amount">@amountText</div>
    @if (Model.AmountInWords.Length > 0)
    {
        <div class="deposit-summary__words">@Model.AmountInWords</div>
    }
</div>
<div class="deposit-summary__grid">
    <div><div class="deposit-key-value__key">Interest rate</div><div class="deposit-key-value__value deposit-key-value__value--rate">@rateText</div></div>
    <div><div class="deposit-key-value__key">Tenure</div><div class="deposit-key-value__value">@form.TenureMonths months</div></div>
    <div><div class="deposit-key-value__key">Payout</div><div class="deposit-key-value__value">@payoutName</div></div>
    <div><div class="deposit-key-value__key">Category</div><div class="deposit-key-value__value">@Model.Category</div></div>
</div>
<div class="deposit-summary__block">
    <div><div class="deposit-key-value__key">Scheme</div><div class="deposit-key-value__value">@schemeText</div></div>
    @if (showsInterestEach)
    {
        <div><div class="deposit-key-value__key">Interest each @payout!.Each</div><div class="deposit-key-value__value">@Money.Rupees(quote!.InterestEach)</div></div>
    }
    <div><div class="deposit-key-value__key">Maturity value</div><div class="deposit-key-value__value">@maturityText</div></div>
    <div><div class="deposit-key-value__key">Matures on</div><div class="deposit-key-value__value">@maturesOnText</div></div>
</div>
<div class="deposit-summary__note">
    @Model.QuoteNote
    @if (quote is not null)
    {
        @tdsNote
    }
</div>
@if (Model.ExtraRateBanner is not null)
{
    <div class="deposit-summary__banner">@Model.ExtraRateBanner</div>
}
<p hidden data-deposit-amount data-problem="@amountProblem" data-hint="@amountHint"></p>
<span hidden data-source-of-funds data-asked="@(Model.SourceOfFunds.Asked ? "yes" : "no")" data-why="@Model.SourceOfFunds.Why"></span>
@foreach (var tenure in Model.Tenures)
{
    <span hidden data-offer="TenureMonths" data-value="@tenure" data-offered="@(Model.Rates.OffersTenure(tenure) ? "yes" : "no")"></span>
}
@foreach (var option in Model.Payouts)
{
    <span hidden data-offer="InterestPayout" data-value="@option.Code" data-offered="@(Model.Rates.OffersPayout(option.Code) ? "yes" : "no")"></span>
}

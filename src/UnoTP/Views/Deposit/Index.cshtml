@model DepositViewModel
@{
    ViewData["Title"] = "FD Configuration";

    var form = Model.Form;
    var appNo = Model.Docs.AppNo;
    var banner = Model.Problem("banner");
    var amountProblem = Model.Problem("Amount");

    // The fields Proceed can find wanting, in page order; the first with a problem takes the caret.
    (string Key, string Id)[] fieldIds =
    [
        ("Amount", "deposit-amount"),
        ("TenureMonths", "deposit-tenure-" + Model.Tenures.FirstOrDefault()),
        ("InterestPayout", "deposit-payout-" + (Model.Payouts.FirstOrDefault()?.Code ?? "")),
        ("RenewInstruction", "deposit-renew"),
        ("SourceOfFunds", "deposit-source-of-funds"),
        ("SourceOfFundsRemark", "deposit-source-of-funds-remark"),
        ("DeliveryType", "deposit-delivery"),
    ];
    string? focus = null;
    foreach (var field in fieldIds)
    {
        if (Model.Problem(field.Key) is not null)
        {
            focus = field.Id;
            break;
        }
    }
    var problemCount = Model.Problems.Count(p => p.Key != "banner");

    // The amount: what stands beside its label, what its field requires, and the line under it.
    var amountAside = $"{Money.Rupees(Model.Config.MinAmount)} minimum · {Money.Rupees(Model.Config.MaxAmount)} maximum";
    string? amountRequired = "Required — enter the deposit amount";
    string? amountCheck = "amount";
    if (Model.AmountFixed)
    {
        amountAside = $"the maturity amount of deposit {Model.Docs.Renewal!.DepositNumber}";
        amountRequired = null;
        amountCheck = null;
    }
    var amountBoxClass = amountProblem is null ? null : "deposit-amount--error";
    var amountDescribedBy = amountProblem is null ? "deposit-amount-hint" : "deposit-amountError";
    var amountHint = $"in multiples of {Money.Rupees(Model.Config.AmountStep)}";
    if (form.AmountValue > 0 && amountProblem is null) amountHint = Model.AmountHint;

    var receiptHint = "The receipt is e-mailed to the investor's e-mail on Investor Information";
    if (Model.Email.Length > 0) receiptHint = $"The receipt is e-mailed to {Model.Email}";
}
@* FD Configuration: the deposit's choices on the left and, beside them, what the backend
   quotes for them. The quote is redrawn on its own as a choice changes (deposit.js);
   Proceed saves the deposit. *@

@functions {
#pragma warning disable CS1998 // Razor makes these helpers async; there is nothing to await in them.

    private const string CopyIcon = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    // The attributes a field with an error carries.
    private string? Invalid(string key) => Model.Problem(key) is null ? null : "is-invalid";
    private string? AriaInvalid(string key) => Model.Problem(key) is null ? null : "true";

    // The error Proceed left on a field, under it.
    private async Task FieldError(string key, string id)
    {
        var message = Model.Problem(key);
        if (message is not null)
        {
            <p class="field-error" id="@(id)Error" role="alert">@message</p>
        }
    }
}

@* Once the card's head has scrolled away, this strip keeps who the step is for and the
   application number in view (sticky-app-strip.js). *@
<div class="app-sticky-strip" id="docsPin" hidden>
    <div class="app-sticky-strip__inner">
        <span class="app-sticky-strip__who">@Model.Docs.HolderName</span>
        <span class="app-sticky-strip__pan">PAN @Model.Docs.HolderPan</span>
        <span class="app-sticky-strip__app">
            <span class="app-sticky-strip__label">Application</span>
            @appNo
            <button type="button" class="doc-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyIcon)</svg>
            </button>
        </span>
    </div>
</div>

<div class="page-layout">
    <partial name="_ClassicSteps" model="4" />

    <form class="page-main" id="depositConfigForm" data-guard method="post" enctype="multipart/form-data" data-partial novalidate data-partial-focus="@focus" data-quote-url="@Url.Action("Quote")">
        @* Pressed for the partner whenever a choice changes: the deposit is saved and redrawn. *@
        <button type="submit" class="visually-hidden" id="depositRefresh" name="refresh" value="" formnovalidate tabindex="-1">Update</button>

        @if (banner is not null)
        {
            <div class="alert alert-success doc-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <span>@banner</span>
            </div>
        }

        <section class="page-card section-card" id="deposit">
            <div class="page-head" data-pin-head>
                <h2 class="page-title">Fixed Deposit Configuration</h2>
                <span class="page-app-number">Application No: <strong>@appNo</strong>
                    <button type="button" class="doc-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyIcon)</svg>
                    </button>
                </span>
            </div>

            @* The choices on the left, the quote beside them. On a phone the quote comes first. *@
            <div class="deposit-layout">
                <div class="deposit-main">

                    @* ===== Amount ===== *@
                    <div class="deposit-group">
                        <div class="investor-section-head">
                            <label class="deposit-label" for="deposit-amount">Amount</label>
                            <div class="deposit-aside">@amountAside</div>
                        </div>
                        <div class="deposit-amount @amountBoxClass">
                            <span class="deposit-amount__currency" aria-hidden="true">&#8377;</span>
                            <input id="deposit-amount" name="Amount" class="deposit-amount__input @Invalid("Amount")" value="@form.Amount" inputmode="numeric" autocomplete="off" data-quote readonly="@Model.AmountFixed"
                                   data-required="@amountRequired" data-check="@amountCheck" data-min="@Model.Config.MinAmount" data-max="@Model.Config.MaxAmount" data-step="@Model.Config.AmountStep" aria-invalid="@AriaInvalid("Amount")" aria-describedby="@amountDescribedBy">
                        </div>
                        @{ await FieldError("Amount", "deposit-amount"); }
                        <div class="deposit-hint" id="deposit-amount-hint">@amountHint</div>
                    </div>

                    @* ===== Tenure ===== *@
                    <div class="deposit-group" role="radiogroup" aria-labelledby="deposit-tenure-label">
                        <div class="investor-section-head">
                            <div class="deposit-label" id="deposit-tenure-label">Tenure &middot; months</div>
                        </div>
                        @* The tenures the rate card carries. One not offered at the amount is shut
                           (deposit.js keeps this up to date as the amount changes). *@
                        <div class="deposit-options deposit-options--tenure">
                            @foreach (var tenure in Model.Tenures)
                            {
                                if (Model.Rates.OffersTenure(tenure))
                                {
                                    <label class="deposit-option">
                                        <input type="radio" id="deposit-tenure-@tenure" name="TenureMonths" value="@tenure" checked="@(tenure == form.TenureMonths)" data-quote>
                                        <span class="deposit-option__face">@tenure</span>
                                    </label>
                                }
                                else
                                {
                                    <label class="deposit-option deposit-option--off">
                                        <input type="radio" id="deposit-tenure-@tenure" name="TenureMonths" value="@tenure" checked="@(tenure == form.TenureMonths)" data-quote disabled>
                                        <span class="deposit-option__face">@tenure</span>
                                    </label>
                                }
                            }
                        </div>
                        @{ await FieldError("TenureMonths", "deposit-tenure"); }
                    </div>

                    @* ===== Interest payout ===== *@
                    <div class="deposit-group" role="radiogroup" aria-labelledby="deposit-payout-label">
                        <div class="investor-section-head">
                            <div class="deposit-label" id="deposit-payout-label">Interest payout</div>
                            <div class="deposit-aside">a payout on maturity makes the deposit cumulative</div>
                        </div>
                        @* The payouts the rate card carries, shut where the amount is under the
                           payout's minimum: on the chart a monthly or quarterly payout needs
                           ₹50,000, a half-yearly or yearly one ₹25,000. *@
                        <div class="deposit-options deposit-options--payout">
                            @foreach (var payout in Model.Payouts)
                            {
                                if (Model.Rates.OffersPayout(payout.Code))
                                {
                                    <label class="deposit-option">
                                        <input type="radio" id="deposit-payout-@payout.Code" name="InterestPayout" value="@payout.Code" checked="@(payout.Code == form.InterestPayout)" data-quote>
                                        <span class="deposit-option__face">@payout.Name</span>
                                    </label>
                                }
                                else
                                {
                                    <label class="deposit-option deposit-option--off">
                                        <input type="radio" id="deposit-payout-@payout.Code" name="InterestPayout" value="@payout.Code" checked="@(payout.Code == form.InterestPayout)" data-quote disabled>
                                        <span class="deposit-option__face">@payout.Name</span>
                                    </label>
                                }
                            }
                        </div>
                        @{ await FieldError("InterestPayout", "deposit-payout"); }
                    </div>

                    @* ===== Auto renewal ===== *@
                    <section class="deposit-section">
                        <label class="deposit-toggle" for="deposit-renew-on">
                            <span class="deposit-toggle__text">
                                <span class="deposit-toggle__title">Auto renewal</span>
                                <span class="deposit-toggle__desc">Renews automatically on maturity unless the investor instructs otherwise</span>
                            </span>
                            <input type="checkbox" id="deposit-renew-on" name="AutoRenewal" value="true" class="investor-switch" checked="@form.AutoRenewal" data-quote>
                            <input type="hidden" name="AutoRenewal" value="false">
                        </label>
                        @* Shown the moment auto renewal is turned on (data-show-when); hidden, it is
                           disabled, so its choice is not posted. *@
                        <fieldset class="deposit-grid-2 doc-choice" data-show-when="AutoRenewal=true" hidden="@(!form.AutoRenewal)" disabled="@(!form.AutoRenewal)">
                            <div class="doc-column">
                                <label class="field-label" for="deposit-renew">Renew</label>
                                <div class="doc-select">
                                    <select class="field-input @Invalid("RenewInstruction")" id="deposit-renew" name="RenewInstruction" data-quote data-required="Required — choose what auto renewal renews" aria-invalid="@AriaInvalid("RenewInstruction")">
                                        <option value="" selected="@(form.RenewInstruction.Length == 0)">Select</option>
                                        @foreach (var instruction in Model.Ref.RenewInstructions)
                                        {
                                            <option value="@instruction.Code" selected="@(instruction.Code == form.RenewInstruction)">@instruction.Name</option>
                                        }
                                    </select>
                                </div>
                                @{ await FieldError("RenewInstruction", "deposit-renew"); }
                            </div>
                            <div class="doc-column">
                                <label class="field-label" for="deposit-renew-for">Renew for</label>
                                <input class="field-input" id="deposit-renew-for" value="Same tenure — @form.TenureMonths months" readonly tabindex="-1">
                                <p class="field-hint">At the card rate on the renewal date, not today&rsquo;s</p>
                            </div>
                        </fieldset>
                    </section>

                    @* ===== TDS exemption ===== *@
                    <section class="deposit-section deposit-section--tight">
                        <label class="deposit-toggle" for="deposit-no-tds">
                            <span class="deposit-toggle__text">
                                <span class="deposit-toggle__title">Do not deduct tax at source (@Glossary.Term("TDS"))</span>
                                <span class="deposit-toggle__desc">Only where the investor is eligible &mdash; their signed Form @Glossary.Term("121") is filed below</span>
                            </span>
                            <input type="checkbox" id="deposit-no-tds" name="NoTds" value="true" class="investor-switch" checked="@form.NoTds" data-quote>
                            <input type="hidden" name="NoTds" value="false">
                        </label>
                        <div class="alert alert-warning deposit-note" data-show-when="NoTds=true" hidden="@(!form.NoTds)">
                            <div class="deposit-note__text"><strong>@Model.TdsForm is needed for the primary holder</strong>, by the investor&rsquo;s date of birth: file the signed form below before proceeding. Turning this off removes the requirement; TDS is then deducted at the applicable rate.</div>
                        </div>
                        @* The form itself, filed here as a document is on Upload Documents; shut with the switch. *@
                        <fieldset class="doc-choice deposit-tds-form" data-show-when="NoTds=true" hidden="@(!form.NoTds)" disabled="@(!form.NoTds)">
                            <div class="doc-grid doc-grid--docs">
                                <div class="doc-column">
                                    <partial name="_DocSlot" model="@(new DocSlotBlock(Model.Docs.View(DocumentsViewModel.TdsFormSlot), Url.Action("Upload")!, "depositConfigForm", Label: Model.TdsForm))" />
                                </div>
                            </div>
                            @{ await FieldError("TdsForm", "slot-tdsform"); }
                        </fieldset>
                    </section>

                    @* ===== Source of funds ===== *@
                    @* Asked once the investor's deposits with us, with this one, pass ₹1 crore and
                       they are a homemaker, student or retired, or earn up to ₹5 lakh a year
                       (SourceOfFundsCheck). Not on the page until then: deposit.js shows and
                       hides it as the amount changes. "Other" opens the remark. *@
                    <section class="deposit-section deposit-grid-2" id="deposit-source-of-funds-section" hidden="@(!Model.SourceOfFunds.Asked)">
                        <div class="doc-column">
                            <label class="field-label" for="deposit-source-of-funds">Source of funds</label>
                            <div class="doc-select">
                                <select class="field-input @Invalid("SourceOfFunds")" id="deposit-source-of-funds" name="SourceOfFunds" disabled="@(!Model.SourceOfFunds.Asked)" data-quote aria-invalid="@AriaInvalid("SourceOfFunds")" aria-describedby="deposit-source-of-funds-why">
                                    <option value="" selected="@(form.SourceOfFunds.Length == 0)">Choose</option>
                                    @foreach (var source in Model.SourcesOfFunds)
                                    {
                                        <option value="@source.Code" selected="@(source.Code == form.SourceOfFunds)">@source.Name</option>
                                    }
                                </select>
                            </div>
                            @{ await FieldError("SourceOfFunds", "deposit-source-of-funds"); }
                            <p class="field-hint" id="deposit-source-of-funds-why">@Model.SourceOfFunds.Why</p>
                        </div>
                        <div class="doc-column">
                            <label class="field-label" for="deposit-source-of-funds-remark">If other, what</label>
                            <input class="field-input @Invalid("SourceOfFundsRemark")" id="deposit-source-of-funds-remark" name="SourceOfFundsRemark" value="@form.SourceOfFundsRemark" maxlength="200" autocomplete="off" disabled="@(!Model.RemarkOpen)" aria-invalid="@AriaInvalid("SourceOfFundsRemark")">
                            @{ await FieldError("SourceOfFundsRemark", "deposit-source-of-funds-remark"); }
                        </div>
                    </section>

                    @* ===== Delivery ===== *@
                    <section class="deposit-section deposit-grid-2">
                        <div class="doc-column">
                            <label class="field-label" for="deposit-delivery">Delivery type</label>
                            <div class="doc-select">
                                <select class="field-input @Invalid("DeliveryType")" id="deposit-delivery" name="DeliveryType" data-quote aria-invalid="@AriaInvalid("DeliveryType")">
                                    @foreach (var delivery in Model.Ref.DeliveryTypes)
                                    {
                                        <option value="@delivery.Code" selected="@(delivery.Code == form.DeliveryType)">@delivery.Name</option>
                                    }
                                </select>
                            </div>
                            @{ await FieldError("DeliveryType", "deposit-delivery"); }
                            <p class="field-hint">@receiptHint</p>
                        </div>
                    </section>
                </div>

                @* ===== The quote ===== *@
                <aside class="deposit-summary" id="deposit-quote" aria-live="polite">
                    <partial name="_Quote" model="Model" />
                </aside>
            </div>
        </section>
    </form>
</div>

<footer class="page-action-bar">
    <div class="page-action-bar__inner">
        <a class="btn btn-outline-primary" asp-controller="Payment" asp-action="Index" data-loader="Going back to Bank Details &amp; Payment">Back</a>
        <p class="page-action-bar__hint">
            @if (problemCount > 0)
            {
                var thingOrThings = problemCount == 1 ? "thing" : "things";
                @problemCount @thingOrThings <text>still to fix on this step</text>
            }
            else
            {
                <text>Choose the deposit, then proceed to <strong>Review Summary</strong> &mdash; Proceed saves it</text>
            }
        </p>
        <div class="page-action-bar__right">
            <button type="submit" form="depositConfigForm" class="btn btn-outline-primary" name="draft" value="1" formnovalidate data-toast="Draft saved">Save draft</button>
            <button type="submit" form="depositConfigForm" class="btn btn-primary" data-loader="Saving the deposit&hellip;" data-validate="form">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/pages/deposit.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/deposit.css" asp-append-version="true" />
}

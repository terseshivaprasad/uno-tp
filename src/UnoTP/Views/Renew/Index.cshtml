@model RenewViewModel
@{
    ViewData["Title"] = "Renew FD";
    ViewData["BackToDashboard"] = true;

    // The old WA_FD_UNOTP/RenewalDashboard, on Investor Identification's frame:
    // the same rail, card and holder block, the search where the purchase has its
    // search, and the record where the purchase shows its record - here the
    // investor with their deposits, each with where it stands and a remark. Renew
    // on a deposit that is due opens an application, as a new deposit does, with
    // the deposit's holders, bank and amount already on it. The old screen's notes
    // stand under the list.
    var s = Model.Search;
    var found = Model.Deposits is { Count: > 0 };
    var deposits = Model.Deposits ?? [];
    var due = deposits.Count(d => d.Renewable);
    var asked = s.ByFolio
        ? new Dictionary<string, string> { ["by"] = "folio", ["folio"] = s.Folio }
        : new Dictionary<string, string> { ["by"] = "pan", ["pan"] = s.Pan, ["dd"] = s.Dd, ["mm"] = s.Mm, ["yyyy"] = s.Yyyy };
}

<div class="csi">
    <partial name="_ClassicSteps" model="0" />

    <div class="csi-main">
    <section class="csi-card cii-card">
        <div class="cii-head"><h1 class="cii-title">Renewal &mdash; Search</h1></div>

        @if (Model.Said is not null)
        {
            <div class="alert alert-danger csi-gap" role="alert">
                <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="csi-gap__body"><p>@Model.Said</p></div>
            </div>
        }

        <section class="csi-holder">
            <div class="csi-holder__head">
                <span class="csi-holder__no">1</span>
                <span class="csi-holder__name">Investor</span>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">Primary holder</span>
                <span class="csi-status @(found ? "csi-status--ok" : null)">@(found ? "Identified" : "Not identified")</span>
            </div>

            @if (!found)
            {
                @* The search, as Investor Identification's: by PAN and date of birth, or by folio. *@
                <form class="csi-search" id="rnForm" method="get" asp-action="Index" novalidate>
                    <fieldset class="csi-searchby">
                        <legend class="csi-label">Search By</legend>
                        <label class="csi-radio">
                            <input type="radio" name="by" value="pan" checked="@(!s.ByFolio)">
                            <span>PAN &amp; Date of Birth</span>
                        </label>
                        <label class="csi-radio">
                            <input type="radio" name="by" value="folio" checked="@s.ByFolio">
                            <span>Folio Number</span>
                        </label>
                    </fieldset>

                    <fieldset class="cud-choice" data-show-when="by=pan" hidden="@s.ByFolio" disabled="@s.ByFolio">
                        <div class="csi-fields">
                            <div class="csi-field">
                                <label class="csi-label" for="rnPan">Enter PAN</label>
                                <input class="csi-control csi-control--caps @(Model.Problem("Pan") is null ? null : "is-invalid")" id="rnPan" name="pan" value="@s.Pan" maxlength="10" autocomplete="off" spellcheck="false"
                                       data-required="Enter the PAN" data-check="pan" aria-invalid="@(Model.Problem("Pan") is null ? null : "true")" aria-describedby="rnPanError" autofocus="@(Model.Problem("Pan") is not null)">
                                <p class="csi-error" id="rnPanError" hidden="@(Model.Problem("Pan") is null)">@Model.Problem("Pan")</p>
                            </div>
                            <div class="csi-field">
                                <span class="csi-label" id="rnDobLabel">Date Of Birth</span>
                                <div class="csi-date @(Model.Problem("Dob") is null ? null : "is-invalid")" role="group" aria-labelledby="rnDobLabel" aria-describedby="rnDobError"
                                     data-required="Enter the date of birth" data-check="date" data-error-id="rnDobError">
                                    <input class="csi-date__part" id="rnDd" name="dd" value="@s.Dd" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off">
                                    <span class="csi-date__sep">/</span>
                                    <input class="csi-date__part" name="mm" value="@s.Mm" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                                    <span class="csi-date__sep">/</span>
                                    <input class="csi-date__part csi-date__part--year" name="yyyy" value="@s.Yyyy" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                                </div>
                                <p class="csi-error" id="rnDobError" hidden="@(Model.Problem("Dob") is null)">@Model.Problem("Dob")</p>
                            </div>
                            <div class="csi-field csi-field--check">
                                <button type="submit" class="csi-check" data-validate=".csi-search">Search deposits <span aria-hidden="true">&rsaquo;</span></button>
                            </div>
                        </div>
                        <p class="csi-hint">Both fields are required &mdash; a PAN-only search is not permitted.</p>
                    </fieldset>

                    <fieldset class="cud-choice" data-show-when="by=folio" hidden="@(!s.ByFolio)" disabled="@(!s.ByFolio)">
                        <div class="csi-fields">
                            <div class="csi-field">
                                <label class="csi-label" for="rnFolio">Enter Folio Number</label>
                                <input class="csi-control csi-control--caps @(Model.Problem("Folio") is null ? null : "is-invalid")" id="rnFolio" name="folio" value="@s.Folio" maxlength="16" autocomplete="off" spellcheck="false"
                                       data-required="Enter the folio number" data-chars="code" aria-invalid="@(Model.Problem("Folio") is null ? null : "true")" aria-describedby="rnFolioError">
                                <p class="csi-error" id="rnFolioError" hidden="@(Model.Problem("Folio") is null)">@Model.Problem("Folio")</p>
                            </div>
                            <div class="csi-field csi-field--check">
                                <button type="submit" class="csi-check" data-validate=".csi-search">Search deposits <span aria-hidden="true">&rsaquo;</span></button>
                            </div>
                        </div>
                        <p class="csi-hint">The folio number alone is enough &mdash; it finds the same deposits as the PAN search.</p>
                    </fieldset>

                    @if (Model.NotFound)
                    {
                        <div class="alert alert-danger csi-gap csi-ops" role="alert">
                            <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"></circle><path d="M5.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M18.5 4.5l2 2M20.5 4.5l-2 2"></path></svg>
                            <div class="csi-gap__body">
                                <div class="csi-gap__title">No deposit on record against @Model.Asked</div>
                                <p>Check what was typed, or search the other way. Only deposits due for renewal, and the folio's others, are shown here.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Deposits is { Count: 0 })
                    {
                        <p class="csi-hint">Nothing due for renewal, or held, against @Model.Asked.</p>
                    }
                </form>
            }
            else
            {
                @* The investor, as Investor Identification lays out its record: one read-only panel. *@
                <div class="inv-panel csi-result">
                    <div class="csi-result__head">
                        <span class="csi-result__name">@deposits[0].Investor</span>
                        <span class="csi-result__tag">Folio @deposits[0].Folio</span>
                        <a class="csi-check csi-result__again" asp-action="Index">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L20 20"></path></svg> Search again
                        </a>
                    </div>
                    <div class="inv-kv-grid">
                        @if (!s.ByFolio)
                        {
                            <div class="inv-kv"><div class="inv-kv__k">PAN</div><div class="inv-kv__v">@DocumentsViewModel.Mask(s.Pan)</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Date of birth</div><div class="inv-kv__v">@Dates.Show(s.Dob ?? "")</div></div>
                        }
                        <div class="inv-kv"><div class="inv-kv__k">Folio</div><div class="inv-kv__v">@deposits[0].Folio</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Deposits</div><div class="inv-kv__v">@deposits.Count &middot; @due due for renewal</div></div>
                    </div>
                    <p class="csi-result__said">@deposits.Count @(deposits.Count == 1 ? "deposit" : "deposits") against @Model.Asked. @(due == 0 ? "None is inside the renewal window: the remark on each row says why." : "Renew from the row of one that is due.")</p>
                </div>
            }
        </section>

        @if (found)
        {
            @* The deposits, each with where it stands; Renew on one that is due. *@
            <section class="csi-holder">
                <div class="csi-holder__head">
                    <span class="csi-holder__no">2</span>
                    <span class="csi-holder__name">Deposits</span>
                    <span class="badge @(due > 0 ? "bg-success-subtle text-success-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">@due due for renewal</span>
                </div>
                <table class="su-table">
                    <colgroup>
                        <col style="width:15%"><col style="width:12%"><col style="width:15%"><col style="width:10%">
                        <col style="width:11%"><col style="width:26%"><col style="width:11%">
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Deposit</th>
                            <th scope="col" class="pis-table__amt">Amount</th>
                            <th scope="col">Rate &middot; tenure &middot; payout</th>
                            <th scope="col">Matures on</th>
                            <th scope="col">Status</th>
                            <th scope="col">Remark</th>
                            <th scope="col" class="su-table__act"><span class="visually-hidden">Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in deposits)
                        {
                            <tr data-state="@d.Status">
                                <td data-label="Deposit"><strong>@d.Number</strong><div class="su-table__sub">from @Money.Day(d.StartedOn)@(d.JointHolders is { Count: > 0 } j ? $" · {j.Count} joint holder{(j.Count == 1 ? "" : "s")}" : "")@(d.AutoRenewal ? " · auto renewal" : "")</div></td>
                                <td data-label="Amount" class="pis-table__amt">@Money.Rupees(d.Amount)<div class="su-table__sub">@Money.Rupees(d.MaturityAmount) at maturity</div></td>
                                <td data-label="Rate · tenure · payout">@d.Rate.ToString("0.00")% &middot; @d.TenureMonths months<div class="su-table__sub">@Model.PayoutName(d.Payout)</div></td>
                                <td data-label="Matures on">@Money.Day(d.MaturesOn)</td>
                                <td data-label="Status"><span class="chip @RenewViewModel.StatusTone(d.Status)">@RenewViewModel.StatusLabel(d.Status)</span></td>
                                <td data-label="Remark">@Model.Remark(d)</td>
                                <td data-label="" class="su-table__act">
                                    @if (d.Renewable)
                                    {
                                        <form method="post" action="@Url.Action("Start", "Renew", asked.Concat([KeyValuePair.Create("number", d.Number)]).ToDictionary())" asp-antiforgery="true">
                                            <button type="submit" class="btn btn-primary" data-loader="Opening the renewal&hellip;">Renew</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        @* The old screen's notes, as the backend gives them, under the list. *@
        <div class="alert alert-warning csi-note">
            <svg class="csi-note__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
            <div class="csi-note__body">
                <div class="csi-note__title">Note</div>
                <ul>
                    @foreach (var n in Model.Ref.RenewalNotes)
                    {
                        <li>@n</li>
                    }
                </ul>
            </div>
        </div>
    </section>
    </div>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="Index" data-loader="Going back to the dashboard">Back</a>
        <p class="csi-bar__hint">
            @if (!found)
            {
                <text>Find the investor by PAN and date of birth, or by folio &mdash; deposits from @Model.Config.RenewFromDays to @Model.Config.RenewUntilDays days before maturity can be renewed</text>
            }
            else if (due > 0)
            {
                <text>@due @(due == 1 ? "deposit is" : "deposits are") due &mdash; <strong>Renew</strong> on its row opens the application, at <strong>Upload Documents</strong></text>
            }
            else
            {
                <text>Nothing here is inside the renewal window &mdash; the remark on each row says when it will be</text>
            }
        </p>
        <div class="csi-bar__right"></div>
    </div>
</footer>


@section Styles {
    <link rel="stylesheet" href="~/css/pages/renew.css" asp-append-version="true" />
}

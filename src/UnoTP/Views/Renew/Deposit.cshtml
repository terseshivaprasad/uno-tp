@model RenewDepositViewModel
@{
    ViewData["Title"] = "Renew FD";

    // One deposit, and the renewal to ask for it: what is renewed, the tenure and
    // the payout on the left, as FD Configuration asks them; beside them, what the
    // backend quotes for that, redrawn alone as a choice changes (fd-quote.js).
    // Nothing is saved until Proceed, which sends it to the investor to accept.
    var d = Model.Deposit;
    var f = Model.Form;
    var stopped = Model.Problem("Deposit");
}

@functions {
#pragma warning disable CS1998
    private async Task FieldError(string field, string id)
    {
        if (Model.Problem(field) is { } error)
        {
            <p class="csi-error" id="@(id)Error" role="alert">@error</p>
        }
    }
}

<div class="csi csi--wide">
    <form class="csi-main" id="renewForm" method="post" asp-action="Renew" asp-route-number="@d.Number" data-partial novalidate data-quote-url="@Url.Action("Quote", new { number = d.Number })">

        @if (stopped is not null)
        {
            <div class="csi-gap csi-gap--alert" role="alert">
                <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="csi-gap__body">
                    <div class="csi-gap__title">This deposit cannot be renewed now</div>
                    <p>@stopped</p>
                </div>
            </div>
        }

        <section class="csi-card cii-card" id="renew">
            <div class="cii-head">
                <h2 class="cii-title">Renew deposit @d.Number</h2>
                <span class="cii-app">Folio <strong>@d.Folio</strong> &middot; @d.Investor</span>
            </div>

            @* The deposit as it stands, read-only: what is being renewed. *@
            <div class="cii-record">
                <div class="inv-panel">
                    <div class="inv-panel__label" style="padding-bottom:10px">The deposit &middot; from the register &middot; read-only</div>
                    <div class="inv-kv-grid">
                        <div class="inv-kv"><div class="inv-kv__k">Amount</div><div class="inv-kv__v">@Money.Rupees(d.Amount)</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Rate</div><div class="inv-kv__v">@d.Rate.ToString("0.00")% a year</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Tenure &middot; payout</div><div class="inv-kv__v">@d.TenureMonths months &middot; @Model.PayoutName(d.Payout)</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Started on</div><div class="inv-kv__v">@Money.Day(d.StartedOn)</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Matures on</div><div class="inv-kv__v">@Money.Day(d.MaturesOn) <span class="chip @RenewViewModel.StatusTone(d.Status)">@RenewViewModel.StatusLabel(d.Status)</span></div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Maturity amount</div><div class="inv-kv__v">@Money.Rupees(d.MaturityAmount)</div></div>
                    </div>
                </div>
            </div>

            <div class="fd-layout">
                <div class="fd-main">

                    @* ── What is renewed ────────────────────────────────────────── *@
                    <div class="fd-group" role="radiogroup" aria-labelledby="rn-mode-label">
                        <div class="inv-section-head">
                            <div class="fd-label" id="rn-mode-label">What is renewed</div>
                            <div class="fd-aside">principal only pays the interest out at maturity</div>
                        </div>
                        <div class="fd-options fd-options--payout">
                            @foreach (var m in Model.Ref.RenewInstructions)
                            {
                                <label class="fd-option">
                                    <input type="radio" id="rn-mode-@m.Code" name="Mode" value="@m.Code" checked="@(m.Code == f.Mode)" data-quote>
                                    <span class="fd-option__face">@m.Name</span>
                                </label>
                            }
                        </div>
                        @{ await FieldError("Mode", "rn-mode"); }
                    </div>

                    @* ── Tenure ─────────────────────────────────────────────────── *@
                    <div class="fd-group" role="radiogroup" aria-labelledby="rn-tenure-label">
                        <div class="inv-section-head">
                            <div class="fd-label" id="rn-tenure-label">Tenure &middot; months</div>
                        </div>
                        <div class="fd-options fd-options--tenure">
                            @foreach (var t in Model.Ref.Tenures)
                            {
                                <label class="fd-option">
                                    <input type="radio" id="rn-tenure-@t" name="TenureMonths" value="@t" checked="@(t == f.TenureMonths)" data-quote>
                                    <span class="fd-option__face">@t</span>
                                </label>
                            }
                        </div>
                        @{ await FieldError("TenureMonths", "rn-tenure"); }
                    </div>

                    @* ── Interest payout ────────────────────────────────────────── *@
                    <div class="fd-group" role="radiogroup" aria-labelledby="rn-payout-label">
                        <div class="inv-section-head">
                            <div class="fd-label" id="rn-payout-label">Interest payout</div>
                            <div class="fd-aside">a payout on maturity makes the deposit cumulative</div>
                        </div>
                        <div class="fd-options fd-options--payout">
                            @foreach (var p in Model.Ref.Payouts)
                            {
                                <label class="fd-option">
                                    <input type="radio" id="rn-payout-@p.Code" name="Payout" value="@p.Code" checked="@(p.Code == f.Payout)" data-quote>
                                    <span class="fd-option__face">@p.Name</span>
                                </label>
                            }
                        </div>
                        @{ await FieldError("Payout", "rn-payout"); }
                    </div>
                </div>

                <aside class="fd-summary" id="fd-quote" aria-live="polite">
                    <partial name="_RenewQuote" model="Model" />
                </aside>
            </div>
        </section>
    </form>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-action="Index" asp-route-folio="@d.Folio" data-loader="Back to the folio's deposits">Back</a>
        <p class="csi-bar__hint">Choose the renewal, then send it to the investor to accept &mdash; nothing is renewed until they do</p>
        <div class="csi-bar__right">
            <button type="submit" form="renewForm" class="csi-btn csi-btn--primary" data-validate="form" data-loader="Sending the renewal for acceptance&hellip;" disabled="@(!d.Renewable)">Send for acceptance</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/partial-forms.js" asp-append-version="true"></script>
    <script src="~/js/checks.js" asp-append-version="true"></script>
    <script src="~/js/fd-quote.js" asp-append-version="true"></script>
}

@model RenewDepositViewModel
@* What the backend quotes for the renewal as it stands: drawn with the page, and
   alone in answer to Quote each time a choice changes (fd-quote.js). *@
@{
    var d = Model.Deposit;
    var f = Model.Form;
    var q = Model.Quote;
    var payout = Model.PayoutChosen;
    var renewsOn = RenewForm.RenewsOn(d);
}

<div class="fd-summary__label">The renewed deposit</div>
<div>
    <div class="fd-kv__k">@(f.Mode == RenewForm.PrincipalAndInterest ? "Maturity amount renewed" : "Principal renewed")</div>
    <div class="fd-summary__amount">@Money.Rupees(f.AmountFor(d))</div>
</div>
<div class="fd-summary__grid">
    <div><div class="fd-kv__k">Interest rate</div><div class="fd-kv__v fd-kv__v--rate">@(q is null ? "—" : $"{q.Rate:0.00}%")</div></div>
    <div><div class="fd-kv__k">Tenure</div><div class="fd-kv__v">@(f.TenureMonths > 0 ? $"{f.TenureMonths} months" : "—")</div></div>
    <div><div class="fd-kv__k">Payout</div><div class="fd-kv__v">@(payout?.Name ?? "—")</div></div>
    <div><div class="fd-kv__k">Category</div><div class="fd-kv__v">@Model.Category</div></div>
</div>
<div class="fd-summary__block">
    <div><div class="fd-kv__k">Renews on</div><div class="fd-kv__v">@Money.Day(renewsOn)</div></div>
    <div><div class="fd-kv__k">Scheme</div><div class="fd-kv__v">@(Model.Cumulative ? "Cumulative" : "Non-cumulative")</div></div>
    @if (!Model.Cumulative && q is not null && payout is not null)
    {
        <div><div class="fd-kv__k">Interest each @payout.Each</div><div class="fd-kv__v">@Money.Rupees(q.InterestEach)</div></div>
    }
    <div><div class="fd-kv__k">Maturity value</div><div class="fd-kv__v">@(q is null ? "—" : Money.Rupees(q.MaturityAmount))</div></div>
    <div><div class="fd-kv__k">Matures on</div><div class="fd-kv__v">@(q is null ? "—" : Money.Day(q.MaturesOn))</div></div>
</div>
<div class="fd-summary__note">
    @if (q is null)
    {
        <text>Choose what is renewed, the tenure and the payout for a quote.</text>
    }
    else
    {
        <text>Card rate as on @Money.Day(q.RateAsOn). The rate is locked once the investor accepts.</text>
    }
</div>

@model InvestorInfoViewModel
@{
    ViewData["Title"] = "Investor Information";

    // The old WA_FD_UNOTP/InvestorInformation: a card for the investor, one for each
    // joint holder added, and one for the nominee, down one column. The page is one
    // form, and every button posts all of it, so nothing typed is lost to a post
    // about something else (see InvestorInfoController).
    var lists = new Lists(
        ["Upto Rs.5,00,000", "Rs.5,00,000 - Rs.10,00,000", "Rs.10,00,000 - Rs.25,00,000", "Above Rs.25,00,000"],
        ["Salaried", "Self-employed", "Business", "Retired", "Homemaker", "Student"],
        ["MMFSL Employee", "Private sector", "Public sector", "Government service", "Professional"],
        ["Married", "Single", "Widowed", "Divorced"]);
    var relations = new[] { "Son", "Daughter", "Spouse", "Father", "Mother", "Brother", "Sister" };
    var appNo = Model.Docs.AppNo;
    var banner = Model.Docs.Shown?.Banner;
}

@functions {
    // .NET 8 Razor leaves the body of a tag helper inside a helper below async with
    // nothing to await (fixed in Razor 9); nothing runs differently for it.
#pragma warning disable CS1998
    // What the drop-downs offer, passed to the helpers below in one piece.
    private sealed record Lists(string[] Incomes, string[] Occupations, string[] SubOccupations, string[] Maritals);

    private const string BinGlyph = "<path d=\"M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13\"></path>";

    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    // A button that posts the page's form to one of the page's steps.
    private async Task Post(string action, object? route, string css, string label, string? loader = null)
    {
        <button type="submit" class="@css" formaction="@Url.Action(action, route)" formnovalidate data-loader="@loader">@Html.Raw(label)</button>
        await Task.CompletedTask;
    }

    // A labelled drop-down, as the classic steps draw one, holding what was posted.
    private async Task Select(string id, string name, string label, IEnumerable<string> options, string opening = "")
    {
        var selected = Model.Value(name, opening);
        <div class="cud-col">
            <label class="csi-label" for="@id">@label</label>
            <div class="cud-select">
                <select class="csi-control" id="@id" name="@name">
                    <option value="" selected="@(selected.Length == 0)">Select</option>
                    @foreach (var o in options)
                    {
                        <option selected="@(o == selected)">@o</option>
                    }
                </select>
            </div>
        </div>
        await Task.CompletedTask;
    }

    // More Information, which every holder gives, and on the investor's card the
    // FATCA answers - asked of the investor and the joint holders together.
    private async Task MoreInformation(int holder, Lists lists, string income = "", string occupation = "", string sub = "", string marital = "", string mobile = "", string email = "")
    {
        var p = $"Holder{holder}";
        var id = $"cii{holder}";
        <h3 class="cii-section">More Information</h3>
        <div class="cud-grid">
            @{ await Select($"{id}Income", $"{p}.AnnualIncome", "Annual Income", lists.Incomes, income); }
            @{ await Select($"{id}Occupation", $"{p}.Occupation", "Occupation", lists.Occupations, occupation); }
            @{ await Select($"{id}SubOccupation", $"{p}.SubOccupation", "Sub Occupation", lists.SubOccupations, sub); }
            @{ await Select($"{id}Marital", $"{p}.MaritalStatus", "Marital Status", lists.Maritals, marital); }
            <div class="cud-col">
                <label class="csi-label" for="@(id)Mobile">Mobile Number</label>
                <input class="csi-control" id="@(id)Mobile" name="@(p).Mobile" value="@Model.Value($"{p}.Mobile", mobile)" inputmode="numeric" maxlength="10" autocomplete="off">
            </div>
            <div class="cud-col">
                <label class="csi-label" for="@(id)Email">E-Mail</label>
                <input class="csi-control csi-control--caps" id="@(id)Email" name="@(p).Email" value="@Model.Value($"{p}.Email", email)" type="email" autocomplete="off">
            </div>
        </div>

        if (holder == 1)
        {
            <h3 class="cii-section">Investor's FATCA Details</h3>
            <div class="cii-switches">
                <label class="inv-switch-row"><span>Are you/joint holder a tax resident of a country other than India?</span><input type="checkbox" class="inv-switch" name="@(p).FatcaTaxResident" checked="@Model.On($"{p}.FatcaTaxResident")"></label>
                <label class="inv-switch-row"><span>Are you/joint holder a permanent resident of a foreign country?</span><input type="checkbox" class="inv-switch" name="@(p).FatcaPermanentResident" checked="@Model.On($"{p}.FatcaPermanentResident")"></label>
            </div>
        }
    }

    // A proof's label: with document identification, the type the copy was
    // identified as beside it; without, the drop-down the type is chosen from first.
    private async Task ProofLabel(UploadDocumentsViewModel.DocHolder h, string field, string label, bool used, string type)
    {
        if (Model.Docs.AutoProofType)
        {
            <span class="csi-label">@label <partial name="_ProofType" model="@(used ? type : null)" /></span>
        }
        else
        {
            var key = h.Key(field);
            var error = Model.Docs.Shown?.Errors.GetValueOrDefault(key);
            <label class="csi-label" for="@key">@label</label>
            <div class="cud-select">
                <select class="csi-control @(error is null ? null : "is-invalid")" id="@key" name="@key" disabled="@(!used)" data-submit="refresh-@h.Code">
                    <option value="">@(used ? "Select" : "Not Applicable")</option>
                    @foreach (var p in UploadDocumentsViewModel.ProofsOfAddress)
                    {
                        <option value="@p" selected="@(type == p)">@p</option>
                    }
                </select>
            </div>
            if (error is not null)
            {
                <p class="csi-error" id="@(key)Error" role="alert">@error</p>
            }
        }
    }

    // A joint holder's documents, as Upload Documents asks the investor for theirs
    // and through the same model: the PAN copy, the photograph, the proof of address
    // and - where post goes elsewhere - the communication address proof, each
    // identified, read and checked before it is filed under the holder's type; and
    // what was read. Every holder's attempts are at the foot of the page. Where post
    // goes stands beside the heading, as it stands beside the application type for
    // the investor; the refresh button it posts through is shown only without a script.
    private async Task Documents(int holder, UploadDocumentsViewModel.DocHolder h)
    {
        var docs = Model.Docs;
        var upload = Url.Action("JointUpload", new { n = holder })!;
        var pan = docs.View(UploadDocumentsViewModel.PanSlot, h);
        var poa = docs.View(UploadDocumentsViewModel.PoaSlot, h);
        var mail = docs.View(UploadDocumentsViewModel.MailSlot, h);
        var different = docs.MailDifferentOf(h);
        var canDiffer = docs.MailCanDiffer(h);
        var mailingLabel = $"cii{holder}MailingLabel";
        <button type="submit" class="csi-check cud-refresh" id="refresh-@h.Code" name="refresh" value="" formaction="@Url.Action("JointRefresh", new { n = holder })" formnovalidate>Update</button>
        <div class="cii-docs-head">
            <h3 class="cii-docs-head__title">Documents</h3>
            <div class="cud-apptype__group">
                <span class="csi-label" id="@mailingLabel">Communication Address</span>
                <div class="seg-toggle" role="radiogroup" aria-labelledby="@mailingLabel">
                    @foreach (var (value, label) in new[] { ("same", "Same as Permanent"), ("different", "Different from Permanent") })
                    {
                        var on = different == (value == "different");
                        var shut = value == "different" && !canDiffer;
                        <label class="seg-toggle__opt @(on ? "seg-toggle__opt--active" : null)" title="@(shut ? mail.NotApplicable : null)">
                            <input class="visually-hidden" type="radio" name="@h.Key("mailing")" id="@h.Key("mailing")-@value" value="@value" checked="@on" disabled="@shut" data-submit="refresh-@h.Code" data-confirm="@(value == "same" && !on && mail.Doc is not null ? UploadDocumentsViewModel.MailDropAsk : null)">@label
                        </label>
                    }
                </div>
            </div>
        </div>
        <div class="cud-grid cud-grid--docs">
            <div class="cud-col">
                <span class="csi-label">PAN @if (pan.Optional) { <span class="cud-optional">(Non-mandatory)</span> }</span>
                <partial name="_DocSlot" model="@(new DocSlotBlock(pan, upload))" />
            </div>
            <div class="cud-col">
                <span class="csi-label">Photo</span>
                <partial name="_DocSlot" model="@(new DocSlotBlock(docs.View(UploadDocumentsViewModel.PhotoSlot, h), upload))" />
            </div>
            <div class="cud-col">
                @{ await ProofLabel(h, "poaType", "Proof of address", poa.Used, docs.PoaTypeOf(h)); }
                <partial name="_DocSlot" model="@(new DocSlotBlock(poa, upload))" />
            </div>
            <div class="cud-col">
                @{ await ProofLabel(h, "mailType", "Communication address proof", mail.Used, docs.MailTypeOf(h)); }
                <partial name="_DocSlot" model="@(new DocSlotBlock(mail, upload))" />
            </div>
        </div>

        @* The addresses are in the panel below, so only the PAN's checks stand here. *@
        <section class="cud-read">
            <h2 class="cud-read__title">What the PAN was checked with</h2>
            <p class="cud-read__sub">Asked once the PAN copy is filed above. The addresses the proofs give are in the address panel below.</p>
            <partial name="_ReadCards" model="@(new ReadCardsBlock(docs.PanReadsOf(h), Url.Action("JointNsdl", new { n = holder })))" />
        </section>
    }

    // A joint holder's card, laid out as the investor's: until they are added,
    // Investor Identification's search, by PAN and date of birth - found on the
    // register, or a PAN with no folio, and they are added there and then; a holder
    // it cannot add is removed and added again, never searched again. Once added,
    // the record read-only, the address as their documents give it, what has to be
    // typed because nothing read it, their documents, More Information and the PEP
    // questions. FATCA is asked once, on the investor's card, for every holder.
    private async Task JointHolder(int index, Lists lists)
    {
        var holder = index + 2;
        var state = Model.State.Joint[index];
        var search = Model.Joint[index];
        var who = InvestorInfoViewModel.Ordinal(holder) + " Holder";
        var h = state.Added ? Model.Docs.JointHolder(InvestorInfoViewModel.CodeOf(holder)) : null;
        <section class="csi-card cii-card" id="holder-@holder">
            <div class="cii-head">
                <h2 class="cii-title">@who Details</h2>
                <span class="csi-status @(h is not null ? "csi-status--ok" : null)">@(h is not null ? "Added" : "Not added")</span>
                @* Only the last holder opened can go: the second waits for the third. *@
                @if (holder < Model.State.Joint.Count + 1)
                {
                    <button type="button" class="inv-remove" disabled title="Remove the third holder first">@Html.Raw($"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">{BinGlyph}</svg> Remove")</button>
                }
                else
                {
                    await Post("JointRemove", new { n = holder }, "inv-remove", $"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">{BinGlyph}</svg> Remove");
                }
            </div>

            @if (h is null)
            {
                if (Model.Unfinished == holder)
                {
                    <div class="csi-gap csi-gap--alert cii-unfinished" role="alert">
                        <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                        <div class="csi-gap__body">
                            <div class="csi-gap__title">This holder is not added yet</div>
                            <p>Check the @who.ToLowerInvariant()&rsquo;s record to add them &mdash; or remove them &mdash; before you proceed.</p>
                        </div>
                    </div>
                }
                <div class="cii-identify">
                    <partial name="_HolderIdentification" model="@(new HolderIdentificationBlock(search, $"j{holder}", step => Url.Action("Joint" + step, new { n = holder })!, Prefix: $"Joint{holder}.", FolioSearch: false, Locked: true))" />
                </div>
            }
            else
            {
                await JointRecord(holder, h, search.Record);
                await Documents(holder, h);
                await JointAddress(holder, h, search.Record);
                await MoreInformation(holder, lists);
                await Pep(holder, h);
            }
        </section>
    }

    // An added joint holder's record, as the investor's card shows theirs: who they
    // are, read-only. Their documents follow, then their addresses and what nothing
    // read, typed - the gender where the record holds none, and the father's,
    // mother's or spouse's name, which OCR does not read.
    private async Task JointRecord(int holder, UploadDocumentsViewModel.DocHolder h, InvestorIdentificationViewModel.Holder? record)
    {
        var docs = Model.Docs;
        var gender = record?.Gender ?? "";
        var photo = docs.State.Docs.GetValueOrDefault(h.Key("photo"));
        var onFolio = h.Who.Folio.Length > 0;
        <div class="cii-record">
            <div class="inv-panel inv-ckyc">
                @if (photo is { Before: false })
                {
                    <img class="inv-ckyc__photo inv-ckyc__photo--img" src="@Url.Action("Copy", "UploadDocuments", new { slot = h.Key("photo"), v = photo.GetHashCode() })" alt="@(h.Who.Name)'s photograph">
                }
                else
                {
                    <div class="inv-ckyc__photo">Photo<br />@(docs.View(UploadDocumentsViewModel.PhotoSlot, h).Used ? "upload below" : "on the folio")</div>
                }
                <div style="flex:1;min-width:0">
                    <div class="inv-panel__label" style="padding-bottom:10px">@(onFolio ? $"From folio {h.Who.Folio}" : "From the search and the PAN copy") &middot; read-only</div>
                    <div class="inv-kv-grid">
                        <div class="inv-kv"><div class="inv-kv__k">Applicant Name</div><div class="inv-kv__v @(h.Who.Name.Length == 0 ? "inv-kv__v--unread" : null)">@(h.Who.Name.Length > 0 ? h.Who.Name : "Read off the PAN copy once filed")</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">DOB</div><div class="inv-kv__v">@h.Who.Dob</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Gender</div><div class="inv-kv__v @(gender.Length == 0 ? "inv-kv__v--unread" : null)">@(gender.Length > 0 ? gender : "Not read — enter below")</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Father Name</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">PAN</div><div class="inv-kv__v">@UploadDocumentsViewModel.Mask(h.Who.Pan)</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Folio</div><div class="inv-kv__v @(onFolio ? null : "inv-kv__v--unread")">@(onFolio ? h.Who.Folio : "Opens with this application")</div></div>
                    </div>
                </div>
            </div>

        </div>
        await Task.CompletedTask;
    }

    // An added joint holder's addresses, as their folio and the documents above give
    // them, and what nothing read, typed here.
    private async Task JointAddress(int holder, UploadDocumentsViewModel.DocHolder h, InvestorIdentificationViewModel.Holder? record)
    {
        var docs = Model.Docs;
        var p = $"Holder{holder}";
        var gender = record?.Gender ?? "";
        var poa = docs.ReadsOf(h)[0].Card;
        <div class="cii-record cii-record--after">
            <div class="inv-panel inv-panel--stack">
                <div class="inv-section-head">
                    <div class="inv-panel__label" style="flex:1;min-width:0">Address &amp; proof of address &middot; from the folio and the documents above</div>
                </div>
                <div class="inv-kv-grid">
                    <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Permanent address</div><div class="inv-kv__v">@poa.Lines</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">Permanent POA type</div><div class="inv-kv__v">@(docs.PoaTypeOf(h) is { Length: > 0 } poaType ? poaType : "—")</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v">@poa.State</div></div>
                </div>
                <div class="inv-kv-grid inv-kv-grid--divided">
                    @if (docs.MailDifferentOf(h))
                    {
                        var mail = docs.MailReadOf(h);
                        <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Communication address</div><div class="inv-kv__v">@mail.Lines</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Proof</div><div class="inv-kv__v">@(docs.MailTypeOf(h) is { Length: > 0 } mailType ? mailType : "—")</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v">@mail.State</div></div>
                    }
                    else
                    {
                        <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Communication address</div><div class="inv-kv__v">Same as permanent</div></div>
                    }
                </div>
            </div>

            <div class="inv-manual" id="h@(holder)-manual">
                <div class="inv-section-head">
                    <div class="inv-manual__title">@(gender.Length == 0 ? "Two fields" : "One field") could not be read for this holder</div>
                    <span class="inv-manual__badge">Manual entry</span>
                </div>
                <div class="inv-manual__text">@(gender.Length == 0 ? "Neither the record nor OCR gives a gender or a parent or spouse name" : "OCR does not read a parent or spouse name") for this holder. Type @(gender.Length == 0 ? "them" : "it") exactly as printed &mdash; everything that was read stays read-only above.</div>
                <div class="inv-grid">
                    @if (gender.Length == 0)
                    {
                        <div class="inv-field inv-field--sm">
                            <label for="h@(holder)-gender">Gender <span class="required">*</span></label>
                            <select id="h@(holder)-gender" name="@(p).Gender" class="inv-control" required>
                                <option value="">Select</option>
                                @foreach (var g in new[] { "Male", "Female", "Transgender" }) { if (g == Model.Value($"{p}.Gender")) { <option selected>@g</option> } else { <option>@g</option> } }
                            </select>
                        </div>
                    }
                    <div class="inv-field inv-field--sm">
                        <label for="h@(holder)-nametype">Name type <span class="required">*</span></label>
                        <select id="h@(holder)-nametype" name="@(p).NameType" class="inv-control inv-control--strong" required>
                            @foreach (var t in new[] { "Father", "Mother", "Spouse" }) { if (t == Model.Value($"{p}.NameType", "Father")) { <option selected>@t</option> } else { <option>@t</option> } }
                        </select>
                    </div>
                    <div class="inv-field inv-field--sm">
                        <label for="h@(holder)-parent">Father / Mother / Spouse name <span class="required">*</span></label>
                        <input id="h@(holder)-parent" name="@(p).ParentName" class="inv-control" value="@Model.Value($"{p}.ParentName")" required />
                    </div>
                </div>
            </div>
        </div>
        await Task.CompletedTask;
    }

    // Whether the holder is, or is related to, a politically exposed person: asked
    // of every holder with no folio, and both answers needed to proceed. A holder
    // on a folio has answered already, so is not asked.
    private async Task Pep(int holder, UploadDocumentsViewModel.DocHolder h)
    {
        if (!InvestorInfoViewModel.PepAsked(h)) return;
        <div class="cii-pep">
            @foreach (var (field, question) in InvestorInfoViewModel.PepQuestions)
            {
                var name = $"Holder{holder}.{field}";
                var answer = Model.Value(name);
                var missing = Model.PepMissing.Contains(name);
                <div class="cii-pep__row @(missing ? "is-invalid" : null)" id="pep-@name" tabindex="-1" role="radiogroup" aria-labelledby="pep-@(name)-q">
                    <span class="cii-pep__q" id="pep-@(name)-q">@question</span>
                    <div class="cii-pep__answers">
                        <label class="cii-pep__answer">YES <input type="radio" name="@name" value="yes" checked="@(answer == "yes")"></label>
                        <label class="cii-pep__answer">NO <input type="radio" name="@name" value="no" checked="@(answer == "no")"></label>
                    </div>
                    @if (missing)
                    {
                        <p class="csi-error cii-pep__error" role="alert">Choose Yes or No</p>
                    }
                </div>
            }
        </div>
        await Task.CompletedTask;
    }

    // "Would you like to add …?" with the link that adds it.
    private async Task Ask(string id, string question, string action, string label)
    {
        <section class="csi-card cii-ask" id="@id">
            <p class="cii-ask__q">@question</p>
            @{ await Post(action, null, "cii-add", $"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"></path></svg> {label}"); }
        </section>
    }
}

@* Once the investor's card head has scrolled off, this keeps who the step is for
   and which application it is in view, as Upload Documents does. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@Model.Docs.HolderName</span>
        <span class="cud-pin__pan">PAN @Model.Docs.HolderPan</span>
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @appNo
            <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="2" />

    <form class="csi-main" id="investorInfoForm" method="post" asp-action="Proceed" enctype="multipart/form-data" data-partial novalidate data-partial-focus="@Model.Focus">

        @if (banner is not null)
        {
            <div class="cud-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <span>@banner</span>
            </div>
        }

        @* ── The investor ─────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="holder-1">
            @* A holder who is a tax or permanent resident of another country invests
               offline: Proceed stops, and says so over the top of this card. *@
            <div class="cii-alert" id="ciiFatcaAlert" role="alert" tabindex="-1" hidden="@(!Model.Offline)">
                <svg class="cii-alert__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5L2.5 20h19z"></path><path d="M12 10v4.5"></path><circle cx="12" cy="17.3" r=".6" fill="currentColor"></circle></svg>
                <p class="cii-alert__text">@InvestorInfoViewModel.FatcaOffline</p>
                <button type="button" class="cii-alert__close btn-reset" data-cii-close="ciiFatcaAlert" aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="cii-head" data-pin-head>
                <h2 class="cii-title">Investor Details</h2>
                <span class="cii-app">Application No: <strong>@appNo</strong>
                    <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
                    </button>
                </span>
            </div>
            <div class="cii-record">
                <div class="inv-panel inv-ckyc">
                    <div class="inv-ckyc__photo">Photo<br />from CKYC</div>
                    <div style="flex:1;min-width:0">
                        <div class="inv-panel__label" style="padding-bottom:10px">From the CKYC record &middot; read-only</div>
                        <div class="inv-kv-grid">
                            <div class="inv-kv"><div class="inv-kv__k">Applicant Name</div><div class="inv-kv__v">R&bull;&bull;&bull;&bull;&bull;&bull; S&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull;</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">DOB</div><div class="inv-kv__v">10-06-1992</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Gender</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Father Name</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">PAN</div><div class="inv-kv__v">BISPM4465N</div></div>
                        </div>
                    </div>
                </div>

                <div class="inv-panel inv-panel--stack">
                    <div class="inv-section-head">
                        <div class="inv-panel__label" style="flex:1;min-width:0">Address &amp; proof of address &middot; from the documents on <a asp-controller="UploadDocuments" asp-action="Index" class="inv-step-link">Upload Documents</a></div>
                        <a class="inv-panel__action" asp-controller="UploadDocuments" asp-action="Index">Open documents</a>
                    </div>
                    <div class="inv-kv-grid">
                        <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Permanent address</div><div class="inv-kv__v">704 Kisan Vihar, M G Road, Maharashtra Nagar, Dombivli, Thane, Maharashtra 421202</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Permanent POA type</div><div class="inv-kv__v">Passport</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">POA reference number</div><div class="inv-kv__v">P4471882</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">POA expiry date</div><div class="inv-kv__v">11/2032</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v" style="color:var(--green)">Verified &middot; all seven fields</div></div>
                    </div>
                    @* Where the investor's post goes is answered on Upload Documents, with
                       the proof of any other address; it is shown here as it stands. *@
                    <div class="inv-kv-grid inv-kv-grid--divided">
                        @if (Model.Docs.MailDifferentOf(Model.Docs.Investor))
                        {
                            var mail = Model.Docs.MailReadOf(Model.Docs.Investor);
                            <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Communication address</div><div class="inv-kv__v">@mail.Lines</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Proof</div><div class="inv-kv__v">@(Model.Docs.MailTypeOf(Model.Docs.Investor) is { Length: > 0 } t ? t : "Not chosen yet")</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v">@mail.State</div></div>
                        }
                        else
                        {
                            <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Communication address</div><div class="inv-kv__v">Same as permanent</div></div>
                        }
                    </div>
                </div>

                <div class="inv-manual" id="h1-manual">
                    <div class="inv-section-head">
                        <div class="inv-manual__title">Two fields could not be read from this holder&rsquo;s documents</div>
                        <span class="inv-manual__badge">Manual entry</span>
                    </div>
                    <div class="inv-manual__text">OCR returned no gender and no parent or spouse name for the documents uploaded on <a asp-controller="UploadDocuments" asp-action="Index" style="font-weight:600">Upload Documents</a>. Type them exactly as printed &mdash; <span style="font-weight:600">what is typed here is cross-checked against the verify-with-source response</span> just as an extracted value would be. Only unread fields open for typing; everything OCR did read stays read-only above.</div>
                    <div class="inv-grid">
                        <div class="inv-field inv-field--sm">
                            <label for="h1-gender">Gender <span class="required">*</span></label>
                            <select id="h1-gender" name="Holder1.Gender" class="inv-control" required>
                                <option value="">Select</option>
                                @foreach (var g in new[] { "Male", "Female", "Transgender" }) { if (g == Model.Value("Holder1.Gender")) { <option selected>@g</option> } else { <option>@g</option> } }
                            </select>
                        </div>
                        <div class="inv-field inv-field--sm">
                            <label for="h1-nametype">Name type <span class="required">*</span></label>
                            <select id="h1-nametype" name="Holder1.NameType" class="inv-control inv-control--strong" required>
                                @foreach (var t in new[] { "Father", "Mother", "Spouse" }) { if (t == Model.Value("Holder1.NameType", "Father")) { <option selected>@t</option> } else { <option>@t</option> } }
                            </select>
                        </div>
                        <div class="inv-field inv-field--sm">
                            <label for="h1-parent">Father / Mother / Spouse name <span class="required">*</span></label>
                            <input id="h1-parent" name="Holder1.ParentName" class="inv-control" value="@Model.Value("Holder1.ParentName")" required />
                        </div>
                    </div>
                </div>
            </div>
            @{ await MoreInformation(1, lists, "Upto Rs.5,00,000", "Salaried", "MMFSL Employee", "Married", "8779712676", "TERSESHIVAPRASAD@ICLOUD.COM"); }
            @{ await Pep(1, Model.Docs.Investor); }
        </section>

        @* ── Joint holders, one at a time: the third only once the second is added ── *@
        @for (var i = 0; i < Model.State.Joint.Count; i++)
        {
            await JointHolder(i, lists);
        }
        @if (Model.CanAddJoint)
        {
            await Ask("ciiAddHolder", "Would you like to add Joint Account Holder?", "JointAdd", "Add Joint Holder");
        }

        @* ── The nominee, once for the application ────────────────────────── *@
        @if (!Model.State.Nominee)
        {
            await Ask("ciiAddNominee", "Would you like to add Nominee Details?", "NomineeAdd", "Add Nominee");
        }
        else
        {
            <section class="csi-card cii-card" id="nominee">
                <div class="cii-head">
                    <h2 class="cii-title">Nominee Details</h2>
                    @{ await Post("NomineeRemove", null, "inv-remove", $"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">{BinGlyph}</svg> Remove"); }
                </div>
                <div class="cud-grid">
                    <div class="cud-col">
                        <label class="csi-label" for="ciiNomName">Name</label>
                        <input class="csi-control" id="ciiNomName" name="Nominee.Name" value="@Model.Value("Nominee.Name")" autocomplete="off">
                    </div>
                    <div class="cud-col">
                        <span class="csi-label" id="ciiNomDobLabel">Date Of Birth</span>
                        <div class="csi-date" role="group" aria-labelledby="ciiNomDobLabel">
                            <input class="csi-date__part" name="Nominee.Dd" value="@Model.Value("Nominee.Dd")" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off">
                            <span class="csi-date__sep">/</span>
                            <input class="csi-date__part" name="Nominee.Mm" value="@Model.Value("Nominee.Mm")" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                            <span class="csi-date__sep">/</span>
                            <input class="csi-date__part csi-date__part--year" name="Nominee.Yyyy" value="@Model.Value("Nominee.Yyyy")" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                        </div>
                    </div>
                    @{ await Select("ciiNomRelation", "Nominee.Relation", "Relation with primary holder", relations); }
                </div>

                @* Only a minor nominee has a guardian. Shut, the fields are not posted, so
                   nothing typed for a guardian is kept against an adult nominee. The page
                   opens or shuts this as the date of birth is typed. *@
                <fieldset class="cii-guardian" id="ciiGuardian" data-cii-guardian hidden="@(!Model.NomineeMinor)" disabled="@(!Model.NomineeMinor)">
                <h3 class="cii-section">Guardian Details</h3>
                <p class="cii-note">The nominee is under @InvestorInfoViewModel.MinorUnder, so a guardian acts for them.</p>
                <div class="cud-grid">
                    <div class="cud-col">
                        <label class="csi-label" for="ciiNomGuardian">Guardian Name</label>
                        <input class="csi-control" id="ciiNomGuardian" name="Nominee.GuardianName" value="@Model.Value("Nominee.GuardianName")" autocomplete="off">
                    </div>
                </div>
                <div class="cud-grid">
                    <div class="cud-col"><label class="csi-label" for="ciiGdn1">Address Line 1</label><input class="csi-control" id="ciiGdn1" name="Nominee.GuardianAddress.Line1" value="@Model.Value("Nominee.GuardianAddress.Line1")"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdn2">Address Line 2 (Non-mandatory)</label><input class="csi-control" id="ciiGdn2" name="Nominee.GuardianAddress.Line2" value="@Model.Value("Nominee.GuardianAddress.Line2")"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdn3">Address Line 3 (Non-mandatory)</label><input class="csi-control" id="ciiGdn3" name="Nominee.GuardianAddress.Line3" value="@Model.Value("Nominee.GuardianAddress.Line3")"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdnPin">Pin Code</label><input class="csi-control" id="ciiGdnPin" name="Nominee.GuardianAddress.PinCode" value="@Model.Value("Nominee.GuardianAddress.PinCode")" inputmode="numeric" maxlength="6"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdnCity">City</label><input class="csi-control" id="ciiGdnCity" name="Nominee.GuardianAddress.City" value="@Model.Value("Nominee.GuardianAddress.City")"></div>
                </div>
                <p class="cii-note">District- , State-</p>
                </fieldset>
            </section>
        }

        @* Every joint holder's attempts, newest first, in one place at the foot of
           the page: the investor's are on Upload Documents. *@
        @{ var jointLog = Model.Docs.State.Log.Where(e => e.Holder is UnoTP.Backend.HolderType.Second or UnoTP.Backend.HolderType.Third).ToList(); }
        @if (jointLog.Count > 0)
        {
            <section class="csi-card cud-log" id="ciiLog">
                <h2 class="cud-extra__title">Joint holders&rsquo; upload, OCR and verification history</h2>
                <p class="cud-log__sub">Every attempt at a joint holder&rsquo;s document, newest first, each named with the holder it is for. Three copies of a document refused one after another and it goes to Operations; a copy the checks take clears the count. The investor&rsquo;s are on Upload Documents.</p>
                <partial name="_DocLog" model="@jointLog" />
            </section>
        }
    </form>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="UploadDocuments" asp-action="Index" data-loader="Going back to Upload Documents">Back</a>
        <p class="csi-bar__hint">Add any joint holders and the nominee, then proceed to <strong>Bank Details &amp; Payment</strong></p>
        <div class="csi-bar__right">
            <button type="submit" form="investorInfoForm" class="csi-link btn-reset" formaction="@Url.Action("Clear")" formnovalidate>Clear All</button>
            <button type="submit" form="investorInfoForm" class="csi-btn csi-btn--primary">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/partial-forms.js" asp-append-version="true"></script>
    <script src="~/js/classic-pin.js" asp-append-version="true"></script>
    <script>
        // A guardian is named only for a minor nominee: the section opens once the
        // date of birth typed makes them one, and shuts - its fields no longer
        // posted - once it does not. The server draws it the same way from what was
        // posted last.
        document.addEventListener('input', function (e) {
            var box = e.target.closest && e.target.closest('#nominee .csi-date');
            var guardian = document.getElementById('ciiGuardian');
            if (!box || !guardian) return;
            var part = function (n) { return box.querySelector('[name="Nominee.' + n + '"]').value; };
            var d = +part('Dd'), m = +part('Mm'), y = +part('Yyyy');
            var born = new Date(y, m - 1, d);
            var whole = part('Yyyy').length === 4 && y >= 1900 && born.getMonth() === m - 1 && born.getDate() === d;
            var today = new Date();
            var adult = new Date(y + @InvestorInfoViewModel.MinorUnder, m - 1, d);
            var minor = whole && born <= today && adult > today;
            guardian.hidden = !minor;
            guardian.disabled = !minor;
        });

        // The offline alert closes on its cross; Proceed with a FATCA Yes brings it back.
        document.addEventListener('click', function (e) {
            var close = e.target.closest && e.target.closest('[data-cii-close]');
            if (close) document.getElementById(close.dataset.ciiClose).hidden = true;
        });
    </script>
}

@model InvestorInfoViewModel
@{
    ViewData["Title"] = "Investor Information";

    // The old WA_FD_UNOTP/InvestorInformation: a card for the investor, one for each
    // joint holder added, and one for the nominee, down one column. The page is one
    // form, and every button posts all of it, so nothing typed is lost to a post
    // about something else (see InvestorInfoController).
    var lists = new Lists(
        ["Upto Rs.5,00,000", "Rs.5,00,000 - Rs.10,00,000", "Rs.10,00,000 - Rs.25,00,000", "Above Rs.25,00,000"],
        ["Salaried", "Self-employed", "Business", "Retired", "Homemaker", "Student"],
        ["MMFSL Employee", "Private sector", "Public sector", "Government service", "Professional"],
        ["Married", "Single", "Widowed", "Divorced"],
        ["Aadhaar", "Passport", "Driving Licence", "Voter ID", "Utility bill"]);
    var relations = new[] { "Son", "Daughter", "Spouse", "Father", "Mother", "Brother", "Sister" };
    const string appNo = "FBBMFL26F99AAC1";
    const string holderName = "R•••••• S•••••• T•••••";
}

@functions {
    // What the drop-downs offer, passed to the helpers below in one piece.
    private sealed record Lists(string[] Incomes, string[] Occupations, string[] SubOccupations, string[] Maritals, string[] Proofs);

    private const string UploadGlyph = "<path d=\"M12 15.5V4\"></path><path d=\"M7.5 8.5L12 4l4.5 4.5\"></path><path d=\"M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15\"></path>";

    private const string BinGlyph = "<path d=\"M6 7h12M9 7V5h6v2M8 7l1 13h6l1-13\"></path>";

    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    // A button that posts the page's form to one of the page's steps.
    private async Task Post(string action, object? route, string css, string label, string? loader = null)
    {
        <button type="submit" class="@css" formaction="@Url.Action(action, route)" formnovalidate data-loader="@loader">@Html.Raw(label)</button>
        await Task.CompletedTask;
    }

    // A labelled drop-down, as the classic steps draw one, holding what was posted.
    private async Task Select(string id, string name, string label, IEnumerable<string> options, string opening = "")
    {
        var selected = Model.Value(name, opening);
        <div class="cud-col">
            <label class="csi-label" for="@id">@label</label>
            <div class="cud-select">
                <select class="csi-control" id="@id" name="@name">
                    <option value="" selected="@(selected.Length == 0)">Select</option>
                    @foreach (var o in options)
                    {
                        <option selected="@(o == selected)">@o</option>
                    }
                </select>
            </div>
        </div>
        await Task.CompletedTask;
    }

    // A box a file is picked into.
    private async Task Drop(string id, string name, string title, string hint, string accept)
    {
        <label class="cud-drop" for="@id">
            <span class="cud-drop__idle">
                <span class="cud-drop__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(UploadGlyph)</svg></span>
                <span class="cud-drop__title">@title</span>
                <span class="cud-drop__hint">@hint</span>
            </span>
        </label>
        <input type="file" id="@id" name="@name" accept="@accept" hidden>
        await Task.CompletedTask;
    }

    // A proof of address and where post goes. An address other than the permanent
    // one is proved with a copy of its own, uploaded in the box that opens for it.
    private async Task Addresses(int holder, Lists lists)
    {
        var p = $"Holder{holder}";
        var id = $"cii{holder}";
        var different = Model.Value($"{p}.CommunicationAddress") == "Different from Permanent";
        <div class="cud-grid">
            @{ await Select($"{id}Poa", $"{p}.ProofOfAddress", "Proof of Address", lists.Proofs); }
            <div class="cud-col">
                <label class="csi-label" for="@(id)Comm">Communication Address</label>
                <div class="cud-select">
                    <select class="csi-control" id="@(id)Comm" name="@(p).CommunicationAddress" data-cii-comm="@(id)CommProof">
                        <option selected="@(!different)">Same as Permanent</option>
                        <option selected="@different">Different from Permanent</option>
                    </select>
                </div>
            </div>
            <div class="cud-col" id="@(id)CommProof" hidden="@(!different)">
                <span class="csi-label">Communication Address Proof</span>
                @{ await Drop($"{id}CommFile", $"{p}.CommunicationProof", "Click to upload", "Supported format: PDF/JPG/JPEG (max. 2 MB)", "application/pdf,image/jpeg"); }
            </div>
        </div>
    }

    // More Information and the FATCA answers, which every holder gives.
    private async Task MoreInformation(int holder, Lists lists, string income = "", string occupation = "", string sub = "", string marital = "", string mobile = "", string email = "")
    {
        var p = $"Holder{holder}";
        var id = $"cii{holder}";
        <h3 class="cii-section">More Information</h3>
        <div class="cud-grid">
            @{ await Select($"{id}Income", $"{p}.AnnualIncome", "Annual Income", lists.Incomes, income); }
            @{ await Select($"{id}Occupation", $"{p}.Occupation", "Occupation", lists.Occupations, occupation); }
            @{ await Select($"{id}SubOccupation", $"{p}.SubOccupation", "Sub Occupation", lists.SubOccupations, sub); }
            @{ await Select($"{id}Marital", $"{p}.MaritalStatus", "Marital Status", lists.Maritals, marital); }
            <div class="cud-col">
                <label class="csi-label" for="@(id)Mobile">Mobile Number</label>
                <input class="csi-control" id="@(id)Mobile" name="@(p).Mobile" value="@Model.Value($"{p}.Mobile", mobile)" inputmode="numeric" maxlength="10" autocomplete="off">
            </div>
            <div class="cud-col">
                <label class="csi-label" for="@(id)Email">E-Mail</label>
                <input class="csi-control csi-control--caps" id="@(id)Email" name="@(p).Email" value="@Model.Value($"{p}.Email", email)" type="email" autocomplete="off">
            </div>
        </div>

        <h3 class="cii-section">@(holder == 1 ? "Investor's" : "Holder's") FATCA Details</h3>
        <div class="cii-switches">
            <label class="inv-switch-row"><span>Are you/joint holder a tax resident of a country other than India?</span><input type="checkbox" class="inv-switch" name="@(p).FatcaTaxResident" checked="@Model.On($"{p}.FatcaTaxResident")"></label>
            <label class="inv-switch-row"><span>Are you/joint holder a permanent resident of a foreign country?</span><input type="checkbox" class="inv-switch" name="@(p).FatcaPermanentResident" checked="@Model.On($"{p}.FatcaPermanentResident")"></label>
        </div>
    }

    // A joint holder's card: Investor Identification's search, by PAN and date of
    // birth, and once they are identified, Continue to add them. Once added: the
    // record, the photograph, the addresses, More Information and FATCA.
    private async Task JointHolder(int index, Lists lists)
    {
        var holder = index + 2;
        var state = Model.State.Joint[index];
        var search = Model.Joint[index];
        var who = InvestorInfoViewModel.Ordinal(holder) + " Holder";
        <section class="csi-card cii-card" id="holder-@holder">
            <div class="cii-head">
                <h2 class="cii-title">@who Details</h2>
                <span class="csi-status @(state.Added ? "csi-status--ok" : null)">@(state.Added ? "Added" : search.Identified ? "Identified" : "Not identified")</span>
                @{ await Post("JointRemove", new { n = holder }, "inv-remove", $"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">{BinGlyph}</svg> Remove"); }
            </div>

            @if (Model.Unfinished == holder)
            {
                <div class="csi-gap csi-gap--alert cii-unfinished" role="alert">
                    <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                    <div class="csi-gap__body">
                        <div class="csi-gap__title">This holder is not added yet</div>
                        <p>Identify the @who.ToLowerInvariant() and press Continue to add them &mdash; or remove them &mdash; before you proceed.</p>
                    </div>
                </div>
            }

            <div class="cii-identify">
                <partial name="_HolderIdentification" model="@(new HolderIdentificationBlock(search, $"j{holder}", step => Url.Action("Joint" + step, new { n = holder })!, Prefix: $"Joint{holder}.", FolioSearch: false, NameRetry: false, Locked: state.Added))" />
            </div>

            @if (!state.Added && search.Identified)
            {
                <div class="cii-actions">
                    @{ await Post("JointContinue", new { n = holder }, "csi-btn csi-btn--primary", "Continue", $"Adding the {who.ToLowerInvariant()}…"); }
                </div>
            }

            @if (state.Added)
            {
                <div class="cud-grid">
                    <div class="cud-col">
                        <span class="csi-label">@who&rsquo;s Photo</span>
                        @{ await Drop($"cii{holder}Photo", $"Holder{holder}.Photo", "Click to upload photograph", "Supported format: JPG/JPEG (max. 2 MB)", "image/jpeg"); }
                    </div>
                </div>
                await Addresses(holder, lists);
                await MoreInformation(holder, lists);
            }
        </section>
    }

    // "Would you like to add …?" with the link that adds it.
    private async Task Ask(string id, string question, string action, string label)
    {
        <section class="csi-card cii-ask" id="@id">
            <p class="cii-ask__q">@question</p>
            @{ await Post(action, null, "cii-add", $"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"></path></svg> {label}"); }
        </section>
    }
}

@* Once the investor's card head has scrolled off, this keeps who the step is for
   and which application it is in view, as Upload Documents does. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@holderName</span>
        <span class="cud-pin__pan">PAN BISPM&bull;&bull;&bull;&bull;N</span>
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @appNo
            <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="2" />

    <form class="csi-main" id="investorInfoForm" method="post" asp-action="Proceed" enctype="multipart/form-data" data-partial novalidate data-partial-focus="@Model.Focus">

        @* ── The investor ─────────────────────────────────────────────────── *@
        <section class="csi-card cii-card" id="holder-1">
            @* A holder who is a tax or permanent resident of another country invests
               offline: Proceed stops, and says so over the top of this card. *@
            <div class="cii-alert" id="ciiFatcaAlert" role="alert" tabindex="-1" hidden="@(!Model.Offline)">
                <svg class="cii-alert__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5L2.5 20h19z"></path><path d="M12 10v4.5"></path><circle cx="12" cy="17.3" r=".6" fill="currentColor"></circle></svg>
                <p class="cii-alert__text">@InvestorInfoViewModel.FatcaOffline</p>
                <button type="button" class="cii-alert__close btn-reset" data-cii-close="ciiFatcaAlert" aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
                </button>
            </div>
            <div class="cii-head" data-pin-head>
                <h2 class="cii-title">Investor Details</h2>
                <span class="cii-app">Application No: <strong>@appNo</strong>
                    <button type="button" class="cud-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
                    </button>
                </span>
            </div>
            <div class="cii-record">
                <div class="inv-panel inv-ckyc">
                    <div class="inv-ckyc__photo">Photo<br />from CKYC</div>
                    <div style="flex:1;min-width:0">
                        <div class="inv-panel__label" style="padding-bottom:10px">From the CKYC record &middot; read-only</div>
                        <div class="inv-kv-grid">
                            <div class="inv-kv"><div class="inv-kv__k">Applicant Name</div><div class="inv-kv__v">R&bull;&bull;&bull;&bull;&bull;&bull; S&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull;</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">DOB</div><div class="inv-kv__v">10-06-1992</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Gender</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">Father Name</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                            <div class="inv-kv"><div class="inv-kv__k">PAN</div><div class="inv-kv__v">BISPM4465N</div></div>
                        </div>
                    </div>
                </div>

                <div class="inv-panel inv-panel--stack">
                    <div class="inv-section-head">
                        <div class="inv-panel__label" style="flex:1;min-width:0">Address &amp; proof of address &middot; from the documents on <a asp-controller="UploadDocuments" asp-action="Index" class="inv-step-link">Upload Documents</a></div>
                        <a class="inv-panel__action" asp-controller="UploadDocuments" asp-action="Index">Open documents</a>
                    </div>
                    <div class="inv-kv-grid">
                        <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Permanent address</div><div class="inv-kv__v">704 Kisan Vihar, M G Road, Maharashtra Nagar, Dombivli, Thane, Maharashtra 421202</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Permanent POA type</div><div class="inv-kv__v">Passport</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">POA reference number</div><div class="inv-kv__v">P4471882</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">POA expiry date</div><div class="inv-kv__v">11/2032</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v" style="color:var(--green)">Verified &middot; all seven fields</div></div>
                    </div>
                    <div class="inv-kv-grid inv-kv-grid--divided">
                        <div class="inv-kv inv-kv--wide"><div class="inv-kv__k">Mailing address</div><div class="inv-kv__v">14 Sai Chambers, Andheri East, Mumbai 400069</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Mailing POA type</div><div class="inv-kv__v">Voter ID</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">POA reference number</div><div class="inv-kv__v">ABX4471093</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">POA expiry date</div><div class="inv-kv__v">No expiry</div></div>
                        <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v" style="color:var(--green)">Verified &middot; all seven fields</div></div>
                    </div>
                    <div class="inv-panel__note">This holder answered Yes to a differing mailing address, so a second proof of address was filed on Upload Documents. Both proofs passed verification there &mdash; reference numbers and expiry dates were read off them by OCR and cross-checked against the source, and cannot be typed here.</div>
                </div>

                <div class="inv-manual" id="h1-manual">
                    <div class="inv-section-head">
                        <div class="inv-manual__title">Two fields could not be read from this holder&rsquo;s documents</div>
                        <span class="inv-manual__badge">Manual entry</span>
                    </div>
                    <div class="inv-manual__text">OCR returned no gender and no parent or spouse name for the documents uploaded on <a asp-controller="UploadDocuments" asp-action="Index" style="font-weight:600">Upload Documents</a>. Type them exactly as printed &mdash; <span style="font-weight:600">what is typed here is cross-checked against the verify-with-source response</span> just as an extracted value would be. Only unread fields open for typing; everything OCR did read stays read-only above.</div>
                    <div class="inv-grid">
                        <div class="inv-field inv-field--sm">
                            <label for="h1-gender">Gender <span class="required">*</span></label>
                            <select id="h1-gender" name="Holder1.Gender" class="inv-control" required>
                                <option value="">Select</option>
                                @foreach (var g in new[] { "Male", "Female", "Transgender" }) { if (g == Model.Value("Holder1.Gender")) { <option selected>@g</option> } else { <option>@g</option> } }
                            </select>
                        </div>
                        <div class="inv-field inv-field--sm">
                            <label for="h1-nametype">Name type <span class="required">*</span></label>
                            <select id="h1-nametype" name="Holder1.NameType" class="inv-control inv-control--strong" required>
                                @foreach (var t in new[] { "Father", "Mother", "Spouse" }) { if (t == Model.Value("Holder1.NameType", "Father")) { <option selected>@t</option> } else { <option>@t</option> } }
                            </select>
                        </div>
                        <div class="inv-field inv-field--sm">
                            <label for="h1-parent">Father / Mother / Spouse name <span class="required">*</span></label>
                            <input id="h1-parent" name="Holder1.ParentName" class="inv-control" value="@Model.Value("Holder1.ParentName")" required />
                        </div>
                    </div>
                </div>
            </div>
            @{ await MoreInformation(1, lists, "Upto Rs.5,00,000", "Salaried", "MMFSL Employee", "Married", "8779712676", "TERSESHIVAPRASAD@ICLOUD.COM"); }
        </section>

        @* ── Joint holders, one at a time: the third only once the second is added ── *@
        @for (var i = 0; i < Model.State.Joint.Count; i++)
        {
            await JointHolder(i, lists);
        }
        @if (Model.CanAddJoint)
        {
            await Ask("ciiAddHolder", "Would you like to add Joint Account Holder?", "JointAdd", "Add Joint Holder");
        }

        @* ── The nominee, once for the application ────────────────────────── *@
        @if (!Model.State.Nominee)
        {
            await Ask("ciiAddNominee", "Would you like to add Nominee Details?", "NomineeAdd", "Add Nominee");
        }
        else
        {
            <section class="csi-card cii-card" id="nominee">
                <div class="cii-head">
                    <h2 class="cii-title">Nominee Details</h2>
                    @{ await Post("NomineeRemove", null, "inv-remove", $"<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" aria-hidden=\"true\">{BinGlyph}</svg> Remove"); }
                </div>
                <div class="cud-grid">
                    <div class="cud-col">
                        <label class="csi-label" for="ciiNomName">Name</label>
                        <input class="csi-control" id="ciiNomName" name="Nominee.Name" value="@Model.Value("Nominee.Name")" autocomplete="off">
                    </div>
                    <div class="cud-col">
                        <span class="csi-label" id="ciiNomDobLabel">Date Of Birth</span>
                        <div class="csi-date" role="group" aria-labelledby="ciiNomDobLabel">
                            <input class="csi-date__part" name="Nominee.Dd" value="@Model.Value("Nominee.Dd")" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off">
                            <span class="csi-date__sep">/</span>
                            <input class="csi-date__part" name="Nominee.Mm" value="@Model.Value("Nominee.Mm")" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                            <span class="csi-date__sep">/</span>
                            <input class="csi-date__part csi-date__part--year" name="Nominee.Yyyy" value="@Model.Value("Nominee.Yyyy")" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                        </div>
                    </div>
                    @{ await Select("ciiNomRelation", "Nominee.Relation", "Relation with primary holder", relations); }
                    <div class="cud-col">
                        <label class="csi-label" for="ciiNomGuardian">Guardian Name</label>
                        <input class="csi-control" id="ciiNomGuardian" name="Nominee.GuardianName" value="@Model.Value("Nominee.GuardianName")" autocomplete="off">
                    </div>
                </div>

                <h3 class="cii-section">Guardian Address Details</h3>
                <div class="cud-grid">
                    <div class="cud-col"><label class="csi-label" for="ciiGdn1">Address Line 1</label><input class="csi-control" id="ciiGdn1" name="Nominee.GuardianAddress.Line1" value="@Model.Value("Nominee.GuardianAddress.Line1")"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdn2">Address Line 2 (Non-mandatory)</label><input class="csi-control" id="ciiGdn2" name="Nominee.GuardianAddress.Line2" value="@Model.Value("Nominee.GuardianAddress.Line2")"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdn3">Address Line 3 (Non-mandatory)</label><input class="csi-control" id="ciiGdn3" name="Nominee.GuardianAddress.Line3" value="@Model.Value("Nominee.GuardianAddress.Line3")"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdnPin">Pin Code</label><input class="csi-control" id="ciiGdnPin" name="Nominee.GuardianAddress.PinCode" value="@Model.Value("Nominee.GuardianAddress.PinCode")" inputmode="numeric" maxlength="6"></div>
                    <div class="cud-col"><label class="csi-label" for="ciiGdnCity">City</label><input class="csi-control" id="ciiGdnCity" name="Nominee.GuardianAddress.City" value="@Model.Value("Nominee.GuardianAddress.City")"></div>
                </div>
                <p class="cii-note">District- , State-</p>
            </section>
        }
    </form>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="UploadDocuments" asp-action="Index" data-loader="Going back to Upload Documents">Back</a>
        <p class="csi-bar__hint">Add any joint holders and the nominee, then proceed to <strong>Bank Details &amp; Payment</strong></p>
        <div class="csi-bar__right">
            <button type="submit" form="investorInfoForm" class="csi-link btn-reset" formaction="@Url.Action("Clear")" formnovalidate>Clear All</button>
            <button type="submit" form="investorInfoForm" class="csi-btn csi-btn--primary">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/partial-forms.js" asp-append-version="true"></script>
    <script src="~/js/classic-pin.js" asp-append-version="true"></script>
    <script>
        // A communication address other than the permanent one needs its own proof:
        // the box for it opens as soon as that is chosen. Delegated, so it still
        // works after partial-forms.js redraws the page.
        document.addEventListener('change', function (e) {
            var select = e.target.closest && e.target.closest('[data-cii-comm]');
            if (!select) return;
            document.getElementById(select.dataset.ciiComm).hidden = select.value !== 'Different from Permanent';
        });

        // The offline alert closes on its cross; Proceed with a FATCA Yes brings it back.
        document.addEventListener('click', function (e) {
            var close = e.target.closest && e.target.closest('[data-cii-close]');
            if (close) document.getElementById(close.dataset.ciiClose).hidden = true;
        });
    </script>
}

@model NewApplicationViewModel
@using Stage = UnoTP.ViewModels.NewApplicationViewModel.Stage
@{
    ViewData["Title"] = "Investor Identification";
    ViewData["BackToDashboard"] = true;

    // The old WA_FD_UNOTP/searchinvestor, carrying the new Investor Identification
    // screen's working parts. No script: every step is a form the controller
    // answers, and what it found is written into the page.
}

@* Nothing typed travels in an address or a hidden field: every form below posts
   to the controller, which keeps the search in the session and redirects back to
   the bare page. *@

<div class="page-layout">
    <partial name="_ClassicSteps" model="0" />

    <div class="page-main">
    <section class="page-card section-card">
        <div class="page-head"><h1 class="page-title">Enter Basic Information</h1></div>

        @* What the partner is told before anything is searched, across the card as
           the later steps give their notes. *@
        <div class="alert alert-warning page-warning-note">
            <svg class="page-warning-note__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
            <div class="page-warning-note__body">
                <div class="page-warning-note__title">Note</div>
                <ul>
                    @foreach (var n in (await Lookups.ReferenceAsync()).IdentificationNotes)
                    {
                        <li>@n</li>
                    }
                </ul>
            </div>
        </div>

        <section class="identify-holder">
            <div class="identify-holder__head">
                <span class="identify-holder__no">1</span>
                <span class="identify-holder__name">Investor</span>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">Primary holder</span>
                <span class="identify-status @(Model.CanProceed ? "identify-status--ok" : null)">@(Model.Identified ? "Identified" : Model.CanProceed ? "New investor" : "Not identified")</span>
            </div>

            <partial name="_HolderIdentification" model="@(new HolderIdentificationBlock(Model, "csi", step => Url.Action(step)!,
                NewPanNote: "No folio against this PAN: a new application opens, and the PAN copy is checked with NSDL on Upload Documents."))" />
        </section>
    </section>

    @* Only the partner's own applications, opened here and not yet submitted. *@
    <section class="page-card section-card">
        <div class="drafts__head"><h2 class="page-title drafts__title">Continue an application @if (Model.Drafts.Count > 0) { <span class="drafts__count">@Model.Drafts.Count</span> }</h2></div>
        @if (Model.Drafts.Count == 0)
        {
            <p class="page-note">No application is waiting to be finished. One opened below and left before it is submitted is listed here, kept for @((await Lookups.ConfigAsync()).DraftDays) days.</p>
        }
        else
        {
        <partial name="_Drafts" model="@(new DraftsBlock(Model.Drafts, Model.Drafts.Count, Partial: true))" />
        }
    </section>

    @if (Model.Demo is { } demo)
    {
    <section class="demo-data">
        <div class="demo-data__head">
            <h2 class="demo-data__title">Test data</h2>
            <p class="demo-data__sub">@demo.Cases.Count cases, and what each one does &middot; test records only &middot; every date of birth on record is <strong>@Dates.Show(demo.Dob)</strong></p>
        </div>
        <table class="demo-data__table">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">Case</span></th>
                    <th scope="col">PAN</th>
                    <th scope="col">Date of birth</th>
                    <th scope="col">Folio</th>
                    <th scope="col">What happens</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < demo.Cases.Count; i++)
                {
                    var c = demo.Cases[i];
                    <tr>
                        <td data-label="Case"><span class="demo-data__no">@(i + 1)</span></td>
                        <td data-label="PAN"><code>@c.Pan</code></td>
                        <td data-label="Date of birth">
                            @if (c.Dob.Length > 0) { @Dates.Show(c.Dob) }
                            else { <span class="demo-data__none">not on record</span> }
                        </td>
                        <td data-label="Folio">
                            @if (c.Folios.Count == 0) { <span class="demo-data__none">no folio</span> }
                            @foreach (var f in c.Folios) { <code>@f</code> }
                        </td>
                        <td data-label="What happens">@c.Shows</td>
                    </tr>
                }
            </tbody>
        </table>
        <ul class="demo-data__notes">
            @foreach (var note in demo.Notes) { <li>@note</li> }
        </ul>
    </section>
    }
    </div>
</div>

@* Proceed re-checks everything on the server and opens the application. *@
<form id="pageProceedForm" method="post" asp-action="Proceed" data-partial hidden></form>
<form id="pageClearForm" method="post" asp-action="Clear" data-partial hidden></form>

<footer class="page-action-bar">
    <div class="page-action-bar__inner">
        <a class="btn btn-outline-primary" asp-controller="Dashboard" asp-action="Index"
           data-loader="Going back to the dashboard">Back</a>
        <p class="page-action-bar__hint">
            @if (Model.Identified)
            {
                @:Investor identified &mdash; <strong>ready to proceed</strong>
            }
            else if (Model.CanProceed)
            {
                @:New investor &mdash; <strong>the PAN copy is uploaded and checked next</strong>
            }
            else
            {
                @:Identify the investor to continue &mdash; <strong>check the record once the fields are filled</strong>
            }
        </p>
        <div class="page-action-bar__right">
            <button type="submit" class="link-button btn-reset" form="pageClearForm">Clear All</button>
            <button type="submit" class="btn btn-primary" form="pageProceedForm" disabled="@(!Model.CanProceed)"
                    data-loader="Opening Upload Documents…">Proceed</button>
        </div>
    </div>
</footer>

@* Every form and link above posts or fetches without the page reloading. *@

@section Styles {
    <link rel="stylesheet" href="~/css/pages/new.css" asp-append-version="true" />
}

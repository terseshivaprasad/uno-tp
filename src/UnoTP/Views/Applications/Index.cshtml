@model ApplicationsViewModel
@{
    ViewData["Title"] = "View Application";
    ViewData["BackToDashboard"] = true;

    // The old WA_FD_UNOTP/ViewApplication screen: one Application Number box and
    // a Proceed button, which showed nothing until you already knew the number.
    // This one opens on the last fourteen days of applications - every one still
    // in flight - and keeps the search for reaching a particular application, or
    // everything under one folio.
    var earliest = Model.Earliest;
    var today = ApplicationsViewModel.Today;
    var listed = Model.Listed.ToList();
    var all = listed.Concat(Model.Older).ToList();
    var open = listed.Count(r => r.State is "progress" or "awaiting");
}

<div class="page-layout page-layout--wide">
    <aside class="page-rail page-rail--steps">
        <h2 class="page-rail__title">What this screen shows</h2>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 6.5V12l3.5 2.5"></path></svg>
            <div>
                <div class="page-rail__note-title">The last @Model.WindowDays days</div>
                <p>An unpaid application cancels itself after @Model.WindowDays days, so everything still in flight was raised inside that window.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M16.5 16.5l4 4"></path></svg>
            <div>
                <div class="page-rail__note-title">By application or by folio</div>
                <p>An application number finds one application. A folio finds every application that investor has, however old.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path><circle cx="12" cy="12" r="2.8"></circle></svg>
            <div>
                <div class="page-rail__note-title">Looking, not editing</div>
                <p>Every value here is read-only. An application that still needs work is picked up from the dashboard.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
            <div>
                <div class="page-rail__note-title">Masked identifiers</div>
                <p>A holder's PAN keeps its first five and last character. Nothing on this screen shows one in full.</p>
            </div>
        </div>
    </aside>

    <div class="page-card">
        <div class="page-head"><h1 class="page-title">View Application</h1></div>
        <p class="page-note">Every application raised in the last @Model.WindowDays days. @listed.Count listed, @(open == 1 ? "one of them is" : $"{open} of them are") still waiting on someone. Search by number or folio to reach an older one.</p>

        <form class="payin-slip-form" id="viewAppForm" novalidate>
            <fieldset class="search-by search-by--first">
                <legend class="field-label">Search By</legend>
                <label class="radio-option">
                    <input type="radio" name="viewAppSearchBy" value="dates" checked>
                    <span>Application date</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="viewAppSearchBy" value="appno">
                    <span>Application number</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="viewAppSearchBy" value="folio">
                    <span>Folio number</span>
                </label>
            </fieldset>

            <div class="payin-slip-form__row payin-slip-form__row--search">
                <div class="form-field" data-for="dates">
                    <span class="field-label" id="viewAppFromLabel">From Date</span>
                    @* The three-box control the old wizard steps use. *@
                    <div class="date-input" data-date id="viewAppFrom" role="group" aria-labelledby="viewAppFromLabel">
                        <input class="date-input__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" value="@earliest.ToString("dd")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off" value="@earliest.ToString("MM")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part date-input__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off" value="@earliest.ToString("yyyy")">
                    </div>
                </div>

                <div class="form-field" data-for="dates">
                    <span class="field-label" id="viewAppToLabel">To Date</span>
                    <div class="date-input" data-date id="viewAppTo" role="group" aria-labelledby="viewAppToLabel">
                        <input class="date-input__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" value="@today.ToString("dd")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off" value="@today.ToString("MM")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part date-input__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off" value="@today.ToString("yyyy")">
                    </div>
                </div>

                <div class="form-field payin-slip-field--appno" data-for="appno" hidden>
                    <label class="field-label" for="viewAppAppNo">Application Number</label>
                    <input class="field-input" id="viewAppAppNo" data-chars="code" maxlength="18" autocomplete="off" spellcheck="false" placeholder="e.g. FBBMFL26F10000">
                </div>

                <div class="form-field payin-slip-field--appno" data-for="folio" hidden>
                    <label class="field-label" for="viewAppFolio">Folio Number</label>
                    <input class="field-input" id="viewAppFolio" data-chars="code" maxlength="12" autocomplete="off" spellcheck="false" placeholder="e.g. MF0040000">
                </div>

                <div class="form-field form-field--check payin-slip-field--actions">
                    <button type="submit" class="btn btn-primary payin-slip-btn--search">Search</button>
                    <button type="button" class="btn btn-outline-primary" id="viewAppClear">Clear</button>
                </div>
            </div>

            <p class="field-error" id="viewAppError" hidden></p>
            <p class="field-hint" id="viewAppScope">Showing the last @Model.WindowDays days &mdash; @earliest.ToString("dd/MM/yyyy") to @today.ToString("dd/MM/yyyy").</p>
        </form>

        <p class="alert alert-secondary view-app-scope-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
            <span><strong>A date search reaches back @Model.WindowDays days</strong> &mdash; an older application has booked or cancelled itself. Search by number to reach one, or by folio for everything an investor has. A new customer has no folio until their first deposit books.</span>
        </p>

        <div class="register-filters">
            <div class="register-pills" role="group" aria-label="Filter by status">
                <button type="button" class="register-pill register-pill--on" data-state="all">All <span class="register-pill__number" data-count="all"></span></button>
                @foreach (var st in ApplicationsViewModel.States)
                {
                    <button type="button" class="register-pill" data-state="@st.Key">@st.Label <span class="register-pill__number" data-count="@st.Key"></span></button>
                }
            </div>
            <label class="register-search">
                <span class="visually-hidden">Filter the listed applications</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
                <input type="search" id="viewAppFilter" maxlength="50" placeholder="Narrow by investor, scheme or amount" autocomplete="off">
            </label>
        </div>

        <table class="register-table view-app-table">
            <colgroup>
                <col style="width:16%"><col style="width:12%"><col style="width:11%"><col style="width:10%">
                <col style="width:14%"><col style="width:9%"><col style="width:17%"><col style="width:11%">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Application</th>
                    <th scope="col">Investor</th>
                    <th scope="col">Folio</th>
                    <th scope="col" class="payin-slip-table__amount">Amount</th>
                    <th scope="col">Deposit</th>
                    <th scope="col">Applied</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="register-table__actions"><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody id="viewAppRows">
                @* The older applications are in the table but never listed: only a
                   search by number or folio reaches them. *@
                @foreach (var r in all)
                {
                    <tr data-state="@r.State" data-appno="@r.AppNo.ToLowerInvariant()" data-folio="@(r.Folio?.ToLowerInvariant() ?? "")"
                        data-date="@r.Applied.ToString("yyyy-MM-dd")" data-window="@(r.InWindow ? "in" : "out")"
                        data-search="@($"{r.AppNo} {r.Investor} {r.Folio} {r.Scheme} {r.Tenure} {ApplicationsViewModel.Rupees(r.Amount)} {r.Status.Label}".ToLowerInvariant())"
                        hidden="@(!r.InWindow)">
                        <td data-label="Application">
                            <strong>@r.AppNo</strong>
                            <div class="register-table__sub@(r.Urgent ? " register-table__sub--urgent" : "")">@r.Countdown</div>
                        </td>
                        <td data-label="Investor">
                            @r.Investor
                            <div class="register-table__sub">@(r.Holders == 1 ? "single holder" : $"{r.Holders} holders")</div>
                        </td>
                        <td data-label="Folio">
                            @r.FolioLabel
                            <div class="register-table__sub">@r.FolioNote</div>
                        </td>
                        <td data-label="Amount" class="payin-slip-table__amount">@ApplicationsViewModel.Rupees(r.Amount)</td>
                        <td data-label="Deposit">
                            @r.Scheme
                            <div class="register-table__sub">@r.Tenure &middot; @r.Payout.ToLowerInvariant()</div>
                        </td>
                        <td data-label="Applied">@r.Applied.ToString("dd/MM/yyyy")</td>
                        <td data-label="Status">
                            <span class="@Tones.Badge(r.Status.Tone)">@r.Status.Text</span>
                            <div class="register-table__sub">@r.Waiting</div>
                        </td>
                        <td class="register-table__actions">
                            <button type="button" class="link-button" data-view="@r.AppNo">View</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="register-empty" id="viewAppEmpty" hidden></p>

        <div class="register-pager">
            <p class="register-pager__count" id="viewAppCount"></p>
            <div class="register-pager__nav">
                <button type="button" class="register-page register-page--step" id="viewAppPrev" aria-label="Previous page">&lsaquo;</button>
                <div class="register-pager__pages" id="viewAppPages"></div>
                <button type="button" class="register-page register-page--step" id="viewAppNext" aria-label="Next page">&rsaquo;</button>
            </div>
        </div>
    </div>
</div>

@* One read-only sheet per application, kept out of the page until the dialog
   takes a copy of it. Building them here keeps every value the row's own. *@
<div hidden id="viewAppSheets">
    @foreach (var r in all)
    {
        <section data-sheet="@r.AppNo" data-title="@r.AppNo" data-sub="@r.Investor &middot; @r.Status.Text &middot; raised @r.Applied.ToString("dd/MM/yyyy")">
            <div class="view-app-sheet__grid">
                <div class="view-app-key-value"><div class="view-app-key-value__key">Status</div><div class="view-app-key-value__value @r.Status.Tone">@r.Status.Text</div><div class="view-app-key-value__note">@r.Waiting</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Came in as</div><div class="view-app-key-value__value"><span class="badge @(r.Digital ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">@r.Tag</span></div><div class="view-app-key-value__note">@(r.Digital ? "accepted online by the investor" : "signed form on file")</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Folio</div><div class="view-app-key-value__value">@r.FolioLabel</div><div class="view-app-key-value__note">@r.FolioNote</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Investor</div><div class="view-app-key-value__value">@r.Investor</div><div class="view-app-key-value__note">@(r.Holders == 1 ? "single holder" : $"{r.Holders} holders")</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">PAN</div><div class="view-app-key-value__value">@r.Pan</div><div class="view-app-key-value__note">first holder &middot; masked</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Applied</div><div class="view-app-key-value__value">@r.Applied.ToString("dd/MM/yyyy")</div><div class="view-app-key-value__note">@r.Countdown</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Amount</div><div class="view-app-key-value__value view-app-key-value__value--lg">@ApplicationsViewModel.Rupees(r.Amount)</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Scheme</div><div class="view-app-key-value__value">@r.Scheme</div><div class="view-app-key-value__note">interest @r.Payout.ToLowerInvariant()</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Tenure</div><div class="view-app-key-value__value">@r.Tenure</div><div class="view-app-key-value__note">@(r.State == "booked" ? $"matures {r.Maturity:dd/MM/yyyy}" : $"would mature {r.Maturity:dd/MM/yyyy}")</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">Payment</div><div class="view-app-key-value__value">@r.Instrument</div><div class="view-app-key-value__note">@(r.Instrument == "Net banking" ? "paid online" : r.Branch)</div></div>
                <div class="view-app-key-value"><div class="view-app-key-value__key">FDR</div><div class="view-app-key-value__value">@(r.Fdr ?? "—")</div><div class="view-app-key-value__note">@(r.Fdr is null ? "issued once the deposit books" : "issued")</div></div>
            </div>

            <h3 class="view-app-sheet__head">Status</h3>
            @* Every stage from entry to the FDR, in order, the same list for every
               application: one it does not go through stands greyed with the reason. *@
            <ol class="view-app-steps">
                @foreach (var m in r.Timeline)
                {
                    var tone = m.Failed ? "view-app-step--failed" : m.Done ? "view-app-step--done" : !m.Applies ? "view-app-step--na" : "view-app-step--pending";
                    <li class="view-app-step @tone">
                        <span class="view-app-step__text">
                            <span class="view-app-step__label">@m.Label</span>
                            @if (m.Note is not null)
                            {
                                <span class="view-app-step__note">@m.Note</span>
                            }
                        </span>
                        <span class="view-app-step__when">@m.When</span>
                    </li>
                }
            </ol>
        </section>
    }
</div>

<div class="modal-overlay" id="viewAppModal" hidden>
    <div class="app-dialog view-app-sheet" role="dialog" aria-modal="true" aria-labelledby="viewAppModalTitle">
        <header class="app-dialog__head">
            <div>
                <h2 class="app-dialog__title" id="viewAppModalTitle"></h2>
                <p class="app-dialog__sub" id="viewAppModalSub"></p>
            </div>
            <button type="button" class="btn-close app-dialog__close" id="viewAppModalClose" aria-label="Close"></button>
        </header>

        <div class="view-app-sheet__body" id="viewAppModalBody" tabindex="0"></div>

        <footer class="app-dialog__foot">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".6" fill="currentColor"></circle></svg>
            <span>This view is read-only. An application that still needs work is picked up from the dashboard, where it opens on the step it stopped at.</span>
        </footer>
    </div>
</div>

<div class="app-toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/pages/applications.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/applications.css" asp-append-version="true" />
}

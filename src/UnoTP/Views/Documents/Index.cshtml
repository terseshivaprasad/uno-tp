@model DocumentsViewModel
@{
    ViewData["Title"] = "Upload Documents";

    var state = Model.State;
    var flash = Model.Shown;
    var isPhysical = state.AppType == DocumentsViewModel.Physical;
    var uploadUrl = Url.Action("Upload")!;
    var nextSlotKey = Model.NextSlot();
    var stillToDo = Model.Outstanding();

    // The document cards.
    var panSlot = Model.View(DocumentsViewModel.PanSlot);
    var photoSlot = Model.View(DocumentsViewModel.PhotoSlot);
    var poaSlot = Model.View(DocumentsViewModel.PoaSlot);
    var mailSlot = Model.View(DocumentsViewModel.MailSlot);
    var paymentSlot = Model.View(DocumentsViewModel.PaymentSlot);
    var employeeProofSlot = Model.View(DocumentsViewModel.EmpProofSlot);
    var poaUsed = poaSlot.Used;
    var mailUsed = mailSlot.Used;

    // What the PAN was checked with, and where a name typed for NSDL posts.
    var panReads = new ReadCardsBlock(Model.PanReadsOf(Model.Investor), Url.Action("Nsdl"));

    // The communication address: whether it may differ from the permanent one, and whether
    // its proof's card can be switched in place (only while nothing is filed there).
    var mailDifferent = Model.MailDifferentOf(Model.Investor);
    var mailCanDiffer = Model.MailCanDiffer(Model.Investor);
    var mailSwitchesInPlace = mailCanDiffer && mailSlot.Doc is null;

    // Sourcing. Agency type 1033 chooses the mode, the code and the category; anyone else
    // sources as a broker under their own code.
    var partnerChoosesSourcing = Model.Chooses;
    var sourcingMode = Model.ModeOf(state.Sourcing);
    var sourceRegister = DocumentsViewModel.RegisterName(sourcingMode, sub: false);
    var subRegister = DocumentsViewModel.RegisterName(sourcingMode, sub: true);
    var registerSearchUrl = Url.Action("Sourcing");
    var sourceCodeDisabled = !partnerChoosesSourcing || sourcingMode is null || sourcingMode.House.Length > 0;
    var subBrokerDisabled = sourcingMode is null
        || sourcingMode.Sub is DocumentsViewModel.SubField.House or DocumentsViewModel.SubField.Shut or DocumentsViewModel.SubField.EmployeeShut;
    var subBrokerRequired = sourcingMode is not null && DocumentsViewModel.SubRequired(sourcingMode);
    var sourceCodeName = Model.Resolved(sourcingMode, sub: false);
    var subBrokerName = Model.Resolved(sourcingMode, sub: true);
    var sourceCodeLabel = sourcingMode?.CodeLabel ?? "Broker Code";
    var sourceNameLabel = sourcingMode?.NameLabel ?? "Broker Name";

    IReadOnlyList<string> categories = [state.Category];
    if (partnerChoosesSourcing) categories = sourcingMode?.Categories ?? [];

    var isEmployeeCategory = Model.IsEmployee(state.Category);
    var employeeName = Model.StaffName(state.EmpCode);

    (string Value, string Label)[] mailingOptions = [("same", "Same as Permanent"), ("different", "Different from Permanent")];
}
@* Upload Documents: the documents across the top, the payment's instrument under them,
   and the details the application is sourced under. Every change posts the form and the
   controller answers; partial-forms.js swaps the answer in without a reload, and without
   a script the same forms post the ordinary way. *@

@functions {
#pragma warning disable CS1998 // Razor makes these helpers async; there is nothing to await in them.

    // The error message a field's last post left, or nothing.
    async Task FieldError(string key)
    {
        var message = Model.Shown?.Errors.GetValueOrDefault(key);
        if (message is not null)
        {
            <p class="field-error" id="@(key)Error" role="alert">@message</p>
        }
    }

    // "is-invalid" when the field's last post left an error.
    string? Invalid(string key)
    {
        var hasError = Model.Shown?.Errors.GetValueOrDefault(key) is not null;
        return hasError ? "is-invalid" : null;
    }

    // Whether the field is the one the page came back to.
    bool Focus(string key) => Model.Shown?.Focus == key;

    // A note under a field: a compact informational alert.
    async Task Note(string text)
    {
        <p class="alert alert-info doc-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
            <span>@text</span>
        </p>
    }
}

<div class="doc-page" data-partial-focus="@(flash?.Focus)">

@* Once the head has scrolled away, this strip keeps who the step is for and the
   application number in view (sticky-app-strip.js). *@
<div class="app-sticky-strip" id="docsPin" hidden>
    <div class="app-sticky-strip__inner">
        <span class="app-sticky-strip__who">@Model.HolderName</span>
        <span class="app-sticky-strip__pan">PAN @Model.HolderPan</span>
        @if (Model.IsRenewal)
        {
            <span class="app-sticky-strip__pan">FDR @Model.Renewal!.DepositNumber</span>
        }
        <span class="app-sticky-strip__app">
            <span class="app-sticky-strip__label">Application</span>
            @Model.AppNo
            <button type="button" class="doc-copy" data-copy="@Model.AppNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.6"></rect><path d="M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1"></path></svg>
            </button>
        </span>
    </div>
</div>

<div class="page-layout">
    <partial name="_ClassicSteps" model="1" />

    <div class="page-main">
    <form class="page-card" id="docsForm" data-guard method="post" enctype="multipart/form-data" data-partial novalidate>
        @* The application is known from the session, so the form carries no identifier.
           The Update button is what a choice posts through; it is shown only without a script. *@
        <button type="submit" class="identify-check-button doc-refresh" id="docsRefresh" name="refresh" value="" asp-action="Refresh">Update</button>

        @if (flash?.Banner is not null)
        {
            <div class="alert alert-success doc-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M8 12.5l2.8 2.8L16.5 9.5"></path></svg>
                <span>@flash.Banner</span>
            </div>
        }

        @* The head: who the step is for on the left, what it is filed under on the right. *@
        <div class="doc-head" data-pin-head>
            <div class="doc-head__who">
                <p class="doc-head__step">Upload documents</p>
                <h1 class="doc-head__name">@Model.HolderName</h1>
                <p class="doc-head__ids">
                    <span><em>PAN</em>@Model.HolderPan</span>
                    <span><em>DOB</em>@Model.HolderDob</span>
                </p>
            </div>
            <div class="doc-head__right">
                <dl class="doc-head__refs">
                    <div>
                        <dt>Folio</dt>
                        <dd class="@(Model.HasFolio ? null : "doc-head__pending")">@Model.HolderFolio</dd>
                    </div>
                    @if (Model.IsRenewal)
                    {
                        <div>
                            <dt>Renews</dt>
                            <dd>FDR @Model.Renewal!.DepositNumber</dd>
                        </div>
                    }
                    <div>
                        <dt>Application</dt>
                        <dd class="doc-head__ref">@Model.AppNo
                            <button type="button" class="doc-copy" data-copy="@Model.AppNo" title="Copy the application number" aria-label="Copy the application number">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.6"></rect><path d="M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1"></path></svg>
                            </button>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        @* Two choices with two answers each: how the application arrived, and where the
           investor's post goes. *@
        <div class="doc-app-type">
            <div class="doc-app-type__group">
                <span class="field-label" id="docsAppTypeLabel">Application Type</span>
                <div class="choice-toggle" role="radiogroup" aria-labelledby="docsAppTypeLabel">
                    @foreach (var type in Model.ApplicationTypes)
                    {
                        // A CKYC application is completed online, so it cannot be filed on paper.
                        var disabledForCkyc = state.Ckyc && type.Code == DocumentsViewModel.Physical;
                        string? title = disabledForCkyc ? "A CKYC application is completed online, so it cannot be filed on paper." : null;
                        <label class="choice-toggle__option" title="@title">
                            <input class="visually-hidden" type="radio" name="appType" id="docsAppType@(type.Code)" value="@type.Code" checked="@(state.AppType == type.Code)" disabled="@disabledForCkyc">@type.Name
                        </label>
                    }
                </div>
            </div>

            @* Post going anywhere but the permanent address is proved with a copy of its own, in
               the card beside the proof of address below. While that upload is switched off
               (CommProofUpload), the address is typed on Investor Information instead. *@
            <div class="doc-app-type__group">
                <span class="field-label" id="docsMailingLabel">Communication Address</span>
                <div class="choice-toggle" role="radiogroup" aria-labelledby="docsMailingLabel">
                    @foreach (var option in mailingOptions)
                    {
                        var isDifferent = option.Value == "different";
                        var isOn = mailDifferent == isDifferent;
                        var disabled = isDifferent && !mailCanDiffer;
                        string? title = disabled ? mailSlot.NotApplicable : null;

                        // Without a script this choice posts through Update; when the card can be
                        // switched in place no post is needed. Going back to "same" with a proof filed
                        // asks first, because the proof is taken off.
                        string? submitVia = mailSwitchesInPlace ? null : "docsRefresh";
                        var asksBeforeDroppingProof = option.Value == "same" && !isOn && mailSlot.Doc is not null;
                        string? confirm = asksBeforeDroppingProof ? DocumentsViewModel.MailDropAsk : null;

                        <label class="choice-toggle__option" title="@title">
                            <input class="visually-hidden" type="radio" name="mailing" id="docsMailing-@option.Value" value="@option.Value" checked="@isOn" disabled="@disabled" data-submit="@submitVia" data-confirm="@confirm">@option.Label
                        </label>
                    }
                </div>
                @if (!Model.CommProofUpload)
                {
                    <span class="doc-app-type__note" data-show-when="mailing=different" hidden="@(!mailDifferent)">Typed on Investor Information</span>
                }
            </div>
        </div>

        @* Fetch from CKYC. Offered only to an investor without a folio (one with a folio has
           been through KYC already), before any PAN copy is uploaded or once NSDL has verified
           the uploaded one (CkycPanVerified), and only for a digital application: consent is
           given online, so a physical application never fetches it. *@
        @if (!Model.HasFolio)
        {
            var routeClass = state.Ckyc ? "is-on" : null;
            <section class="doc-kyc-route @routeClass" id="docsRoute">
                <div class="doc-kyc-route__text">
                    @if (state.Ckyc)
                    {
                        <h2 class="doc-kyc-route__title">KYC from @Glossary.Term("CERSAI")</h2>
                        <p class="doc-kyc-route__p">The addresses and the photograph come from the record; only the PAN copy is filed below.</p>
                        <details class="doc-more-info">
                            <summary>How it works</summary>
                            <p class="doc-kyc-route__p">The investor is asked for consent once the application is completed online: a link goes to their registered mobile number and email address, and they enter the OTP sent to the CERSAI-registered mobile number.</p>
                            <p class="doc-kyc-route__p">The addresses &mdash; permanent and communication &mdash; and the photograph are CERSAI&rsquo;s to send. They are not uploaded here, and the record cannot be fetched again. Joint holders file their own documents on Investor Information.</p>
                        </details>
                    }
                    else
                    {
                        <h2 class="doc-kyc-route__title">Fetch the KYC from @Glossary.Term("CERSAI")</h2>
                        <p class="doc-kyc-route__p">Take the addresses and the photograph from the investor&rsquo;s record instead of uploading them.</p>
                        <details class="doc-more-info">
                            <summary>How it works</summary>
                            <p class="doc-kyc-route__p">If the record is fetched, the investor is asked for consent once the application is completed online: a link goes to their registered mobile number and email address, and they enter the OTP sent to the CERSAI-registered mobile number.</p>
                            <p class="doc-kyc-route__p">The addresses &mdash; permanent and communication &mdash; and the photograph then come from CERSAI instead of being filed here, and anything uploaded for them is not used. The PAN copy is filed here either way, and the record is fetched for the investor only: joint holders file their own documents on Investor Information. Nothing changes until the record is fetched.</p>
                        </details>
                    }
                </div>
                <div class="doc-kyc-route__actions">
                    @if (state.Ckyc)
                    {
                        <p class="doc-ckyc-on">KYC from @Glossary.Term("CKYC")</p>
                    }
                    else
                    {
                        var panVerifiedForCkyc = Model.CkycPanVerified;

                        @* Razor writes a data- attribute even when its value is null, so the button that
                           follows the application type is a separate element from the plain disabled one. *@
                        if (panVerifiedForCkyc)
                        {
                            <button type="button" class="btn btn-secondary btn-sm doc-ckyc-btn" popovertarget="docsCkycAsk" disabled="@isPhysical" data-enable-when="appType=@DocumentsViewModel.Digital">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v11"></path><path d="M7.5 10L12 14.5 16.5 10"></path><path d="M4.5 15.5v3a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-3"></path></svg>
                                Fetch from CKYC
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm doc-ckyc-btn" disabled>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v11"></path><path d="M7.5 10L12 14.5 16.5 10"></path><path d="M4.5 15.5v3a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-3"></path></svg>
                                Fetch from CKYC
                            </button>
                        }

                        @if (!panVerifiedForCkyc)
                        {
                            <p class="doc-ckyc-ask__note">@DocumentsViewModel.CkycWaitsOnPan</p>
                        }
                        else
                        {
                            <p class="doc-ckyc-ask__note" data-show-when="appType=@DocumentsViewModel.Digital" hidden="@isPhysical">Once fetched, this cannot be undone on this application.</p>
                            <p class="doc-ckyc-ask__note" data-show-when="appType=@DocumentsViewModel.Physical" hidden="@(!isPhysical)">Not applicable: a physical application is signed and filed by hand, so the CERSAI record is not fetched for it.</p>
                        }
                    }
                </div>
            </section>

            @* Fetching is the investor's decision, so it is confirmed before it is done. *@
            <div class="doc-sheet doc-ckyc-pop" id="docsCkycAsk" popover role="dialog" aria-modal="true" aria-labelledby="docsCkycTitle">
                <div class="doc-ckyc__sheet">
                    <header class="doc-ckyc__head">
                        <span class="doc-ckyc__mark" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                        </span>
                        <h2 class="doc-ckyc__title" id="docsCkycTitle">Fetch the KYC record from CERSAI?</h2>
                        <button type="button" class="doc-preview__close" popovertarget="docsCkycAsk" popovertargetaction="hide" aria-label="Close">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
                        </button>
                    </header>
                    <div class="doc-ckyc__body">
                        <p>The addresses &mdash; permanent and communication &mdash; and the photograph will come from the CERSAI record instead of being filed here, and the investor will be asked for OTP consent once the application is completed online.</p>
                        <p><strong>This cannot be undone on this application:</strong> the record cannot be fetched twice, and the application can no longer be filed as a physical one &mdash; consent is given online.</p>
                    </div>
                    <footer class="doc-ckyc__foot">
                        <button type="button" class="link-button" popovertarget="docsCkycAsk" popovertargetaction="hide">Cancel</button>
                        <button type="submit" class="btn btn-primary" asp-action="Ckyc">Proceed <span aria-hidden="true">&rarr;</span></button>
                    </footer>
                </div>
            </div>
        }

        @* The document cards. A card a choice reshapes (the form's, the communication proof's)
           is drawn once per value of the choice, all but the chosen one hidden, so the page
           can swap them the moment the choice changes (data-show-when, partial-forms.js). A hidden
           one is a disabled fieldset, so nothing in it is posted. *@
        <div class="doc-grid doc-grid--docs">
            <div class="doc-column">
                @foreach (var alternative in Model.AlternativesFor("appType"))
                {
                    <fieldset class="doc-choice" data-show-when="appType=@alternative.Value" hidden="@(!alternative.Now)" disabled="@(!alternative.Now)">
                        <partial name="_DocSlot" model="@(new DocSlotBlock(alternative.Slot, uploadUrl, Alternate: !alternative.Now, Label: "Application form"))" />
                    </fieldset>
                }
            </div>

            @* The PAN copy. It comes over already filed when the step before uploaded or matched one. *@
            <div class="doc-column">
                <partial name="_DocSlot" model="@(new DocSlotBlock(panSlot, uploadUrl, IsNext: panSlot.Key == nextSlotKey, Label: "PAN", LabelOptional: panSlot.Optional))" />
            </div>

            @* NSDL asking for the name printed on the PAN: a row straight under the PAN's card. *@
            @if (panReads.AsksName)
            {
                <div class="doc-retry-row doc-retry-row--pan-second"><partial name="_NsdlRetry" model="@panReads" /></div>
            }

            <div class="doc-column">
                <partial name="_DocSlot" model="@(new DocSlotBlock(photoSlot, uploadUrl, IsNext: photoSlot.Key == nextSlotKey, Label: "Photo"))" />
            </div>

            @* Proof of address. With document identification on, the type is what the copy is
               identified as, shown beside the label. Without it, the type is chosen first. *@
            <div class="doc-column">
                @if (Model.AutoProofType)
                {
                    string? poaType = poaUsed ? state.PoaType : null;
                    <partial name="_DocSlot" model="@(new DocSlotBlock(poaSlot, uploadUrl, IsNext: poaSlot.Key == nextSlotKey, Label: "Proof of address", ShowsProofType: true, ProofType: poaType))" />
                }
                else
                {
                <div class="doc-column__head">
                    <label class="field-label" for="docsPoaType">Proof of address</label>
                    <div class="doc-select">
                        <select class="field-input @Invalid("docsPoaType")" id="docsPoaType" name="poaType" disabled="@(!poaUsed)" data-submit="docsRefresh" autofocus="@Focus("docsPoaType")">
                            <option value="">@(poaUsed ? "Select" : "Not Applicable")</option>
                            @foreach (var proof in Model.ProofsFor(DocumentsViewModel.PoaSlot.Key))
                            {
                                <option value="@proof" selected="@(state.PoaType == proof)">@proof</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("docsPoaType"); }
                </div>
                    <partial name="_DocSlot" model="@(new DocSlotBlock(poaSlot, uploadUrl, IsNext: poaSlot.Key == nextSlotKey))" />
                }
            </div>

            @* The communication address proof. *@
            @if (!Model.CommProofUpload)
            {
                @* Its upload is switched off: the card stands, not applicable, saying the address is
                   typed on Investor Information, so the row keeps its shape. *@
                var mailSlotTyped = mailSlot with { Used = false, NotApplicable = mailSlot.NotApplicable ?? DocumentsViewModel.MailTypedWhy };
            <div class="doc-column">
                <partial name="_DocSlot" model="@(new DocSlotBlock(mailSlotTyped, uploadUrl, IsNext: mailSlotTyped.Key == nextSlotKey, Label: "Communication address proof"))" />
            </div>
            }
            else
            {
                // The label heads the card only when the type is identified from the upload;
                // otherwise the label and its picker stand above the card.
                string? mailLabel = Model.AutoProofType ? "Communication address proof" : null;
                string? mailType = mailUsed ? state.MailPoaType : null;
            <div class="doc-column">
                @if (!Model.AutoProofType)
                {
                <div class="doc-column__head">
                    <label class="field-label" for="docsMailType">Communication address proof</label>
                    <div class="doc-select">
                        <select class="field-input @Invalid("docsMailType")" id="docsMailType" name="mailType" disabled="@(!mailUsed)" data-submit="docsRefresh" autofocus="@Focus("docsMailType")"
                                data-enable-when="@(mailSwitchesInPlace ? "mailing=different" : null)">
                            <option value="">@(mailUsed ? "Select" : "Not Applicable")</option>
                            @foreach (var proof in Model.ProofsOfAddress)
                            {
                                <option value="@proof" selected="@(state.MailPoaType == proof)">@proof</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("docsMailType"); }
                </div>
                }
                @if (mailSwitchesInPlace)
                {
                    @* Nothing is filed there yet, so the card follows the toggle at once. *@
                    foreach (var alternative in Model.AlternativesFor("mailing"))
                    {
                        <fieldset class="doc-choice" data-show-when="mailing=@alternative.Value" hidden="@(!alternative.Now)" disabled="@(!alternative.Now)">
                            <partial name="_DocSlot" model="@(new DocSlotBlock(alternative.Slot, uploadUrl, Alternate: !alternative.Now, Label: mailLabel, ShowsProofType: Model.AutoProofType, ProofType: mailType))" />
                        </fieldset>
                    }
                }
                else
                {
                    <partial name="_DocSlot" model="@(new DocSlotBlock(mailSlot, uploadUrl, IsNext: mailSlot.Key == nextSlotKey, Label: mailLabel, ShowsProofType: Model.AutoProofType, ProofType: mailType))" />
                }
            </div>
            }

            @* An Aadhaar is filed but OCR could not read its number: it is typed here for the
               PAN-Aadhaar link, in a row under the proofs of address. *@
            @if (Model.AsksAadhaarNumber(Model.Investor))
            {
                var (aadhaarField, aadhaarError) = Model.AadhaarNumberField(Model.Investor);
                <div class="doc-retry-row doc-retry-row--end"><partial name="_AadhaarNumber" model="@(new AadhaarNumberBlock(aadhaarField, Url.Action("AadhaarNumber")!, aadhaarError))" /></div>
            }
        </div>

        @* What the PAN was checked with. An investor on a folio is not checked again, so has no section. *@
        @if (Model.PanChecksShown(Model.Investor))
        {
            <section class="doc-read-result">
                <h2 class="doc-read-result__title">What the PAN was checked with</h2>
                <partial name="_ReadCards" model="@panReads" />
            </section>
        }

        @* The payment: the mode, the instrument's card (one per mode, the chosen one shown),
           and what the instrument was read to say. *@
        <section class="doc-read-result doc-payment" id="docsPayment" aria-label="Payment">
            <div class="doc-payment__grid">
                <div class="doc-payment__mode">
                    <label class="field-label" for="docsPayMode">Payment Mode</label>
                    <div class="doc-select">
                        <select class="field-input @Invalid("docsPayMode")" id="docsPayMode" name="payMode" autofocus="@Focus("docsPayMode")" disabled="@(Model.IsRenewal)">
                            <option value="">@(Model.IsRenewal ? "Not applicable" : "Select")</option>
                            @foreach (var mode in Model.PaymentModes)
                            {
                                <option value="@mode.Name" selected="@(state.PayMode == mode.Name)">@mode.Name</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("docsPayMode"); }
                    @if (Model.IsRenewal)
                    {
                        <p class="field-hint">No payment: the maturing deposit @Model.Renewal!.DepositNumber pays for the new one.</p>
                    }
                </div>
                <div class="doc-payment__slot">
                    @foreach (var alternative in Model.AlternativesFor("payMode"))
                    {
                        <fieldset class="doc-choice" data-show-when="payMode=@alternative.Value" hidden="@(!alternative.Now)" disabled="@(!alternative.Now)">
                            <partial name="_DocSlot" model="@(new DocSlotBlock(alternative.Slot, uploadUrl, Alternate: !alternative.Now))" />
                        </fieldset>
                    }
                </div>
                @* The account read off the instrument. Greyed, saying why, for a mode that carries no instrument. *@
                @{
                    var instrumentModes = string.Join("|", Model.PaymentModes.Where(m => m.Document is not null).Select(m => m.Name));
                    var instrumentReadable = paymentSlot.Used && state.PayMode.Length > 0;
                }
                <div class="doc-payment__card" data-enable-when="payMode=@instrumentModes" aria-disabled="@(instrumentReadable ? "false" : "true")">
                    <partial name="_ReadCard" model="@(new ReadCardBlock(Model.PaymentRead()))" />
                </div>
            </div>
        </section>
    </form>

    <section class="page-card doc-section">
        <h2 class="doc-section__title">Additional Details</h2>
        <div class="doc-grid doc-grid--details">
            <div class="doc-column">
                <label class="field-label" for="docsSourcing">Sourcing Mode</label>
                <div class="doc-select">
                    <select class="field-input @Invalid("docsSourcing")" id="docsSourcing" name="sourcing" form="docsForm" data-submit="docsRefresh" disabled="@(!partnerChoosesSourcing)" autofocus="@Focus("docsSourcing")">
                        <option value="">Select</option>
                        @foreach (var mode in Model.SourcingModes)
                        {
                            <option value="@mode.Code" selected="@(state.Sourcing == mode.Code)">@mode.Name</option>
                        }
                    </select>
                </div>
                @if (!partnerChoosesSourcing)
                {
                    await Note("Sourced as a broker under your business broker code.");
                }
                @{ await FieldError("docsSourcing"); }
            </div>

            @* The two code fields stand under every mode; the mode decides what they are called,
               which is typed, and which the mode fills itself. A searched field looks its register
               up on the backend as it is typed (documents.js) and posts as it is left. *@
            <div class="doc-column">
                <label class="field-label" for="docsSourceCode">@sourceCodeLabel</label>
                <input class="field-input @Invalid("docsSourceCode")" id="docsSourceCode" name="sourceCode" data-chars="code" form="docsForm" value="@state.SourceCode" maxlength="12" autocomplete="off" spellcheck="false"
                       disabled="@sourceCodeDisabled" data-submit="docsRefresh" autofocus="@Focus("docsSourceCode")"
                       data-register-search="@(sourceRegister is null ? null : registerSearchUrl)" data-register="@sourceRegister" data-name-label="@sourceNameLabel"
                       role="@(sourceRegister is null ? null : "combobox")" aria-autocomplete="@(sourceRegister is null ? null : "list")" aria-expanded="@(sourceRegister is null ? null : "false")" aria-controls="@(sourceRegister is null ? null : "docsSourceCodeSuggest")">
                @if (sourceRegister is not null)
                {
                    <ul class="bank-suggest" id="docsSourceCodeSuggest" role="listbox" aria-label="@sourceNameLabel found" hidden></ul>
                }
                @* The name the code stands for, always under the field: a dash until there is a code. *@
                @if (sourceCodeName is not null)
                {
                    var nameClass = sourceCodeName.Value.Found ? null : "doc-resolved__none";
                    <p class="doc-resolved @nameClass">@sourceCodeName.Value.Text</p>
                }
                else
                {
                    <p class="doc-resolved">@sourceNameLabel &mdash; <strong class="doc-resolved__none">&mdash;</strong></p>
                }
                @{ await FieldError("docsSourceCode"); }
            </div>

            <div class="doc-column">
                <label class="field-label" for="docsSubBroker">Sub Broker Code
                    @if (!subBrokerRequired && !subBrokerDisabled) { <span class="doc-optional">(Non-mandatory)</span> }
                </label>
                <input class="field-input @Invalid("docsSubBroker")" id="docsSubBroker" name="subBroker" data-chars="code" form="docsForm" value="@state.SubBroker" maxlength="12" autocomplete="off" spellcheck="false" data-submit="docsRefresh"
                       disabled="@subBrokerDisabled" autofocus="@Focus("docsSubBroker")"
                       data-register-search="@(subRegister is null ? null : registerSearchUrl)" data-register="@subRegister" data-name-label="Sub Broker Name"
                       role="@(subRegister is null ? null : "combobox")" aria-autocomplete="@(subRegister is null ? null : "list")" aria-expanded="@(subRegister is null ? null : "false")" aria-controls="@(subRegister is null ? null : "docsSubBrokerSuggest")">
                @if (subRegister is not null)
                {
                    <ul class="bank-suggest" id="docsSubBrokerSuggest" role="listbox" aria-label="Sub brokers found" hidden></ul>
                }
                @if (subBrokerName is not null)
                {
                    var nameClass = subBrokerName.Value.Found ? null : "doc-resolved__none";
                    <p class="doc-resolved @nameClass">@subBrokerName.Value.Text</p>
                }
                else
                {
                    <p class="doc-resolved">Sub Broker Name &mdash; <strong class="doc-resolved__none">&mdash;</strong></p>
                }
                @{ await FieldError("docsSubBroker"); }
            </div>

            @* What a deposit may be booked as belongs to the sourcing mode. *@
            <div class="doc-column">
                <label class="field-label" for="docsCategory">Deposit Category</label>
                <div class="doc-select">
                    <select class="field-input @Invalid("docsCategory")" id="docsCategory" name="category" form="docsForm" disabled="@(!partnerChoosesSourcing || sourcingMode is null)" data-submit="docsRefresh" autofocus="@Focus("docsCategory")">
                        <option value="">Select</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category" selected="@(state.Category == category)">@Model.CategoryName(category)</option>
                        }
                    </select>
                </div>
                @if (!partnerChoosesSourcing)
                {
                    await Note(Model.SetCategoryWhy);
                }
                else if (categories.Count == 1)
                {
                    await Note($"An application sourced as {sourcingMode!.Name} can only be booked as {Model.CategoryName(categories[0])}, so it is chosen here.");
                }
                @{ await FieldError("docsCategory"); }
            </div>

            @if (isEmployeeCategory)
            {
                @* An employee deposit is booked against a staff record. *@
                var employeeNameClass = employeeName is null ? "doc-resolved__none" : null;
                var employeeNameText = "—";
                if (employeeName is not null) employeeNameText = employeeName;
                else if (state.EmpCode.Length > 0) employeeNameText = "not found";

                <div class="doc-column">
                    <label class="field-label" for="docsEmployeeCode">Employee Code</label>
                    <input class="field-input @Invalid("docsEmployeeCode")" id="docsEmployeeCode" name="empCode" data-chars="code" form="docsForm" value="@state.EmpCode" maxlength="10" autocomplete="off" spellcheck="false" autofocus="@Focus("docsEmployeeCode")"
                           data-register-search="@registerSearchUrl" data-register="staff" data-name-label="Employee Name" data-submit="docsRefresh"
                           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="docsEmployeeCodeSuggest">
                    <ul class="bank-suggest" id="docsEmployeeCodeSuggest" role="listbox" aria-label="Staff found" hidden></ul>
                    <p class="doc-resolved">Employee Name &mdash; <strong class="@employeeNameClass">@employeeNameText</strong></p>
                    @if (state.EmpCode.Length > 0 && employeeName is null)
                    {
                        await Note("No name against this code here. You can still proceed — Operations check it against the staff register before the deposit is booked.");
                    }
                    @{ await FieldError("docsEmployeeCode"); }
                </div>

                <div class="doc-column">
                    <label class="field-label" for="docsEmployeeCompany">Employee Company Name</label>
                    <input class="field-input @Invalid("docsEmployeeCompany")" id="docsEmployeeCompany" name="empCompany" data-chars="text" form="docsForm" value="@state.EmpCompany" maxlength="50" autocomplete="off" autofocus="@Focus("docsEmployeeCompany")">
                    @{ await FieldError("docsEmployeeCompany"); }
                </div>

                <div class="doc-column">
                    <label class="field-label" for="docsEmployeeHolder">Employee holder</label>
                    <div class="doc-select">
                        <select class="field-input @Invalid("docsEmployeeHolder")" id="docsEmployeeHolder" name="empHolder" form="docsForm" autofocus="@Focus("docsEmployeeHolder")">
                            <option value="">Select</option>
                            @foreach (var holder in Model.EmployeeHolders)
                            {
                                <option value="@holder" selected="@(state.EmpHolder == holder)">@holder</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("docsEmployeeHolder"); }
                </div>

                @* When the employee is the primary holder the relation is Self, fixed and disabled;
                   the hidden field beside it posts the value a disabled one would not. *@
                <div class="doc-column">
                    <label class="field-label" for="docsEmployeeRelation">Emp Relation with holder</label>
                    <div class="doc-select">
                        <select class="field-input @Invalid("docsEmployeeRelation")" id="docsEmployeeRelation" name="empRelation" form="docsForm" autofocus="@Focus("docsEmployeeRelation")"
                                disabled="@Model.EmployeeIsPrimary" data-fixed-by="empHolder" data-fixed-when="@Model.PrimaryHolder" data-fixed-value="@Model.SelfRelation" aria-describedby="docsEmployeeRelationWhy">
                            <option value="">Select</option>
                            @foreach (var relation in Model.EmployeeRelations)
                            {
                                var selfNotAllowed = relation == Model.SelfRelation && !Model.EmployeeIsPrimary;
                                <option value="@relation" selected="@(state.EmpRelation == relation)" disabled="@selfNotAllowed">@relation</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" id="docsEmployeeRelationFixed" name="empRelation" value="@Model.SelfRelation" form="docsForm" disabled="@(!Model.EmployeeIsPrimary)">
                    <p class="field-hint" id="docsEmployeeRelationWhy">@Model.SelfRelation when the employee is the @Model.PrimaryHolder.ToLowerInvariant(); otherwise chosen here.</p>
                    @{ await FieldError("docsEmployeeRelation"); }
                </div>
            }

            @* A paper application carries its form number; a digital one is filed as 0000. *@
            <div class="doc-column">
                <label class="field-label" for="docsFormNo">Physical Application Form No.
                    @if (!isPhysical) { <span class="doc-optional">(No paper form &mdash; filed as 0000)</span> }
                </label>
                <input class="field-input @Invalid("docsFormNo")" id="docsFormNo" name="formNo" data-chars="code" form="docsForm" value="@state.FormNo" maxlength="20" autocomplete="off" spellcheck="false" readonly="@(!isPhysical)" autofocus="@Focus("docsFormNo")">
                @{ await FieldError("docsFormNo"); }
            </div>

            @if (isEmployeeCategory)
            {
                <div class="doc-column">
                    <label class="field-label" for="docsEmployeeProofType">Employee Proof</label>
                    <div class="doc-select">
                        <select class="field-input @Invalid("docsEmployeeProofType")" id="docsEmployeeProofType" name="empProofType" form="docsForm" data-submit="docsRefresh" autofocus="@Focus("docsEmployeeProofType")">
                            <option value="">Select</option>
                            @foreach (var proof in Model.EmployeeProofs)
                            {
                                <option value="@proof" selected="@(state.EmpProofType == proof)">@proof</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("docsEmployeeProofType"); }
                    <partial name="_DocSlot" model="@(new DocSlotBlock(employeeProofSlot, uploadUrl, "docsForm", IsNext: employeeProofSlot.Key == nextSlotKey))" />
                </div>
            }
        </div>
    </section>

    @* Every upload attempt this session, newest first, with the checks it went through. *@
    <section class="page-card doc-history">
        <h2 class="doc-section__title">Upload, @Glossary.Term("OCR") and verification history</h2>
        <p class="doc-history__sub">Every attempt, newest first. Three refusals in a row send a document to Operations.</p>
        @if (state.Log.Count == 0)
        {
            <p class="doc-history__none">Nothing uploaded against this application yet.</p>
        }
        else
        {
            <partial name="_DocLog" model="@state.Log" />
        }
    </section>
    </div>
</div>

<footer class="page-action-bar">
    <div class="page-action-bar__inner">
        <a class="btn btn-outline-primary" asp-controller="NewApplication" asp-action="Index"
           data-loader="Going back to Investor Identification"
           data-loader-hint="Nothing filed here is lost — it is kept against this application.">Back</a>

        @* What Proceed would ask for next; with more than one thing left, the whole list on a click. *@
        @if (stillToDo.Count == 0)
        {
            <p class="page-action-bar__hint">Everything is in &mdash; <strong>ready to proceed</strong></p>
        }
        else if (stillToDo.Count == 1)
        {
            <p class="page-action-bar__hint">1 thing still to go &mdash; <strong>@stillToDo[0]</strong></p>
        }
        else
        {
            <details class="page-action-bar__hint page-remaining">
                <summary>@stillToDo.Count things still to go &mdash; <strong>@stillToDo[0]</strong> first<span class="page-remaining__more">See all</span></summary>
                <ol class="page-remaining__list">
                    @foreach (var need in stillToDo)
                    {
                        <li>@need</li>
                    }
                </ol>
            </details>
        }

        <div class="page-action-bar__right">
            @if (state.SavedAt is not null)
            {
                <span class="page-action-bar__saved">Draft saved @state.SavedAt.Value.ToString("HH:mm")</span>
            }
            <button type="submit" class="btn btn-outline-primary" form="docsForm" asp-action="Save" data-toast="Draft saved">Save draft</button>
            <button type="submit" class="btn btn-primary" form="docsForm" asp-action="Proceed"
                    data-loader="Checking everything on this step&hellip;">Proceed</button>
        </div>
    </div>
</footer>

</div>

@section Scripts {
    <script src="~/js/pages/documents.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/documents.css" asp-append-version="true" />
}

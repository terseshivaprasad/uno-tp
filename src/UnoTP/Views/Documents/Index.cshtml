@model DocumentsViewModel
@using M = UnoTP.ViewModels.DocumentsViewModel
@{
    ViewData["Title"] = "Upload Documents";

    // The old WA_FD_UNOTP/UploadInvestorDocuments: the documents across the top,
    // the one the payment carries under them, and the details the application is
    // sourced under. Every change posts the form and the controller answers:
    // partial-forms.js swaps the answer in without a reload, and without it the
    // same forms post the ordinary way.
    var s = Model.State;
    var flash = Model.Shown;
    var mode = Model.ModeOf(s.Sourcing);
    var views = M.Slots.ToDictionary(d => d.Key, Model.View);
    var physical = s.AppType == M.Physical;
    // What the PAN was checked with, and where a name typed for NSDL posts.
    var panReads = new ReadCardsBlock(Model.PanReadsOf(Model.Investor), Url.Action("Nsdl"));
    // The communication proof's box switches in place with the toggle, while nothing is filed there.
    var mailInstant = Model.MailCanDiffer(Model.Investor) && views["mail"].Doc is null;
    var poaUsed = views["poa"].Used;
    var mailUsed = views["mail"].Used;
    var employee = Model.IsEmployee(s.Category);
    // Agency type 1033 chooses the mode, the code and the category; anyone else
    // sources as a broker under their own code, booked as the holder's details say.
    var chooses = Model.Chooses;
    var left = Model.Outstanding();

    string? Err(string key) => flash?.Errors.GetValueOrDefault(key);
    string? Invalid(string key) => Err(key) is null ? null : "is-invalid";
    bool Focus(string key) => flash?.Focus == key;

    var sourceRegister = M.RegisterName(mode, sub: false);
    var subRegister = M.RegisterName(mode, sub: true);
    var registerSearch = Url.Action("Sourcing");
    var sourceShut = !chooses || mode is null || mode.House.Length > 0;
    var subShut = mode is null || mode.Sub is M.SubField.House or M.SubField.Shut or M.SubField.EmployeeShut;
    var subRequired = mode is not null && M.SubRequired(mode);
    var sourceName = Model.Resolved(mode, sub: false);
    var subName = Model.Resolved(mode, sub: true);
    IReadOnlyList<string> categories = chooses ? mode?.Categories ?? [] : [s.Category];
    var empName = Model.StaffName(s.EmpCode);
}

@functions {
    // .NET 8 Razor leaves the body of a tag helper inside a helper below async with
    // nothing to await (fixed in Razor 9); nothing runs differently for it.
#pragma warning disable CS1998
    // A field's error line, when the last post left one.
    async Task FieldError(string key)
    {
        var message = Model.Shown?.Errors.GetValueOrDefault(key);
        if (message is not null)
        {
            <p class="csi-error" id="@(key)Error" role="alert">@message</p>
        }
        await Task.CompletedTask;
    }

    // One document slot, drawn by the partial Investor Information shares.
    async Task Slot(M.SlotView v, string? form = null)
    {
        <partial name="_DocSlot" model="@(new DocSlotBlock(v, Url.Action("Upload")!, form, IsNext: v.Key == Model.NextSlot()))" />
    }

    // A slot as each value of a choice leaves it, every one drawn and all but the
    // one standing hidden, so the page shows the right one the moment the choice
    // changes (data-show-when, partial-forms.js) while the change is saved. A hidden
    // one is a disabled fieldset, so nothing in it is posted. Each is worked out by
    // setting the choice on the state for a moment and putting it back.
    async Task Choices(string field, IEnumerable<(string Value, bool Now)> values, Func<string, M.SlotView> slotAs)
    {
        foreach (var (value, now) in values)
        {
            <fieldset class="cud-choice" data-show-when="@field=@value" hidden="@(!now)" disabled="@(!now)">
                <partial name="_DocSlot" model="@(new DocSlotBlock(slotAs(value), Url.Action("Upload")!, Alternate: !now))" />
            </fieldset>
        }
    }

    M.SlotView FormAs(string type)
    {
        var state = Model.State;
        var was = state.AppType;
        state.AppType = type;
        try { return Model.View(M.FormSlot); } finally { state.AppType = was; }
    }

    M.SlotView MailAs(string mailing)
    {
        var state = Model.State;
        var was = state.MailDifferent;
        state.MailDifferent = mailing == "different";
        try { return Model.View(M.MailSlot); } finally { state.MailDifferent = was; }
    }

    M.SlotView PaymentAs(string mode)
    {
        var state = Model.State;
        var was = state.PayMode;
        state.PayMode = mode;
        try { return Model.View(M.PaymentSlot); } finally { state.PayMode = was; }
    }
}

<div class="cud-page" data-partial-focus="@(flash?.Focus)">

@* Once the head has scrolled off, this holds what every screenshot of this step
   needs to be worth anything: who it is for and which application it is. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@Model.HolderName</span>
        <span class="cud-pin__pan">PAN @Model.HolderPan</span>
        @if (Model.IsRenewal)
        {
            <span class="cud-pin__pan">FDR @Model.Renewal!.DepositNumber</span>
        }
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @Model.AppNo
            <button type="button" class="cud-copy" data-copy="@Model.AppNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.6"></rect><path d="M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1"></path></svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="1" />

    @* Both cards share the column beside the rail; the page grid holds two
       columns, so a card left loose lands under the rail instead. *@
    <div class="csi-main">
    <form class="csi-card" id="cudForm" data-guard method="post" enctype="multipart/form-data" data-partial novalidate>
        @* Who the step is for is not in the form: the server knows the application from the session. *@
        @* What a change that reshapes the step posts through. Shown only without a script. *@
        <button type="submit" class="csi-check cud-refresh" id="cudRefresh" name="refresh" value="" asp-action="Refresh">Update</button>

        @if (flash?.Banner is not null)
        {
            <div class="cud-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M8 12.5l2.8 2.8L16.5 9.5"></path></svg>
                <span>@flash.Banner</span>
            </div>
        }

        <div class="cud-head" data-pin-head>
            <div class="cud-head__who">
                <p class="cud-head__step">Upload documents</p>
                <h1 class="cud-head__name">@Model.HolderName</h1>
                <p class="cud-head__ids">
                    <span><em>PAN</em>@Model.HolderPan</span>
                    <span><em>DOB</em>@Model.HolderDob</span>
                </p>
            </div>
            <div class="cud-head__right">
                <dl class="cud-head__refs">
                    <div>
                        <dt>Folio</dt>
                        <dd class="@(Model.HasFolio ? null : "cud-head__pending")">@Model.HolderFolio</dd>
                    </div>
                    @if (Model.IsRenewal)
                    {
                        @* A renewal: the deposit receipt it renews, beside the folio. *@
                        <div>
                            <dt>Renews</dt>
                            <dd>FDR @Model.Renewal!.DepositNumber</dd>
                        </div>
                    }
                    <div>
                        <dt>Application</dt>
                        @* The number every question about this application starts with. *@
                        <dd class="cud-head__ref">@Model.AppNo
                            <button type="button" class="cud-copy" data-copy="@Model.AppNo" title="Copy the application number" aria-label="Copy the application number">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.6"></rect><path d="M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1"></path></svg>
                            </button>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        @* How the application arrived, and where the investor's post goes. Two ways
           each and no third, so both are the segmented toggle the new design uses
           for exactly this. *@
        <div class="cud-apptype">
            <div class="cud-apptype__group">
                <span class="csi-label" id="cudAppTypeLabel">Application Type</span>
                <div class="seg-toggle" role="radiogroup" aria-labelledby="cudAppTypeLabel">
                    @foreach (var t in Model.ApplicationTypes)
                    {
                        var shut = s.Ckyc && t.Code == M.Physical;
                        <label class="seg-toggle__opt" title="@(shut ? "A CKYC application is completed online, so it cannot be filed on paper." : null)">
                            <input class="visually-hidden" type="radio" name="appType" id="cudAppType@(t.Code)" value="@t.Code" checked="@(s.AppType == t.Code)" disabled="@shut">@t.Name
                        </label>
                    }
                </div>
            </div>
            @* Post going anywhere but the permanent address is proved with a copy of
               its own, in the box beside the proof of address below - or, while that
               upload is switched off (CommProofUpload), typed on Investor Information,
               which the note beside the choice says. Only where a
               proof of address is asked for - a folio that holds the address has it
               as the mailing address too - and not once CKYC is fetched, whose
               record brings it. *@
            <div class="cud-apptype__group">
                <span class="csi-label" id="cudMailingLabel">Communication Address</span>
                <div class="seg-toggle" role="radiogroup" aria-labelledby="cudMailingLabel">
                    @foreach (var (value, label) in new[] { ("same", "Same as Permanent"), ("different", "Different from Permanent") })
                    {
                        var on = Model.MailDifferentOf(Model.Investor) == (value == "different");
                        var shut = value == "different" && !Model.MailCanDiffer(Model.Investor);
                        <label class="seg-toggle__opt" title="@(shut ? Model.View(M.MailSlot).NotApplicable : null)">
                            <input class="visually-hidden" type="radio" name="mailing" id="cudMailing-@value" value="@value" checked="@on" disabled="@shut" data-submit="@(mailInstant ? null : "cudRefresh")" data-confirm="@(value == "same" && !on && Model.View(M.MailSlot).Doc is not null ? M.MailDropAsk : null)">@label
                        </label>
                    }
                </div>
                @if (!Model.CommProofUpload)
                {
                    <span class="cud-apptype__note" data-show-when="mailing=different" hidden="@(!Model.MailDifferentOf(Model.Investor))">Typed on Investor Information</span>
                }
            </div>
        </div>

        @* Only where the register holds nothing: an investor who already has a
           folio has been through KYC, so there is no CERSAI record to fetch. It
           applies to a digital application only: consent is given online, so a
           physical one, signed and filed by hand, never fetches it. Choosing
           Physical disables the button and greys the section at once
           (data-enable-when, data-show-when), so it reads as not applicable
           rather than missing; the server refuses it too. *@
        @if (!Model.HasFolio)
        {
            <section class="cud-route @(s.Ckyc ? "is-on" : null)" id="cudRoute">
                <div class="cud-route__text">
                    @if (s.Ckyc)
                    {
                        <h2 class="cud-route__title">KYC from @Glossary.Term("CERSAI")</h2>
                        <p class="cud-route__p">The addresses and the photograph come from the record; only the PAN copy is filed below.</p>
                        <details class="cud-more">
                            <summary>How it works</summary>
                            <p class="cud-route__p">The investor is asked for consent once the application is completed online: a link goes to their registered mobile number and email address, and they enter the OTP sent to the CERSAI-registered mobile number.</p>
                            <p class="cud-route__p">The addresses &mdash; permanent and communication &mdash; and the photograph are CERSAI&rsquo;s to send. They are not uploaded here, and the record cannot be fetched again. Joint holders file their own documents on Investor Information.</p>
                        </details>
                    }
                    else
                    {
                        <h2 class="cud-route__title">Fetch the KYC from @Glossary.Term("CERSAI")</h2>
                        <p class="cud-route__p">Take the addresses and the photograph from the investor&rsquo;s record instead of uploading them.</p>
                        <details class="cud-more">
                            <summary>How it works</summary>
                            <p class="cud-route__p">If the record is fetched, the investor is asked for consent once the application is completed online: a link goes to their registered mobile number and email address, and they enter the OTP sent to the CERSAI-registered mobile number.</p>
                            <p class="cud-route__p">The addresses &mdash; permanent and communication &mdash; and the photograph then come from CERSAI instead of being filed here, and anything uploaded for them is not used. The PAN copy is filed here either way, and the record is fetched for the investor only: joint holders file their own documents on Investor Information. Nothing changes until the record is fetched.</p>
                        </details>
                    }
                </div>
                <div class="cud-route__act">
                    @if (s.Ckyc)
                    {
                        <p class="cud-ckyc-on">KYC from @Glossary.Term("CKYC")</p>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary btn-sm cud-ckyc-btn" popovertarget="cudCkycAsk" disabled="@physical" data-enable-when="appType=@M.Digital">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v11"></path><path d="M7.5 10L12 14.5 16.5 10"></path><path d="M4.5 15.5v3a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-3"></path></svg>
                            Fetch from CKYC
                        </button>
                        <p class="cud-ckyc-ask__note" data-show-when="appType=@M.Digital" hidden="@physical">Once fetched, this cannot be undone on this application.</p>
                        <p class="cud-ckyc-ask__note" data-show-when="appType=@M.Physical" hidden="@(!physical)">Not applicable: a physical application is signed and filed by hand, so the CERSAI record is not fetched for it.</p>
                    }
                </div>
            </section>

            @* The investor's decision, not the partner's, so it is asked before it is done. *@
            <div class="cud-sheet cud-ckyc-pop" id="cudCkycAsk" popover role="dialog" aria-modal="true" aria-labelledby="cudCkycTitle">
                <div class="cud-ckyc__sheet">
                    <header class="cud-ckyc__head">
                        <span class="cud-ckyc__mark" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                        </span>
                        <h2 class="cud-ckyc__title" id="cudCkycTitle">Fetch the KYC record from CERSAI?</h2>
                        <button type="button" class="cud-preview__close" popovertarget="cudCkycAsk" popovertargetaction="hide" aria-label="Close">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
                        </button>
                    </header>
                    <div class="cud-ckyc__body">
                        <p>The addresses &mdash; permanent and communication &mdash; and the photograph will come from the CERSAI record instead of being filed here, and the investor will be asked for OTP consent once the application is completed online.</p>
                        <p><strong>This cannot be undone on this application:</strong> the record cannot be fetched twice, and the application can no longer be filed as a physical one &mdash; consent is given online.</p>
                    </div>
                    <footer class="cud-ckyc__foot">
                        <button type="button" class="csi-link" popovertarget="cudCkycAsk" popovertargetaction="hide">Cancel</button>
                        <button type="submit" class="csi-btn csi-btn--primary" asp-action="Ckyc">Proceed <span aria-hidden="true">&rarr;</span></button>
                    </footer>
                </div>
            </div>
        }

        <div class="cud-grid cud-grid--docs">
            <div class="cud-col">
                <div class="cud-col__head"><span class="csi-label">Application form</span></div>
                @{ await Choices("appType", Model.ApplicationTypes.Select(t => (t.Code, t.Code == s.AppType)), FormAs); }
            </div>

            @* The PAN copy the application is filed with. It comes over already
               filed when the step before uploaded or matched one. *@
            <div class="cud-col">
                <div class="cud-col__head"><span class="csi-label">PAN @if (views["pan"].Optional) { <span class="cud-optional">(Non-mandatory)</span> }</span></div>
                @{ await Slot(views["pan"]); }
            </div>

            @* NSDL asking for the name printed on the PAN: across the row straight
               under the PAN's box, however many boxes a row holds. *@
            @if (panReads.AsksName)
            {
                <div class="cud-retry-row cud-retry-row--pan-second"><partial name="_NsdlRetry" model="@panReads" /></div>
            }

            <div class="cud-col">
                <div class="cud-col__head"><span class="csi-label">Photo</span></div>
                @{ await Slot(views["photo"]); }
            </div>

            <div class="cud-col">
                @* With document identification, the type is what the copy is identified
                   as once it is uploaded, shown beside the label. Without it, the type is
                   chosen first, and the box waits for it. *@
                <div class="cud-col__head">
                @if (Model.AutoProofType)
                {
                    <span class="csi-label">Proof of address <partial name="_ProofType" model="@(poaUsed ? s.PoaType : null)" /></span>
                }
                else
                {
                    <label class="csi-label" for="cudPoaType">Proof of address</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("cudPoaType")" id="cudPoaType" name="poaType" disabled="@(!poaUsed)" data-submit="cudRefresh" autofocus="@Focus("cudPoaType")">
                            <option value="">@(poaUsed ? "Select" : "Not Applicable")</option>
                            @foreach (var p in Model.ProofsFor(M.PoaSlot.Key))
                            {
                                <option value="@p" selected="@(s.PoaType == p)">@p</option>
                            }
                        </select>
                    </div>
                    await FieldError("cudPoaType");
                }
                </div>
                @{ await Slot(views["poa"]); }
            </div>

            @* The communication address proof. While its upload is switched off it
               stands too, not applicable, saying the address is typed on Investor
               Information - so the row keeps its shape. *@
            @if (!Model.CommProofUpload)
            {
            <div class="cud-col">
                <div class="cud-col__head"><span class="csi-label">Communication address proof</span></div>
                @{ await Slot(views["mail"] with { Used = false, NotApplicable = views["mail"].NotApplicable ?? M.MailTypedWhy }); }
            </div>
            }
            else
            {
            <div class="cud-col">
                <div class="cud-col__head">
                @if (Model.AutoProofType)
                {
                    <span class="csi-label">Communication address proof <partial name="_ProofType" model="@(mailUsed ? s.MailPoaType : null)" /></span>
                }
                else
                {
                    <label class="csi-label" for="cudMailType">Communication address proof</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("cudMailType")" id="cudMailType" name="mailType" disabled="@(!mailUsed)" data-submit="cudRefresh" autofocus="@Focus("cudMailType")"
                                data-enable-when="@(mailInstant ? "mailing=different" : null)">
                            <option value="">@(mailUsed ? "Select" : "Not Applicable")</option>
                            @foreach (var p in Model.ProofsOfAddress)
                            {
                                <option value="@p" selected="@(s.MailPoaType == p)">@p</option>
                            }
                        </select>
                    </div>
                    await FieldError("cudMailType");
                }
                </div>
                @* Switched in place only while nothing is filed there: taking a filed
                   proof off is asked about, and the page redrawn after it. *@
                @if (mailInstant)
                {
                    await Choices("mailing", new[] { ("same", !Model.MailDifferentOf(Model.Investor)), ("different", Model.MailDifferentOf(Model.Investor)) }, MailAs);
                }
                else
                {
                    await Slot(views["mail"]);
                }
            </div>
            }

            @* An Aadhaar filed whose number OCR could not read: the number typed for
               the PAN-Aadhaar link, across the row under the proofs of address. *@
            @if (Model.AsksAadhaarNumber(Model.Investor))
            {
                var (aadhaarField, aadhaarError) = Model.AadhaarNumberField(Model.Investor);
                <div class="cud-retry-row cud-retry-row--end"><partial name="_AadhaarNumber" model="@(new AadhaarNumberBlock(aadhaarField, Url.Action("AadhaarNumber")!, aadhaarError))" /></div>
            }
        </div>

        @* What the PAN was checked with. The addresses stand in the boxes of the
           proofs above - what a proof was read to say, or what the folio holds -
           so they have no cards here. An investor on a folio is not checked again,
           so has no section. *@
        @if (Model.PanChecksShown(Model.Investor))
        {
            <section class="cud-read">
                <h2 class="cud-read__title">What the PAN was checked with</h2>
                <partial name="_ReadCards" model="@panReads" />
            </section>
        }

        @* How the deposit is paid is the application's, not the investor's KYC: the
           mode, the instrument it carries and what that was read to say stand in a
           row of their own under the KYC documents. The mode's label heads it, as a
           document's label heads its box - no second "Payment" title over it. *@
        <section class="cud-read cud-pay" id="cudPayment" aria-label="Payment">
            @* The mode above its box, and the card beside the box, level with it. *@
            <div class="cud-pay__grid">
                <div class="cud-pay__mode">
                    <label class="csi-label" for="cudPayMode">Payment Mode</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("cudPayMode")" id="cudPayMode" name="payMode" autofocus="@Focus("cudPayMode")" disabled="@(Model.IsRenewal)">
                            <option value="">@(Model.IsRenewal ? "Not applicable" : "Select")</option>
                            @foreach (var m in Model.PaymentModes)
                            {
                                <option value="@m.Name" selected="@(s.PayMode == m.Name)">@m.Name</option>
                            }
                        </select>
                    </div>
                    @{ await FieldError("cudPayMode"); }
                    @if (Model.IsRenewal)
                    {
                        <p class="csi-hint">No payment: the maturing deposit @Model.Renewal!.DepositNumber pays for the new one.</p>
                    }
                </div>
                <div class="cud-pay__slot">@{ await Choices("payMode", new[] { "" }.Concat(Model.PaymentModes.Select(m => m.Name)).Select(m => (m, m == s.PayMode)), PaymentAs); }</div>
                @* The account read off the instrument, under every mode: greyed, saying
                   why, for a mode that carries none, as the mode is chosen. *@
                @{ var instrumentModes = string.Join("|", Model.PaymentModes.Where(m => m.Document is not null).Select(m => m.Name)); }
                <div class="cud-pay__card" data-enable-when="payMode=@instrumentModes" aria-disabled="@(Model.View(M.PaymentSlot).Used && s.PayMode.Length > 0 ? "false" : "true")">
                    <partial name="_ReadCard" model="@(new ReadCardBlock(Model.PaymentRead()))" />
                </div>
            </div>
        </section>
    </form>

    <section class="csi-card cud-extra">
        <h2 class="cud-extra__title">Additional Details</h2>
        <div class="cud-grid cud-grid--details">
            <div class="cud-col">
                <label class="csi-label" for="cudSourcing">Sourcing Mode</label>
                <div class="cud-select">
                    <select class="csi-control @Invalid("cudSourcing")" id="cudSourcing" name="sourcing" form="cudForm" data-submit="cudRefresh" disabled="@(!chooses)" autofocus="@Focus("cudSourcing")">
                        <option value="">Select</option>
                        @foreach (var m in Model.SourcingModes)
                        {
                            <option value="@m.Code" selected="@(s.Sourcing == m.Code)">@m.Name</option>
                        }
                    </select>
                </div>
                @if (!chooses)
                {
                    <p class="cud-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                        <span>Sourced as a broker under your business broker code.</span>
                    </p>
                }
                @{ await FieldError("cudSourcing"); }
            </div>

            @* Both code fields stand under every mode: what changes is what they are
               called, which of them is typed, and which the mode fills itself. A
               searched field offers its register as the browser's own suggestions.
               A searched field is looked up on the backend as it is typed
               (register-search.js), and a code picked or typed posts as the field is
               left, so its name is shown at once, not with the next choice made. *@
            <div class="cud-col">
                <label class="csi-label" for="cudSourceCode">@(mode?.CodeLabel ?? "Broker Code")</label>
                <input class="csi-control @Invalid("cudSourceCode")" id="cudSourceCode" name="sourceCode" data-chars="code" form="cudForm" value="@s.SourceCode" maxlength="12" autocomplete="off" spellcheck="false"
                       disabled="@sourceShut" data-submit="cudRefresh" autofocus="@Focus("cudSourceCode")"
                       data-register-search="@(sourceRegister is null ? null : registerSearch)" data-register="@sourceRegister" data-name-label="@(mode?.NameLabel ?? "Broker Name")"
                       role="@(sourceRegister is null ? null : "combobox")" aria-autocomplete="@(sourceRegister is null ? null : "list")" aria-expanded="@(sourceRegister is null ? null : "false")" aria-controls="@(sourceRegister is null ? null : "cudSourceCodeSuggest")">
                @if (sourceRegister is not null)
                {
                    <ul class="bank-suggest" id="cudSourceCodeSuggest" role="listbox" aria-label="@(mode?.NameLabel ?? "Brokers") found" hidden></ul>
                }
                @* The name the code stands for, always under the field: a dash until
                   there is a code, so nothing appears or moves as one is typed. *@
                @if (sourceName is { } sn)
                {
                    <p class="cud-resolved @(sn.Found ? null : "cud-resolved__none")">@sn.Text</p>
                }
                else
                {
                    <p class="cud-resolved">@(mode?.NameLabel ?? "Broker Name") &mdash; <strong class="cud-resolved__none">&mdash;</strong></p>
                }
                @{ await FieldError("cudSourceCode"); }
            </div>

            <div class="cud-col">
                <label class="csi-label" for="cudSubBroker">Sub Broker Code
                    @if (!subRequired && !subShut) { <span class="cud-optional">(Non-mandatory)</span> }
                </label>
                <input class="csi-control @Invalid("cudSubBroker")" id="cudSubBroker" name="subBroker" data-chars="code" form="cudForm" value="@s.SubBroker" maxlength="12" autocomplete="off" spellcheck="false" data-submit="cudRefresh"
                       disabled="@subShut" autofocus="@Focus("cudSubBroker")"
                       data-register-search="@(subRegister is null ? null : registerSearch)" data-register="@subRegister" data-name-label="Sub Broker Name"
                       role="@(subRegister is null ? null : "combobox")" aria-autocomplete="@(subRegister is null ? null : "list")" aria-expanded="@(subRegister is null ? null : "false")" aria-controls="@(subRegister is null ? null : "cudSubBrokerSuggest")">
                @if (subRegister is not null)
                {
                    <ul class="bank-suggest" id="cudSubBrokerSuggest" role="listbox" aria-label="Sub brokers found" hidden></ul>
                }
                @if (subName is { } bn)
                {
                    <p class="cud-resolved @(bn.Found ? null : "cud-resolved__none")">@bn.Text</p>
                }
                else
                {
                    <p class="cud-resolved">Sub Broker Name &mdash; <strong class="cud-resolved__none">&mdash;</strong></p>
                }
                @{ await FieldError("cudSubBroker"); }
            </div>

            @* What a deposit may be booked as belongs to the mode. *@
            <div class="cud-col">
                <label class="csi-label" for="cudCategory">Deposit Category</label>
                <div class="cud-select">
                    <select class="csi-control @Invalid("cudCategory")" id="cudCategory" name="category" form="cudForm" disabled="@(!chooses || mode is null)" data-submit="cudRefresh" autofocus="@Focus("cudCategory")">
                        <option value="">Select</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c" selected="@(s.Category == c)">@Model.CategoryName(c)</option>
                        }
                    </select>
                </div>
                @if (!chooses)
                {
                    <p class="cud-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                        <span>@Model.SetCategoryWhy</span>
                    </p>
                }
                else if (categories.Count == 1)
                {
                    <p class="cud-note">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                        <span>An application sourced as @mode!.Name can only be booked as @Model.CategoryName(categories[0]), so it is chosen here.</span>
                    </p>
                }
                @{ await FieldError("cudCategory"); }
            </div>

            @if (employee)
            {
                @* An employee deposit is booked against a staff record. *@
                <div class="cud-col">
                    <label class="csi-label" for="cudEmpCode">Employee Code</label>
                    <input class="csi-control @Invalid("cudEmpCode")" id="cudEmpCode" name="empCode" data-chars="code" form="cudForm" value="@s.EmpCode" maxlength="10" autocomplete="off" spellcheck="false" autofocus="@Focus("cudEmpCode")"
                           data-register-search="@registerSearch" data-register="staff" data-name-label="Employee Name" data-submit="cudRefresh"
                           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="cudEmpCodeSuggest">
                    <ul class="bank-suggest" id="cudEmpCodeSuggest" role="listbox" aria-label="Staff found" hidden></ul>
                    <p class="cud-resolved">Employee Name &mdash; <strong class="@(empName is null ? "cud-resolved__none" : null)">@(empName ?? (s.EmpCode.Length > 0 ? "not found" : "—"))</strong></p>
                    @if (s.EmpCode.Length > 0 && empName is null)
                    {
                        <p class="cud-note">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                            <span>No name against this code here. You can still proceed &mdash; Operations check it against the staff register before the deposit is booked.</span>
                        </p>
                    }
                    @{ await FieldError("cudEmpCode"); }
                </div>

                <div class="cud-col">
                    <label class="csi-label" for="cudEmpCompany">Employee Company Name</label>
                    <input class="csi-control @Invalid("cudEmpCompany")" id="cudEmpCompany" name="empCompany" data-chars="text" form="cudForm" value="@s.EmpCompany" maxlength="60" autocomplete="off" autofocus="@Focus("cudEmpCompany")">
                    @{ await FieldError("cudEmpCompany"); }
                </div>

                <div class="cud-col">
                    <label class="csi-label" for="cudEmpHolder">Employee holder</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("cudEmpHolder")" id="cudEmpHolder" name="empHolder" form="cudForm" autofocus="@Focus("cudEmpHolder")">
                            <option value="">Select</option>
                            @foreach (var h in Model.EmployeeHolders) { <option value="@h" selected="@(s.EmpHolder == h)">@h</option> }
                        </select>
                    </div>
                    @{ await FieldError("cudEmpHolder"); }
                </div>

                <div class="cud-col">
                    @* The primary holder is the employee themselves: the relation is Self,
                       fixed and disabled - its value posted by the field beside it, as a
                       disabled one is not. Any other holder chooses, and cannot be Self. *@
                    <label class="csi-label" for="cudEmpRelation">Emp Relation with holder</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("cudEmpRelation")" id="cudEmpRelation" name="empRelation" form="cudForm" autofocus="@Focus("cudEmpRelation")"
                                disabled="@Model.EmployeeIsPrimary" data-fixed-by="empHolder" data-fixed-when="@Model.PrimaryHolder" data-fixed-value="@Model.SelfRelation" aria-describedby="cudEmpRelationWhy">
                            <option value="">Select</option>
                            @foreach (var r in Model.EmployeeRelations) { <option value="@r" selected="@(s.EmpRelation == r)" disabled="@(r == Model.SelfRelation && !Model.EmployeeIsPrimary)">@r</option> }
                        </select>
                    </div>
                    <input type="hidden" id="cudEmpRelationFixed" name="empRelation" value="@Model.SelfRelation" form="cudForm" disabled="@(!Model.EmployeeIsPrimary)">
                    <p class="csi-hint" id="cudEmpRelationWhy">@Model.SelfRelation when the employee is the @Model.PrimaryHolder.ToLowerInvariant(); otherwise chosen here.</p>
                    @{ await FieldError("cudEmpRelation"); }
                </div>
            }

            @* A paper application has to carry its form number; a digital one has no
               paper, so the field stands but is filed as 0000. *@
            <div class="cud-col">
                <label class="csi-label" for="cudFormNo">Physical Application Form No.
                    @if (!physical) { <span class="cud-optional">(No paper form &mdash; filed as 0000)</span> }
                </label>
                <input class="csi-control @Invalid("cudFormNo")" id="cudFormNo" name="formNo" data-chars="code" form="cudForm" value="@s.FormNo" maxlength="20" autocomplete="off" spellcheck="false" readonly="@(!physical)" autofocus="@Focus("cudFormNo")">
                @{ await FieldError("cudFormNo"); }
            </div>

            @if (employee)
            {
                <div class="cud-col">
                    <label class="csi-label" for="cudEmpProofType">Employee Proof</label>
                    <div class="cud-select">
                        <select class="csi-control @Invalid("cudEmpProofType")" id="cudEmpProofType" name="empProofType" form="cudForm" data-submit="cudRefresh" autofocus="@Focus("cudEmpProofType")">
                            <option value="">Select</option>
                            @foreach (var p in Model.EmployeeProofs) { <option value="@p" selected="@(s.EmpProofType == p)">@p</option> }
                        </select>
                    </div>
                    @{ await FieldError("cudEmpProofType"); }
                    @{ await Slot(views["empproof"], form: "cudForm"); }
                </div>
            }
        </div>
    </section>

    @* Three attempts for each document in a session, counted separately. Each
       attempt is kept as the checks it went through, so a refusal is never just a
       red line that has since been cleared away. *@
    <section class="csi-card cud-log">
        <h2 class="cud-extra__title">Upload, @Glossary.Term("OCR") and verification history</h2>
        <p class="cud-log__sub">Every attempt, newest first. Three refusals in a row send a document to Operations.</p>
        @if (s.Log.Count == 0)
        {
            <p class="cud-log__none">Nothing uploaded against this application yet.</p>
        }
        else
        {
            <partial name="_DocLog" model="@s.Log" />
        }
    </section>
    </div>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-controller="NewApplication" asp-action="Index"
           data-loader="Going back to Investor Identification"
           data-loader-hint="Nothing filed here is lost — it is kept against this application.">Back</a>
        @* What Proceed would ask for next, so the partner is never sent looking for
           it - and, with more than one thing left, the whole list on a click. *@
        @if (left.Count == 0)
        {
            <p class="csi-bar__hint">Everything is in &mdash; <strong>ready to proceed</strong></p>
        }
        else if (left.Count == 1)
        {
            <p class="csi-bar__hint">1 thing still to go &mdash; <strong>@left[0]</strong></p>
        }
        else
        {
            <details class="csi-bar__hint csi-left">
                <summary>@left.Count things still to go &mdash; <strong>@left[0]</strong> first<span class="csi-left__more">See all</span></summary>
                <ol class="csi-left__list">
                    @foreach (var need in left)
                    {
                        <li>@need</li>
                    }
                </ol>
            </details>
        }
        <div class="csi-bar__right">
            @if (s.SavedAt is { } saved)
            {
                <span class="csi-bar__saved">Draft saved @saved.ToString("HH:mm")</span>
            }
            <button type="submit" class="csi-btn csi-btn--back" form="cudForm" asp-action="Save" data-toast="Draft saved">Save draft</button>
            <button type="submit" class="csi-btn csi-btn--primary" form="cudForm" asp-action="Proceed"
                    data-loader="Checking everything on this step&hellip;">Proceed</button>
        </div>
    </div>
</footer>

</div>

@section Scripts {
    <script src="~/js/pages/documents.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/documents.css" asp-append-version="true" />
}

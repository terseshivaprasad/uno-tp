@page "/ReviewSummary/{appNo}/{handler?}"
@model ReviewModel
@{
    ViewData["Title"] = "Review Summary";

    // The last classic step, in the frame the steps before it draw: everything the
    // application holds, as the backend has it - what each step saved, the
    // documents filed, and the backend's quote for the deposit - one card a step,
    // read-only as Investor Information shows what was read, each with its Edit.
    var d = Model.View.Deposit;
    var docs = Model.View.Docs;
    var appNo = docs.AppNo;
    var blockers = Model.View.Blockers;
    string Or(string value, string empty = "Not entered") => value.Length > 0 ? value : empty;
}

@functions {
    private const string CopyGlyph = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";


}

@* Once the first card's head has scrolled off, this keeps who the application is
   for and which it is in view, as the steps before it do. *@
<div class="app-sticky-strip" id="docsPin" hidden>
    <div class="app-sticky-strip__inner">
        <span class="app-sticky-strip__who">@docs.HolderName</span>
        <span class="app-sticky-strip__pan">PAN @docs.HolderPan</span>
        <span class="app-sticky-strip__app">
            <span class="app-sticky-strip__label">Application</span>
            @appNo
            <button type="button" class="doc-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyGlyph)</svg>
            </button>
        </span>
    </div>
</div>

<div class="page-layout">
    <partial name="_ClassicSteps" model="5" />

    <div class="page-main">
        @if (Model.View.Refused is { } refused)
        {
            <div class="alert alert-danger page-missing-items" role="alert">
                <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="page-missing-items__body"><p>@refused</p></div>
            </div>
        }

        @if (blockers.Count == 0)
        {
            <div class="alert alert-success doc-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
                <span><strong>Nothing is missing.</strong> Every step is complete &mdash; <strong>Submit Application</strong> sends it.</span>
            </div>
        }
        else
        {
            <div class="alert alert-danger page-missing-items" role="alert">
                <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <div class="page-missing-items__body">
                    <div class="page-missing-items__title">@blockers.Count thing@(blockers.Count == 1 ? " is" : "s are") still missing before this can be submitted</div>
                    <p>@string.Join("; ", blockers.Select(b => $"{b.What} ({b.Step})")).</p>
                </div>
            </div>
        }

        @* The application, section by section - the same partial View Application's
           details sheet draws, read-only there. *@
        <partial name="_ApplicationSummary" model="@(new ApplicationSummary(Model.View, Editable: true))" />

        @* Submit posts this: nothing is typed on the page, so it carries the token alone.
           Whether anything is still missing is the server's, here as data-ready. *@
        <form method="post" asp-page-handler="Submit" id="reviewForm" novalidate data-ready="@(Model.View.Ready ? "true" : "false")" hidden></form>
    </div>
</div>

<footer class="page-action-bar">
    <div class="page-action-bar__inner">
        <a class="btn btn-outline-primary" asp-page="/Deposit/Index" data-loader="Going back to FD Configuration">Back</a>
        <p class="page-action-bar__hint" id="review-footer-hint">@(Model.View.Ready ? "Nothing missing · ready to submit" : $"{blockers.Count} thing{(blockers.Count == 1 ? "" : "s")} still missing before submitting")</p>
        <div class="page-action-bar__right">
            <button type="button" class="btn btn-primary" id="openPaymentLinkModal" disabled>Submit Application</button>
        </div>
    </div>
</footer>

@* The submit dialog: what is sent to the investor once the application is submitted.
   Both of its buttons submit - the application is saved either way. Submit & send
   link then makes and sends the link; Try later leaves the link for later. *@
<div class="modal-overlay pay-link-overlay" id="paymentLinkModal" hidden>
    <div class="app-dialog pay-link-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentLinkTitle" aria-describedby="paymentLinkIntro">
        <div class="pay-link-head">
            <h2 class="pay-link-head__title" id="paymentLinkTitle">Send the payment link</h2>
            <button type="button" class="btn-close app-dialog__close pay-link-head__close" id="closePaymentLinkModal" aria-label="Close without submitting"></button>
        </div>
        <div class="pay-link-body">
            <p class="pay-link-intro pay-link-intro--long" id="paymentLinkIntro">On Submit the application is submitted and a payment link is sent to the investor: <strong>the deposit is not booked until the investor pays it</strong>.</p>
            <dl class="pay-link-terms">
                <div><dt>SMS to</dt><dd>@Or(Model.View.InvestorMobile)</dd><dd class="pay-link-terms__note">the primary holder&rsquo;s mobile, from Investor Information</dd></div>
                <div><dt>E-mail to</dt><dd class="pay-link-terms__email">@Or(Model.View.InvestorEmail.ToLowerInvariant())</dd><dd class="pay-link-terms__note">the primary holder&rsquo;s e-mail, from Investor Information</dd></div>
                <div><dt>Amount</dt><dd>@(d is null ? "—" : Money.Rupees(d.Amount))</dd><dd class="pay-link-terms__note">fixed &mdash; the investor cannot change it</dd></div>
                <div><dt>Valid for</dt><dd>@Model.View.PaymentLinkValidFor</dd><dd class="pay-link-terms__note">from when it is sent</dd></div>
            </dl>
            <div class="pay-link-lapse pay-link-lapse--long"><strong>A link stays open for @Model.View.PaymentLinkValidFor; the application stands for @Model.View.ApplicationDays days.</strong> A new link can be sent until then; unpaid after that, the application lapses and the rate is no longer held.</div>
            <p class="pay-link-foot">Try later submits the application as well, but makes no link &mdash; nothing is sent to the investor until a link is generated, from Application Submitted.</p>
        </div>
        <div class="pay-link-actions">
            <button type="submit" form="reviewForm" name="link" value="@ReviewModel.LinkLater" class="pay-link-actions__later" data-loader="Submitting&hellip;" data-loader-hint="No link is made: generate it later">Try later</button>
            <button type="submit" form="reviewForm" name="link" value="send" class="btn btn-primary pay-link-actions__send" data-loader="Submitting&hellip;" data-loader-hint="The application is saved, then its link is made">Submit &amp; send link</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/review.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/review.css" asp-append-version="true" />
}

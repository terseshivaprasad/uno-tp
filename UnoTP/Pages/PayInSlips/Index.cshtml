@page "/PayInSlip/{handler?}"
@model PayInSlipsModel
@{
    ViewData["Title"] = "Pay In Slip Generation";
    ViewData["BackToDashboard"] = true;

    // The old PayinSlipGenerationAxis screen. That page opened on an empty form
    // and made you search before it would show anything; this one opens on the
    // last fourteen days of applications, which is every one a slip can still be
    // made for, and keeps the search for narrowing that down. The search is sent
    // to the server, which reads only what it reaches: the page never holds the
    // partner's whole list.
    var earliest = Model.View.Earliest;
    var today = PayInSlipsViewModel.Today;
    var search = Model.View.Search;
    var byNumber = search.By == ApplicationSearch.ByNumber;
    var from = Model.View.From;
    var to = Model.View.To;
    var listed = Model.View.Listed.ToList();
    var pending = listed.Count(r => r.State == "pending" && !r.Blocked);
    var blocked = listed.Count(r => r.Blocked);
}

<div class="page-layout page-layout--wide">
    <aside class="page-rail page-rail--steps">
        <h2 class="page-rail__title">What needs a slip</h2>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect><path d="M3.5 10h17"></path></svg>
            <div>
                <div class="page-rail__note-title">Money arriving on paper</div>
                <p>A cheque is paid in at an Axis CMS branch with a slip. Anything paid online never reaches this list.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 6.5V12l3.5 2.5"></path></svg>
            <div>
                <div class="page-rail__note-title">Raised in the last @Model.View.WindowDays days</div>
                <p>An older application has cancelled itself, so its cheque can no longer be paid in against it.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 6.5l-11 11-5.5-5.5"></path></svg>
            <div>
                <div class="page-rail__note-title">Accepted, if it came in digitally</div>
                <p>A physical application arrives signed. A digital one is not signed until the investor accepts it, so its slip waits on that.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 2.5H14l5 5v13a1 1 0 0 1-1 1H6.5a1.5 1.5 0 0 1-1.5-1.5V4a1.5 1.5 0 0 1 1.5-1.5z"></path><path d="M14 2.5v5h5"></path><path d="M8.5 13h7M8.5 16.5h4"></path></svg>
            <div>
                <div class="page-rail__note-title">One slip, one application</div>
                <p>A slip carries a single application's money to a single branch, so it is generated from that application's own row.</p>
            </div>
        </div>
    </aside>

    <div class="page-card">
        <div class="page-head"><h1 class="page-title">Pay In Slip Generation &mdash; Axis</h1></div>
        <p class="page-note">@(Model.View.IsOpeningList ? $"Every application raised in the last {Model.View.WindowDays} days whose money is coming by cheque. " : "")@pending of @listed.Count @(pending == 1 ? "is" : "are") ready for a slip@(blocked > 0 ? $", and {blocked} {(blocked == 1 ? "is" : "are")} held back for acceptance" : "").</p>

        @* Sent as a GET: pay-in-slips.js checks the fields, puts what is searched
           for in the three hidden boxes and lets the browser go. *@
        <form class="payin-slip-form" id="payinSlipForm" method="get" asp-page="/PayInSlips/Index" asp-page-handler="" novalidate
              data-by="@search.By" data-opening="@(Model.View.IsOpeningList ? "yes" : "no")"
              data-earliest="@earliest.ToString("yyyy-MM-dd")" data-today="@today.ToString("yyyy-MM-dd")">
            <input type="hidden" name="q" id="payinSlipAskedText">
            <input type="hidden" name="from" id="payinSlipAskedFrom">
            <input type="hidden" name="to" id="payinSlipAskedTo">
            <fieldset class="search-by search-by--first">
                <legend class="field-label">Search By</legend>
                <label class="radio-option">
                    <input type="radio" name="by" value="@ApplicationSearch.ByDates" checked="@(!byNumber)">
                    <span>Application date</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="by" value="@ApplicationSearch.ByNumber" checked="@byNumber">
                    <span>Application number</span>
                </label>
            </fieldset>

            <div class="payin-slip-form__row payin-slip-form__row--search">
                <div class="form-field" data-for="dates" hidden="@byNumber">
                    <span class="field-label" id="payinSlipFromLabel">From Date</span>
                    @* The three-box control the old wizard steps use. *@
                    <div class="date-input" data-date id="payinSlipFrom" role="group" aria-labelledby="payinSlipFromLabel">
                        <input class="date-input__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" value="@from.ToString("dd")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off" value="@from.ToString("MM")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part date-input__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off" value="@from.ToString("yyyy")">
                    </div>
                </div>

                <div class="form-field" data-for="dates" hidden="@byNumber">
                    <span class="field-label" id="payinSlipToLabel">To Date</span>
                    <div class="date-input" data-date id="payinSlipTo" role="group" aria-labelledby="payinSlipToLabel">
                        <input class="date-input__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" value="@to.ToString("dd")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off" value="@to.ToString("MM")">
                        <span class="date-input__sep">/</span>
                        <input class="date-input__part date-input__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off" value="@to.ToString("yyyy")">
                    </div>
                </div>

                <div class="form-field payin-slip-field--appno" data-for="appno" hidden="@(!byNumber)">
                    <label class="field-label" for="payinSlipAppNo">Application Number</label>
                    <input class="field-input" id="payinSlipAppNo" data-chars="code" maxlength="18" autocomplete="off" spellcheck="false" placeholder="e.g. FBBMFL26F10000" value="@(byNumber ? search.Text : "")">
                </div>

                <div class="form-field form-field--check payin-slip-field--actions">
                    <button type="submit" class="btn btn-primary payin-slip-btn--search">Search</button>
                    <button type="button" class="btn btn-outline-primary" id="payinSlipClear">Clear</button>
                </div>
            </div>

            <p class="field-error" id="payinSlipError" hidden></p>
            <p class="field-hint" id="payinSlipScope">@Model.View.Scope</p>
            @if (Model.View.MoreExist)
            {
                <p class="field-hint" id="payinSlipMore">@ListSearch.MoreExistNote</p>
            }
        </form>

        @if (blocked > 0)
        {
            <p class="payin-slip-flag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                <span><strong>@blocked digital @(blocked == 1 ? "application is" : "applications are") waiting on the investor's acceptance</strong> &mdash; no slip until it is in. The link is sent from Short URL.</span>
            </p>
        }

        <table class="register-table payin-slip-table">
            <colgroup>
                <col style="width:16%"><col style="width:11%"><col style="width:9%"><col style="width:12%">
                <col style="width:11%"><col style="width:13%"><col style="width:9%"><col style="width:11%">
                <col style="width:8%">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Application</th>
                    <th scope="col">Investor</th>
                    <th scope="col" class="payin-slip-table__amount">Amount</th>
                    <th scope="col">Instrument</th>
                    <th scope="col">Type</th>
                    <th scope="col">@Glossary.Term("CMS") branch</th>
                    <th scope="col">Applied</th>
                    <th scope="col">Slip</th>
                    <th scope="col" class="register-table__actions"><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody id="payinSlipRows" data-per-page="@ListSearch.PerPage">
                @* What the search reached, and nothing else. The rows after the first
                   page start hidden, so the list does not jump when the script pages it. *@
                @foreach (var (r, at) in listed.Select((row, index) => (row, index)))
                {
                    <tr data-state="@r.State" data-amount="@r.Amount" data-branch="@r.Branch" data-mode="@(r.Digital ? "digital" : "physical")"
                        data-blocked="@(r.Blocked ? "yes" : "no")" hidden="@(at >= ListSearch.PerPage)">
                        <td data-label="Application">
                            <strong>@r.AppNo</strong>
                            <div class="register-table__sub@(r.Urgent ? " register-table__sub--urgent" : "")">@r.Countdown</div>
                        </td>
                        <td data-label="Investor">@r.Investor</td>
                        <td data-label="Amount" class="payin-slip-table__amount">@PayInSlipsViewModel.Rupees(r.Amount)</td>
                        <td data-label="Instrument">
                            @r.Instrument @r.InstrumentNo
                            <div class="register-table__sub">@r.DrawnOn</div>
                        </td>
                        <td data-label="Type">
                            <span class="status-word @(r.Digital ? "text-info-emphasis" : "text-secondary-emphasis")">@r.Tag</span>
                            <div class="register-table__sub@(r.Blocked ? " register-table__sub--urgent" : "")">@r.TagNote</div>
                        </td>
                        <td data-label="CMS branch">@r.Branch</td>
                        <td data-label="Applied">@r.Applied.ToString("dd/MM/yyyy")</td>
                        <td data-label="Slip" class="payin-slip-table__slip">
                            <span class="@Tones.Word(r.SlipTone)" data-status>@r.SlipLabel</span>
                            <div class="register-table__sub" data-slip-detail>@r.SlipNote</div>
                        </td>
                        <td class="register-table__actions">
                            @if (r.State == "pending" && !r.Blocked)
                            {
                                <form method="post" asp-page-handler="Generate">
                                    <input type="hidden" name="appNo" value="@r.AppNo" />
                                    <button type="submit" class="link-button" data-loader="Generating the slip&hellip;">Generate</button>
                                </form>
                            }
                            else if (r.State == "generated")
                            {
                                <form method="post" asp-page-handler="Generate">
                                    <input type="hidden" name="appNo" value="@r.AppNo" />
                                    <button type="submit" class="link-button" data-loader="Reprinting the slip&hellip;">Reprint</button>
                                </form>
                            }
                            else
                            {
                                <span class="register-no-link">&mdash;</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="register-empty" id="payinSlipEmpty" hidden></p>

        <div class="register-pager">
            <p class="register-pager__count" id="payinSlipCount"></p>
            <div class="register-pager__nav">
                <button type="button" class="register-page register-page--step" id="payinSlipPrev" aria-label="Previous page">&lsaquo;</button>
                <div class="register-pager__pages" id="payinSlipPages"></div>
                <button type="button" class="register-page register-page--step" id="payinSlipNext" aria-label="Next page">&rsaquo;</button>
            </div>
        </div>
    </div>
</div>

@* A slip generated just now: its PDF is saved as the page opens (pay-in-slips.js). *@
@if (Model.SlipToSave is not null)
{
    <a id="payinSlipDownload" asp-page-handler="Slip" asp-route-appNo="@Model.SlipToSave" download hidden></a>
}
<div class="app-toast" id="toast" role="status" aria-live="polite" data-toast-now="@(ViewData["Toast"] as string)"></div>

@section Scripts {
    <script src="~/js/pages/pay-in-slips.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/pay-in-slips.css" asp-append-version="true" />
}

@model ReadCardsBlock
@* NSDL holds a filed PAN copy's PAN against another name: the name printed on the
   card is typed and NSDL is asked again from here, without the copy being uploaded
   - and identified and read - again. Any other NSDL failure has no retry: the PAN
   copy is uploaded again. The page places the row in its document grid, straight
   under the PAN's box (.doc-retry-row), where the PAN was just filed. *@
@foreach (var item in Model.Items.Where(i => i.Retry is not null && Model.RetryUrl is not null))
{
    var retry = item.Retry!;
    <div class="doc-retry @(retry.Error is null ? null : "is-invalid")" role="group" aria-labelledby="@(retry.Field)Label">
        <div class="doc-retry__say">
            <span class="doc-retry__title" id="@(retry.Field)Label">@retry.Title</span>
            <span class="doc-retry__text">@retry.Text</span>
        </div>
        <div class="doc-retry__ask">
            <input class="field-input field-input--caps @(retry.Error is null ? null : "is-invalid")" id="@retry.Field" name="@retry.Field" data-check="name" value="@retry.Value"
                   maxlength="50" autocomplete="off" spellcheck="false" aria-label="Name exactly as printed on the PAN" aria-describedby="@(retry.Field)Error">
            <button type="submit" class="btn btn-primary" formaction="@Model.RetryUrl" formnovalidate data-loader="Asking NSDL again&hellip;" data-loader-progress="@Url.Page("/Documents/Index", "Progress")">Retry NSDL</button>
        </div>
        @if (retry.Error is not null)
        {
            <p class="field-error doc-retry__error" id="@(retry.Field)Error" role="alert">@retry.Error</p>
        }
    </div>
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PathBase": "",
  "DataProtection": {
    "KeysPath": ""
  },
  "ConnectionStrings": {
    "UnoTP": "",
    "UnoTP_Masters": "",
    "UnoTP_Folios": "",
    "UnoTP_Links": "",
    "UnoTP_Errors": ""
  },
  "Dms": {
    "Root": ""
  },

  "//Backend": "The one gateway every backend API is behind. Set the real host in the environment, never here.",
  "Backend": {
    "BaseUrl": "https://<gateway-host>/",
    "ClientId": "unotp",
    "TimeoutSeconds": 55,
    "ReferenceCacheMinutes": 10,
    "Switches": {
      "Identify": true,
      "Ocr": true,
      "Verification": true,
      "PanAadhaarLink": true,
      "FaceMatch": true,
      "NameMatch": true
    }
  },

  "//Services": "One section per service below. BasePath is its place under the gateway, and every other path is under that. No leading slash.",

  "//AuthApi": "The way in from the portal: decrypt what it sent, start the session, read the menus.",
  "AuthApi": {
    "BasePath": "v10-e-sarathi-app-auth-api/api/v1",
    "DecryptPath": "cipher/decrypt",
    "SessionPath": "auth/sessions",
    "MenuPath": "app-menus/{userId}/{sysCode}",
    "SessionHours": 8
  },

  "//PanApi": "A holder's PAN checked with NSDL.",
  "PanApi": {
    "BasePath": "<pan-api>/api/v1",
    "VerifyPath": "verify-pan"
  },

  "//UidMasking": "An Aadhaar copy with its number masked, before it is filed.",
  "UidMasking": {
    "BasePath": "<uid-masking-api>/api/v1",
    "MaskPath": "mask",
    "MaskLength": 8,
    "OutputJpegQuality": 80,
    "CheckDocumentType": true
  },

  "//Ckyc": "Whether CERSAI holds a KYC record for a PAN and date of birth.",
  "Ckyc": {
    "BasePath": "<ckyc-api>/api/v1",
    "SearchPath": "search",
    "IncludeImages": "N"
  },

  "//Idfy": "Idfy.Api: document identification, OCR (a cheque's too), verification with the issuer, the PAN-Aadhaar link and face match.",
  "Idfy": {
    "BasePath": "<idfy-api>/api",
    "ValidateDocumentPath": "documents/validate",
    "ExtractPanPath": "pan/extract",
    "ExtractAadhaarPath": "aadhaar/extract",
    "ExtractDrivingLicencePath": "driving-license/extract",
    "ExtractPassportPath": "passport/extract",
    "ExtractVoterIdPath": "voter-id/extract",
    "ExtractChequePath": "cheque/extract",
    "VerifyDrivingLicencePath": "driving-license/verify/sync",
    "VerifyPassportPath": "passport/verify/sync",
    "VerifyVoterIdPath": "voter-id/verify/sync",
    "VerifyPanAadhaarLinkPath": "pan-aadhaar-link/verify/sync",
    "CompareFacesPath": "face/compare"
  },

  "//NameScreening": "Whether a holder may invest online. ApiCall 0 switches it off. ApiKey is set in the environment, never here.",
  "NameScreening": {
    "BasePath": "<name-screening-api>/api/v1",
    "ScreenPath": "screen",
    "ApiKey": "",
    "ApiCall": "1",
    "BlackListCheck": "",
    "CustomerDataBaseCheck": "",
    "RejectedListCheck": "",
    "EmployeeDataBaseCheck": ""
  },

  "//NameMatch": "Whether two names are the same person's.",
  "NameMatch": {
    "BasePath": "<name-match-api>/api/v1",
    "MatchPath": "match"
  },

  "//Shortener": "The payment link shortened on submit. No ShortenPath, and the link goes in full.",
  "Shortener": {
    "BasePath": "<shortener-api>/api",
    "ShortenPath": ""
  },

  "//Menu": "Which dashboard feature each page of the portal's menu opens.",
  "Menu": {
    "Pages": {
      "SearchInvestor": "new-fd",
      "PayInSlip": "pis",
      "ViewApplication": "view-app",
      "ShortUrl": "short-url",
      "ApplicationStatus": "app-status",
      "RenewalDashboard": "renew",
      "Admin": "admin"
    }
  },

  "PaymentLink": {
    "Template": ""
  },
  "Portal": {
    "Home": "",
    "Logout": ""
  },
  "Apps": {
    "eSarathiLogin": "",
    "eSarathiConsole": "",
    "UnoTP": "",
    "DmsExplorer": "",
    "OvdExplorer": ""
  },
  "Features": {
    "NewFd": true,
    "PisGeneration": true,
    "ViewApplication": true,
    "ShortUrl": true,
    "ApplicationStatus": false,
    "RenewFd": true,
    "Admin": false,
    "DocIdentification": true,
    "CommProofUpload": false
  }
}

@model PaymentViewModel
@{
    ViewData["Title"] = "Bank Details & Payment";

    var form = Model.Form;
    var sameAsPayment = Model.SameAsPayment;
    var appNo = Model.Docs.AppNo;
    var banner = Model.Problem("banner");

    // The fields Proceed can find wanting, in page order; the first with a problem takes the caret.
    (string Key, string Id)[] fieldIds =
    [
        ("Payment.Ifsc", "pay-ifsc"),
        ("Payment.AccountNumber", "pay-account"),
        ("Payment.AccountNumberConfirm", "pay-account-confirm"),
        ("Cheque.Number", "cheque-number"),
        ("Cheque.Date", "cheque-date"),
        ("Cheque.CmsLocation", "cms-location"),
        ("Repayment.Ifsc", "repay-ifsc"),
        ("Repayment.AccountNumber", "repay-account"),
        ("Repayment.AccountNumberConfirm", "repay-account-confirm"),
    ];
    string? focus = null;
    foreach (var field in fieldIds)
    {
        if (Model.Problem(field.Key) is not null)
        {
            focus = field.Id;
            break;
        }
    }
    var problemCount = Model.Problems.Count(p => p.Key != "banner");

    // The card says what the repayment account is for, right over its fields. How the
    // deposit is paid was chosen on Upload Documents and is not repeated here; a
    // renewal alone says why its fields come filled.
    string? howPaid = null;
    if (Model.IsRenewal)
    {
        howPaid = $"The maturing deposit {Model.Docs.Renewal!.DepositNumber} pays for the new one; its repayment account is filled in below.";
    }
    var repaymentNote = "Interest and the maturity amount are paid into this account.";
}
@* Bank Details & Payment: the account the deposit is paid from, then the account
   interest and the maturity amount are paid into. Only a cheque is drawn on an
   account, so the first card (and "same as the payment account") is there only when
   the deposit is paid by cheque; paid online or by RTGS, the repayment account is all
   the step asks for. *@

@functions {
    // One account on the folio: the bank and the number's last digits, the branch and IFSC, the deposit it was used on, and Use.
    private async Task AccountRow(int i)
    {
        var account = Model.AccountsOnRecord[i];
        <li class="on-record__row">
            <span class="on-record__main">@account.Bank · @PaymentViewModel.MaskAccount(account.AccountNumber)</span>
            <span class="on-record__meta">@account.Branch · @account.Ifsc · on @account.UsedOn@if (!Model.OnGateway(account)) { <text> · <strong>not on the payment gateway</strong></text> }</span>
            <button type="submit" name="UseRepayment" value="@i" class="btn btn-outline-primary btn-sm on-record__use" formnovalidate data-loader="Filling the repayment account&hellip;">Use</button>
        </li>
    }
#pragma warning disable CS1998 // Razor makes these helpers async; there is nothing to await in them.

    private const string CopyIcon = "<rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"1.6\"></rect><path d=\"M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1\"></path>";

    // The attributes a field with an error carries.
    private string? Invalid(string key) => Model.Problem(key) is null ? null : "is-invalid";
    private string? AriaInvalid(string key) => Model.Problem(key) is null ? null : "true";
    private string? DescribedBy(string key, string id) => Model.Problem(key) is null ? null : id + "Error";

    // The error Proceed left on a field, under it.
    private async Task FieldError(string key, string id)
    {
        var message = Model.Problem(key);
        if (message is not null)
        {
            <p class="field-error" id="@(id)Error" role="alert">@message</p>
        }
    }

    // A card's head: its title and, on the first card, the application number (which the
    // sticky strip keeps in view once it scrolls off).
    private async Task CardHead(string title, bool first)
    {
        <div class="page-head" data-pin-head="@(first ? "" : null)">
            <h1 class="page-title">@title</h1>
            @if (first)
            {
                <span class="page-app-number">Application No: <strong>@Model.Docs.AppNo</strong>
                    <button type="button" class="doc-copy" data-copy="@Model.Docs.AppNo" title="Copy the application number" aria-label="Copy the application number">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyIcon)</svg>
                    </button>
                </span>
            }
        </div>
    }

    // An account: the bank (searched by name, branch, IFSC or MICR - payment.js) and the
    // account number typed twice. key is "Payment" or "Repayment"; id its element-id prefix.
    private async Task AccountFields(string key, string id, AccountForm account)
    {
        var ifscKey = key + ".Ifsc";
        var numberKey = key + ".AccountNumber";
        var confirmKey = key + ".AccountNumberConfirm";
        <div class="doc-grid">
            <div class="doc-column bank-search">
                <label class="field-label" for="@(id)-ifsc">Bank &mdash; search by name, branch, @Glossary.Term("IFSC") or @Glossary.Term("MICR")</label>
                <input class="field-input @Invalid(ifscKey)" id="@(id)-ifsc" name="@(key).Ifsc" value="@account.Ifsc" maxlength="50" autocomplete="off" spellcheck="false" placeholder="e.g. HDFC Andheri or HDFC0000521"
                       data-required="Search for the bank and pick its branch"
                       role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="@(id)-suggest"
                       data-chars="search" data-bank-search="@Url.Action("Branches")" data-find="bank-find-@(key.ToLowerInvariant())"
                       aria-invalid="@AriaInvalid(ifscKey)" aria-describedby="@DescribedBy(ifscKey, id + "-ifsc")">
                <ul class="bank-suggest" id="@(id)-suggest" role="listbox" aria-label="Branches found" hidden></ul>
                @{ await FieldError(ifscKey, id + "-ifsc"); }
            </div>
            <div class="doc-column">
                <label class="field-label" for="@(id)-account">Account Number</label>
                <input class="field-input @Invalid(numberKey)" id="@(id)-account" name="@(key).AccountNumber" value="@account.AccountNumber" inputmode="numeric" maxlength="18" autocomplete="off" data-required="Enter the account number, 6 to 18 digits" data-check="account" aria-invalid="@AriaInvalid(numberKey)" aria-describedby="@DescribedBy(numberKey, id + "-account")">
                @{ await FieldError(numberKey, id + "-account"); }
            </div>
            <div class="doc-column">
                <label class="field-label" for="@(id)-account-confirm">Re-enter Account Number</label>
                @* Masked as it is typed, so the number is typed again rather than copied from the first box. *@
                <input class="field-input field-input--masked @Invalid(confirmKey)" id="@(id)-account-confirm" name="@(key).AccountNumberConfirm" value="@account.AccountNumberConfirm" inputmode="numeric" maxlength="18" autocomplete="off" spellcheck="false" data-required="Enter the account number again" data-check="match:@(id)-account" aria-invalid="@AriaInvalid(confirmKey)" aria-describedby="@DescribedBy(confirmKey, id + "-account-confirm")">
                @{ await FieldError(confirmKey, id + "-account-confirm"); }
            </div>
        </div>
    }

    // The bank and branch an IFSC names, read-only.
    private async Task BranchPanel(BankBranch? branch, string ifsc, string id)
    {
        var notFoundText = "No branch has this IFSC — pick one from the search, or check it against the cheque";
        if (ifsc.Length == 0) notFoundText = "Found once a branch is picked from the search";
        <div class="investor-panel bank-branch" id="@id">
            <div class="investor-panel__label" style="padding-bottom:10px">Bank and branch &middot; from the IFSC</div>
            <div class="investor-key-value-grid">
                @if (branch is not null)
                {
                    <div class="investor-key-value"><div class="investor-key-value__key">Bank name</div><div class="investor-key-value__value">@branch.Bank</div></div>
                    <div class="investor-key-value"><div class="investor-key-value__key">Branch name</div><div class="investor-key-value__value">@branch.Branch</div></div>
                    <div class="investor-key-value"><div class="investor-key-value__key">@Glossary.Term("IFSC") &middot; @Glossary.Term("MICR")</div><div class="investor-key-value__value">@branch.Ifsc &middot; @branch.Micr</div></div>
                }
                else
                {
                    <div class="investor-key-value investor-key-value--wide"><div class="investor-key-value__value investor-key-value__value--unread">@notFoundText</div></div>
                }
            </div>
        </div>
    }
}

@* Once the first card's head has scrolled away, this strip keeps who the step is for
   and the application number in view (sticky-app-strip.js). *@
<div class="app-sticky-strip" id="docsPin" hidden>
    <div class="app-sticky-strip__inner">
        <span class="app-sticky-strip__who">@Model.Docs.HolderName</span>
        <span class="app-sticky-strip__pan">PAN @Model.Docs.HolderPan</span>
        <span class="app-sticky-strip__app">
            <span class="app-sticky-strip__label">Application</span>
            @appNo
            <button type="button" class="doc-copy" data-copy="@appNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(CopyIcon)</svg>
            </button>
        </span>
    </div>
</div>

<div class="page-layout">
    <partial name="_ClassicSteps" model="3" />

    <form class="page-main" id="bankDetailsForm" data-guard method="post" data-partial novalidate data-partial-focus="@focus">
        @* Enter in an IFSC field looks the branch up: these are the form's first submit buttons. *@
        @if (Model.ByCheque)
        {
            <button type="submit" class="visually-hidden" id="bank-find-payment" name="Find" value="payment" formnovalidate tabindex="-1">Find the payment branch</button>
        }
        <button type="submit" class="visually-hidden" id="bank-find-repayment" name="Find" value="repayment" formnovalidate tabindex="-1">Find the repayment branch</button>

        @if (banner is not null)
        {
            <div class="alert alert-success doc-banner" role="status">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                <span>@banner</span>
            </div>
        }

        @* ===== The account the cheque is drawn on ===== *@
        @if (Model.ByCheque)
        {
            <section class="page-card section-card" id="payment">
                @{ await CardHead("Payment Bank Details", first: true); }
                <p class="page-note">The account the cheque is drawn on &middot; paid by @Model.PayMode</p>
                @{ await AccountFields("Payment", "pay", form.Payment); }
                <div class="bank-after">@{ await BranchPanel(Model.PaymentBranch, form.Payment.CleanIfsc, "pay-lookup"); }</div>

                <h3 class="section-title">Cheque Details</h3>
                <div class="doc-grid">
                    <div class="doc-column">
                        <label class="field-label" for="cheque-number">Cheque Number</label>
                        <input class="field-input @Invalid("Cheque.Number")" id="cheque-number" name="Cheque.Number" value="@form.Cheque.Number" inputmode="numeric" maxlength="6" autocomplete="off" data-required="Enter the six-digit cheque number" data-check="digits:6" data-message="Enter the six-digit cheque number" aria-invalid="@AriaInvalid("Cheque.Number")" aria-describedby="@DescribedBy("Cheque.Number", "cheque-number")">
                        @{ await FieldError("Cheque.Number", "cheque-number"); }
                    </div>
                    <div class="doc-column">
                        <label class="field-label" id="cheque-date-label" for="cheque-date">Cheque Date</label>
                        <div class="date-input @Invalid("Cheque.Date")" role="group" data-required="Enter the cheque date" data-check="dmy" data-message="Enter the cheque date as a real date, DD/MM/YYYY" data-error-id="cheque-dateError" aria-labelledby="cheque-date-label" aria-describedby="@DescribedBy("Cheque.Date", "cheque-date")">
                            <input class="date-input__part" id="cheque-date" name="Cheque.Dd" value="@form.Cheque.Dd" inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" aria-invalid="@AriaInvalid("Cheque.Date")">
                            <span class="date-input__sep">/</span>
                            <input class="date-input__part" name="Cheque.Mm" value="@form.Cheque.Mm" inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                            <span class="date-input__sep">/</span>
                            <input class="date-input__part date-input__part--year" name="Cheque.Yyyy" value="@form.Cheque.Yyyy" inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                        </div>
                        @{ await FieldError("Cheque.Date", "cheque-date"); }
                    </div>
                    <div class="doc-column">
                        <label class="field-label" for="cms-location">Axis @Glossary.Term("CMS") Branch</label>
                        @* Typed, with the backend's branches offered as the browser's own suggestions. *@
                        <input class="field-input @Invalid("Cheque.CmsLocation")" id="cms-location" name="Cheque.CmsLocation" maxlength="50" data-chars="text" value="@form.Cheque.CmsLocation" list="cms-locations" placeholder="Start typing a branch" autocomplete="off" spellcheck="false" data-required="Enter the Axis CMS branch" aria-invalid="@AriaInvalid("Cheque.CmsLocation")" aria-describedby="@(DescribedBy("Cheque.CmsLocation", "cms-location") ?? "cms-location-hint")">
                        <datalist id="cms-locations">
                            @foreach (var location in Model.CmsLocations)
                            {
                                <option value="@location"></option>
                            }
                        </datalist>
                        @{ await FieldError("Cheque.CmsLocation", "cms-location"); }
                        <p class="field-hint" id="cms-location-hint">The Axis branch the cheque is presented at &mdash; the one nearest the investor</p>
                    </div>
                </div>

                @if (Model.ChequeRead is not null)
                {
                    @* What Upload Documents read off the cheque, to check the account against. *@
                    var cheque = Model.ChequeRead;
                    <div class="bank-verified bank-after">
                        <svg class="bank-verified__tick" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
                        <div class="bank-verified__text"><strong>@cheque.State.</strong> Read off the cheque filed on <a asp-controller="Documents" asp-action="Index">Upload Documents</a>: @cheque.Lines@if (Model.FilledFromCheque) {<text>. The account and the cheque above are filled in from it &mdash; check them against the cheque before you proceed.</text>}</div>
                    </div>
                }
            </section>
        }

        @* ===== The account interest and the maturity amount go to ===== *@
        <section class="page-card section-card" id="repayment">
            @{ await CardHead("Repayment Bank Details", first: !Model.ByCheque); }
            @if (howPaid is not null)
            {
                <p class="page-note">@howPaid</p>
            }

            @* The accounts used on the folio's earlier deposits, each with Use, which fills the
               repayment fields from it and opens them (the switch above them goes off).
               Above the switch, so it shows whatever the switch says. *@
            @if (Model.AccountsOnRecord.Count > 0)
            {
                @* The five most recent are shown; the rest open on Show all. *@
                var shownAccounts = Math.Min(Model.AccountsOnRecord.Count, 5);
                <div class="on-record">
                    <div class="on-record__title">Accounts on this folio</div>
                    <ul class="on-record__list">
                        @for (var i = 0; i < shownAccounts; i++)
                        {
                            await AccountRow(i);
                        }
                    </ul>
                    @if (Model.AccountsOnRecord.Count > shownAccounts)
                    {
                        <details class="on-record__more">
                            <summary class="on-record__more-summary">Show all @Model.AccountsOnRecord.Count</summary>
                            <ul class="on-record__list">
                                @for (var i = shownAccounts; i < Model.AccountsOnRecord.Count; i++)
                                {
                                    await AccountRow(i);
                                }
                            </ul>
                        </details>
                    }
                </div>
            }

            @if (Model.ByCheque)
            {
                <div class="investor-switches">
                    <label class="investor-switch-row" for="repay-same">
                        <span>Same as the payment account</span>
                        @* The hidden false comes after the box, so an unticked box still posts a value. *@
                        <input type="checkbox" id="repay-same" name="Repayment.SameAsPayment" value="true" class="investor-switch" checked="@sameAsPayment">
                        <input type="hidden" name="Repayment.SameAsPayment" value="false">
                    </label>
                </div>
            }

            @* The repayment account is always drawn, so the toggle shows or hides it at once
               (data-show-when). Hidden, it is disabled and not posted. *@
            <fieldset class="doc-choice" data-show-when="Repayment.SameAsPayment!=true" hidden="@sameAsPayment" disabled="@sameAsPayment">
                <p class="page-note">@repaymentNote</p>
                @{ await AccountFields("Repayment", "repay", form.Repayment); }
                <div class="bank-after">@{ await BranchPanel(Model.RepaymentBranch, form.Repayment.CleanIfsc, "repay-lookup"); }</div>
                @* Paid online, a bank the gateway does not take is an error as soon as it is picked, with what to do. *@
                @if (Model.GatewayProblem is { } gatewayProblem && Model.Problem("Repayment.Ifsc") is null)
                {
                    <div class="alert alert-danger page-missing-items bank-after" role="alert">
                        <svg class="page-missing-items__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
                        <div class="page-missing-items__body">
                            <div class="page-missing-items__title">Cannot proceed: this bank is not on the payment gateway</div>
                            <p>@gatewayProblem</p>
                            <p class="page-missing-items__action"><a class="btn btn-primary btn-sm" asp-controller="Documents" asp-action="Index" data-loader="Going to Upload Documents">Change the payment mode</a></p>
                        </div>
                    </div>
                }
            </fieldset>

            <div class="bank-note bank-after">
                <strong>The account must belong to a holder on this application.</strong> A third-party account is rejected by Operations or at the time of payment.
                @if (Model.ByCheque)
                {
                    <span data-show-when="Repayment.SameAsPayment=true" hidden="@(!sameAsPayment)">Interest and the maturity amount go back to the account the cheque is drawn on.</span>
                }
            </div>
        </section>
    </form>
</div>

<footer class="page-action-bar">
    <div class="page-action-bar__inner">
        <a class="btn btn-outline-primary" asp-controller="Investor" asp-action="Index" data-loader="Going back to Investor Information">Back</a>
        <p class="page-action-bar__hint">
            @if (problemCount > 0)
            {
                var thingOrThings = problemCount == 1 ? "thing" : "things";
                @problemCount @thingOrThings <text>still to fix on this step</text>
            }
            else
            {
                var whatToEnter = Model.ByCheque ? "accounts and the cheque" : "repayment account";
                <text>Enter the @whatToEnter, then proceed to <strong>FD Configuration</strong></text>
            }
        </p>
        <div class="page-action-bar__right">
            <button type="submit" form="bankDetailsForm" class="btn btn-outline-primary" name="draft" value="1" formnovalidate data-toast="Draft saved">Save draft</button>
            <button type="submit" form="bankDetailsForm" class="btn btn-primary" id="bank-proceed" data-validate="form" data-loader="Saving the accounts&hellip;">Proceed</button>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/pages/payment.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/payment.css" asp-append-version="true" />
}

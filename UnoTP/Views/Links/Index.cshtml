@model LinksViewModel
@{
    ViewData["Title"] = "Short URL";
    ViewData["BackToDashboard"] = true;

    // The old GenerateShortURL screen: make one link, send it, and watch what the
    // links already sent are doing. Nothing is sent in this mock.
    var steps = new (string Title, string Text, string Glyph)[]
    {
        ("Make the link", "Choose what the investor has to do and where the link goes.",
            "<path d=\"M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.6 6\"></path><path d=\"M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.6-1.6\"></path>"),
        ("Send it", "The investor gets it by SMS or e-mail, and can open it on a phone.",
            "<path d=\"M3.5 6.5h17v11h-17z\"></path><path d=\"M3.5 7l8.5 6 8.5-6\"></path>"),
        ("Watch it", "The list below says whether it was opened, completed or has expired.",
            "<circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"M16.5 16.5l4 4\"></path>"),
    };
}

<div class="page-layout page-layout--wide">
    <aside class="page-rail page-rail--steps">
        <h2 class="page-rail__title">What can carry a link</h2>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 2.5H14l5 5v13a1 1 0 0 1-1 1H6.5a1.5 1.5 0 0 1-1.5-1.5V4a1.5 1.5 0 0 1 1.5-1.5z"></path><path d="M14 2.5v5h5"></path></svg>
            <div>
                <div class="page-rail__note-title">A pending application</div>
                <p>Started in the last @Model.EligibleDays days and waiting on the investor.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M8.5 7.5h7M8.5 10.5h7M12 7.5c3 0 3 5-.5 5h-3l5.5 5"></path></svg>
            <div>
                <div class="page-rail__note-title">Payment or acceptance</div>
                <p>The application decides which of the two the link asks for.</p>
            </div>
        </div>
        <div class="page-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
            <div>
                <div class="page-rail__note-title">Seen only by the investor</div>
                <p>It goes to the contacts on the application and is never shown here.</p>
            </div>
        </div>
    </aside>

    <div class="page-card">
        <div class="page-head"><h1 class="page-title">Links to investors</h1></div>
        <p class="page-note">A link asks the investor to pay for or accept their FD. The link is never shown here &mdash; it goes to the contacts on the application.</p>

        @{
            var urgent = Model.Rows.Count(r => r.Urgent);
        }
        <div class="alert alert-warning register-notice">
            <svg class="register-notice__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".8" fill="currentColor"></circle></svg>
            <div>
                <div class="register-notice__title">An unpaid application is cancelled after @Model.EligibleDays days</div>
                <p>
                    The investor has @Model.EligibleDays days from the day the application is created to pay for and accept the FD.
                    If they have not by then, the application cancels itself and a new one has to be started &mdash; so only applications
                    from the last @Model.EligibleDays days are listed here, and each row says how long it has left.
                    @if (urgent > 0)
                    {
                        <strong>@urgent @(urgent == 1 ? "application has" : "applications have") 3 days or fewer left.</strong>
                    }
                </p>
            </div>
        </div>

        <div class="register-filters">
            <div class="register-pills" role="group" aria-label="Filter by state">
                <button type="button" class="register-pill register-pill--on" data-state="all">All <span class="register-pill__number" data-count="all"></span></button>
                @foreach (var st in LinksViewModel.States)
                {
                    <button type="button" class="register-pill" data-state="@st.Key">@st.Label <span class="register-pill__number" data-count="@st.Key"></span></button>
                }
            </div>
            <label class="register-search">
                <span class="visually-hidden">Search links</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
                <input type="search" id="registerSearch" maxlength="50" placeholder="Application, investor or purpose" autocomplete="off">
            </label>
        </div>

        <table class="register-table">
            <colgroup>
                <col style="width:19%"><col style="width:20%"><col style="width:15%">
                <col style="width:11%"><col style="width:11%"><col style="width:14%"><col style="width:10%">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Application</th>
                    <th scope="col">Investor</th>
                    <th scope="col">Asks for</th>
                    <th scope="col">Sent</th>
                    <th scope="col">Expires</th>
                    <th scope="col">State</th>
                    <th scope="col" class="register-table__actions"><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody id="registerRows">
                @foreach (var l in Model.Rows)
                {
                    <tr data-state="@l.State" data-validity="@Model.Purposes.First(x => x.Key == l.PurposeKey).Validity"
                        data-search="@($"{l.AppNo} {l.Investor} {l.Contact} {l.Purpose} {l.Status}".ToLowerInvariant())">
                        <td data-label="Application">
                            <strong>@l.AppNo</strong>
                            <div class="register-table__sub@(l.Urgent ? " register-table__sub--urgent" : "")">@l.Countdown</div>
                        </td>
                        <td data-label="Investor">@l.Investor<div class="register-table__sub">@l.Contact</div></td>
                        <td data-label="Asks for">@l.Purpose</td>
                        <td data-label="Sent">@l.Sent</td>
                        <td data-label="Expires">@l.Expires</td>
                        <td data-label="State"><span class="@Tones.Word(l.Tone)">@l.Status</span></td>
                        <td class="register-table__actions">
                            @if (l.State == "none")
                            {
                                <form method="post" asp-action="Send">
                                    <input type="hidden" name="appNo" value="@l.AppNo" /><input type="hidden" name="purpose" value="@l.PurposeKey" />
                                    <button type="submit" class="link-button" data-loader="Sending the link&hellip;">Send link</button>
                                </form>
                            }
                            else if (l.State == "done")
                            {
                                <span class="register-no-link">&mdash;</span>
                            }
                            else
                            {
                                <form method="post" asp-action="Send">
                                    <input type="hidden" name="appNo" value="@l.AppNo" /><input type="hidden" name="purpose" value="@l.PurposeKey" />
                                    <button type="submit" class="link-button" data-loader="Sending a new link&hellip;">Regenerate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="register-empty" id="registerEmpty" hidden>No application matches that filter.</p>

        <div class="register-pager">
            <p class="register-pager__count" id="registerCount"></p>
            <div class="register-pager__nav">
                <button type="button" class="register-page register-page--step" id="registerPrev" aria-label="Previous page">&lsaquo;</button>
                <div class="register-pager__pages" id="registerPages"></div>
                <button type="button" class="register-page register-page--step" id="registerNext" aria-label="Next page">&rsaquo;</button>
            </div>
        </div>
    </div>
</div>

<div class="app-toast" id="toast" role="status" aria-live="polite" data-toast-now="@(ViewData["Toast"] as string)"></div>

@section Scripts {
    <script src="~/js/pages/links.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/links.css" asp-append-version="true" />
}

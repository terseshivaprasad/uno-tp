@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["FirstNavActive"] = true;

    var notes = (await Lookups.ReferenceAsync()).DashboardNotes;
    var draftsShown = Model.Drafts.Take(DashboardViewModel.DraftsShown).ToList();
    var hasMoreDrafts = Model.Drafts.Count > DashboardViewModel.DraftsShown;
}
@* The dashboard: the four steps down the left, the tiles on the right, then the work
   waiting on the partner and the applications they can continue.
   Which tiles show, and whether each is on, comes from DashboardViewModel. *@

@functions {
#pragma warning disable CS1998 // Razor makes these helpers async; there is nothing to await in them.

    // One tile. A link while its feature is on; a greyed card with the reason while it is off.
    // Pressing an off tile reloads the dashboard with the reason in the alert at the top.
    async Task Tile(DashboardTile tile)
    {
        var icon = $"<svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">{tile.Glyph}</svg>";
        var isOff = tile.Off is not null || tile.Controller is null;

        if (isOff)
        {
            <a class="dashboard-tile dashboard-tile--off" asp-controller="Dashboard" asp-action="Index" asp-route-off="@tile.Key" title="@tile.Why">
                <span class="dashboard-tile__icon">@Html.Raw(icon)</span>
                <span class="dashboard-tile__title">@tile.Title</span>
                <span class="badge bg-warning-subtle text-warning-emphasis dashboard-tile__off">@tile.Off</span>
            </a>
        }
        else
        {
            <a class="dashboard-tile" asp-controller="@tile.Controller" asp-action="Index">
                <span class="dashboard-tile__icon">@Html.Raw(icon)</span>
                <span class="dashboard-tile__title">@tile.Title</span>
            </a>
        }
    }
}

@if (Model.Closed is not null)
{
    @* Shown when a closed page sent the partner back here, or an off tile was pressed. *@
    <div class="alert alert-danger dashboard-closed" role="status">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 7v6"></path><circle cx="12" cy="16.8" r=".6" fill="currentColor"></circle></svg>
        <span>@Model.Closed</span>
    </div>
}

<div class="dashboard-panel">
    <section class="dashboard-steps">
        <h1 class="dashboard-steps__title">Book a FD in just <strong>4 easy steps....</strong></h1>
        <ol class="dashboard-steps__list">
            @for (var i = 0; i < DashboardViewModel.StepLabels.Length; i++)
            {
                <li class="dashboard-step">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(DashboardViewModel.StepGlyphs[i])</svg>
                    <span>@DashboardViewModel.StepLabels[i]</span>
                </li>
            }
        </ol>

        @* Opens the dialog in _RequiredDocs. It is a browser popover, so no script is needed. *@
        <button type="button" class="dashboard-docs btn-reset" popovertarget="requiredDocsModal" aria-haspopup="dialog"><em>Click here</em> to see the list of required documents</button>

        <div class="dashboard-note">
            <div class="dashboard-note__title">Note</div>
            <ul>
                @foreach (var note in notes)
                {
                    <li>@note</li>
                }
            </ul>
        </div>
    </section>

    <section class="dashboard-actions">
        <h2 class="dashboard-actions__title">Apply for a new FD</h2>
        <div class="dashboard-tiles">
            @foreach (var tile in Model.NewFd)
            {
                await Tile(tile);
            }
        </div>

        <hr class="dashboard-actions__rule">
        <h2 class="dashboard-actions__title">FD Services</h2>
        <div class="dashboard-tiles">
            @foreach (var tile in Model.Services)
            {
                await Tile(tile);
            }
        </div>

        @* Work waiting on the partner, one count per kind, each a link to the page that handles it. *@
        @if (Model.Work.Count > 0)
        {
            <hr class="dashboard-actions__rule">
            <nav class="work-counts" aria-labelledby="workTitle">
                <h2 class="dashboard-actions__title" id="workTitle">Waiting on you</h2>
                <ul class="work-counts__list">
                    @foreach (var work in Model.WorkByUrgency)
                    {
                        <li>
                            <a class="work-count work-count--@work.Tone" asp-controller="@work.Controller" asp-action="Index" title="@work.Detail">
                                <span class="work-count__n">@work.Count</span>
                                <span class="work-count__label">@work.Title</span>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        @* The partner's applications opened and not yet submitted: the latest few here,
           the full list on Investor Identification. *@
        @if (Model.Drafts.Count > 0)
        {
            <hr class="dashboard-actions__rule">
            <section class="drafts" aria-labelledby="draftsTitle">
                <div class="drafts__head">
                    <h2 class="dashboard-actions__title drafts__title" id="draftsTitle">Continue an application <span class="drafts__count">@Model.Drafts.Count</span></h2>
                    @if (hasMoreDrafts)
                    {
                        <a class="drafts__all" asp-controller="NewApplication" asp-action="Index">View all <span aria-hidden="true">&rsaquo;</span></a>
                    }
                </div>
                <partial name="_Drafts" model="@(new DraftsBlock(draftsShown, Model.Drafts.Count, Partial: false))" />
            </section>
        }

        @if (Model.Admin.Count > 0)
        {
            <hr class="dashboard-actions__rule">
            <h2 class="dashboard-actions__title">Administration</h2>
            <div class="dashboard-tiles">
                @foreach (var tile in Model.Admin)
                {
                    await Tile(tile);
                }
            </div>
        }
    </section>
</div>

<partial name="_RequiredDocs" />

@section Styles {
    <link rel="stylesheet" href="~/css/pages/dashboard.css" asp-append-version="true" />
}

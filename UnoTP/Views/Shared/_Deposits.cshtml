@model DepositsBlock
@* The identified investor's deposits, each with where it stands; Renew on one that
   is due opens its renewal at Upload Documents. Under the investor's record on
   Investor Identification. *@
<section class="identify-holder">
    <div class="identify-holder__head">
        <span class="identify-holder__no">2</span>
        <span class="identify-holder__name">Deposits</span>
        <span class="status-word @(Model.Due > 0 ? "text-success-emphasis" : "text-secondary-emphasis")">@Model.Due due for renewal</span>
    </div>
    @if (Model.Off is not null)
    {
        <p class="field-hint">@Model.Off Renew is disabled until it is back.</p>
    }
    <table class="register-table">
        <colgroup>
            <col style="width:20%"><col style="width:16%"><col style="width:18%"><col style="width:13%">
            <col style="width:18%"><col style="width:15%">
        </colgroup>
        <thead>
            <tr>
                <th scope="col">Deposit</th>
                <th scope="col" class="payin-slip-table__amount">Amount</th>
                <th scope="col">Rate &middot; tenure</th>
                <th scope="col">Matures on</th>
                <th scope="col">Status</th>
                <th scope="col" class="register-table__actions"><span class="visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.InOrder)
            {
                var tags = DepositsBlock.Tags(d);
                <tr data-state="@d.Status">
                    <td data-label="Deposit">
                        <strong>@d.Number</strong>
                        @if (tags.Length > 0)
                        {
                            <div class="register-table__sub">@tags</div>
                        }
                    </td>
                    <td data-label="Amount" class="payin-slip-table__amount">
                        @Money.Rupees(d.Amount)
                        @if (d.MaturityAmount != d.Amount)
                        {
                            <div class="register-table__sub">@Money.Rupees(d.MaturityAmount) at maturity</div>
                        }
                    </td>
                    <td data-label="Rate · tenure">@d.Rate.ToString("0.00")% &middot; @d.TenureMonths months<div class="register-table__sub">@Model.PayoutName(d.Payout)</div></td>
                    <td data-label="Matures on">@Money.Day(d.MaturesOn)</td>
                    <td data-label="Status">
                        @* One block, so on a phone the note stays under the status and not beside it. *@
                        <div>
                            <span class="chip @DepositsBlock.StatusTone(d.Status)" title="@Model.Remark(d)">@DepositsBlock.StatusLabel(d.Status)</span>
                            <div class="register-table__sub">@Model.Note(d)</div>
                        </div>
                    </td>
                    <td data-label="" class="register-table__actions">
                        @if (d.Renewable)
                        {
                            <form method="post" asp-controller="Renew" asp-action="Start" asp-route-number="@d.Number">
                                <button type="submit" class="btn btn-primary" disabled="@(Model.Off is not null)" title="@Model.Off" data-loader="Opening the renewal&hellip;">Renew</button>
                            </form>
                        }
                        else if (d.Renewal is { Submitted: false, Mine: true } draft)
                        {
                            @* A renewal still being entered: picked up where it stopped, or taken back. *@
                            <form method="post" asp-controller="NewApplication" asp-action="Continue">
                                <input type="hidden" name="draft" value="@draft.AppNo">
                                <button type="submit" class="btn btn-primary" data-loader="Opening the renewal&hellip;">Continue</button>
                            </form>
                            <form method="post" asp-controller="Renew" asp-action="Cancel" asp-route-number="@d.Number" class="deposits-cancel">
                                <button type="submit" class="link-button btn-reset" disabled="@(Model.Off is not null)" title="@Model.Off"
                                        data-confirm="@Messages.RenewFd.ConfirmCancelRenewalDraft(d.Number)" data-loader="Cancelling the renewal request&hellip;">Cancel request</button>
                            </form>
                        }
                        else if (d.Renewal is { Submitted: true } renewal)
                        {
                            @* A submitted renewal is taken back only while it is digital and the investor has not accepted it. *@
                            var cannot = Model.Off ?? (renewal.CanCancel ? null : renewal.CancelWhy);
                            <form method="post" asp-controller="Renew" asp-action="Cancel" asp-route-number="@d.Number">
                                <button type="submit" class="btn btn-outline-primary" disabled="@(cannot is not null)" title="@cannot"
                                        data-confirm="@Messages.RenewFd.ConfirmCancelRenewal(d.Number)" data-loader="Cancelling the renewal request&hellip;">Cancel request</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* The old renewal screen's notes, as the backend gives them: closed until asked for. *@
    <details class="deposits-notes">
        <summary>Renewal notes</summary>
        <ul>
            @foreach (var n in Model.Ref.RenewalNotes)
            {
                <li>@n</li>
            }
        </ul>
    </details>
</section>

@model ReadCardsBlock
@* What the PAN was checked with: a slim row per check - what it is, where it
   stands, what it matched - with the explanation behind the info mark by its name.
   Only a failure keeps its explanation written out, under its row, since it says
   what is wrong and what follows. Where NSDL has not verified the PAN, it is asked
   again from _NsdlRetry, under the PAN's own box. *@
<ul class="doc-checks">
    @foreach (var item in Model.Items)
    {
        var card = item.Card;
        var explainInline = card.Kind == "is-failed" && card.From.Length > 0;
        <li class="doc-check @card.Kind" id="@(item.Id is null ? null : "read-" + item.Id)" tabindex="@(item.Id is null ? null : "-1")">
            <span class="doc-check__kind">@item.Kind
                @if (!explainInline && card.From.Length > 0)
                {
                    <span class="hover-hint hover-hint--info hover-hint--mark" tabindex="0" data-tip="@card.From"><span class="visually-hidden">@card.From</span></span>
                }
            </span>
            <span class="doc-check__state"><span class="doc-check__dot" aria-hidden="true"></span>@card.State</span>
            <span class="doc-check__lines" title="@card.Lines">@card.Lines</span>
            @if (explainInline)
            {
                <p class="doc-check__from">@card.From</p>
            }
            @if (item.Error is not null)
            {
                <p class="field-error" role="alert">@item.Error</p>
            }
        </li>
    }
</ul>

# Code rules for Uno TP. The build on every push (see .github/workflows/build.yml)
# fails on any of the warnings below, so dead code does not build up.
root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space

[*.{cs,cshtml}]
indent_size = 4

[*.{json,yml,yaml,csproj,props,js,css}]
indent_size = 2

[*.cs]
# A using line nothing in the file needs.
dotnet_diagnostic.IDE0005.severity = warning
# A private member nothing calls, or nothing reads.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
# A value assigned and never used; a parameter never used.
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

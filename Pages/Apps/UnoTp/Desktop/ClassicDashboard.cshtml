@page "/Apps/UnoTp/Classic"
@model UnoTp.Pages.Apps.UnoTpApp.Desktop.ClassicDashboardModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Desktop
@using UnoTp.Models
@{
    ViewData["Title"] = "Uno TP Dashboard (classic)";
    ViewData["FirstNavPage"] = "/Apps/UnoTp/Desktop/ClassicDashboard";
    ViewData["FirstNavActive"] = true;

    // The old WA_FD_UNOTP/Dashboard as it stands today: four steps down the left,
    // two rows of big icon tiles on the right. Tile glyphs are solid, as the old
    // site's SVG icons are.
    var steps = new[] { "Upload documents", "Investor information", "Payment & repayment", "Fixed deposit details" }
        .Zip(ClassicDashboardModel.StepGlyphs, (label, glyph) => (Label: label, Glyph: glyph)).ToArray();

    // Each tile's glyph says what it opens, drawn solid in the old site's style:
    // slate shapes with white detail knocked out of them.
    // A page with its corner folded over: the body, then the fold, split by a white gap.
    const string page = "<path d=\"M5 3.5a2 2 0 0 1 2-2h6.5V7a2 2 0 0 0 2 2H21v12.5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z\" fill=\"currentColor\"></path><path d=\"M15 1.5l6 6h-5a1 1 0 0 1-1-1z\" fill=\"currentColor\"></path>";
    const string white = "stroke=\"#fff\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";
    const string slate = "stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";

    var newFd = new (string Title, string Glyph, string? Page, string? Off)[]
    {
        // A new page with a plus.
        ("Create New FD", page + $"<path d=\"M13 11.5v8M9 15.5h8\" {white} stroke-width=\"2.4\"></path>", "/Apps/UnoTp/Desktop/ClassicSearchInvestor", ConsoleAdmin.OffLabel("new-fd")),
        // A pay-in slip: a torn-off receipt with the rupee on it.
        ("PIS Generation - Axis", "<path d=\"M5 3.5a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v18l-2.3-1.5-2.4 1.5-2.3-1.5-2.3 1.5-2.4-1.5L5 21.5z\" fill=\"currentColor\"></path>"
            + $"<path d=\"M9 7h6M9 10h6M12.3 7c2.6 0 2.6 5-.8 5H9.4l4.8 4.3\" {white} stroke-width=\"1.8\" fill=\"none\"></path>", "/Apps/UnoTp/Desktop/ClassicPayInSlip", ConsoleAdmin.OffLabel("pis")),
        // Looking an application up: a page with a magnifier.
        ("View existing application", page + $"<circle cx=\"12.5\" cy=\"14.5\" r=\"3.2\" {white} stroke-width=\"2\"></circle><path d=\"M14.9 16.9l2.6 2.6\" {white} stroke-width=\"2.2\"></path>", "/Apps/UnoTp/Desktop/ClassicViewApplication", ConsoleAdmin.OffLabel("view-app")),
        // Two chain links.
        ("Short URL", $"<g {slate} stroke-width=\"2.8\"><path d=\"M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.6 6\"></path><path d=\"M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.6-1.6\"></path></g>", "/Apps/UnoTp/Desktop/ClassicShortUrl", ConsoleAdmin.OffLabel("short-url")),
    };

    var services = new (string Title, string Glyph, string? Page, string? Off)[]
    {
        // Where an application stands: a clipboard with a tick.
        ("Application status", "<rect x=\"4.5\" y=\"3.5\" width=\"15\" height=\"19\" rx=\"2\" fill=\"currentColor\"></rect><rect x=\"8.5\" y=\"1.5\" width=\"7\" height=\"4\" rx=\"1\" fill=\"currentColor\" stroke=\"#fff\" stroke-width=\"1.4\"></rect>"
            + $"<path d=\"M8.5 14l2.5 2.5 4.8-5\" {white} stroke-width=\"2.2\" fill=\"none\"></path>", null, ConsoleAdmin.OffLabel("app-status")),
        // Rolling a deposit over: arrows turning round the rupee.
        ("Renew FD", $"<g {slate} stroke-width=\"2.3\"><path d=\"M20.5 12a8.5 8.5 0 0 1-15 5.5\"></path><path d=\"M3.5 12a8.5 8.5 0 0 1 15-5.5\"></path><path d=\"M19.5 2.5V7H15\"></path><path d=\"M4.5 21.5V17H9\"></path></g>"
            + $"<path d=\"M10.2 9.2h3.6M10.2 11h3.6M12.1 9.2c1.6 0 1.6 3.4-.6 3.4h-1.3l3 2.6\" {slate} stroke-width=\"1.4\"></path>", null, ConsoleAdmin.OffLabel("renew")),
    };

    // Only an administrator is shown this, and only they can open the page.
    var admin = new (string Title, string Glyph, string? Page, string? Off)[]
    {
        // Sliders: three settings, each with its own knob.
        ("Console Admin", $"<g {slate} stroke-width=\"2.4\"><path d=\"M3.5 7h17M3.5 12h17M3.5 17h17\"></path></g>"
            + "<circle cx=\"9\" cy=\"7\" r=\"2.9\" fill=\"currentColor\" stroke=\"#fff\" stroke-width=\"1.6\"></circle>"
            + "<circle cx=\"15\" cy=\"12\" r=\"2.9\" fill=\"currentColor\" stroke=\"#fff\" stroke-width=\"1.6\"></circle>"
            + "<circle cx=\"7\" cy=\"17\" r=\"2.9\" fill=\"currentColor\" stroke=\"#fff\" stroke-width=\"1.6\"></circle>", "/Apps/UnoTp/Desktop/ClassicAdmin", null),
    };
}

@functions {
    // One big grey tile. A tile the mock has not built yet toasts instead of
    // navigating; one carrying a reason in Off cannot be opened at all.
    async Task Tile((string Title, string Glyph, string? Page, string? Off) t)
    {
        var icon = $"<svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">{t.Glyph}</svg>";
        if (t.Off is not null)
        {
            <div class="classic-tile classic-tile--off" aria-disabled="true">
                <span class="classic-tile__icon">@Html.Raw(icon)</span>
                <span class="classic-tile__title">@t.Title</span>
                <span class="classic-tile__off">@t.Off</span>
            </div>
        }
        else if (t.Page is not null)
        {
            <a class="classic-tile" asp-page="@t.Page"><span class="classic-tile__icon">@Html.Raw(icon)</span><span class="classic-tile__title">@t.Title</span></a>
        }
        else
        {
            <button type="button" class="classic-tile btn-reset js-stub"><span class="classic-tile__icon">@Html.Raw(icon)</span><span class="classic-tile__title">@t.Title</span></button>
        }
        await Task.CompletedTask;
    }
}

<div class="classic">
    <section class="classic-steps">
        <h1 class="classic-steps__title">Book a FD in just <strong>4 easy steps....</strong></h1>
        <ol class="classic-steps__list">
            @foreach (var s in steps)
            {
                <li class="classic-step">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(s.Glyph)</svg>
                    <span>@s.Label</span>
                </li>
            }
        </ol>
        <button type="button" class="classic-docs btn-reset" id="openRequiredDocs" aria-haspopup="dialog"><em>Click here</em> to see the list of required documents</button>
        <div class="classic-note">
            <div class="classic-note__title">Note</div>
            <ul>
                <li>Currently Esarathi is enabled with individual and sole proprietorship investment only.</li>
                <li>Verification of the Fixed Deposit is subject to validation of the submitted documents by the Operations team.</li>
            </ul>
        </div>
    </section>

    <section class="classic-actions">
        <h2 class="classic-actions__title">Apply for a new FD</h2>
        <div class="classic-tiles">
            @foreach (var t in newFd) { await Tile(t); }
        </div>
        <hr class="classic-actions__rule">
        <h2 class="classic-actions__title">FD Services</h2>
        <div class="classic-tiles">
            @foreach (var t in services) { await Tile(t); }
        </div>
        @if (ConsoleAdmin.IsAdmin)
        {
            <hr class="classic-actions__rule">
            <h2 class="classic-actions__title">Administration</h2>
            <div class="classic-tiles">
                @foreach (var t in admin) { await Tile(t); }
            </div>
        }
    </section>
</div>

<partial name="_RequiredDocs" />

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/console.js"></script>
    <script src="~/js/required-docs.js" asp-append-version="true"></script>
}

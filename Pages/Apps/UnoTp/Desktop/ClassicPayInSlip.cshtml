@page "/Apps/UnoTp/Classic/PayInSlip"
@model UnoTp.Pages.Apps.UnoTpApp.Desktop.ClassicPayInSlipModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Desktop
@{
    ViewData["Title"] = "Pay In Slip Generation (classic)";
    ViewData["FirstNavPage"] = "/Apps/UnoTp/Desktop/ClassicDashboard";

    // The old PayinSlipGenerationAxis screen. That page opened on an empty form
    // and made you search before it would show anything; this one opens on the
    // last fourteen days of applications, which is every one a slip can still be
    // made for, and keeps the search for narrowing that down.
    var earliest = ClassicPayInSlipModel.Earliest;
    var today = ClassicPayInSlipModel.Today;
    var listed = ClassicPayInSlipModel.Listed.ToList();
    var pending = listed.Count(r => r.State == "pending" && !r.Blocked);
    var blocked = listed.Count(r => r.Blocked);
}

<div class="csi csi--wide">
    <aside class="csi-rail csi-rail--steps">
        <h2 class="csi-rail__title">What needs a slip</h2>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect><path d="M3.5 10h17"></path></svg>
            <div>
                <div class="csi-rail__note-title">Money arriving on paper</div>
                <p>A cheque or DD is paid in at an Axis CMS branch with a slip. Anything paid online never reaches this list.</p>
            </div>
        </div>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 6.5V12l3.5 2.5"></path></svg>
            <div>
                <div class="csi-rail__note-title">Raised in the last @ClassicPayInSlipModel.WindowDays days</div>
                <p>An older application has cancelled itself, so its cheque can no longer be paid in against it.</p>
            </div>
        </div>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 6.5l-11 11-5.5-5.5"></path></svg>
            <div>
                <div class="csi-rail__note-title">Accepted, if it came in digitally</div>
                <p>A physical application arrives signed. A digital one is not signed until the investor accepts it, so its slip waits on that.</p>
            </div>
        </div>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 2.5H14l5 5v13a1 1 0 0 1-1 1H6.5a1.5 1.5 0 0 1-1.5-1.5V4a1.5 1.5 0 0 1 1.5-1.5z"></path><path d="M14 2.5v5h5"></path><path d="M8.5 13h7M8.5 16.5h4"></path></svg>
            <div>
                <div class="csi-rail__note-title">One slip, one application</div>
                <p>A slip carries a single application's money to a single branch, so it is generated from that application's own row.</p>
            </div>
        </div>
    </aside>

    <div class="csi-card">
        <div class="csi-drafts__head">
            <h1 class="csi-card__title csi-card__title--plain">Pay In Slip Generation &mdash; Axis</h1>
            <p class="csi-drafts__sub">Every application raised in the last @ClassicPayInSlipModel.WindowDays days whose money is coming by cheque or DD. @pending of @listed.Count @(pending == 1 ? "is" : "are") ready for a slip@(blocked > 0 ? $", and {blocked} {(blocked == 1 ? "is" : "are")} held back for acceptance" : "").</p>
        </div>

        <form class="pis-form" id="pisForm" novalidate>
            <fieldset class="csi-searchby csi-searchby--first">
                <legend class="csi-label">Search By</legend>
                <label class="csi-radio">
                    <input type="radio" name="pisSearchBy" value="dates" checked>
                    <span>Application date</span>
                </label>
                <label class="csi-radio">
                    <input type="radio" name="pisSearchBy" value="appno">
                    <span>Application number</span>
                </label>
            </fieldset>

            <div class="pis-form__row pis-form__row--search">
                <div class="csi-field" data-for="dates">
                    <span class="csi-label" id="pisFromLabel">From Date</span>
                    @* The three-box control the old wizard steps use. *@
                    <div class="csi-date" data-date id="pisFrom" role="group" aria-labelledby="pisFromLabel">
                        <input class="csi-date__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" value="@earliest.ToString("dd")">
                        <span class="csi-date__sep">/</span>
                        <input class="csi-date__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off" value="@earliest.ToString("MM")">
                        <span class="csi-date__sep">/</span>
                        <input class="csi-date__part csi-date__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off" value="@earliest.ToString("yyyy")">
                    </div>
                </div>

                <div class="csi-field" data-for="dates">
                    <span class="csi-label" id="pisToLabel">To Date</span>
                    <div class="csi-date" data-date id="pisTo" role="group" aria-labelledby="pisToLabel">
                        <input class="csi-date__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off" value="@today.ToString("dd")">
                        <span class="csi-date__sep">/</span>
                        <input class="csi-date__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off" value="@today.ToString("MM")">
                        <span class="csi-date__sep">/</span>
                        <input class="csi-date__part csi-date__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off" value="@today.ToString("yyyy")">
                    </div>
                </div>

                <div class="csi-field pis-field--appno" data-for="appno" hidden>
                    <label class="csi-label" for="pisAppNo">Application Number</label>
                    <input class="csi-control" id="pisAppNo" maxlength="18" autocomplete="off" spellcheck="false" placeholder="e.g. FBBMFL26F10000">
                </div>

                <div class="csi-field csi-field--check pis-field--actions">
                    <button type="submit" class="csi-btn csi-btn--primary pis-btn--search">Search</button>
                    <button type="button" class="csi-btn csi-btn--back" id="pisClear">Clear</button>
                </div>
            </div>

            <p class="csi-error" id="pisError" hidden></p>
            <p class="csi-hint" id="pisScope">Showing the last @ClassicPayInSlipModel.WindowDays days &mdash; @earliest.ToString("dd/MM/yyyy") to @today.ToString("dd/MM/yyyy").</p>
        </form>

        @if (blocked > 0)
        {
            <p class="pis-flag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                <span><strong>@blocked digital @(blocked == 1 ? "application is" : "applications are") waiting on the investor's acceptance</strong> &mdash; no slip until it is in. Send the link from the row.</span>
            </p>
        }

        <table class="su-table pis-table">
            <colgroup>
                <col style="width:16%"><col style="width:11%"><col style="width:9%"><col style="width:12%">
                <col style="width:11%"><col style="width:13%"><col style="width:9%"><col style="width:11%">
                <col style="width:8%">
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Application</th>
                    <th scope="col">Investor</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Instrument</th>
                    <th scope="col">Type</th>
                    <th scope="col">CMS branch</th>
                    <th scope="col">Applied</th>
                    <th scope="col">Slip</th>
                    <th scope="col" class="su-table__act"><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody id="pisRows">
                @* The cancelled applications are in the table but never listed: only a
                   search by number reaches them, so they can say what became of them. *@
                @foreach (var r in listed.Concat(ClassicPayInSlipModel.Lapsed))
                {
                    <tr data-state="@r.State" data-appno="@r.AppNo.ToLowerInvariant()" data-date="@r.Applied.ToString("yyyy-MM-dd")"
                        data-window="@(r.InWindow ? "in" : "out")" data-amount="@r.Amount" data-branch="@r.Branch" data-mode="@(r.Digital ? "digital" : "physical")"
                        data-blocked="@(r.Blocked ? "yes" : "no")" hidden="@(!r.InWindow)">
                        <td data-label="Application">
                            <strong>@r.AppNo</strong>
                            <div class="su-table__sub@(r.Urgent ? " su-table__sub--urgent" : "")">@r.Countdown</div>
                        </td>
                        <td data-label="Investor">@r.Investor</td>
                        <td data-label="Amount" class="pis-table__amt">@ClassicPayInSlipModel.Rupees(r.Amount)</td>
                        <td data-label="Instrument">
                            @r.Instrument @r.InstrumentNo
                            <div class="su-table__sub">@r.DrawnOn</div>
                        </td>
                        <td data-label="Type">
                            <span class="pis-tag @(r.Digital ? "pis-tag--digital" : "pis-tag--physical")">@r.Tag</span>
                            <div class="su-table__sub@(r.Blocked ? " su-table__sub--urgent" : "")">@r.TagNote</div>
                        </td>
                        <td data-label="CMS branch">@r.Branch</td>
                        <td data-label="Applied">@r.Applied.ToString("dd/MM/yyyy")</td>
                        <td data-label="Slip" class="pis-table__slip">
                            <span class="@r.SlipTone" data-status>@r.SlipLabel</span>
                            <div class="su-table__sub" data-slip-detail>@r.SlipNote</div>
                        </td>
                        <td class="su-table__act">
                            @if (r.Blocked)
                            {
                                <button type="button" class="csi-link" data-chase>Send link</button>
                            }
                            else if (r.State == "pending")
                            {
                                <button type="button" class="csi-link" data-make>Generate</button>
                            }
                            else if (r.State == "generated")
                            {
                                <button type="button" class="csi-link" data-make>Reprint</button>
                            }
                            else
                            {
                                <span class="su-nolink">&mdash;</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="su-empty" id="pisEmpty" hidden></p>

        <div class="su-pager">
            <p class="su-pager__count" id="pisCount"></p>
            <div class="su-pager__nav">
                <button type="button" class="su-page su-page--step" id="pisPrev" aria-label="Previous page">&lsaquo;</button>
                <div class="su-pager__pages" id="pisPages"></div>
                <button type="button" class="su-page su-page--step" id="pisNext" aria-label="Next page">&rsaquo;</button>
            </div>
        </div>
    </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/console.js"></script>
    <script src="~/js/classic-payin-slip.js" asp-append-version="true"></script>
}

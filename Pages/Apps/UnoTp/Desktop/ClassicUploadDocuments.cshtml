@page "/Apps/UnoTp/Classic/UploadDocuments"
@model UnoTp.Pages.Apps.UnoTpApp.Desktop.ClassicUploadDocumentsModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Desktop
@{
    ViewData["Title"] = "Upload Documents (classic)";
    ViewData["FirstNavPage"] = "/Apps/UnoTp/Desktop/ClassicDashboard";

    // The old WA_FD_UNOTP/UploadInvestorDocuments: three documents across the top,
    // the one the payment carries under them, and the details the application is
    // sourced under. Nothing is uploaded anywhere - a file is read where it was
    // picked and named back to the partner.
}

@functions {
    // One document slot: its picker, the eye and bin that act on what was picked,
    // and the box the file lands in. Key names the slot to the script.
    void Slot(string key, string label, ClassicUploadDocumentsModel.Accepts accepts)
    {
        <div class="cud-slot" data-slot="@key">
            <div class="cud-slot__frame">
            @* View and replace only: a document already on the application is
               swapped for a better copy, never left empty by this step. They sit
               on the card's own foot, since it is the card they act on. *@
            <div class="cud-slot__tools">
                <button type="button" class="cud-tool" data-view title="View @label" disabled>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.8 12S5.5 5.5 12 5.5 22.2 12 22.2 12 18.5 18.5 12 18.5 1.8 12 1.8 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <span>View</span>
                </button>
                <button type="button" class="cud-tool" data-replace title="Replace @label" disabled>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 12a8.5 8.5 0 0 1-14.6 5.9"></path><path d="M3.5 12a8.5 8.5 0 0 1 14.6-5.9"></path><path d="M18.5 2.5V7H14"></path><path d="M5.5 21.5V17H10"></path></svg>
                    <span>Replace</span>
                </button>
            </div>

            <button type="button" class="cud-drop" data-drop aria-describedby="@(key)Error">
                <span class="cud-drop__idle">
                    <span class="cud-drop__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16.5V4.5"></path><path d="M7.5 9L12 4.5 16.5 9"></path><path d="M4.5 15v3.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V15"></path></svg>
                    </span>
                    <span class="cud-drop__title">Click to upload @label</span>
                    <span class="cud-drop__hint">Supported format: @accepts.Label (max. @(accepts.MaxMb) MB)</span>
                    @* What this particular document must be, where that is more
                       than a format: an Aadhaar has to come unmasked. *@
                    <span class="cud-drop__must" data-must hidden></span>
                    @* And what will be done with it, before the partner spends a
                       minute looking for the file: the copy is identified, read
                       by OCR and put to whoever keeps the register behind it. A
                       partner who knows the issuer will be asked picks the copy
                       that issuer would recognise. *@
                    <span class="cud-drop__with" data-with hidden></span>
                </span>
                @* Nothing can be picked here yet, and what is in the way. *@
                <span class="cud-drop__locked" hidden>
                    <span class="cud-drop__lock" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="10.5" width="14" height="9.5" rx="1.6"></rect><path d="M8.5 10.5V7.8a3.5 3.5 0 0 1 7 0v2.7"></path></svg>
                    </span>
                    <span class="cud-drop__title" data-lock></span>
                    <span class="cud-drop__hint">The type decides what the copy is checked as, and with whom.</span>
                </span>
                @* Three things happen to a copy before it is filed, and the box
                   names each one as it runs: what the document is, what OCR reads
                   off it, and what the register behind it answers. A partner who
                   walks away mid-check comes back to a box that says where it got
                   to rather than a spinner that could mean anything. *@
                <span class="cud-drop__busy" hidden>
                    <span class="cud-drop__spinner" aria-hidden="true"></span>
                    <span class="cud-drop__checking" data-checking>Identifying the document&hellip;</span>
                    <span class="cud-drop__step" data-step></span>
                </span>
                <span class="cud-drop__done" hidden>
                    <span class="cud-drop__check" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                    </span>
                    <span class="cud-drop__file" data-file></span>
                    <span class="cud-drop__size" data-size></span>
                </span>
            </button>
            @* A slot the application has no use for says so, and says why: a
               card that only reads NOT APPLICABLE leaves the partner wondering
               whether they have done something wrong. *@
            <span class="cud-slot__na" data-na hidden>
                <span class="cud-slot__na-mark" aria-hidden="true"></span>
                <span class="cud-slot__na-text">
                    <span class="cud-slot__na-title">Not applicable</span>
                    <span class="cud-slot__na-why" data-na-why></span>
                </span>
            </span>
            </div>
            <input type="file" data-input accept="@accepts.Mime" hidden>
            <p class="csi-error" id="@(key)Error" role="alert" hidden></p>
            @* What the checks came back with, on the card the document sits in.
               The cards further down carry what was read; this one line says
               whether anybody outside stood behind the copy, so a filed document
               that nobody could confirm never passes for a clean one. *@
            <p class="cud-slot__check" data-check hidden></p>
            <p class="cud-slot__tries" data-tries hidden></p>
            <span class="visually-hidden" data-said role="status" aria-live="polite"></span>
        </div>
    }
}

@* Once the head has scrolled off, this holds what every screenshot of this step
   needs to be worth anything: who it is for and which application it is. *@
<div class="cud-pin" id="cudPin" hidden>
    <div class="cud-pin__inner">
        <span class="cud-pin__who">@Model.HolderName</span>
        <span class="cud-pin__pan">PAN @Model.HolderPan</span>
        <span class="cud-pin__app">
            <span class="cud-pin__label">Application</span>
            @Model.AppNo
            <button type="button" class="cud-copy js-copy" data-copy="@Model.AppNo" title="Copy the application number" aria-label="Copy the application number">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.6"></rect><path d="M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1"></path></svg>
            </button>
        </span>
    </div>
</div>

<div class="csi">
    <partial name="_ClassicSteps" model="1" />

    @* Both cards share the column beside the rail; the page grid holds two
       columns, so a card left loose lands under the rail instead. *@
    <div class="csi-main">
    <form class="csi-card" id="cudForm" data-draft="@Model.AppNo" novalidate>
        <div class="cud-head">
            <div class="cud-head__who">
                <p class="cud-head__step">Upload documents</p>
                <h1 class="cud-head__name">@Model.HolderName</h1>
                @* Each identifier under its own label, spaced like the folio and
                   application on the other side of the head rather than run
                   together on one line by a middot. *@
                <p class="cud-head__ids">
                    <span><em>PAN</em>@Model.HolderPan</span>
                    <span><em>DOB</em>@Model.HolderDob</span>
                </p>
            </div>

            @* What the application is filed under, and the one thing that can be
               fetched against it. CKYC answers for an application the investor
               accepts online; a paper one is filed from the forms in front of the
               partner, so the link goes quiet for it. *@
            <div class="cud-head__right">
                <dl class="cud-head__refs">
                    <div>
                        <dt>Folio</dt>
                        <dd class="@(Model.HasFolio ? null : "cud-head__pending")">@Model.HolderFolio</dd>
                    </div>
                    <div>
                        <dt>Application</dt>
                        @* The number every question about this application starts
                           with, so it is one press to put it in a message. *@
                        <dd class="cud-head__ref">@Model.AppNo
                            <button type="button" class="cud-copy js-copy" data-copy="@Model.AppNo" title="Copy the application number" aria-label="Copy the application number">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.6"></rect><path d="M15 6.5V5.4A1.4 1.4 0 0 0 13.6 4H5.4A1.4 1.4 0 0 0 4 5.4v8.2A1.4 1.4 0 0 0 5.4 15h1.1"></path></svg>
                            </button>
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        @if (ClassicUploadDocumentsModel.MailingAddress)
        {
            @* Address proof is filed against the permanent address. Where the investor
               is written to somewhere else, that address needs a proof of its own, so
               the answer here opens a second type and picker below. *@
            <fieldset class="cud-mailing">
                <legend class="csi-label">Mailing address same as permanent?</legend>
                <label class="csi-radio">
                    <input type="radio" name="cudMailing" value="same" checked>
                    <span>Yes</span>
                </label>
                <label class="csi-radio">
                    <input type="radio" name="cudMailing" value="other">
                    <span>No &mdash; written to elsewhere</span>
                </label>
            </fieldset>
        }

        @* How the application arrived, which is a thing about the application
           rather than a document it carries: its own row above them, where the
           mailing question also stands. Two ways and no third, so it is the
           segmented toggle the new design uses for exactly this. *@
        <div class="cud-apptype">
            <span class="csi-label" id="cudAppTypeLabel">Application Type</span>
            <div class="seg-toggle" role="radiogroup" aria-labelledby="cudAppTypeLabel" data-apptype>
                @foreach (var t in ClassicUploadDocumentsModel.ApplicationTypes)
                {
                    var on = t == ClassicUploadDocumentsModel.ApplicationTypes[0];
                    <button type="button" class="seg-toggle__opt@(on ? " seg-toggle__opt--active" : "")" role="radio" aria-checked="@(on ? "true" : "false")" data-value="@t">@t</button>
                }
            </div>

        </div>

        @* Only where the register holds nothing: an investor who already has a
           folio has been through KYC, so there is no CERSAI record to fetch and
           the offer would only be a question the partner has to dismiss. *@
        @if (!Model.HasFolio)
        {
            <section class="cud-route" id="cudRoute">
                <div class="cud-route__text">
                    <h2 class="cud-route__title" id="cudRouteTitle">Fetch the KYC from CERSAI</h2>
                    @* Everything here is what would happen: until the record is fetched, none of
                       it is in force and the pickers below are asked for as usual. *@
                    <p class="cud-route__p" id="cudRouteOne">If the record is fetched, the investor would be asked for consent once the application is completed online: a link goes to their registered mobile number and email address, and they enter the OTP sent to the CERSAI-registered mobile number.</p>
                    <p class="cud-route__p" id="cudRouteTwo">The address and the photograph would then come from CERSAI instead of being filed here, and anything uploaded for them would not be used. The PAN copy is filed here either way. <strong>Nothing changes until the record is fetched.</strong></p>
                </div>
                <div class="cud-route__act">
                    <button type="button" class="btn btn-secondary btn-sm cud-ckyc-btn" id="cudCkyc">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5v11"></path><path d="M7.5 10L12 14.5 16.5 10"></path><path d="M4.5 15.5v3a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-3"></path></svg>
                        Fetch from CKYC
                    </button>
                    <p class="cud-ckyc-ask__note" id="cudCkycNote">Once fetched, this cannot be undone on this application.</p>
                    <p class="cud-ckyc-on" id="cudCkycOn" hidden>KYC from CKYC</p>
                </div>
            </section>
        }

        <div class="cud-grid cud-grid--docs">
            <div class="cud-col">
                <span class="csi-label">Application form</span>
                @{ Slot("form", "Application Form", ClassicUploadDocumentsModel.Form); }
            </div>

            @* The PAN copy the application is filed with. It comes over already
               filed when the step before uploaded or matched one, and can still
               be replaced here. *@
            <div class="cud-col">
                <span class="csi-label">PAN</span>
                @{ Slot("pan", "PAN copy", ClassicUploadDocumentsModel.Proof); }
            </div>

            <div class="cud-col">
                <span class="csi-label">Photo</span>
                @{ Slot("photo", "photograph", ClassicUploadDocumentsModel.Image); }
            </div>

            <div class="cud-col">
                <label class="csi-label" for="cudPoaType">Proof of address</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudPoaType" data-poatype aria-describedby="cudPoaTypeError">
                        <option value="">Select</option>
                        @foreach (var p in ClassicUploadDocumentsModel.ProofsOfAddress)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <p class="csi-error" id="cudPoaTypeError" hidden></p>
                @{ Slot("poa", "POA", ClassicUploadDocumentsModel.Image); }
            </div>

            @if (ClassicUploadDocumentsModel.MailingAddress)
            {
                @* Only where the two addresses part company. Its own type, since the
                   proof that carries the mailing address is rarely the one that
                   carries the permanent one. *@
                <div class="cud-col" data-when="mailing">
                    <label class="csi-label" for="cudMailingPoaType">Mailing address proof</label>
                    <div class="cud-select">
                        <select class="csi-control" id="cudMailingPoaType" data-mailingpoatype aria-describedby="cudMailingPoaTypeError">
                            <option value="">Select</option>
                            @foreach (var p in ClassicUploadDocumentsModel.ProofsOfAddress)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <p class="csi-error" id="cudMailingPoaTypeError" hidden></p>
                    @{ Slot("mailing", "mailing address proof", ClassicUploadDocumentsModel.Image); }
                </div>
            }

            <div class="cud-col">
                <label class="csi-label" for="cudPayMode">Payment Mode</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudPayMode" data-paymode aria-describedby="cudPayModeError">
                        <option value="">Select</option>
                        @foreach (var m in ClassicUploadDocumentsModel.PaymentModes)
                        {
                            <option value="@m.Name" data-document="@m.Document">@m.Name</option>
                        }
                    </select>
                </div>
                <p class="csi-error" id="cudPayModeError" hidden></p>
                @{ Slot("payment", "the instrument", ClassicUploadDocumentsModel.Image); }
            </div>
        </div>

        @* What the copies are for. OCR reads each one and whoever stands behind it
           is asked to confirm what it says: the Income Tax Department for a PAN,
           the issuer for an address, the bank for a cheque. Nothing on the
           application changes until that answer comes back clean. *@
        <section class="cud-read" id="cudAddress">
            <h2 class="cud-read__title">What the copies were read to say</h2>
            <p class="cud-read__sub">Read off the documents filed above and checked with whoever stands behind them.</p>

            <div class="cud-read__cards">
                @* A PAN is no use to the application unless the Income Tax
                   Department holds an Aadhaar against it: unlinked, the deposit
                   is booked but TDS runs at the higher rate. *@
                <article class="cud-read__card@(Model.PanFiled ? " is-done" : "")" data-read="pan">
                    <header class="cud-read__head">
                        <h3 class="cud-read__kind">PAN and Aadhaar</h3>
                        <span class="cud-read__state" data-state>@(Model.PanFiled ? "Linked with Aadhaar" : "Not yet read")</span>
                    </header>
                    <p class="cud-read__lines" data-lines>@(Model.PanFiled ? Model.HolderPan + " · linked with Aadhaar" : "Read off the PAN copy once one is filed here.")</p>
                    <p class="cud-read__was" data-was hidden></p>
                    <p class="cud-read__from" data-from>@(Model.PanFiled ? "Confirmed with the Income Tax Department when the PAN was identified." : "The Income Tax Department is asked whether it holds an Aadhaar against this PAN.")</p>
                </article>

                <article class="cud-read__card" data-read="poa">
                    <header class="cud-read__head">
                        <h3 class="cud-read__kind">Permanent address</h3>
                        <span class="cud-read__state" data-state>On the application</span>
                    </header>
                    <p class="cud-read__lines" data-lines>@Model.PermanentAddress</p>
                    <p class="cud-read__was" data-was hidden></p>
                    <p class="cud-read__from" data-from>From the folio the application was opened against.</p>
                </article>

                @if (ClassicUploadDocumentsModel.MailingAddress)
                {
                    <article class="cud-read__card" data-read="mailing" hidden>
                        <header class="cud-read__head">
                            <h3 class="cud-read__kind">Mailing address</h3>
                            <span class="cud-read__state" data-state>Not yet proved</span>
                        </header>
                        <p class="cud-read__lines" data-lines>Same as the permanent address until a proof is filed for it.</p>
                        <p class="cud-read__was" data-was hidden></p>
                        <p class="cud-read__from" data-from>The investor is written to somewhere else, so this address is taken from its own proof.</p>
                    </article>
                }
            </div>
        </section>

        @* A cheque is read the same way a proof is: OCR takes the account off the
           copy filed above and the bank it is drawn on is asked to stand behind
           it. Only a clean answer carries the account forward to Bank Details &
           Payment. Online and RTGS settle electronically and carry nothing. *@
        <section class="cud-read" data-when="instrument" hidden>
            <h2 class="cud-read__title">Account on the instrument</h2>
            <p class="cud-read__sub">Read off the cheque filed above and confirmed with the bank it is drawn on.</p>

            <div class="cud-read__cards">
                <article class="cud-read__card" data-read="payment">
                    <header class="cud-read__head">
                        <h3 class="cud-read__kind">Paid from</h3>
                        <span class="cud-read__state" data-state>Not yet read</span>
                    </header>
                    <p class="cud-read__lines" data-lines>Read off the instrument once a copy is filed.</p>
                    <p class="cud-read__was" data-was hidden></p>
                    <p class="cud-read__from" data-from>The account the deposit is paid from. Bank Details &amp; Payment opens with whatever is confirmed here.</p>
                </article>
            </div>
        </section>
    </form>

    <section class="csi-card cud-extra">
        <h2 class="cud-extra__title">Additional Details</h2>
        <div class="cud-grid cud-grid--details">
            <div class="cud-col">
                <label class="csi-label" for="cudSourcing">Sourcing Mode</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudSourcing" form="cudForm" data-sourcing aria-describedby="cudSourcingError">
                        <option value="">Select</option>
                        @foreach (var m in ClassicUploadDocumentsModel.SourcingModes)
                        {
                            <option value="@m.Code">@m.Name</option>
                        }
                    </select>
                </div>
                <p class="csi-error" id="cudSourcingError" hidden></p>
            </div>

            @* Both code fields stand under every mode, as they do on the old
               screen: what changes is what they are called, which of them is
               typed, and which the mode fills itself. A field the mode fills is
               shut rather than gone, so the partner can see what the application
               is being sourced under. *@
            <div class="cud-col">
                <label class="csi-label" for="cudSourceCode" id="cudSourceCodeLabel">Broker Code</label>
                <div class="cud-find">
                    <input class="csi-control" id="cudSourceCode" form="cudForm" maxlength="12" autocomplete="off" spellcheck="false"
                           role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="cudSourceCodeList" aria-describedby="cudSourceCodeError" disabled>
                    <ul class="cud-find__list" id="cudSourceCodeList" role="listbox" hidden></ul>
                </div>
                @* The name the register holds against the code, which is the only
                   way to tell one nine-digit code from another. *@
                <p class="cud-resolved" id="cudSourceCodeName" hidden></p>
                <p class="csi-error" id="cudSourceCodeError" hidden></p>
            </div>

            <div class="cud-col">
                <label class="csi-label" for="cudSubBroker" id="cudSubBrokerLabel">Sub Broker Code <span class="cud-optional" id="cudSubBrokerOptional" hidden>(Non-mandatory)</span></label>
                <div class="cud-find">
                    <input class="csi-control" id="cudSubBroker" form="cudForm" maxlength="12" autocomplete="off" spellcheck="false"
                           role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="cudSubBrokerList" aria-describedby="cudSubBrokerError" disabled>
                    <ul class="cud-find__list" id="cudSubBrokerList" role="listbox" hidden></ul>
                </div>
                <p class="cud-resolved" id="cudSubBrokerName" hidden></p>
                <p class="csi-error" id="cudSubBrokerError" hidden></p>
            </div>

            @* What a deposit may be booked as is not the same list under every
               mode - an employee deposit only exists where the application is
               sourced by one - so the mode fills this rather than the page. *@
            <div class="cud-col">
                <label class="csi-label" for="cudCategory">Deposit Category</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudCategory" form="cudForm" data-category aria-describedby="cudCategoryError" disabled>
                        <option value="">Select</option>
                    </select>
                </div>
                @* A mode with one category settles it: the field says so rather
                   than looking like a choice that was made for no reason. *@
                <p class="cud-note" id="cudCategoryOnly" hidden>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                    <span data-only-why></span>
                </p>
                <p class="csi-error" id="cudCategoryError" hidden></p>
            </div>

            @* An employee deposit is booked against a staff record: whose it is,
               how they are related to the holder, and what proves it. *@
            <div class="cud-col" data-when="employee" hidden>
                <label class="csi-label" for="cudEmpCode">Employee Code</label>
                <input class="csi-control" id="cudEmpCode" form="cudForm" maxlength="10" autocomplete="off" spellcheck="false" aria-describedby="cudEmpCodeError">
                <p class="cud-resolved">Employee Name &mdash; <strong data-empname>&mdash;</strong></p>
                @* A code this screen cannot put a name to does not stop the
                   application; Operations settle it against the staff register. *@
                <p class="cud-note" data-empunknown hidden>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                    <span>No name against this code here. You can still proceed &mdash; Operations check it against the staff register before the deposit is booked.</span>
                </p>
                <p class="csi-error" id="cudEmpCodeError" hidden></p>
            </div>

            <div class="cud-col" data-when="employee" hidden>
                <label class="csi-label" for="cudEmpCompany">Employee Company Name</label>
                <input class="csi-control" id="cudEmpCompany" form="cudForm" maxlength="60" autocomplete="off" aria-describedby="cudEmpCompanyError">
                <p class="csi-error" id="cudEmpCompanyError" hidden></p>
            </div>

            <div class="cud-col" data-when="employee" hidden>
                <label class="csi-label" for="cudEmpHolder">Employee holder</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudEmpHolder" form="cudForm" aria-describedby="cudEmpHolderError">
                        <option value="">Select</option>
                        @foreach (var h in ClassicUploadDocumentsModel.EmployeeHolders)
                        {
                            <option value="@h">@h</option>
                        }
                    </select>
                </div>
                <p class="csi-error" id="cudEmpHolderError" hidden></p>
            </div>

            <div class="cud-col" data-when="employee" hidden>
                <label class="csi-label" for="cudEmpRelation">Emp Relation with holder</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudEmpRelation" form="cudForm" aria-describedby="cudEmpRelationError">
                        <option value="">Select</option>
                        @foreach (var r in ClassicUploadDocumentsModel.EmployeeRelations)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
                <p class="csi-error" id="cudEmpRelationError" hidden></p>
            </div>

            @* A paper application has to carry its form number; a digital one has
               no paper, so the field stands but is not asked for. *@
            <div class="cud-col">
                <label class="csi-label" for="cudFormNo">Physical Application Form No. <span class="cud-optional" data-formno-optional hidden>(No paper form &mdash; filed as 0000)</span></label>
                <input class="csi-control" id="cudFormNo" form="cudForm" maxlength="20" autocomplete="off" spellcheck="false" aria-describedby="cudFormNoError">
                <p class="csi-error" id="cudFormNoError" hidden></p>
            </div>

            <div class="cud-col" data-when="employee" hidden>
                <label class="csi-label" for="cudEmpProofType">Employee Proof</label>
                <div class="cud-select">
                    <select class="csi-control" id="cudEmpProofType" form="cudForm" aria-describedby="cudEmpProofTypeError">
                        <option value="">Select</option>
                        @foreach (var p in ClassicUploadDocumentsModel.EmployeeProofs)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <p class="csi-error" id="cudEmpProofTypeError" hidden></p>
                @{ Slot("empproof", "Employee Proof", ClassicUploadDocumentsModel.Proof); }
            </div>
        </div>
    </section>

    @* Three attempts for each document in a session, counted separately. Each
       attempt is kept as the three checks it went through - what the copy was
       identified as, what OCR read off it, and what the register behind it
       answered - so a refusal is never just a red line that has since been
       cleared away, and neither is a copy nobody could confirm. *@
    <section class="csi-card cud-log">
        <h2 class="cud-extra__title">Upload, OCR and verification history</h2>
        <p class="cud-log__sub">Every attempt against this application, newest first. A document goes to Operations only after three copies of it are refused one after another &mdash; a copy the checks take clears the count, so replacing a document that is already filed costs nothing. The count is kept per document and per session: the PAN copy running out says nothing about the proof of address, and what an earlier session tried is on the record without counting against this one.</p>
        <ol class="cud-log__list" id="cudLogList">
            @foreach (var past in Model.PastAttempts)
            {
                <li class="cud-log__row is-@past.Kind">
                    <div class="cud-log__top">
                        <span class="cud-log__doc">@past.Document</span>
                        <span class="cud-log__try">Attempt @past.Attempt of 3</span>
                        <span class="cud-log__at">@past.When</span>
                        <span class="cud-log__mark">@past.Mark</span>
                    </div>
                    <p class="cud-log__file">@past.File</p>
                    <ul class="cud-log__stages">
                        @foreach (var stage in past.Stages)
                        {
                            <li class="cud-log__stage @(stage.Kind.Length > 0 ? "is-" + stage.Kind : null)">@stage.Text</li>
                        }
                    </ul>
                </li>
            }
        </ol>
        <p class="cud-log__none" id="cudLogNone" hidden>Nothing uploaded against this application yet.</p>
    </section>
    </div>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        @* Leaving the step is a wait like any other: the screen says so rather
           than sitting still while the next page is fetched. *@
        <a class="csi-btn csi-btn--back" asp-page="/Apps/UnoTp/Desktop/ClassicSearchInvestor"
           data-loader="Going back to Investor Identification"
           data-loader-hint="Nothing filed here is lost — the draft is kept against this application.">Back</a>
        <p class="csi-bar__hint" id="cudHint"></p>
        <div class="csi-bar__right">
            @* What is saved and when, so Save draft is not a button that appears
               to do nothing. *@
            <span class="csi-bar__saved" id="cudSaved" hidden></span>
            <button type="button" class="csi-btn csi-btn--back" id="cudDraft">Save draft</button>
            <button type="submit" class="csi-btn csi-btn--primary" form="cudForm" id="cudProceed">Proceed</button>
        </div>
    </div>
</footer>

@* Fetching from CKYC is the investor's decision, not the partner's: a link goes
   to their registered mobile and email, and the record comes back only once they
   have entered the OTP sent to the CERSAI-registered number. Nothing uploaded on
   this step counts towards that, which is why the dialog says so before the
   partner spends any more time on the pickers. *@
@if (!Model.HasFolio)
{
    <div class="cud-ckyc" id="cudCkycAsk" hidden>
        <div class="cud-ckyc__sheet" role="dialog" aria-modal="true" aria-labelledby="cudCkycTitle">
            <header class="cud-ckyc__head">
                <span class="cud-ckyc__mark" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                </span>
                <h2 class="cud-ckyc__title" id="cudCkycTitle">Fetch the KYC record from CERSAI?</h2>
                <button type="button" class="cud-preview__close" id="cudCkycClose" aria-label="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
                </button>
            </header>
            <div class="cud-ckyc__body">
                <p>The address and the photograph will come from the CERSAI record instead of being filed here, and the investor will be asked for OTP consent once the application is completed online.</p>
                <p><strong>This cannot be undone on this application:</strong> the record cannot be fetched twice, and the application can no longer be filed as a physical one &mdash; consent is given online.</p>
            </div>
            <footer class="cud-ckyc__foot">
                <button type="button" class="csi-link" id="cudCkycCancel">Cancel</button>
                <button type="button" class="csi-btn csi-btn--primary" id="cudCkycGo">Proceed <span aria-hidden="true">&rarr;</span></button>
            </footer>
        </div>
    </div>
}

@* What the eye opens: the document itself where the browser can show it. It is
   a view and nothing else - replacing goes through the card the document sits in,
   which is where the partner came from. *@
<div class="cud-preview" id="cudPreview" hidden>
    <div class="cud-preview__sheet" role="dialog" aria-modal="true" aria-labelledby="cudPreviewTitle">
        <header class="cud-preview__head">
            <div>
                <p class="cud-preview__kind" data-preview-kind></p>
                <h2 class="cud-preview__title" id="cudPreviewTitle" data-preview-title></h2>
            </div>
            <button type="button" class="cud-preview__close" data-preview-close aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
        </header>
        <div class="cud-preview__body" data-preview-body></div>
        <footer class="cud-preview__foot">
            <span class="cud-preview__meta" data-preview-meta></span>
        </footer>
    </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@* The staff the mock can put a name to, so the page and the script hold one
   list between them. *@
<script id="cudPanFiled" type="application/json">@(Model.PanFiled ? "true" : "false")</script>
<script id="cudHeld" type="application/json">@Html.Raw(Model.HeldJson)</script>
<script id="cudAddresses" type="application/json">@Html.Raw(Model.AddressJson)</script>
@* The sourcing modes, and the two registers a code is searched against. *@
<script id="cudSourcingModes" type="application/json">@Html.Raw(Model.SourcingJson)</script>
<script id="cudEmployees" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ClassicUploadDocumentsModel.Employees))</script>

@section Scripts {
    <script src="~/js/console.js"></script>
    <script src="~/js/classic-upload-documents.js" asp-append-version="true"></script>
}

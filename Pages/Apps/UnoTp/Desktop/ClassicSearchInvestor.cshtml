@page "/Apps/UnoTp/Classic/SearchInvestor"
@model UnoTp.Pages.Apps.UnoTpApp.Desktop.ClassicSearchInvestorModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Desktop
@{
    ViewData["Title"] = "Investor Identification (classic)";
    ViewData["FirstNavPage"] = "/Apps/UnoTp/Desktop/ClassicDashboard";

    // The old WA_FD_UNOTP/searchinvestor, carrying the new Investor Identification
    // screen's working parts: the record is checked against the register before
    // the application can go on, and Proceed waits for that match.
    var notes = new[]
    {
        "Only individual depositors 18 years and above are allowed to make investments.",
        "We strongly advice the depositor(s) to avail the nomination",
        "For investment above Rs.5 Cr, please write to fixeddeposit@mahindrafinance.com",
    };
}

<div class="csi">
    <partial name="_ClassicSteps" model="0" />

    <form class="csi-card" id="csiForm" novalidate>
        <h1 class="csi-card__title">Enter Basic Information</h1>

        <section class="csi-holder" data-holder="1">
            <div class="csi-holder__head">
                <span class="csi-holder__no">1</span>
                <span class="csi-holder__name">Investor</span>
                <span class="csi-chip">Primary holder</span>
                <span class="csi-status" data-status>Not identified</span>
            </div>

                <div data-search>
                    <fieldset class="csi-searchby">
                        <legend class="csi-label">Search By</legend>
                        <label class="csi-radio">
                            <input type="radio" name="searchBy" value="pan" checked>
                            <span>PAN &amp; Date of Birth</span>
                        </label>
                        <label class="csi-radio">
                            <input type="radio" name="searchBy" value="folio">
                            <span>Folio Number</span>
                        </label>
                    </fieldset>

                    <div class="csi-fields" data-mode="pan">
                        <div class="csi-field" data-for="pan">
                            <label class="csi-label" for="csiPan">Enter PAN</label>
                            <input class="csi-control" id="csiPan" data-pan maxlength="10" autocomplete="off" spellcheck="false" aria-describedby="csiPanError">
                            <p class="csi-error" id="csiPanError" hidden></p>
                        </div>

                        <div class="csi-field" data-for="pan">
                            <span class="csi-label" id="csiDobLabel">Date Of Birth</span>
                            @* Three boxes with slashes between, like the old jq-dte control. *@
                            <div class="csi-date" data-date role="group" aria-labelledby="csiDobLabel" aria-describedby="csiDobError">
                                <input class="csi-date__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="Day" autocomplete="off">
                                <span class="csi-date__sep">-</span>
                                <input class="csi-date__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="Month" autocomplete="off">
                                <span class="csi-date__sep">-</span>
                                <input class="csi-date__part csi-date__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="Year" autocomplete="off">
                            </div>
                            <p class="csi-error" id="csiDobError" hidden></p>
                        </div>

                        <div class="csi-field" data-for="folio" hidden>
                            <label class="csi-label" for="csiFolio">Enter Folio Number</label>
                            <input class="csi-control" id="csiFolio" data-folio maxlength="16" autocomplete="off" spellcheck="false" aria-describedby="csiFolioError">
                            <p class="csi-error" id="csiFolioError" hidden></p>
                        </div>

                        <div class="csi-field csi-field--check">
                            <button type="button" class="csi-check" data-check>Check record <span aria-hidden="true">&rsaquo;</span></button>
                        </div>
                    </div>

                    <p class="csi-hint" data-hint-for="pan">Both fields are required &mdash; a PAN-only search is not permitted.</p>
                    <p class="csi-hint" data-hint-for="folio" hidden>The folio number alone is enough &mdash; it returns the same record as the PAN search.</p>
                </div>

                @* Filled in by the check, then shown in place of the search fields.
                   The old site put the match behind a "Please make a selection"
                   dialog; here the record is laid out on the page instead, with
                   its identifiers masked the way the register masks them. *@
                <div class="csi-result" data-result hidden>
                    <div class="csi-result__head">
                        <div class="csi-result__title">
                            <span data-result-name></span>
                            <span class="csi-chip csi-chip--success" data-result-kind></span>
                        </div>
                        <button type="button" class="csi-link" data-again>Search again</button>
                    </div>
                    <div class="csi-result__detail" data-result-detail></div>

                    <dl class="csi-record">
                        @* The folio and the name head the card, so neither is repeated
                           here. A PAN with no folio heads the card with its new
                           application number instead, which this row spells out. *@
                        <div class="csi-record__item" data-item="appno" hidden><dt>Application</dt><dd data-field="appno"></dd></div>
                        <div class="csi-record__item"><dt>PAN</dt><dd data-field="pan"></dd></div>
                        <div class="csi-record__item"><dt>Date of birth</dt><dd data-field="dob"></dd></div>
                        @* Gender is held against the folio and is not the partner's
                           to change here, so the card says where a correction comes
                           from instead of offering an edit. *@
                        <div class="csi-record__item" data-item="gender">
                            <dt>Gender</dt>
                            <dd data-field="gender"></dd>
                            <p class="csi-record__hint" data-gender-hint hidden>Not editable during application entry &mdash; if this is wrong, ask the Operations team to correct it against the folio.</p>
                        </div>
                    </dl>

                    @* A PAN with no folio behind it cannot be identified from the
                       register, so it is established here instead: the PAN copy is
                       uploaded, read by OCR, and the PAN, date of birth and name are
                       put to NSDL. Nothing leaves the browser - the steps are mocked. *@
                    <div class="csi-verify" data-verify hidden>
                        <div class="csi-verify__head">
                            <h3 class="csi-verify__title">Establish this PAN</h3>
                            <p class="csi-verify__sub">Upload the PAN copy. It is read by OCR, then the PAN, date of birth and name are verified with NSDL.</p>
                        </div>

                        <div class="csi-verify__upload" data-upload>
                            <label class="csi-check" for="csiPanFile">Upload PAN copy</label>
                            <input type="file" id="csiPanFile" data-panfile accept="application/pdf,image/jpeg" hidden>
                            <span class="csi-verify__file" data-filename hidden></span>
                        </div>

                        <ol class="csi-verify__log" data-log hidden></ol>

                        @* The three NSDL results, each carrying what was put to it. *@
                        <div class="csi-verify__checks" data-checks hidden>
                            <div class="csi-checkrow" data-row="pan">
                                <span class="csi-checkrow__label">PAN</span>
                                <span class="csi-checkrow__value" data-row-value="pan"></span>
                                <span class="csi-checkrow__status" data-row-status="pan"></span>
                            </div>
                            <div class="csi-checkrow" data-row="dob">
                                <span class="csi-checkrow__label">Date of birth</span>
                                <span class="csi-checkrow__value" data-row-value="dob"></span>
                                <span class="csi-checkrow__status" data-row-status="dob"></span>
                            </div>
                            <div class="csi-checkrow" data-row="name">
                                <span class="csi-checkrow__label">Name</span>
                                <span class="csi-checkrow__value" data-row-value="name"></span>
                                <span class="csi-checkrow__status" data-row-status="name"></span>
                            </div>
                        </div>

                        @* NSDL holds the PAN against another name, so the name is typed
                           from the card and put to NSDL again. *@
                        <div class="csi-verify__fix" data-namefix hidden>
                            <label class="csi-label" for="csiNsdlName">Enter the name exactly as printed on the PAN</label>
                            <div class="csi-verify__fixrow">
                                <input class="csi-control" id="csiNsdlName" data-nsdlname maxlength="60" autocomplete="off" spellcheck="false" aria-describedby="csiNsdlNameError">
                                <button type="button" class="csi-check" data-retry>Retry NSDL verification</button>
                            </div>
                            <p class="csi-error" id="csiNsdlNameError" hidden></p>
                        </div>

                        <div class="csi-gap csi-gap--alert" data-verify-fail hidden>
                            <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M15 9l-6 6"></path><path d="M9 9l6 6"></path></svg>
                            <div class="csi-gap__body">
                                <div class="csi-gap__title">NSDL could not verify this PAN</div>
                                <p data-verify-fail-text></p>
                                <button type="button" class="csi-link" data-again>Search again</button>
                            </div>
                        </div>

                        <div class="csi-gap csi-gap--ok" data-verify-ok hidden>
                            <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M8 12.5l2.8 2.8L16.5 9.5"></path></svg>
                            <div class="csi-gap__body">
                                <div class="csi-gap__title">Verified with NSDL</div>
                                <p>The PAN, date of birth and name all match. The application can go on.</p>
                            </div>
                        </div>
                    </div>

                    @* What the register is missing against this folio. Anything
                       listed here is asked for again during entry, so it is said
                       here rather than left for the upload step to spring. *@
                    <div class="csi-gap" data-gap hidden>
                        <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3.5H7a1.5 1.5 0 0 0-1.5 1.5v14A1.5 1.5 0 0 0 7 20.5h10a1.5 1.5 0 0 0 1.5-1.5V8z"></path><path d="M14 3.5V8h4.5"></path><path d="M9 13h6"></path><path d="M9 16.5h4"></path></svg>
                        <div class="csi-gap__body">
                            <div class="csi-gap__title" data-gap-title></div>
                            <ul data-gap-list></ul>
                            <p data-gap-foot></p>
                        </div>
                    </div>

                    <div class="csi-gap csi-gap--ok" data-complete hidden>
                        <svg class="csi-gap__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M8 12.5l2.8 2.8L16.5 9.5"></path></svg>
                        <div class="csi-gap__body">
                            <div class="csi-gap__title">The record is complete</div>
                            <p>PAN, photograph, proof of address and the address are all available with us, so nothing is asked for again during entry.</p>
                        </div>
                    </div>
                </div>
        </section>

        <div class="csi-note">
            <svg class="csi-note__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
            <div class="csi-note__body">
                <div class="csi-note__title">Note</div>
                <ul>
                    @foreach (var n in notes)
                    {
                        <li>@n</li>
                    }
                </ul>
            </div>
        </div>

    <section class="csi-drafts">
        <div class="csi-drafts__head">
            <h2 class="csi-drafts__title">Continue an incomplete application</h2>
            <p class="csi-drafts__sub">@Model.Drafts.Count most recent saved and not submitted &middot; identifiers are masked &middot; a draft is kept for 30 days</p>
        </div>
        <table class="csi-drafts__table">
            <thead>
                <tr>
                    <th scope="col">Application</th>
                    <th scope="col">Name</th>
                    <th scope="col">PAN</th>
                    <th scope="col">Date of birth</th>
                    <th scope="col">Amount</th>
                    <th scope="col"><span class="visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Drafts)
                {
                    <tr>
                        <td data-label="Application"><strong>@d.AppNo</strong></td>
                        <td data-label="Name">@d.Name</td>
                        <td data-label="PAN">@d.Pan</td>
                        <td data-label="Date of birth">@d.Dob</td>
                        <td data-label="Amount">@d.Amount</td>
                        <td class="csi-drafts__act"><button type="button" class="csi-link js-stub">Continue <span aria-hidden="true">&rsaquo;</span></button></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @* Nothing here is real: every PAN starts XXXX and they all share one date of
       birth, so the page can be demoed without anybody's own details. *@
    <section class="csi-demo">
        <div class="csi-demo__head">
            <h2 class="csi-demo__title">Test data</h2>
            <p class="csi-demo__sub">Five cases, and what each one does &middot; mock records only &middot; every PAN starts <strong>XXXX</strong> &middot; all of them share the date of birth <strong>@ClassicSearchInvestorModel.DemoDob</strong></p>
        </div>
        @{
            // The five cases run on from one another: the folios first, then the
            // PANs the register does not hold.
            var caseNo = 0;
        }
        <table class="csi-demo__table">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">Case</span></th>
                    <th scope="col">PAN</th>
                    <th scope="col">Date of birth</th>
                    <th scope="col">Folio</th>
                    <th scope="col">What happens</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in ClassicSearchInvestorModel.Folios)
                {
                    caseNo++;
                    <tr>
                        <td data-label="Case"><span class="csi-demo__no">@caseNo</span></td>
                        <td data-label="PAN"><code>@f.Pan</code></td>
                        <td data-label="Date of birth">@f.Dob</td>
                        <td data-label="Folio"><code>@f.Folio</code></td>
                        <td data-label="What happens">@f.Shows</td>
                    </tr>
                }
                @foreach (var m in ClassicSearchInvestorModel.Pans)
                {
                    caseNo++;
                    <tr>
                        <td data-label="Case"><span class="csi-demo__no">@caseNo</span></td>
                        <td data-label="PAN"><code>@m.Pan</code></td>
                        <td data-label="Date of birth">@m.Dob</td>
                        <td data-label="Folio"><span class="csi-demo__none">no folio</span></td>
                        <td data-label="What happens">@m.Shows</td>
                    </tr>
                }
            </tbody>
        </table>
        <ul class="csi-demo__notes">
            <li>A folio can also be searched by its number, with the same result as its PAN.</li>
            <li>One of these PANs with any other date of birth is turned back &mdash; the two are always checked together.</li>
            <li>Any other valid PAN still works: its last digit decides the outcome &mdash; <strong>0</strong> no such pair, <strong>1</strong> name mismatch, anything else all three match.</li>
        </ul>
    </section>
    </form>
</div>

<footer class="csi-bar">
    <div class="csi-bar__inner">
        <a class="csi-btn csi-btn--back" asp-page="/Apps/UnoTp/Desktop/ClassicDashboard"
           data-loader="Going back to the dashboard">Back</a>
        <p class="csi-bar__hint" id="csiHint">Identify the investor to continue.</p>
        <div class="csi-bar__right">
            <button type="button" class="csi-link btn-reset" id="csiClear">Clear All</button>
            <button type="submit" class="csi-btn csi-btn--primary" form="csiForm" id="csiProceed" disabled>Proceed</button>
        </div>
    </div>
</footer>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@* The register and the mock NSDL, as the script reads them. The card above is
   written from the same two lists, so neither can drift from the other. *@
<script id="csiMockData" type="application/json">@Html.Raw(Model.MockJson)</script>

@section Scripts {
    <script src="~/js/console.js"></script>
    <script src="~/js/classic-search-investor.js" asp-append-version="true"></script>
}

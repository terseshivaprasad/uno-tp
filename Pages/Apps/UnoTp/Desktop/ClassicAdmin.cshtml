@page "/Apps/UnoTp/Classic/Admin"
@model UnoTp.Pages.Apps.UnoTpApp.Desktop.ClassicAdminModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Desktop
@using UnoTp.Models
@{
    ViewData["Title"] = "Console Admin (classic)";
    ViewData["FirstNavPage"] = "/Apps/UnoTp/Desktop/ClassicDashboard";

    // The screen behind the classic console: which features are on, and what the
    // bell in the top bar tells partners is coming. The two are one thing here -
    // a window that is announced writes its own notice - so nobody has to
    // remember to tell anyone, and nothing can be told about a window that is
    // not set.
    var off = Model.Features.Count(f => ConsoleAdmin.StateOf(f.Key) == "disabled");
    var queued = Model.Features.Count(f => ConsoleAdmin.StateOf(f.Key) == "scheduled");

}

@functions {
    // A moment, in the boxes the classic wizard writes one in: three for the day
    // and two for the time, on the twenty-four hour clock.
    async Task When(string id, DateTime value, string label)
    {
        <div class="adm-when" role="group" aria-label="@label">
            <div class="csi-date" data-date id="@(id)Date">
                <input class="csi-date__part" data-dd inputmode="numeric" maxlength="2" placeholder="DD" aria-label="@label day" autocomplete="off" value="@value.ToString("dd")">
                <span class="csi-date__sep">/</span>
                <input class="csi-date__part" data-mm inputmode="numeric" maxlength="2" placeholder="MM" aria-label="@label month" autocomplete="off" value="@value.ToString("MM")">
                <span class="csi-date__sep">/</span>
                <input class="csi-date__part csi-date__part--year" data-yyyy inputmode="numeric" maxlength="4" placeholder="YYYY" aria-label="@label year" autocomplete="off" value="@value.ToString("yyyy")">
            </div>
            <div class="csi-date adm-time" data-time id="@(id)Time">
                <input class="csi-date__part" data-hh inputmode="numeric" maxlength="2" placeholder="HH" aria-label="@label hour" autocomplete="off" value="@value.ToString("HH")">
                <span class="csi-date__sep">:</span>
                <input class="csi-date__part" data-mi inputmode="numeric" maxlength="2" placeholder="MM" aria-label="@label minute" autocomplete="off" value="@value.ToString("mm")">
            </div>
        </div>
        await Task.CompletedTask;
    }
}

<div class="csi csi--wide">
    <aside class="csi-rail csi-rail--steps">
        <h2 class="csi-rail__title">Admin only</h2>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
            <div>
                <div class="csi-rail__note-title">Every partner sees this</div>
                <p>A tile turned off here is off for everyone on the console, at once. Nothing is off for one partner alone.</p>
            </div>
        </div>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 6.5V12l3.5 2.5"></path></svg>
            <div>
                <div class="csi-rail__note-title">A window, not a switch</div>
                <p>A disable runs from one date and time to another. It starts and ends itself, so nothing is left off by accident.</p>
            </div>
        </div>
        <div class="csi-rail__note">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <div>
                <div class="csi-rail__note-title">One window per tile</div>
                <p>A tile already in a window has to have it ended or cancelled before another can be set over it.</p>
            </div>
        </div>
    </aside>

    <div class="adm-stack">
        <div class="csi-card">
            <div class="csi-drafts__head">
                <h1 class="csi-card__title csi-card__title--plain">Tile availability</h1>
                <p class="csi-drafts__sub">
                    The @Model.Features.Length tiles on the classic dashboard.
                    <span id="admSummary">@(off == 0 ? "All on" : $"{off} off now") &middot; @queued scheduled to go off.</span>
                </p>
            </div>

            <table class="su-table adm-table">
                <colgroup>
                    <col style="width:28%"><col style="width:20%"><col style="width:38%"><col style="width:14%">
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Tile</th>
                        <th scope="col">Availability</th>
                        <th scope="col">Window</th>
                        <th scope="col" class="su-table__act"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody id="admRows">
                    @foreach (var f in Model.Features)
                    {
                        var w = ConsoleAdmin.WindowFor(f.Key);
                        var state = ConsoleAdmin.StateOf(f.Key);
                        var others = w?.Features.Where(k => k != f.Key).Select(k => ConsoleAdmin.Feature(k).Name).ToList() ?? new List<string>();
                        <tr data-feature="@f.Key" data-state="@state" data-window="@(w?.Id ?? "")" data-name="@f.Name">
                            <td data-label="Tile">
                                <strong>@f.Name</strong>
                                <div class="su-table__sub">@f.Group</div>
                            </td>
                            <td data-label="Availability">
                                @switch (state)
                                {
                                    case "off":
                                        <span class="text-muted" data-status>Off indefinitely</span>
                                        <div class="su-table__sub" data-status-sub>@f.Off</div>
                                        break;
                                    case "disabled":
                                        <span class="text-danger" data-status>Off now</span>
                                        <div class="su-table__sub su-table__sub--urgent" data-status-sub>back at @ConsoleAdmin.Clock(w!.To)</div>
                                        break;
                                    case "scheduled":
                                        <span class="text-amber" data-status>Goes off @w!.Away</span>
                                        <div class="su-table__sub" data-status-sub>on until then</div>
                                        break;
                                    default:
                                        <span class="text-success" data-status>Available</span>
                                        <div class="su-table__sub" data-status-sub>no window set</div>
                                        break;
                                }
                            </td>
                            <td data-label="Window">
                                <span data-window-when>@(w is null ? "—" : w.When)</span>
                                <div class="su-table__sub" data-window-sub>
                                    @if (w is null)
                                    {
                                        @(f.Off is null ? "" : "off until it is rebuilt")
                                    }
                                    else
                                    {
                                        @(w.Length
                                            + (others.Count > 0 ? " · with " + string.Join(" and ", others) : "")
                                            + " · " + (w.Announced ? "in the bell" : "not announced"))
                                    }
                                </div>
                            </td>
                            <td class="su-table__act" data-act>
                                @switch (state)
                                {
                                    case "off":
                                        <span class="su-nolink">&mdash;</span>
                                        break;
                                    case "disabled":
                                        <button type="button" class="csi-link" data-end>End now</button>
                                        break;
                                    case "scheduled":
                                        <button type="button" class="csi-link" data-cancel>Cancel</button>
                                        break;
                                    default:
                                        <button type="button" class="csi-link" data-schedule>Disable&hellip;</button>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <h2 class="adm-form__title" id="admScheduleTitle">Disable a tile for a window</h2>
            <form class="adm-form" id="admWindowForm" novalidate aria-labelledby="admScheduleTitle">
                <div class="csi-field">
                    <span class="csi-label">Tiles to disable</span>
                    <div class="adm-picks" id="admPicks">
                        @foreach (var f in Model.Features.Where(f => f.Off is null))
                        {
                            <label class="adm-pick" data-pick="@f.Key">
                                <input type="checkbox" value="@f.Key">
                                <span>@f.Name</span>
                            </label>
                        }
                    </div>
                    <p class="csi-hint">A tile already in a window cannot be picked until that window is ended or cancelled.</p>
                </div>

                <div class="adm-form__row">
                    <div class="csi-field">
                        <span class="csi-label" id="admFromLabel">From</span>
                        @{ await When("admFrom", Model.DefaultFrom, "From"); }
                    </div>
                    <div class="csi-field">
                        <span class="csi-label" id="admToLabel">To</span>
                        @{ await When("admTo", Model.DefaultTo, "To"); }
                    </div>
                </div>

                <div class="csi-field">
                    <label class="csi-label" for="admTitle">Notice to partners</label>
                    <input class="csi-control adm-control--wide" id="admTitle" maxlength="90" autocomplete="off" placeholder="e.g. New FD booking is unavailable on Sunday night">
                    <p class="csi-hint">Shown in the bell until the window ends, with the tiles it affects. Leave it blank for a short window and only the greyed tile will say anything.</p>
                </div>

                <p class="csi-error" id="admWindowError" hidden></p>

                <div class="adm-form__actions">
                    <button type="submit" class="csi-btn csi-btn--primary">Schedule window</button>
                    <button type="button" class="csi-btn csi-btn--back" id="admWindowReset">Clear</button>
                </div>
            </form>
        </div>

        <div class="csi-card">
            <div class="csi-drafts__head">
                <h1 class="csi-card__title csi-card__title--plain">What partners are told</h1>
                <p class="csi-drafts__sub">Everything in the bell in the top bar, soonest first. A notice against a window goes when that window does; a standalone one is removed by hand.</p>
            </div>

            <table class="su-table adm-table adm-table--notices">
                <colgroup>
                    <col style="width:14%"><col style="width:38%"><col style="width:20%">
                    <col style="width:16%"><col style="width:12%">
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Kind</th>
                        <th scope="col">Notice</th>
                        <th scope="col">When</th>
                        <th scope="col">Raised by</th>
                        <th scope="col" class="su-table__act"><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody id="admNotices">
                    @* The two sources read as one list, in the order the bell shows
                       them: the windows that announce themselves, and the notices
                       that stand on their own. *@
                    @{
                        var bell = Model.Upcoming.Where(w => w.Announced)
                            .Select(w => (w.From, w.Id, Kind: "Downtime", Title: w.Notice, Detail: w.Affects, w.When, w.Away, By: w.SetBy, Sub: $"with window {w.Id}", Source: "window"))
                            .Concat(Model.Notices.Select(n => (From: n.At, n.Id, n.Kind, n.Title, n.Detail, When: ConsoleAdmin.Stamp(n.At), Away: ConsoleAdmin.Away(n.At), By: n.SetBy, Sub: n.SetOn.ToString("dd/MM, HH:mm"), Source: "standalone")))
                            .OrderBy(x => x.From);
                    }
                    @foreach (var n in bell)
                    {
                        <tr data-notice="@n.Id" data-source="@n.Source" data-at="@n.From.ToString("s")">
                            <td data-label="Kind"><span class="adm-kindtag @ConsoleAdmin.Tone(n.Kind)">@n.Kind</span></td>
                            <td data-label="Notice">
                                <strong>@n.Title</strong>
                                <div class="su-table__sub">@n.Detail</div>
                            </td>
                            <td data-label="When">
                                <span>@n.When</span>
                                <div class="su-table__sub">@n.Away</div>
                            </td>
                            <td data-label="Raised by">
                                <span>@n.By</span>
                                <div class="su-table__sub">@n.Sub</div>
                            </td>
                            <td class="su-table__act">
                                @if (n.Source == "window")
                                {
                                    <span class="su-nolink">&mdash;</span>
                                }
                                else
                                {
                                    <button type="button" class="csi-link" data-remove>Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <p class="su-empty" id="admNoticesEmpty" hidden>Nothing in the bell. Partners see no notices at all.</p>

            <h2 class="adm-form__title" id="admNoticeTitle">Add a notification</h2>
            <form class="adm-form" id="admNoticeForm" novalidate aria-labelledby="admNoticeTitle">
                <p class="va-flag">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v6"></path><circle cx="12" cy="7.5" r=".7" fill="currentColor"></circle></svg>
                    <span><strong>This tells, it does not disable.</strong> Use it for a rate change, or for a service behind the wizard such as DMS. To take a classic tile off the air, set a window above.</span>
                </p>

                <div class="adm-form__row">
                    <div class="csi-field">
                        <span class="csi-label">Kind</span>
                        <div class="adm-kind">
                            <label class="csi-radio">
                                <input type="radio" name="admNoticeKind" value="Rate change" checked>
                                <span>Rate change</span>
                            </label>
                            <label class="csi-radio">
                                <input type="radio" name="admNoticeKind" value="Maintenance">
                                <span>Maintenance</span>
                            </label>
                        </div>
                    </div>
                    <div class="csi-field">
                        <span class="csi-label" id="admAtLabel">Happens at</span>
                        @{ await When("admAt", Model.DefaultNoticeAt, "Happens at"); }
                    </div>
                </div>

                <div class="csi-field">
                    <label class="csi-label" for="admNoticeHead">Notice</label>
                    <input class="csi-control adm-control--wide" id="admNoticeHead" maxlength="90" autocomplete="off" placeholder="e.g. FD rates change from 1 October">
                </div>

                <div class="csi-field">
                    <label class="csi-label" for="admNoticeDetail">What it means for work in flight</label>
                    <textarea class="csi-control adm-textarea" id="admNoticeDetail" rows="2" maxlength="260" placeholder="e.g. An application booked and paid before the change keeps the old rate card."></textarea>
                </div>

                <p class="csi-error" id="admNoticeError" hidden></p>

                <div class="adm-form__actions">
                    <button type="submit" class="csi-btn csi-btn--primary">Publish to the bell</button>
                    <button type="button" class="csi-btn csi-btn--back" id="admNoticeReset">Clear</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/console.js"></script>
    <script src="~/js/classic-admin.js" asp-append-version="true"></script>
}

@page "/Apps/UnoTp/Dashboard/Mobile"
@model UnoTp.Pages.Apps.UnoTpApp.Mobile.DashboardModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Mobile
@{
    ViewData["Title"] = "Uno TP Dashboard";
    var needsAttention = Model.NeedsAttention.Take(3).ToList();
}

<div style="display:flex;flex-direction:column;gap:13px">
    <div class="card" style="border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:13px">
        <div>
            <div style="font-size:17px;font-weight:500">Good morning, Shivaprasad</div>
            <div style="font-size:11.5px;color:var(--muted);padding-top:4px"><span style="font-weight:700;color:var(--red-dark)">5 need you today</span> &middot; 11 in flight</div>
        </div>
        <a class="btn btn-primary" style="width:100%;border-radius:8px" asp-page="/Apps/UnoTp/Application/HolderIdentification">Create New FD</a>
        <a href="#" style="font-size:12px;font-weight:600;color:var(--red);text-align:center">Resume last application</a>
    </div>

    <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:11px">
        <div style="display:flex;align-items:baseline;gap:8px;padding-bottom:10px;border-bottom:1px solid var(--divider)">
            <div style="font-size:13px;font-weight:700;flex:1;min-width:0">Needs your attention</div>
            <div style="font-size:11px;font-weight:700;color:var(--red-dark)">@Model.NeedsAttention.Count</div>
        </div>
        @foreach (var n in needsAttention)
        {
            <div style="display:flex;gap:10px;align-items:flex-start;padding-bottom:11px;border-bottom:1px solid var(--divider)">
                <div style="width:6px;height:6px;border-radius:50%;background:@(n.BlockerClass == "text-danger" ? "#B3132B" : "#D69E2E");flex:none;margin-top:5px"></div>
                <div style="min-width:0;flex:1">
                    <div style="font-size:12px;font-weight:700">@n.AppNo &middot; @n.Holder</div>
                    <div class="@n.BlockerClass" style="font-size:11px;padding-top:3px;line-height:1.45">@n.Blocker</div>
                    <div style="font-size:10.5px;color:var(--muted);padding-top:3px">@n.Stage &middot; waiting @n.Waiting</div>
                </div>
                <a style="flex:none;font-size:11px;font-weight:700;color:var(--red)" asp-page="/Apps/UnoTp/Application/HolderIdentification">@n.ShortAction</a>
            </div>
        }
        <div style="font-size:11.5px;font-weight:700;color:var(--red);text-align:center;padding-top:2px">See all @Model.NeedsAttention.Count</div>
    </div>

    <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:11px">
        <div style="font-size:13px;font-weight:700;padding-bottom:10px;border-bottom:1px solid var(--divider)">In flight &middot; 11</div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px">
        @foreach (var s in Model.InFlightSummary)
        {
            <div style="border:1px solid var(--border-2);border-radius:8px;padding:11px 12px"><div style="font-size:18px;font-weight:600">@s.Count</div><div style="font-size:11px;font-weight:600;color:var(--text);padding-top:2px">@s.Label</div></div>
        }
        </div>
    </div>

    <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:2px">
        <div style="font-size:13px;font-weight:700;padding-bottom:10px;border-bottom:1px solid var(--divider)">Services</div>
        <div style="display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--divider)"><div style="font-size:12px;font-weight:600;flex:1;min-width:0">Application status</div><div style="font-size:10.5px;color:var(--muted);flex:none">11 open</div></div>
        <div style="display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--divider)"><div style="font-size:12px;font-weight:600;flex:1;min-width:0">Renew FD</div><div style="font-size:10.5px;color:var(--muted);flex:none">4 maturing</div></div>
        <div style="display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--divider)"><div style="font-size:12px;font-weight:600;flex:1;min-width:0">DPDP Consent Tracker</div><div style="font-size:10.5px;color:var(--muted);flex:none">2 expiring</div></div>
        <div style="display:flex;align-items:center;gap:10px;padding:11px 0"><div style="font-size:12px;font-weight:600;flex:1;min-width:0">PIS Generation &mdash; Axis</div></div>
    </div>

    <div class="callout" style="border-radius:0 8px 8px 0;padding:12px 14px;gap:7px">
        <div style="font-size:12.5px;font-weight:700">Have these ready before you start</div>
        <div style="font-size:11.5px;color:var(--text);line-height:1.5">PAN + date of birth (or folio) per holder &middot; PAN image for new customers &middot; signed DPDP and CKYC forms for offline consent &middot; holder&rsquo;s mobile for the consent OTP &middot; bank details and the payment cheque &middot; amount, tenure and scheme.</div>
        <a class="action-link" href="#">See the full document list</a>
    </div>
</div>

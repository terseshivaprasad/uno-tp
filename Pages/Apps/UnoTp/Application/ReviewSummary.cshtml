@* 11A: Submit / payment link dialog. Overlay on top of Review Summary (11), per the mockup
   ("11A — Submit · payment link dialog") — not a separate routed page. *@
<div class="modal-overlay" id="paymentLinkModal" hidden>
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="paymentLinkTitle">
        <div class="center-panel" style="max-width:480px;margin:0 auto">
            <div id="paymentLinkTitle" class="card__title">Send the payment link</div>
            <div class="card__subtitle">The deposit is not booked until the investor pays. Unpaid after 48 hours the application lapses.</div>

            <div class="card" style="width:100%;text-align:left">
                <dl class="kv-grid--2">
                    <div class="kv"><dt>Invested amount</dt><dd>&#8377; 5,00,000</dd></div>
                    <div class="kv"><dt>Tenure / Rate of interest</dt><dd>36 months &middot; 7.85%</dd></div>
                    <div class="kv"><dt>Payment method</dt><dd>Online</dd></div>
                    <div class="kv"><dt>Paid from</dt><dd>Any account in a holder's name</dd></div>
                    <div class="kv"><dt>Sent to</dt><dd>Primary holder's mobile, captured at search &middot; 87797 12676</dd></div>
                    <div class="kv"><dt>Valid for</dt><dd>48 hours</dd></div>
                </dl>
                <div class="field-hint" style="margin-top:10px">The broker is the one the investor will call if the link does not work.</div>
            </div>

            <form method="post" asp-page-handler="Send" style="width:100%">
                <div class="wizard__actions" style="border-top:none">
                    <div class="wizard__actions-left">
                        <button type="button" class="btn btn-secondary" id="closePaymentLinkModal">Back</button>
                        <button type="button" class="btn btn-secondary">Try later</button>
                    </div>
                    <div class="wizard__actions-right">
                        <button type="submit" class="btn btn-primary">Send payment link</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('reviewForm');
            var boxes = form.querySelectorAll('.rv-declaration__box');
            var hint = document.getElementById('rv-footer-hint');
            var modal = document.getElementById('paymentLinkModal');
            var submit = document.getElementById('openPaymentLinkModal');
            var closeBtn = document.getElementById('closePaymentLinkModal');
            var WORDS = ['', 'the last declaration', 'two declarations', 'all three declarations'];

            // Submit holds until every declaration is signed; unsigned ones carry "Required".
            function sync() {
                var unsigned = 0;
                boxes.forEach(function (box) {
                    box.closest('.rv-declaration').classList.toggle('rv-declaration--unsigned', !box.checked);
                    if (!box.checked) unsigned++;
                });
                hint.innerHTML = 'Every control point passed &middot; 26 of 26 fields, nominee captured, all proofs verified against source &mdash; '
                    + (unsigned ? '<strong>sign ' + WORDS[unsigned] + ' to submit</strong>' : '<strong>declarations signed &middot; ready to submit</strong>');
                submit.disabled = unsigned > 0;
                submit.classList.toggle('hid-link--primary', !submit.disabled);
                submit.classList.toggle('hid-link--disabled', submit.disabled);
            }

            form.addEventListener('change', sync);
            form.addEventListener('reset', function () {
                // The reset event fires before the values are restored.
                setTimeout(sync);
            });
            submit.addEventListener('click', function () { if (!submit.disabled) modal.hidden = false; });
            closeBtn.addEventListener('click', function () { modal.hidden = true; });
            sync();
        })();
    </script>
}

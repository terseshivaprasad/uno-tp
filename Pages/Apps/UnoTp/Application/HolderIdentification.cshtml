@page "/Apps/UnoTp/Application/HolderIdentification"
@model UnoTp.Pages.Apps.UnoTpApp.Application.HolderIdentificationModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Application
@{
    ViewData["Title"] = "Investor Information - Holder Identification";
    Layout = "/Pages/Shared/_WizardLayout.cshtml";
    ViewData["WizardStep"] = "docs";
    ViewData["StepLabel"] = "Step 2 of 5";
    ViewData["ApplicationNo"] = "New application";
}

@* This single page covers mockup screens 02, 02A, 02B, 03, 04, 05, 06.
   Each screen is one [data-step] section; hid-holder-id.js shows one at a time,
   mirroring the mockup's own client-side step switching (doc-page.js/support.js). *@

<div class="hid-steps" role="tablist" aria-label="Holder identification progress">
    <button type="button" class="hid-step-pill" data-goto="search">02 Search</button>
    <button type="button" class="hid-step-pill" data-goto="result">02A Result</button>
    <button type="button" class="hid-step-pill" data-goto="renewal">02B Renewal</button>
    <button type="button" class="hid-step-pill" data-goto="existing">03 Existing</button>
    <button type="button" class="hid-step-pill" data-goto="newpan">04 New PAN</button>
    <button type="button" class="hid-step-pill" data-goto="consent">05 Consent</button>
    <button type="button" class="hid-step-pill" data-goto="complete">06 Complete</button>
</div>

<form method="post" id="hidForm">
<input type="hidden" name="Step" id="hidStepField" value="@Model.Step" />

<!-- 02: Holder search -->
<section class="hid-section" data-step="search">
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
        <div class="card__title">Holders</div>
        <div class="card__subtitle">the primary holder is required &middot; up to two joint holders are optional, each added after the previous one is identified</div>
    </div>
    <div class="holder-block">
        <div class="holder-block__title">Holder 1 <span class="tag tag--primary">Primary</span></div>
        <div class="form-grid">
            <div class="field">
                <label>Search By</label>
                <select><option>PAN</option><option>Folio Number</option></select>
            </div>
            <div class="field">
                <label>PAN <span class="required">*</span></label>
                <input placeholder="e.g. BISPM4465N" />
            </div>
            <div class="field">
                <label>Date of birth <span class="required">*</span></label>
                <input type="date" />
            </div>
        </div>
    </div>
    <div class="field-hint">Renewal does not need its own flow &mdash; enter the same PAN or folio above and, if the folio has a deposit approaching maturity, the search result offers to renew it.</div>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <a class="btn btn-secondary" asp-page="/Apps/UnoTp/Desktop/Dashboard">Back</a>
            <button type="button" class="btn btn-secondary">Clear All</button>
        </div>
        <div class="wizard__actions-right">
            <button type="button" class="btn btn-primary hid-next" data-goto="result">Proceed</button>
        </div>
    </div>
</section>

<!-- 02A: Search result -->
<section class="hid-section" data-step="result" hidden>
    <div class="card__title">Search result</div>
    <div class="card__subtitle">An outcome of the search the broker already runs &mdash; record found on the folio, with existing deposits and holders shown before proceeding.</div>
    <div class="holder-block">
        <div class="holder-block__title">Record found <span class="tag tag--success">Existing customer</span></div>
        <dl class="kv-grid">
            <div class="kv"><dt>Folio number</dt><dd>MF0051187</dd></div>
            <div class="kv"><dt>PAN</dt><dd>BISPM4465N</dd></div>
            <div class="kv"><dt>Name</dt><dd>Priya Sunil Nair</dd></div>
        </dl>
        <div class="summary-block">
            <div class="summary-block__title">Holders on the folio</div>
            <dl class="kv-grid">
                <div class="kv"><dt>Holder 1 &middot; Primary</dt><dd>Priya Sunil Nair</dd></div>
                <div class="kv"><dt>Holder 2</dt><dd>Not identified</dd></div>
            </dl>
        </div>
        <div class="summary-block">
            <div class="summary-block__title">Existing deposits</div>
            <table class="data-table">
                <thead><tr><th>FD number</th><th>Rate</th><th>Maturity</th><th></th></tr></thead>
                <tbody>
                    <tr><td>FD22771</td><td>7.4%</td><td>Not due</td><td></td></tr>
                    <tr><td>FD38904</td><td>7.6%</td><td>Matures 13 Feb 2028</td><td></td></tr>
                    <tr><td>FD41120</td><td>7.9%</td><td class="text-danger">Maturing soon</td><td><button type="button" class="action-link hid-next" data-goto="renewal" style="background:none;border:none;cursor:pointer">Renew</button></td></tr>
                </tbody>
            </table>
            <div class="field-hint">Renew carries the folio forward &middot; or choose a different deposit above.</div>
        </div>
    </div>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <button type="button" class="btn btn-secondary hid-next" data-goto="search">Back</button>
            <button type="button" class="btn btn-secondary hid-next" data-goto="search">Search again</button>
        </div>
        <div class="wizard__actions-right">
            <button type="button" class="btn btn-primary hid-next" data-goto="existing">Proceed with existing customer</button>
        </div>
    </div>
</section>

<!-- 02B: Renewal decision -->
<section class="hid-section" data-step="renewal" hidden>
    <div class="card__title">Renewal &middot; the one decision taken on search</div>
    <div class="card__subtitle">Renewing FD41120 &middot; same holders pass through &middot; only a holder who needs re-verification walks identification, consent and documents.</div>
    <div class="holder-block">
        <dl class="kv-grid">
            <div class="kv"><dt>Renewal of</dt><dd>FD41120</dd></div>
            <div class="kv"><dt>Maturity</dt><dd>opens 13 Feb 2028</dd></div>
            <div class="kv"><dt>Rate</dt><dd>at the card rate on the renewal date, not today's</dd></div>
        </dl>
        <div class="summary-block">
            <div class="summary-block__title">Holders</div>
            <dl class="kv-grid">
                <div class="kv"><dt>Holder 1 &middot; Primary</dt><dd>Priya Sunil Nair <span class="tag tag--success">CKYC valid</span></dd></div>
                <div class="kv"><dt>Holder 2</dt><dd>Anita Nair <span class="tag tag--success">CKYC valid</span></dd></div>
                <div class="kv"><dt>Holder 3</dt><dd>Rohan Nair <span class="tag tag--warn">Needs re-verification</span></dd></div>
            </dl>
            <div class="field-hint">CKYC lapsed 08 Jun 2024 for holder 3 &mdash; holder 3 will be asked to re-verify inside the normal flow. From here the flow is the purchase flow.</div>
        </div>
    </div>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <button type="button" class="btn btn-secondary hid-next" data-goto="result">Back</button>
            <button type="button" class="btn btn-secondary hid-next" data-goto="search">Cancel renewal</button>
        </div>
        <div class="wizard__actions-right">
            <button type="button" class="btn btn-primary hid-next" data-goto="complete">Renew</button>
        </div>
    </div>
</section>

<!-- 03: Existing customer found -->
<section class="hid-section" data-step="existing" hidden>
    <div class="card__title">Holders</div>
    <div class="card__subtitle">the primary holder is required &middot; up to two joint holders are optional, each added after the previous one is identified</div>
    <div class="holder-block">
        <div class="holder-block__title">Holder 1 <span class="tag tag--primary">Primary</span> <span class="tag tag--success">Existing customer</span> <span class="tag tag--success">Identified</span></div>
        <dl class="kv-grid">
            <div class="kv"><dt>Folio Number</dt><dd>MF0051187</dd></div>
            <div class="kv"><dt>Name</dt><dd>Priya Sunil Nair</dd></div>
            <div class="kv"><dt>Masked Mobile</dt><dd>98214XXX63</dd></div>
            <div class="kv"><dt>Masked Email</dt><dd>pr***@@gmail.com</dd></div>
            <div class="kv"><dt>DPDP consent</dt><dd><span class="tag tag--success">Valid consent already on file</span> &middot; this holder needs nothing further</dd></div>
        </dl>
        <div class="field-hint">Add a joint holder, optional &middot; a third unlocks once the second is complete.</div>
        <button type="button" class="btn btn-secondary btn-sm hid-next" data-goto="newpan" style="align-self:flex-start">Add joint holder</button>
    </div>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <button type="button" class="btn btn-secondary hid-next" data-goto="result">Back</button>
            <button type="button" class="btn btn-secondary">Clear All</button>
        </div>
        <div class="wizard__actions-right">
            <button type="button" class="btn btn-primary hid-next" data-goto="complete">Proceed</button>
        </div>
    </div>
</section>

<!-- 04: New customer PAN & NSDL -->
<section class="hid-section" data-step="newpan" hidden>
    <div class="card__title">Holders on this application</div>
    <div class="card__subtitle">OCR read vs verify with source &mdash; correct the name and date of birth, then retry.</div>
    <div class="holder-block">
        <div class="holder-block__title">Holder 3 <span class="tag tag--optional">Joint</span> <span class="tag tag--danger">NSDL FAILED</span></div>
        <div class="form-grid">
            <div class="field"><label>PAN <span class="required">*</span></label><input value="CDEPN2290F" /></div>
            <div class="field"><label>Name (as on PAN) <span class="required">*</span></label><input value="Priya S Nair" /></div>
            <div class="field"><label>Date of birth (as on PAN) <span class="required">*</span></label><input type="date" /></div>
            <div class="field"><label>Gender</label><select><option>Female</option><option>Male</option></select></div>
            <div class="field"><label>Mobile Number <span class="required">*</span></label><input /></div>
            <div class="field"><label>Email ID</label><input /></div>
        </div>
        <div class="doc-row">
            <div>
                <div class="doc-row__title">PAN card image &mdash; pan-nair.jpg</div>
                <div class="doc-row__hint">OCR read "Priya Sunil Nair" &middot; NSDL validation failed &mdash; correct the name and date of birth first.</div>
            </div>
            <div style="display:flex;gap:10px;flex:none">
                <button type="button" class="btn btn-secondary btn-sm">Replace</button>
                <button type="button" class="btn btn-secondary btn-sm">Retry NSDL</button>
            </div>
        </div>
        <div><button type="button" class="btn btn-secondary btn-sm hid-next" data-goto="existing">Remove Holder 3</button></div>
    </div>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <button type="button" class="btn btn-secondary hid-next" data-goto="existing">Back</button>
            <button type="button" class="btn btn-secondary">Clear All</button>
        </div>
        <div class="wizard__actions-right">
            <button type="button" class="btn btn-primary hid-next" data-goto="consent">Continue to consent</button>
        </div>
    </div>
</section>

<!-- 05: DPDP consent -->
<section class="hid-section" data-step="consent" hidden>
    <div class="card__title">Holders on this application</div>
    <div class="card__subtitle">Consent collection for this holder is chosen here, per holder &mdash; digital sends an OTP or link, offline needs a signed form uploaded.</div>
    <div class="holder-block">
        <div class="holder-block__title">Holder 3 <span class="tag tag--optional">Joint</span> <span class="tag tag--warn">CONSENT DUE</span></div>
        <div class="field-hint">Holder 3 is set to</div>
        <div style="display:flex;gap:10px">
            <button type="button" class="btn btn-secondary btn-sm">Digital</button>
            <button type="button" class="btn btn-primary btn-sm">Offline</button>
        </div>
        <div class="doc-row">
            <div>
                <div class="doc-row__title">Signed DPDP &amp; CKYC form</div>
                <div class="doc-row__hint">Registered contacts cannot be edited here &middot; upload the signed copy collected offline.</div>
            </div>
            <div style="display:flex;gap:10px;flex:none">
                <button type="button" class="btn btn-secondary btn-sm">Download form</button>
                <button type="button" class="btn btn-secondary btn-sm">Upload signed copy</button>
            </div>
        </div>
        <div style="display:flex;gap:10px">
            <button type="button" class="btn btn-secondary btn-sm">Send consent OTP</button>
            <button type="button" class="btn btn-secondary btn-sm">Send consent link</button>
            <button type="button" class="btn btn-secondary btn-sm hid-next" data-goto="newpan">Remove this joint holder</button>
        </div>
    </div>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <button type="button" class="btn btn-secondary hid-next" data-goto="newpan">Back</button>
            <button type="button" class="btn btn-secondary">Clear All</button>
        </div>
        <div class="wizard__actions-right">
            <button type="button" class="btn btn-primary hid-next" data-goto="complete">Continue</button>
        </div>
    </div>
</section>

<!-- 06: All holders complete -->
<section class="hid-section" data-step="complete" hidden>
    <div class="card__title">All holders complete</div>
    <div class="card__subtitle">At completion, every holder is either identified with valid CKYC/NSDL or has consent on file &mdash; ready to move to the documents step.</div>
    <table class="data-table">
        <thead><tr><th>Holder</th><th>Source</th><th>Identification</th><th>DPDP consent</th></tr></thead>
        <tbody>
            <tr><td><strong>Holder 1</strong><div class="field-hint">primary</div></td><td>Existing &middot; folio MF0051187</td><td class="text-green">NSDL valid</td><td class="text-green">On file 12 Mar 2025</td></tr>
            <tr><td><strong>Holder 2</strong></td><td>Existing &middot; folio MF0051188</td><td class="text-green">NSDL valid</td><td class="text-green">On file</td></tr>
            <tr><td><strong>Holder 3</strong></td><td>new customer</td><td class="text-green">CKYC</td><td class="text-green">Offline &middot; signed form uploaded</td></tr>
        </tbody>
    </table>
    <div class="wizard__actions">
        <div class="wizard__actions-left">
            <button type="button" class="btn btn-secondary hid-next" data-goto="consent">Back</button>
            <button type="button" class="btn btn-secondary">Clear All</button>
        </div>
        <div class="wizard__actions-right">
            <button type="submit" class="btn btn-primary">Proceed to documents</button>
        </div>
    </div>
</section>

</form>

@section Scripts {
    <script src="~/js/holder-identification.js" asp-append-version="true"></script>
}

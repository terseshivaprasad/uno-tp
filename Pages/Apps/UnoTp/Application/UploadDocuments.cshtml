@page "/Apps/UnoTp/Application/UploadDocuments"
@model UnoTp.Pages.Apps.UnoTpApp.Application.UploadDocumentsModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Application
@{
    ViewData["Title"] = "Upload Documents";
    Layout = "/Pages/Shared/_WizardLayout.cshtml";
    ViewData["WizardStep"] = "docs";
}

<div class="docs-head" style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap">
    <div style="min-width:0;flex:1">
        <div class="card__title laptop-only" style="font-size:19px;font-weight:600;color:var(--ink)">Upload documents</div>
        <div style="font-size:11.5px;color:var(--muted);padding-top:5px;line-height:1.5">Consent complete for all three holders &middot; 6 of 14 documents accepted &middot; 6 need attention</div>
    </div>
    <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;flex:none">
        <div style="font-size:11.5px;color:var(--muted)">Application No: <strong style="color:var(--ink)">FBBMFL26F99AAC1</strong></div>
        <div style="font-size:11.5px;color:var(--muted)">Application type</div>
        <div class="seg-toggle">
            <button type="button" class="seg-toggle__opt seg-toggle__opt--active">Offline</button>
            <button type="button" class="seg-toggle__opt">Digital</button>
        </div>
    </div>
</div>

<div>
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
        <div style="font-size:14.5px;font-weight:700;color:var(--ink)">Application details</div>
        <div class="card__subtitle">captured once for the application &mdash; these answers decide which documents are required below</div>
    </div>
    <div class="form-grid" style="padding-top:14px">
        <div class="field"><label>Payment Mode <span class="required">*</span></label><select><option>Cheque</option><option>NEFT/RTGS</option></select></div>
        <div class="field"><label>Sourcing Mode <span class="required">*</span></label><select><option>MFL-EX</option></select></div>
        <div class="field"><label>Sourcing Employee Code <span class="required">*</span></label><input value="MFL-EX" /></div>
    </div>
    <div class="form-grid" style="padding-top:16px">
        <div class="field"><label>Deposit Category <span class="required">*</span></label><select><option>EMPLOYEE</option><option>INDIVIDUAL</option></select></div>
        <div class="field"><label>Broker Code <span class="required">*</span></label><input value="100002225" /></div>
        <div class="field"><label>Physical Application Form No. <span class="required">*</span></label><input value="PAF-2290417" /></div>
    </div>
</div>

<div>
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
        <div style="font-size:13.5px;font-weight:700;color:var(--ink)">Employee deposit details</div>
        <span class="chip chip--primary">EMPLOYEE only</span>
        <div class="card__subtitle">Proof type is set on the employee proof row below &mdash; type always belongs to the document.</div>
    </div>
    <div class="form-grid" style="padding-top:14px">
        <div class="field"><label>Employee Code <span class="required">*</span></label><input value="EMP-44119" /></div>
        <div class="field"><label>Employee Company Name <span class="required">*</span></label><input value="Mahindra &amp; Mahindra Fin." /></div>
        <div class="field"><label>Employee holder <span class="required">*</span></label><select><option>Holder 1</option><option>Holder 2</option><option>Holder 3</option></select></div>
    </div>
    <div style="font-size:11px;color:var(--blue);padding-top:8px">Employee Name &mdash; <span style="font-weight:600">S. Terse</span></div>
    <div class="form-grid" style="padding-top:14px">
        <div class="field"><label>Emp Relation with holder <span class="required">*</span></label><select><option>Self</option><option>Spouse</option><option>Parent</option></select></div>
    </div>
</div>

<div class="callout callout--mint">
    <div style="font-size:11.5px;line-height:1.6">
        <span class="text-danger">Verification is mandatory for every proof of address.</span>
        <span style="color:var(--text)">A POA is accepted only when its OCR values match the verify-with-source response on all fields &mdash; name, date of birth, gender, parent or spouse name, address, reference number and expiry date. Until every holder&rsquo;s POA is verified, the document stays rejected and the application cannot proceed.</span>
    </div>
</div>

<div>
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding-bottom:6px">
        <div style="font-size:14.5px;font-weight:600;color:var(--ink)">What is holding this application</div>
        <div class="card__subtitle">6 items across holders 1 and 3 &middot; every one has to clear before Proceed opens</div>
    </div>
    <div class="holding-list">
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Proof of address</strong> &mdash; file no longer matches the selected type</div>
            <div class="holding-row__go">Go to document</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Proof of address &middot; mailing address</strong> &mdash; mandatory because &ldquo;mailing address differs&rdquo; is answered Yes for this holder</div>
            <div class="holding-row__go">Go to document</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Investor&rsquo;s photograph</strong> &mdash; not uploaded</div>
            <div class="holding-row__go">Go to document</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Employee proof</strong> &mdash; proof type not selected, so upload is closed</div>
            <div class="holding-row__go">Go to document</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 3</div>
            <div class="holding-row__reason"><strong>Disability certificate</strong> &mdash; mandatory because &ldquo;person with disability&rdquo; is answered Yes for this holder</div>
            <div class="holding-row__go">Go to document</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 3</div>
            <div class="holding-row__reason"><strong>PAN card</strong> &mdash; upload rejected &mdash; image unreadable</div>
            <div class="holding-row__go">Go to document</div>
        </div>
    </div>
</div>

<div>
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;padding-bottom:8px">
        <div style="font-size:14.5px;font-weight:600;color:var(--ink)">Documents by holder</div>
        <div class="card__subtitle">each row states why the document is asked for, what the system read from it, and what to do when a check fails</div>
    </div>
    <div class="doc-legend">
        <span class="doc-legend__item"><span class="text-green" style="font-weight:700">&#10003;</span> accepted</span>
        <span class="doc-legend__item"><span class="doc-status doc-status--attention">!</span> needs attention</span>
        <span class="doc-legend__item"><span class="doc-status doc-status--outstanding"></span> outstanding</span>
        <span style="margin-left:auto">Checks run per document &mdash; <strong>identification</strong> (what it is) &middot; <strong>extraction</strong> (what it says) &middot; <strong>verification</strong> (does it agree with the record)</span>
    </div>
</div>

<form method="post" id="uploadDocsForm">

@* ── Holder 1 ─────────────────────────────────────────────────────────── *@

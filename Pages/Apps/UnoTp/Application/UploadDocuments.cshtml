@page "/Apps/UnoTp/Application/UploadDocuments"
@model UnoTp.Pages.Apps.UnoTpApp.Application.UploadDocumentsModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Application
@{
    ViewData["Title"] = "Upload Documents";
    Layout = "/Pages/Shared/_WizardLayout.cshtml";
    ViewData["WizardStep"] = "docs";
}

<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap">
    <div>
        <div class="card__title">Upload documents</div>
        <div class="doc-progress-line" style="padding-top:6px">
            <span>6 of 14 documents accepted &middot; <span class="text-danger">6 need attention</span></span>
            <div class="doc-progress-bar"><div class="doc-progress-bar__fill" style="width:43%"></div></div>
        </div>
    </div>
    <div class="doc-app-meta">
        <span>Application No <strong>FBBMFL26F99AC1</strong></span>
        <span class="tag tag--primary">Application type</span>
        <span class="tag tag--danger">Offline</span>
        <span class="tag" style="background:var(--ink);color:#fff">Digital</span>
    </div>
</div>

<div>
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
        <div class="section-label">Application details</div>
        <div class="card__subtitle">captured once for the application &mdash; these answers decide which documents are requested below</div>
    </div>
    <div class="form-grid" style="padding-top:12px">
        <div class="field"><label>Payment Mode <span class="required">*</span></label><select><option>Cheque</option><option>NEFT/RTGS</option></select></div>
        <div class="field"><label>Sourcing Mode <span class="required">*</span></label><select><option>MFL-EX</option></select></div>
        <div class="field"><label>Sourcing Employee Code <span class="required">*</span></label><input value="MFL-EX" readonly style="background:#F7F8FA" /></div>
    </div>
    <div class="form-grid" style="padding-top:16px">
        <div class="field"><label>Deposit Category <span class="required">*</span></label><select><option>EMPLOYEE</option><option>INDIVIDUAL</option></select></div>
        <div class="field"><label>Broker Code</label><input value="100002225" readonly style="background:#F7F8FA" /></div>
        <div class="field"><label>Physical Application Form No. <span class="required">*</span></label><input value="PAF-2290417" /></div>
    </div>
</div>

<div>
    <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
        <div class="section-label">Employee deposit details</div>
        <span class="chip chip--muted">EMPLOYEE only</span>
        <div class="card__subtitle">proof type is set on the employee deposit row &mdash; type belongs to the document</div>
    </div>
    <div class="form-grid" style="padding-top:12px">
        <div class="field"><label>Employee Code <span class="required">*</span></label><input value="EMP-44119" /></div>
        <div class="field"><label>Employee Company Name <span class="required">*</span></label><input value="Mahindra &amp; Mahindra Fin." /></div>
        <div class="field"><label>Employee holder <span class="required">*</span></label><select><option>Holder 1</option><option>Holder 2</option><option>Holder 3</option></select></div>
    </div>
    <div style="font-size:11px;color:var(--muted);padding-top:8px">Employee Name &mdash; <span style="color:var(--red);font-weight:600">S. Terse</span></div>
    <div class="form-grid form-grid--2" style="padding-top:12px;max-width:600px">
        <div class="field"><label>Emp Relation with holder <span class="required">*</span></label><select><option>Self</option><option>Spouse</option><option>Parent</option></select></div>
    </div>
</div>

<div class="callout">
    <span style="font-weight:700;color:var(--red-dark)">Verification is mandatory for every proof of address.</span>
    <span style="font-size:12.5px;line-height:1.55">A POA is accepted only when its OCR values match the verify-with-source response &mdash; name, date of birth, gender, parent or spouse name, address, reference number and expiry date. Until every holder&rsquo;s POA is verified, the document stays rejected and the application cannot proceed.</span>
</div>

<div>
    <div class="section-label">What is holding this application</div>
    <div class="holding-list" style="padding-top:8px">
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Proof of address</strong> &mdash; file no longer matches the selected type</div>
            <div class="holding-row__go">Go to document &rsaquo;</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Proof of address &middot; mailing address</strong> &mdash; mandatory because &ldquo;mailing address differs&rdquo; is answered Yes for this holder</div>
            <div class="holding-row__go">Go to document &rsaquo;</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Investor&rsquo;s photograph</strong> &mdash; not uploaded</div>
            <div class="holding-row__go">Go to document &rsaquo;</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 1</div>
            <div class="holding-row__reason"><strong>Employee proof</strong> &mdash; proof type not selected, so upload is closed</div>
            <div class="holding-row__go">Go to document &rsaquo;</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 3</div>
            <div class="holding-row__reason"><strong>Disability certificate</strong> &mdash; mandatory because &ldquo;person with disability&rdquo; is answered Yes for this holder</div>
            <div class="holding-row__go">Go to document &rsaquo;</div>
        </div>
        <div class="holding-row">
            <div class="holding-row__holder">Holder 3</div>
            <div class="holding-row__reason"><strong>PAN card</strong> &mdash; upload rejected, image unreadable</div>
            <div class="holding-row__go">Go to document &rsaquo;</div>
        </div>
    </div>
</div>

<div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
    <div class="card__title">Documents by holder</div>
    <div class="card__subtitle">each row states why the document is asked for, what the system read from it, and what to do when a check fails</div>
</div>
<div class="doc-legend">
    <span class="doc-legend__item"><span class="doc-status doc-status--accepted">&#10003;</span> accepted</span>
    <span class="doc-legend__item"><span class="doc-status doc-status--attention">!</span> needs attention</span>
    <span class="doc-legend__item"><span class="doc-status doc-status--outstanding"></span> outstanding</span>
    <span style="margin-left:auto">checks run per document &mdash; identification (what it is), extraction (what it says), verification (does it agree with the record)</span>
</div>

<form method="post" id="uploadDocsForm">

<div class="holder-block">
    <div class="holder-block__head">
        <div class="holder-num holder-num--current holder-num--sm">1</div>
        <div class="holder-block__title">Holder 1 &middot; R&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull; <span class="tag tag--primary">Primary</span></div>
        <div class="holder-block__meta">
            <span class="chip chip--danger">3 of 7 accepted</span>
            <span class="text-green" style="font-size:11.5px;font-weight:700">&#10003; CKYC at application completion</span>
        </div>
    </div>
    <div class="holder-block__hint">Both answers are required and neither is pre-selected &mdash; the broker chooses them. Answering Yes to either adds a proof of address or a disability certificate to this holder&rsquo;s documents below.</div>

    <div class="holder-toggles">
        <div class="section-label">Set for this holder</div>
        <div class="holder-toggle-row">
            <div class="holder-toggle-row__label">Mailing address differs from permanent? <span class="required">*</span></div>
            <div class="seg-toggle"><button type="button" class="seg-toggle__opt seg-toggle__opt--active">Yes</button><button type="button" class="seg-toggle__opt">No</button></div>
            <div class="holder-toggle-row__label">Person with disability? <span class="required">*</span></div>
            <div class="seg-toggle"><button type="button" class="seg-toggle__opt">Yes</button><button type="button" class="seg-toggle__opt seg-toggle__opt--active">No</button></div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title"><span class="doc-status doc-status--accepted">&#10003;</span> Application form</div>
            <button type="button" class="btn btn-secondary btn-sm">Replace</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; physical form signed by the holder</div>
        <div class="doc-card__body"><div class="field-hint">fd-application-holder1.pdf &middot; 4 pages &middot; stored as-is</div></div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title"><span class="doc-status doc-status--accepted">&#10003;</span> PAN card</div>
            <button type="button" class="btn btn-secondary btn-sm">Replace</button>
        </div>
        <div class="doc-card__hint">Mandatory for every holder &mdash; identity proof</div>
        <div class="doc-card__body">
            <div class="field-hint">pan-bispm4465n.pdf &middot; 1.1 MB &middot; uploaded 11:24</div>
            <div class="field-hint">5 fields extracted &middot; matched to record</div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--attention"><span class="doc-status doc-status--attention">!</span> Proof of address</div>
            <button type="button" class="btn btn-secondary btn-sm">Re-upload</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; OCR name, DOB, gender, parent/spouse, address, reference number and expiry date are cross-checked with the verify-with-source response &mdash; not accepted until verification passes</div>
        <div class="doc-card__body">
            <div class="field"><label>Type</label><select style="max-width:220px"><option>Passport</option><option>Aadhaar</option><option>Driving licence</option><option>Voter ID</option></select></div>
            <div class="field-hint">poa-mahesh-modified.pdf &middot; 1.3 MB &middot; uploaded 12:34</div>
            <table class="data-table">
                <thead><tr><th></th><th>OCR read</th><th>Verify with source</th><th></th></tr></thead>
                <tbody>
                    <tr><td class="text-muted" style="font-weight:600">Name</td><td>R&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull;</td><td>R&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull;</td><td class="text-green">&#10003;</td></tr>
                    <tr><td class="text-muted" style="font-weight:600">DOB</td><td>1990-06-10</td><td>1990-06-10</td><td class="text-green">&#10003;</td></tr>
                    <tr><td class="text-muted" style="font-weight:600">Gender</td><td>Female</td><td>Female</td><td class="text-green">&#10003;</td></tr>
                    <tr><td class="text-muted" style="font-weight:600">Address</td><td>Nashik 422009</td><td>Pune 411045</td><td class="text-danger">&#10007;</td></tr>
                    <tr><td class="text-muted" style="font-weight:600">Ref no</td><td colspan="2" class="text-muted">not returned</td><td></td></tr>
                    <tr><td class="text-muted" style="font-weight:600">Expiry</td><td colspan="2" class="text-muted">not returned</td><td></td></tr>
                </tbody>
            </table>
            <div class="callout callout--sm">
                <span class="text-danger">&#10007; File does not match the selected type, and the verification does not agree with source.</span> Type on file was Aadhaar &mdash; the cross-check against the verify-with-source response no longer holds, and the address OCR read Nashik 422009 against Pune 411045 on record.
                <span class="text-danger">What to do &mdash; upload the passport pages, or set the type back to Aadhaar and correct the address.</span>
            </div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--attention"><span class="doc-status doc-status--attention">!</span> Investor&rsquo;s photograph</div>
            <button type="button" class="btn btn-primary btn-sm">Upload</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; face must match the PAN and proof of address photographs</div>
        <div class="doc-card__body"><div class="field-hint">Not uploaded</div></div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title"><span class="doc-status doc-status--accepted">&#10003;</span> Payment cheque copy</div>
            <button type="button" class="btn btn-secondary btn-sm">Replace</button>
        </div>
        <div class="doc-card__hint">Asked because Payment Mode is Cheque</div>
        <div class="doc-card__body">
            <div class="field-hint">cheque-hdfc-4471.jpg &middot; 640 KB &middot; uploaded 12:38</div>
            <div class="field-hint">A/c 50100&bull;&bull;&bull;&bull;4471 &middot; IFSC HDFC0000521 &middot; extracted &amp; matched to payout account</div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--muted"><span class="doc-status doc-status--outstanding"></span> Employee proof</div>
            <button type="button" class="btn btn-primary btn-sm">Upload</button>
        </div>
        <div class="doc-card__hint">Asked because Deposit Category is EMPLOYEE</div>
        <div class="doc-card__body">
            <div class="field"><label>Type</label><select style="max-width:220px"><option selected disabled>Select type</option><option>Appointment letter</option><option>Employee ID card</option><option>Payslip</option></select></div>
            <div class="callout callout--warn callout--sm">
                <span style="font-weight:600">! Type not selected.</span> The system needs it before the file can be read.
                <span>What to do &mdash; pick a proof type, then upload.</span>
            </div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--muted"><span class="doc-status doc-status--outstanding"></span> Proof of address &middot; mailing address</div>
            <button type="button" class="btn btn-primary btn-sm">Upload</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; &ldquo;mailing address differs&rdquo; is answered Yes for this holder &mdash; not accepted until verification passes</div>
        <div class="doc-card__body">
            <div class="field"><label>Type</label><select style="max-width:220px"><option selected disabled>Select type</option><option>Utility bill</option><option>Bank statement</option><option>Rent agreement</option></select></div>
            <div class="field-hint">valid bill, bank statement or rent agreement</div>
            <div class="callout callout--warn callout--sm">
                <span style="font-weight:600">Mailing address on file</span> &mdash; 14 Sai Chambers, Andheri East, Mumbai 400069
                <span>dated within the last 3 months</span>
            </div>
        </div>
    </div>
</div>

<div class="holder-block holder-block--done">
    <div class="holder-block__head">
        <div class="holder-num holder-num--done holder-num--sm">&#10003;</div>
        <div class="holder-block__title">Holder 2 &middot; S&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull; <span class="tag tag--optional">Joint</span></div>
        <div class="holder-block__meta"><span class="chip chip--success">3 of 3 accepted</span></div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title"><span class="doc-status doc-status--accepted">&#10003;</span> PAN card</div>
            <button type="button" class="btn btn-secondary btn-sm">Replace</button>
        </div>
        <div class="doc-card__hint">Mandatory for every holder &mdash; identity proof</div>
        <div class="doc-card__body"><div class="field-hint">pan-askpt8891j.jpg &middot; 1.1 MB &middot; uploaded 11:30 &middot; identified &amp; matched</div></div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title"><span class="doc-status doc-status--accepted">&#10003;</span> Proof of address (Driving licence)</div>
            <button type="button" class="btn btn-secondary btn-sm">Replace</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; OCR cross-check with source &mdash; not accepted until verification passes</div>
        <div class="doc-card__body"><div class="field-hint">poa-dl-mh12.jpg &middot; 1.1 MB &middot; uploaded 11:41 &middot; all seven fields checked</div></div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title"><span class="doc-status doc-status--accepted">&#10003;</span> Investor&rsquo;s photograph</div>
            <button type="button" class="btn btn-secondary btn-sm">Replace</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; face must match the PAN and proof of address</div>
        <div class="doc-card__body"><div class="field-hint">photo-holder2.jpg &middot; 220 KB &middot; face match &mdash; PAN 94% &middot; POA 91%</div></div>
    </div>
</div>

<div class="holder-block">
    <div class="holder-block__head">
        <div class="holder-num holder-num--current holder-num--sm">3</div>
        <div class="holder-block__title">Holder 3 &middot; P&bull;&bull;&bull;&bull; N&bull;&bull;&bull; <span class="tag tag--optional">Joint</span></div>
        <div class="holder-block__meta"><span class="chip chip--danger">0 of 4 accepted</span></div>
    </div>
    <div class="holder-block__hint">Answered Yes to person with disability &mdash; a disability certificate is required below.</div>

    <div class="holder-toggles">
        <div class="section-label">Set for this holder</div>
        <div class="holder-toggle-row">
            <div class="holder-toggle-row__label">Mailing address differs from permanent? <span class="required">*</span></div>
            <div class="seg-toggle"><button type="button" class="seg-toggle__opt">Yes</button><button type="button" class="seg-toggle__opt seg-toggle__opt--active">No</button></div>
            <div class="holder-toggle-row__label">Person with disability? <span class="required">*</span></div>
            <div class="seg-toggle"><button type="button" class="seg-toggle__opt seg-toggle__opt--active">Yes</button><button type="button" class="seg-toggle__opt">No</button></div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--attention"><span class="doc-status doc-status--attention">!</span> PAN card</div>
            <button type="button" class="btn btn-secondary btn-sm">Re-upload</button>
        </div>
        <div class="doc-card__hint">Mandatory for every holder &mdash; identity proof</div>
        <div class="doc-card__body">
            <div class="field-hint">pan-scan-3.jpg &middot; rejected 11:49</div>
            <div class="callout callout--sm">
                <span class="text-danger">&#10007; The image is too unclear to read.</span> Glare across the card and resolution below 300 dpi &mdash; no fields could be extracted.
                <span class="text-danger">What to do &mdash; re-shoot without flash on a flat surface, or scan at 300 dpi.</span>
            </div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--muted"><span class="doc-status doc-status--outstanding"></span> Proof of address</div>
            <button type="button" class="btn btn-primary btn-sm">Upload</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; OCR cross-check with source &mdash; not accepted until verification passes</div>
        <div class="doc-card__body">
            <div class="field"><label>Type</label><select style="max-width:220px"><option selected disabled>Select type</option><option>Aadhaar</option><option>Driving licence</option><option>Voter ID</option><option>Passport</option></select></div>
            <div class="field-hint">Upload stays closed until a proof type is chosen</div>
        </div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--muted"><span class="doc-status doc-status--outstanding"></span> Investor&rsquo;s photograph</div>
            <button type="button" class="btn btn-primary btn-sm">Upload</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; face must match the PAN and proof of address</div>
        <div class="doc-card__body"><div class="field-hint">Not uploaded &middot; face match against PAN and POA runs on upload</div></div>
    </div>

    <div class="doc-card">
        <div class="doc-card__head">
            <div class="doc-card__title doc-card__title--muted"><span class="doc-status doc-status--outstanding"></span> Disability certificate</div>
            <button type="button" class="btn btn-primary btn-sm">Upload</button>
        </div>
        <div class="doc-card__hint">Mandatory &mdash; &ldquo;person with disability&rdquo; is answered Yes for this holder</div>
        <div class="doc-card__body"><div class="field-hint">UDID card or medical board certificate</div></div>
    </div>
</div>

</form>

@section Footer {
    <div class="hid-footer">
        <div class="hid-footer__inner">
            <div class="actionbar__hint">Six items need attention across holders 1 and 3 &mdash; <strong>every proof of address must pass verification before Proceed opens</strong></div>
            <div style="display:flex;align-items:center;gap:24px">
                <a class="hid-link" asp-page="/Apps/UnoTp/Application/HolderIdentification"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 6l-6 6 6 6"></path></svg> Back</a>
                <button type="submit" form="uploadDocsForm" class="hid-link hid-link--disabled">Proceed <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 6l6 6-6 6"></path></svg></button>
            </div>
        </div>
    </div>
}

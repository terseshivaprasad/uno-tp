                        <tr><td>Parent</td><td>R&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;</td><td>R&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;</td><td class="text-green">&#10003;</td></tr>
                        <tr><td>Address</td><td>Pune 411045</td><td>Pune 411045</td><td class="text-green">&#10003;</td></tr>
                        <tr><td>Ref no</td><td>MH12 2019 0034471</td><td>MH12 2019 0034471</td><td class="text-green">&#10003;</td></tr>
                        <tr><td>Expiry</td><td>08/2031</td><td>08/2031 &middot; valid</td><td class="text-green">&#10003;</td></tr>
                    </tbody>
                </table>
                <span class="text-green" style="padding-top:3px">&#10003; identified as DL &nbsp; &#10003; OCR extracted &nbsp; &#10003; all seven fields cross-checked</span>
            </div>
            <button type="button" class="doc-grid-row__action">Replace</button>
        </div>

        <div class="doc-grid-row">
            <div>
            <div class="doc-grid-row__title"><span class="text-green">&#10003;</span> Investor&rsquo;s photograph</div>
            <div class="doc-grid-row__why">Mandatory &middot; face must match the PAN card and proof of address</div>
            </div>
            <div class="doc-grid-row__type text-muted" style="font-size:10.5px">Not typed</div>
            <div class="doc-grid-row__read">
                <span class="doc-grid-row__file">photo-holder2.jpg</span>
                <span>JPG &middot; 220 KB &middot; uploaded 11:42</span>
                <span class="text-green">&#10003; face match &middot; PAN 94% &nbsp; &#10003; face match &middot; POA 91%</span>
            </div>
            <button type="button" class="doc-grid-row__action">Replace</button>
        </div>
    </div>
</div>

@* ── Holder 3 ─────────────────────────────────────────────────────────── *@
<div class="holder-block">
    <div class="holder-block__head">
        <div class="holder-num holder-num--current holder-num--sm">3</div>
        <div style="min-width:0;flex:1">
            <div class="holder-block__title">Holder 3 &middot; P&bull;&bull;&bull;&bull; N&bull;&bull;&bull; <span class="chip chip--muted">Joint &middot; optional</span></div>
            <div style="font-size:10.5px;color:var(--muted);padding-top:3px">PAN CDEPN2290F &middot; 4 documents required &mdash; person with disability &middot; 1 rejected, 3 not uploaded</div>
        </div>
        <div class="holder-accept">
            <div class="holder-accept__count text-danger">0 of 4 accepted</div>
            <div class="holder-accept__bar" style="background:var(--divider-2)"></div>
        </div>
        <button type="button" class="doc-grid-row__action" style="flex:none">&#128465; Remove</button>
    </div>

    <div class="holder-toggles">
        <div class="section-label" style="flex:none">Set for this holder</div>
        <div class="holder-toggle">
            <span class="holder-toggle__label">Mailing address differs from permanent <span class="required">*</span></span>
            <div class="seg-toggle seg-toggle--sm"><button type="button" class="seg-toggle__opt">Yes</button><button type="button" class="seg-toggle__opt seg-toggle__opt--active">No</button></div>
        </div>
        <div class="holder-toggle">
            <span class="holder-toggle__label">Person with disability <span class="required">*</span></span>
            <div class="seg-toggle seg-toggle--sm"><button type="button" class="seg-toggle__opt seg-toggle__opt--active">Yes</button><button type="button" class="seg-toggle__opt">No</button></div>
        </div>
        <div class="holder-toggles__note">Answered Yes to person with disability, so a disability certificate is mandatory below; switching to No withdraws it.</div>
    </div>

    <div>
        <div class="doc-grid-row doc-grid-row--head">
            <div>Document &amp; why it is asked</div><div>Type</div><div>What the system read</div><div></div>
        </div>

        <div class="doc-grid-row">
            <div>
            <div class="doc-grid-row__title doc-grid-row__title--attention"><span class="doc-status doc-status--attention">!</span> PAN card</div>
            <div class="doc-grid-row__why">Mandatory for every holder</div>
            </div>
            <div class="doc-grid-row__type text-muted" style="font-size:10.5px">Not typed</div>
            <div class="doc-grid-row__read">
                <span class="doc-grid-row__file doc-grid-row__file--rejected">pan-scan-3.jpg</span>
                <span>JPG &middot; 180 KB &middot; rejected 11:49</span>
                <span><span class="text-green">&#10003; identified as PAN</span> &nbsp; <span class="text-danger">&#10007; extraction failed</span></span>
            </div>
            <button type="button" class="doc-grid-row__action">Re-upload</button>
            <div class="doc-grid-row__panel">
                <div class="callout callout--mint callout--sm">
                    <span><span class="text-danger">&#10007; The image is too unclear to read.</span> Glare across the card and a resolution below 300 dpi &mdash; PAN, name and date of birth could not be extracted.</span>
                    <span>What to do &mdash; <span style="font-weight:600">re-shoot without flash on a flat surface, or upload a 300 dpi scan</span></span>
                </div>
            </div>
        </div>

        <div class="doc-grid-row">
            <div>
            <div class="doc-grid-row__title"><span class="doc-status doc-status--outstanding"></span> Proof of address</div>
            <div class="doc-grid-row__why">Mandatory &middot; OCR name, DOB, gender, parent/spouse name, address, reference number and expiry date are cross-checked with the verify-with-source response &middot; <span style="font-weight:600">not accepted until verification passes</span></div>
            </div>
            <div class="doc-grid-row__type">
                <div class="field"><select style="border-color:var(--red)"><option selected disabled>Select type</option><option>Driving licence</option><option>Voter ID</option><option>Passport</option><option>Aadhaar</option></select></div>
            </div>
            <div class="doc-grid-row__read">
                <span>Upload opens once a type is chosen</span>
                <span class="text-muted">Driving licence, voter ID, passport or Aadhaar</span>
            </div>
            <button type="button" class="doc-grid-row__action">Upload</button>
        </div>

        <div class="doc-grid-row">
            <div>
            <div class="doc-grid-row__title"><span class="doc-status doc-status--outstanding"></span> Investor&rsquo;s photograph</div>
            <div class="doc-grid-row__why">Mandatory &middot; face must match the PAN card and proof of address</div>
            </div>
            <div class="doc-grid-row__type text-muted" style="font-size:10.5px">Not typed</div>
            <div class="doc-grid-row__read">
                <span>Not uploaded</span>
                <span class="text-muted">JPG/JPEG &middot; max 2 MB</span>
                <span class="text-danger">Face match against PAN and POA runs on upload &mdash; both must pass</span>
            </div>
            <button type="button" class="doc-grid-row__action">Upload</button>
        </div>

        <div class="doc-grid-row">
            <div>
            <div class="doc-grid-row__title"><span class="doc-status doc-status--outstanding"></span> Disability certificate</div>
            <div class="doc-grid-row__why"><span class="text-danger">Mandatory &mdash; &ldquo;person with disability&rdquo; is answered Yes for this holder.</span> Answered Yes on this screen; switching to No withdraws the requirement.</div>
            </div>
            <div class="doc-grid-row__type">
                <div class="field"><select style="border-color:var(--red)"><option selected disabled>Select type</option><option>UDID card</option><option>Medical board certificate</option></select></div>
                <div class="doc-grid-row__typenote">UDID card or medical board certificate</div>
            </div>
            <div class="doc-grid-row__read">
                <span>Upload opens once a type is chosen</span>
                <span class="text-muted">Name on the certificate is checked against the holder&rsquo;s name; UDID number and issuing authority are read by OCR and stored as-is.</span>
            </div>
            <button type="button" class="doc-grid-row__action">Upload</button>
        </div>
    </div>
</div>

</form>


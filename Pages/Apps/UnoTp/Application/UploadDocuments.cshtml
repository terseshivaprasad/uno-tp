@page "/Apps/UnoTp/Application/UploadDocuments"
@model UnoTp.Pages.Apps.UnoTpApp.Application.UploadDocumentsModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Application
@{
    ViewData["Title"] = "Upload Documents";
    Layout = "/Pages/Shared/_WizardLayout.cshtml";
    ViewData["WizardStep"] = "docs";
    ViewData["StepLabel"] = "Step 1 of 5";
}

<div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
    <div class="card__title">Documents by holder</div>
    <div class="card__subtitle">each row states why the document is asked for, what the system read from it, and what to do when a check fails</div>
</div>

<div class="field">
    <label>Payment Mode <span class="required">*</span></label>
    <select style="max-width:260px"><option>Cheque</option><option>NEFT/RTGS</option></select>
</div>

<div class="holder-block">
    <div class="holder-block__title">Holder 1 <span class="tag tag--primary">Primary</span></div>
    <div class="form-grid form-grid--2">
        <div class="field"><label>Differing mailing address?</label><select><option>No</option><option>Yes</option></select></div>
        <div class="field"><label>Person with disability?</label><select><option>No</option><option>Yes</option></select></div>
    </div>

    <div class="doc-row">
        <div><div class="doc-row__title">PAN card</div><div class="doc-row__hint">Verified against source on all seven fields</div></div>
        <span class="tag tag--success">Verified</span>
    </div>
    <div class="doc-row">
        <div><div class="doc-row__title">Proof of address (Aadhaar)</div><div class="doc-row__hint">Verify-with-source mandatory before proceeding</div></div>
        <span class="tag tag--success">Verified</span>
    </div>
    <div class="doc-row">
        <div><div class="doc-row__title">Photograph</div><div class="doc-row__hint">Face match against PAN and POA &mdash; mandatory</div></div>
        <span class="tag tag--success">Passes</span>
    </div>
    <div class="doc-row">
        <div><div class="doc-row__title">Payment cheque copy</div><div class="doc-row__hint">Asked because Payment Mode is Cheque</div></div>
        <button type="button" class="btn btn-secondary btn-sm">Replace</button>
    </div>
</div>

<div class="holder-block">
    <div class="holder-block__title">Holder 3 <span class="tag tag--optional">Joint</span></div>
    <div class="doc-row">
        <div><div class="doc-row__title">PAN card</div><div class="doc-row__hint">OCR read name, DOB, gender &mdash; cross-checked with source</div></div>
        <span class="tag tag--success">Verified</span>
    </div>
    <div class="doc-row">
        <div><div class="doc-row__title">Proof of address (Driving licence)</div><div class="doc-row__hint">Verify-with-source mandatory before proceeding</div></div>
        <span class="tag tag--warn">Awaiting upload</span>
    </div>
    <div class="doc-row">
        <div><div class="doc-row__title">Photograph</div><div class="doc-row__hint">Face match against PAN and POA &mdash; mandatory</div></div>
        <span class="tag tag--warn">Awaiting upload</span>
    </div>
</div>

<form method="post" id="uploadDocsForm">
</form>

@section Footer {
    <div class="hid-footer">
        <div class="hid-footer__inner">
            <div class="actionbar__hint">Six items need attention across holders 1 and 3 &mdash; <strong>every proof of address must pass verification before Proceed opens</strong></div>
            <div style="display:flex;align-items:center;gap:24px">
                <a class="hid-link" asp-page="/Apps/UnoTp/Application/HolderIdentification"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 6l-6 6 6 6"></path></svg> Back</a>
                <button type="submit" form="uploadDocsForm" class="hid-link hid-link--disabled">Proceed <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 6l6 6-6 6"></path></svg></button>
            </div>
        </div>
    </div>
}

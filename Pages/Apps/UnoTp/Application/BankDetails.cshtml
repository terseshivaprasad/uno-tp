@page "/Apps/UnoTp/Application/BankDetails"
@model UnoTp.Pages.Apps.UnoTpApp.Application.BankDetailsModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Application
@{
    ViewData["Title"] = "Bank Details & Payment";
    Layout = "/Pages/Shared/_WizardLayout.cshtml";
    ViewData["WizardStep"] = "bank";
}

<div class="inv-page-head">
    <div style="flex:1;min-width:0">
        <div class="inv-title">Payment Bank Details</div>
        <div style="font-size:12px;color:var(--muted);padding-top:4px">The account the deposit is funded from &middot; verified against the payment cheque on 07</div>
    </div>
    <div style="font-size:12.5px;color:var(--muted);flex:none">Application No: <span style="font-weight:600;color:var(--ink)">FBBMFL26F99AAC1</span></div>
</div>

<form method="post" id="bankDetailsForm" class="inv-form" novalidate>

    @* ── Payment account ──────────────────────────────────────────────────── *@
    <div class="bank-grid">
        <div class="inv-field">
            <label for="pay-ifsc">Bank Name &mdash; search IFSC / branch / location <span class="required">*</span></label>
            <input id="pay-ifsc" name="Payment.Ifsc" class="inv-control" value="HDFC0000521" autocomplete="off" />
        </div>
        <div class="inv-field">
            <label for="pay-account">Account Number <span class="required">*</span></label>
            <input id="pay-account" name="Payment.AccountNumber" class="inv-control" value="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;4471" autocomplete="off" />
        </div>
        <div class="inv-field">
            <label for="pay-account-confirm">Re-enter Account Number <span class="required">*</span></label>
            <input id="pay-account-confirm" name="Payment.AccountNumberConfirm" class="inv-control" value="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;4471" autocomplete="off" />
            <div class="inv-field__hint" id="pay-account-match">matches</div>
        </div>
        <div class="inv-field">
            <label for="cheque-date">Cheque Date <span class="required">*</span></label>
            <input id="cheque-date" name="Cheque.Date" class="inv-control" value="12 / 09 / 2026" placeholder="DD / MM / YYYY" />
        </div>
        <div class="inv-field">
            <label for="cheque-number">Cheque Number <span class="required">*</span></label>
            <input id="cheque-number" name="Cheque.Number" class="inv-control" value="004512" inputmode="numeric" maxlength="6" />
        </div>
        <div class="inv-field">
            <label for="cms-location">Axis CMS Location <span class="required">*</span></label>
            <select id="cms-location" name="Cheque.CmsLocation" class="inv-control">
                <option value="">Select</option>
                <option selected>Mumbai &mdash; Andheri</option>
                <option>Mumbai &mdash; Fort</option>
                <option>Thane &mdash; Naupada</option>
                <option>Pune &mdash; Shivajinagar</option>
            </select>
            <div class="inv-field__hint">the Axis branch the cheque is presented at &mdash; pick the one nearest the investor</div>
        </div>
    </div>

    <div class="bank-lookup">
        <div class="inv-kv"><div class="inv-kv__k">Bank name</div><div class="inv-kv__v">HDFC Bank</div></div>
        <div class="inv-kv"><div class="inv-kv__k">Branch name</div><div class="inv-kv__v">Andheri East, Mumbai</div></div>
        <div class="inv-kv"><div class="inv-kv__k">IFSC</div><div class="inv-kv__v">HDFC0000521</div></div>
        <div class="inv-kv"><div class="inv-kv__k">MICR</div><div class="inv-kv__v">400240015</div></div>
    </div>

    <div class="bank-verified">
        <div class="bank-verified__tick">&check;</div>
        <div class="bank-verified__text"><strong>Matches the payment cheque on file.</strong> Account number, IFSC and the account holder name read from cheque-hdfc-4471.jpg agree with what is typed here, and the name matches the primary holder R&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull;. The account itself is not verified with the bank &mdash; the cheque is the evidence.</div>
    </div>

    @* ── Repayment account ────────────────────────────────────────────────── *@
    <section class="bank-repayment">
        <div class="bank-repayment__head">
            <div style="min-width:0;flex:1">
                <div class="inv-title">Repayment Bank Details</div>
                <div style="font-size:12px;color:var(--muted);padding-top:4px">Paid to the investor &mdash; the account must belong to a holder on this application</div>
            </div>
            <label class="bank-same" for="repay-same">
                <span>Same as the payment account</span>
                <input type="checkbox" id="repay-same" name="Repayment.SameAsPayment" value="true" class="inv-switch" aria-label="Same as the payment account" checked />
            </label>
        </div>

        <div class="bank-grid">
            <div class="inv-field">
                <label for="repay-ifsc">Search IFSC / branch / location</label>
                <input id="repay-ifsc" name="Repayment.Ifsc" class="inv-control" value="HDFC0000521" autocomplete="off" readonly />
                <div class="inv-field__hint" data-same="copied from the payment account" data-own="search the IFSC printed on the repayment cheque">copied from the payment account</div>
            </div>
            <div class="inv-field">
                <label for="repay-account">Account Number</label>
                <input id="repay-account" name="Repayment.AccountNumber" class="inv-control" value="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;4471" autocomplete="off" readonly />
            </div>
            <div class="inv-field">
                <label for="repay-account-confirm">Re-enter Account Number</label>
                <input id="repay-account-confirm" name="Repayment.AccountNumberConfirm" class="inv-control" placeholder="not needed" autocomplete="off" readonly />
                <div class="inv-field__hint" data-same="skipped while the accounts are the same" data-own="type the account number again">skipped while the accounts are the same</div>
            </div>
        </div>

        <div class="bank-lookup" id="repay-lookup">
            <div class="inv-kv"><div class="inv-kv__k">Bank name</div><div class="inv-kv__v">HDFC Bank</div></div>
            <div class="inv-kv"><div class="inv-kv__k">Branch name</div><div class="inv-kv__v">Andheri East, Mumbai</div></div>
            <div class="inv-kv"><div class="inv-kv__k">IFSC</div><div class="inv-kv__v">HDFC0000521</div></div>
            <div class="inv-kv"><div class="inv-kv__k">MICR</div><div class="inv-kv__v">400240015</div></div>
        </div>

        <div class="bank-note">
            <strong>Both the payment and the repayment account must belong to a holder on this application.</strong> A third-party account is rejected by Operations at either end. Interest and maturity are paid to the same HDFC account the deposit is funded from &mdash; the cheque already verified on <a asp-page="/Apps/UnoTp/Application/UploadDocuments">07</a>. Turning the toggle off opens these fields, and a separate repayment account then needs its own cheque there before the application can proceed.
        </div>
    </section>

</form>

@section Footer {
    <div class="hid-footer">
        <div class="hid-footer__inner">
            <div class="actionbar__hint" id="bank-footer-hint">Payment and repayment both on the account read from the payment cheque &middot; <strong>nothing outstanding on this step</strong></div>
            <div style="display:flex;align-items:center;gap:24px">
                <a class="hid-link" asp-page="/Apps/UnoTp/Application/InvestorInfo"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 6l-6 6 6 6"></path></svg> Back</a>
                <button type="reset" form="bankDetailsForm" class="hid-link">Clear All</button>
                <button type="submit" form="bankDetailsForm" class="hid-link hid-link--primary" id="bank-proceed">Save &amp; Proceed <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 6l6 6-6 6"></path></svg></button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('bankDetailsForm');
            var payIfsc = document.getElementById('pay-ifsc');
            var payAccount = document.getElementById('pay-account');
            var payConfirm = document.getElementById('pay-account-confirm');
            var matchHint = document.getElementById('pay-account-match');
            var same = document.getElementById('repay-same');
            var repayIfsc = document.getElementById('repay-ifsc');
            var repayAccount = document.getElementById('repay-account');
            var repayConfirm = document.getElementById('repay-account-confirm');
            var repayLookup = document.getElementById('repay-lookup');
            var footerHint = document.getElementById('bank-footer-hint');
            var proceed = document.getElementById('bank-proceed');

            // The re-entered number is checked against the first as it is typed.
            function checkMatch() {
                var typed = payConfirm.value.trim() !== '';
                var matches = typed && payConfirm.value === payAccount.value;
                matchHint.textContent = !typed ? '' : matches ? 'matches' : 'does not match the account number';
                matchHint.classList.toggle('inv-field__hint--error', typed && !matches);
                payConfirm.classList.toggle('inv-control--error', typed && !matches);
            }

            // While the toggle is on the repayment fields mirror the payment account and are locked;
            // off, they open empty and the step waits on a separate repayment cheque.
            function syncRepayment(clearOnOpen) {
                var isSame = same.checked;
                [repayIfsc, repayAccount, repayConfirm].forEach(function (control) { control.readOnly = isSame; });
                if (isSame) {
                    repayIfsc.value = payIfsc.value;
                    repayAccount.value = payAccount.value;
                    repayConfirm.value = '';
                    repayConfirm.placeholder = 'not needed';
                } else {
                    if (clearOnOpen) { repayIfsc.value = ''; repayAccount.value = ''; repayConfirm.value = ''; }
                    repayConfirm.placeholder = '';
                }
                document.querySelectorAll('.bank-repayment [data-same]').forEach(function (hint) {
                    hint.textContent = isSame ? hint.dataset.same : hint.dataset.own;
                });
                repayLookup.hidden = !isSame;
                footerHint.innerHTML = isSame
                    ? 'Payment and repayment both on the account read from the payment cheque &middot; <strong>nothing outstanding on this step</strong>'
                    : 'Repayment goes to a separate account &middot; <strong>its cheque has to be uploaded on 07 before Save &amp; Proceed opens</strong>';
                proceed.disabled = !isSame;
                proceed.classList.toggle('hid-link--primary', isSame);
                proceed.classList.toggle('hid-link--disabled', !isSame);
            }

            payAccount.addEventListener('input', function () { checkMatch(); if (same.checked) syncRepayment(false); });
            payConfirm.addEventListener('input', checkMatch);
            payIfsc.addEventListener('input', function () { if (same.checked) syncRepayment(false); });
            same.addEventListener('change', function () { syncRepayment(true); });
            form.addEventListener('reset', function () {
                // The reset event fires before the values are restored.
                setTimeout(function () { checkMatch(); syncRepayment(false); });
            });
        })();
    </script>
}

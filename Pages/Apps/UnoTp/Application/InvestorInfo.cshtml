@page "/Apps/UnoTp/Application/InvestorInfo"
@model UnoTp.Pages.Apps.UnoTpApp.Application.InvestorInfoModel
@namespace UnoTp.Pages.Apps.UnoTpApp.Application
@{
    ViewData["Title"] = "Investor Information";
    Layout = "/Pages/Shared/_WizardLayout.cshtml";
    ViewData["WizardStep"] = "investor";
}

<div class="inv-page-head">
    <div style="flex:1;min-width:0">
        <div class="inv-title">Investor Information</div>
        <div style="font-size:12px;color:var(--muted);padding-top:4px">Every holder gives the same details &middot; holders are added and removed on the search step</div>
    </div>
    <div style="font-size:12.5px;color:var(--muted);flex:none">Application No: <span style="font-weight:600;color:var(--ink)">FBBMFL26F99AAC1</span></div>
</div>

<div style="display:flex;flex-direction:column;gap:14px">
    <div class="inv-section-head">
        <div class="inv-title">What is holding this application</div>
        <div class="card__subtitle">9 holder fields across 2 holders, plus the nominee &middot; every one has to be filled before Proceed opens</div>
    </div>
    <div>
        <div class="inv-holding-row">
            <div class="inv-holding-row__who">Holder 1</div>
            <div class="inv-holding-row__what"><span class="text-danger">Gender, parent name and Sub Occupation</span> &mdash; the first two could not be read by OCR and must be typed</div>
            <a class="inv-holding-row__go" href="#h1-manual">Go to field</a>
        </div>
        <div class="inv-holding-row">
            <div class="inv-holding-row__who">Holder 3</div>
            <div class="inv-holding-row__what"><span class="text-danger">Six fields</span> &mdash; four More Information and both FATCA answers &middot; only mobile and e-mail are in, from search</div>
            <a class="inv-holding-row__go js-open-holder" href="#holder-3" data-holder="holder-3">Open holder</a>
        </div>
        <div class="inv-holding-row">
            <div class="inv-holding-row__who">Application</div>
            <div class="inv-holding-row__what"><span class="text-amber">Nominee</span> &mdash; name, date of birth and relation are blank</div>
            <a class="inv-holding-row__go" href="#nominee">Go to nominee</a>
        </div>
    </div>
</div>

<form method="post" id="investorInfoForm" class="inv-form" novalidate>

<div>
    <div class="inv-section-head" style="padding-bottom:6px">
        <div class="inv-title">Holder details</div>
        <div class="card__subtitle">identity comes from CKYC &middot; the broker fills More Information and FATCA for each holder</div>
    </div>


                    <div class="inv-kv"><div class="inv-kv__k">Applicant Name</div><div class="inv-kv__v">R&bull;&bull;&bull;&bull;&bull;&bull; S&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull;</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">DOB</div><div class="inv-kv__v">10-06-1992</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">Gender</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">Father Name</div><div class="inv-kv__v inv-kv__v--unread">Not read &mdash; enter below</div></div>
                    <div class="inv-kv"><div class="inv-kv__k">PAN</div><div class="inv-kv__v">BISPM4465N</div></div>
                </div>
            </div>
        </div>

        <div class="inv-panel inv-panel--stack">
            <div class="inv-section-head">
                <div class="inv-panel__label" style="flex:1;min-width:0">Address &amp; proof of address &middot; from the documents on <a asp-page="/Apps/UnoTp/Application/UploadDocuments" class="inv-step-link">07</a></div>

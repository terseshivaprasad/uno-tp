                <div class="inv-kv"><div class="inv-kv__k">POA reference number</div><div class="inv-kv__v inv-kv__v--unread">Not read</div></div>
                <div class="inv-kv"><div class="inv-kv__k">POA expiry date</div><div class="inv-kv__v inv-kv__v--unread">Not read</div></div>
                <div class="inv-kv"><div class="inv-kv__k">Verification</div><div class="inv-kv__v" style="color:var(--red-dark)">Rejected &mdash; address mismatch</div></div>
            </div>
            <div class="inv-kv-grid inv-kv-grid--divided">

@section Scripts {
    <script>
        (function () {
            // "Open" on holder 3 and "Open holder" in the summary both expand the collapsed holder.
            document.querySelectorAll('.js-open-holder').forEach(function (trigger) {
                trigger.addEventListener('click', function () {
                    var holder = document.getElementById(trigger.dataset.holder);
                    var body = document.getElementById(trigger.dataset.holder + '-body');
                    var button = holder.querySelector('button.js-open-holder');
                    var opening = body.hidden || trigger.tagName === 'A';
                    body.hidden = !opening;
                    button.textContent = opening ? 'Close' : 'Open';
                    button.setAttribute('aria-expanded', String(opening));
                });
            });

            // A required field drops its red outline (and its hint) once it carries a value,
            // and gets them back when Clear All returns it to blank.
            var flagged = document.querySelectorAll('[data-flag-empty]');
            function flag(control) {
                var filled = control.value.trim() !== '';
                control.classList.toggle('inv-control--error', !filled);
                var hint = control.parentElement.querySelector('.inv-field__hint--error');
                if (hint) hint.hidden = filled;
            }
            flagged.forEach(function (control) {
                control.addEventListener(control.tagName === 'SELECT' ? 'change' : 'input', function () { flag(control); });
            });
            document.getElementById('investorInfoForm').addEventListener('reset', function () {
                // The reset event fires before the values are restored.
                setTimeout(function () { flagged.forEach(flag); });
            });
        })();
    </script>
}

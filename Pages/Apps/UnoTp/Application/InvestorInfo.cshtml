            <div class="holder-num holder-num--warn">1</div>
            <div style="min-width:0;flex:1">
                <div class="inv-holder__name">Holder 1 &middot; R&bull;&bull;&bull;&bull;&bull;&bull; T&bull;&bull;&bull;&bull;&bull; <span class="chip chip--primary">Primary</span></div>
                <div class="inv-holder__meta">PAN BISPM4465N &middot; identified and consented &middot; added on the search step</div>
            </div>
            <div class="inv-progress">
                <div class="inv-progress__count text-amber">7 of 10 complete</div>
                <div class="inv-progress__bar"><div style="width:70%;background:#E8A700"></div></div>
            </div>
        </div>

        <div class="inv-panel inv-ckyc">
            <div class="inv-ckyc__photo">Photo<br />from CKYC</div>

@page "/Apps/DmsExplorer"
@model UnoTp.Pages.Apps.DmsExplorer.IndexModel
@namespace UnoTp.Pages.Apps.DmsExplorer
@using UnoTp.Models
@using System.Text.Json
@{
    ViewData["Title"] = "DMS Explorer";
    ViewData["FirstNavLabel"] = "DMS Explorer";
    ViewData["FirstNavPage"] = "/Apps/DmsExplorer/Index";
    ViewData["FirstNavActive"] = true;
    ViewData["ShowAppFooter"] = true;

    var filing = Model.Filing;
    var docs = filing?.Documents ?? new List<DmsDocument>();
    // The board opens on the investor's passport, the second document in the list.
    var openDoc = docs.Count > 1 ? docs[1] : docs.FirstOrDefault();
    var open = openDoc is null ? null : Model.CurrentOf(openDoc);
    var inDms = docs.Count(d => d.DmsId is not null);
    var classes = new[] { DmsClass.Kyc, DmsClass.Fd, DmsClass.Open };
    var history = Model.ShowHistory;
}

<nav class="dms-tabs" aria-label="DMS Explorer">
    <a class="dms-tab dms-tab--active" asp-page="/Apps/DmsExplorer/Index" aria-current="page">View documents</a>
    <button type="button" class="dms-tab btn-reset js-dms-stub" data-stub="Upload documents opens its own board — not built yet.">Upload documents</button>
    <button type="button" class="dms-tab btn-reset js-dms-stub" data-stub="The sync queue opens its own board — not built yet.">Sync queue <span class="dms-tab__badge">1</span></button>
</nav>

<div class="dms-page">
    <form class="dms-search" method="get" role="search">
        <div class="dms-search__row">
            <select class="inv-control dms-search__by" name="by" aria-label="Look up by">
                <option value="control">Control / application no</option>
            </select>
            <input class="inv-control dms-search__no" type="search" name="no" value="@Model.Number" placeholder="Control or application number" aria-label="Control or application number" autocomplete="off">
            <div class="dms-search__actions">
                <button type="submit" class="btn btn-primary dms-search__submit">Submit</button>
                <a class="dms-search__clear" href="?no=">Clear</a>
            </div>
        </div>
        @if (filing is not null)
        {
            <div class="dms-search__classes">
                <span class="dms-search__label">Class</span>
                <div class="dms-pills" id="dmsClasses">
                    <button type="button" class="dms-pill dms-pill--active" data-class="all" aria-pressed="true">All <span data-current="@docs.Count" data-history="@Model.History.Count">@(history ? Model.History.Count : docs.Count)</span></button>
                    @foreach (var c in classes)
                    {
                        <button type="button" class="dms-pill" data-class="@c.ToString().ToLowerInvariant()" aria-pressed="false">@IndexModel.ClassLabel(c) <span data-current="@Model.Count(c)" data-history="@Model.HistoryCount(c)">@(history ? Model.HistoryCount(c) : Model.Count(c))</span></button>
                    }
                </div>
                <span class="dms-search__note">Holder type &middot; document type &middot; date &middot; class are the only ways to sort or filter</span>
            </div>
        }
    </form>

    @if (filing is null)
    {
        <div class="dms-empty">
            @if (Model.Number.Length == 0)
            {
                <div class="dms-empty__title">Look up a control or application number</div>
                <div class="dms-empty__text">Every document the store holds under that number is listed, grouped by holder type, with its history behind it.</div>
            }
            else
            {
                <div class="dms-empty__title">Nothing is filed under @Model.Number</div>
                <div class="dms-empty__text">Check the number and look it up again.</div>
            }
        </div>
    }
    else
    {
        var earliest = docs.Min(d => d.Uploaded);
        var latest = docs.Max(d => d.Uploaded);
        var earlier = Model.EarlierVersionCount;

        <div class="dms-result">
            <div class="dms-result__text">
                <div class="dms-result__title">
                    <span class="dms-result__no">Control @filing.ControlNo</span>
                    <span class="dms-result__app">application @filing.ApplicationNo</span>
                    <span class="chip chip--muted">Filed by @filing.FiledBy</span>
                </div>
                <div class="dms-result__summary">
                    @IndexModel.DocumentCount(docs.Count) &middot; @inDms in DMS@(docs.Count > inDms ? $" · {docs.Count - inDms} uploaded but not yet in DMS" : "") &middot; earliest @IndexModel.Stamp(earliest), latest @IndexModel.Stamp(latest)@(earlier > 0 ? $" · {earlier} earlier {(earlier == 1 ? "version" : "versions")} back to {IndexModel.Day(DateOnly.FromDateTime(Model.HistoryFrom))}" : "")
                </div>
            </div>
            <div class="dms-result__actions">
                <div class="seg-toggle seg-toggle--sm dms-views" id="dmsViews" role="group" aria-label="Show">
                    <button type="button" class="seg-toggle__opt@(history ? "" : " seg-toggle__opt--active")" data-view="current" aria-pressed="@(history ? "false" : "true")">Current &middot; @docs.Count</button>
                    <button type="button" class="seg-toggle__opt@(history ? " seg-toggle__opt--active" : "")" data-view="history" aria-pressed="@(history ? "true" : "false")">History &middot; @Model.History.Count</button>
                </div>
                <button type="button" class="dms-link dms-link--ink js-dms-stub" data-stub="Download all zips the @docs.Count current files under @filing.ControlNo — not built yet.">Download all</button>
            </div>
        </div>

        <div class="dms-body">
            <div class="dms-panels">
                <div class="dms-table" id="dmsCurrent" data-view="current" role="table" aria-label="Documents filed under @filing.ControlNo" hidden="@history">
                    <div class="dms-row dms-row--head" role="row">
                        <div role="columnheader">Document</div>
                        <div role="columnheader">Class</div>
                        <div role="columnheader">File</div>
                        <div role="columnheader">Uploaded</div>
                        <div role="columnheader">In DMS</div>
                        <div role="columnheader">DMS doc ID</div>
                        <div role="columnheader">Remark</div>
                        <div role="columnheader" class="dms-cell--action">Action</div>
                    </div>
                    @foreach (var group in Model.Groups)
                    {
                        <div class="dms-group" role="rowgroup">
                            <div class="dms-group__head" role="row">
                                <span role="rowheader">@group.Key</span>
                                <span class="dms-group__count" data-count data-unit="document">@IndexModel.DocumentCount(group.Count())</span>
                            </div>
                            @foreach (var d in group)
                            {
                                var entry = Model.CurrentOf(d);
                                var isOpen = entry == open;
                                var sub = IndexModel.SubLine(d);
                                <div class="dms-row dms-row--file@(isOpen ? " dms-row--open" : "")" role="row"
                                     data-class="@d.Class.ToString().ToLowerInvariant()"
                                     data-doc="@entry.DocKey"
                                     data-key="@entry.Key">
                                    <div class="dms-cell--doc" role="cell">
                                        <div class="dms-doc">@d.Type</div>
                                        @if (sub.Length > 0)
                                        {
                                            <div class="dms-sub">@sub</div>
                                        }
                                    </div>
                                    <div class="dms-cell--class" role="cell"><span class="@IndexModel.ClassChip(d.Class)">@IndexModel.ClassLabel(d.Class)</span></div>
                                    <div class="dms-cell--file" role="cell" data-label="File">@d.File</div>
                                    <div role="cell" data-label="Uploaded">@IndexModel.Stamp(d.Uploaded)</div>
                                    <div role="cell" data-label="In DMS">@(d.InDms is null ? "—" : IndexModel.Stamp(d.InDms.Value))</div>
                                    <div role="cell" data-label="DMS doc ID">@(d.DmsId ?? "—")</div>
                                    <div class="dms-cell--remark@(d.Remark is null ? " dms-cell--blank" : "")" role="cell" data-label="Remark">@(d.Remark ?? "—")</div>
                                    <div class="dms-cell--action" role="cell">
                                        <button type="button" class="dms-action" aria-current="@(isOpen ? "true" : null)">@(isOpen ? "Open •" : "View")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="dms-table__empty" hidden>No documents of this class are filed under this number.</div>
                    <div class="dms-table__foot">
                        <p>@IndexModel.CountWord(docs.Count) documents filed under this number &mdash; the version in force of everything the store holds, nothing inferred. Earlier versions stay in the store and are listed under History. A document that was never uploaded does not appear here at all; what an application still requires is answered in the module that owns it.</p>
                    </div>
                </div>

                <div class="dms-table dms-table--history" id="dmsHistory" data-view="history" role="table" aria-label="History of @filing.ControlNo" hidden="@(!history)">
                    <div class="dms-scope" id="dmsScope" hidden>
                        <span>History of <strong id="dmsScopeName"></strong></span>
                        <button type="button" class="dms-link" id="dmsScopeClear">Show every document</button>
                    </div>
                    <div class="dms-row dms-row--head" role="row">
                        <div role="columnheader">When</div>
                        <div role="columnheader">Event</div>
                        <div role="columnheader">Document</div>
                        <div role="columnheader">Class</div>
                        <div role="columnheader">File</div>
                        <div role="columnheader">Version</div>
                        <div role="columnheader">By</div>
                        <div role="columnheader" class="dms-cell--action">Action</div>
                    </div>
                    @foreach (var day in Model.HistoryDays)
                    {
                        <div class="dms-group" role="rowgroup">
                            <div class="dms-group__head" role="row">
                                <span role="rowheader">@IndexModel.Day(day.Key)</span>
                                <span class="dms-group__count" data-count data-unit="event">@IndexModel.EventCount(day.Count())</span>
                            </div>
                            @foreach (var e in day)
                            {
                                var isOpen = e.IsUpload && e.Version == open;
                                @* Every line names its version, but only the upload opens it in the viewer. *@
                                <div class="dms-row@(e.IsUpload ? " dms-row--file" : "")@(isOpen ? " dms-row--open" : "")" role="row"
                                     data-class="@e.Document.Class.ToString().ToLowerInvariant()"
                                     data-doc="@e.Version.DocKey"
                                     data-key="@e.Version.Key">
                                    <div class="dms-cell--when" role="cell">@IndexModel.Time(e.At)</div>
                                    <div class="dms-cell--event" role="cell">
                                        <div class="dms-event dms-event--@e.Event.Split(' ')[0].ToLowerInvariant()">@e.Event</div>
                                        <div class="dms-sub">@e.Detail</div>
                                    </div>
                                    <div class="dms-cell--doc" role="cell">
                                        <div class="dms-doc">@e.Document.Type</div>
                                        <div class="dms-sub">@e.Document.HolderType</div>
                                    </div>
                                    <div class="dms-cell--class" role="cell"><span class="@IndexModel.ClassChip(e.Document.Class)">@IndexModel.ClassLabel(e.Document.Class)</span></div>
                                    <div class="dms-cell--file" role="cell" data-label="File">@e.Version.File</div>
                                    <div role="cell" data-label="Version">
                                        v@(e.VersionNo) <span class="dms-version@(e.Version.Current ? " dms-version--current" : "")">@(e.Version.Current ? "current" : "superseded")</span>
                                    </div>
                                    <div role="cell" data-label="By">@e.By</div>
                                    <div class="dms-cell--action@(e.IsUpload ? "" : " dms-cell--blank")" role="cell">
                                        @if (e.IsUpload)
                                        {
                                            <button type="button" class="dms-action" aria-current="@(isOpen ? "true" : null)">@(isOpen ? "Open •" : "View")</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="dms-table__empty" hidden>Nothing of this class has been filed under this number.</div>
                    <div class="dms-table__foot">
                        <p>Every version filed under this number since @IndexModel.Day(DateOnly.FromDateTime(Model.HistoryFrom)), newest first. The store never drops a version, so each one stays viewable here after a newer one is filed.</p>
                    </div>
                </div>
            </div>

            @if (open is not null)
            {
                <aside class="dms-viewer" id="dmsViewer" aria-label="Document viewer" data-open="@open.Key">
                    <div class="dms-viewer__head">
                        <div class="dms-viewer__file" id="dmsFile">@open.File</div>
                        <span class="chip chip--muted" id="dmsSuperseded" hidden>Superseded</span>
                        <div class="dms-viewer__pos" id="dmsPos"></div>
                    </div>
                    <div class="dms-viewer__tools">
                        <button type="button" class="dms-tool" id="dmsZoomOut" aria-label="Zoom out">&minus;</button>
                        <span class="dms-viewer__zoom" id="dmsZoom" aria-live="polite">100%</span>
                        <button type="button" class="dms-tool" id="dmsZoomIn" aria-label="Zoom in">+</button>
                        <button type="button" class="dms-tool" id="dmsRotate">Rotate</button>
                        <button type="button" class="dms-tool dms-tool--red js-dms-file" data-verb="Open full">Open full</button>
                        <button type="button" class="dms-tool dms-tool--red js-dms-file" data-verb="Download">Download</button>
                    </div>
                    <div class="dms-preview">
                        <div class="dms-preview__page" id="dmsPage">
                            <span class="dms-preview__ext" id="dmsExt">@System.IO.Path.GetExtension(open.File).TrimStart('.').ToUpperInvariant()</span>
                        </div>
                    </div>
                    <dl class="dms-facts">
                        <dt>Holder type</dt><dd data-field="holder">@open.Holder</dd>
                        <dt>Class &middot; type</dt><dd data-field="type">@open.Type</dd>
                        <dt>Doc ref no</dt><dd data-field="ref">@open.Ref</dd>
                        <dt>Expiry</dt><dd data-field="expiry">@open.Expiry</dd>
                        <dt>Filed by</dt><dd data-field="filed">@open.Filed</dd>
                        <dt>DMS</dt><dd data-field="dms">@open.Dms</dd>
                        <dt>Versions</dt>
                        <dd><span data-field="versions">@open.Versions</span> <button type="button" class="dms-link dms-link--sm" id="dmsDocHistory">History</button></dd>
                    </dl>
                    <div class="dms-viewer__nav">
                        <button type="button" class="dms-step" id="dmsPrev">Previous</button>
                        <button type="button" class="dms-step" id="dmsNext">Next</button>
                        <button type="button" class="dms-link" id="dmsOpenCurrent" hidden>Open current version</button>
                    </div>
                    <p class="dms-viewer__note">This view only reads the store. Documents are filed and replaced under Upload documents; every earlier version stays viewable under History.</p>
                </aside>
                <script type="application/json" id="dmsVersions">@Html.Raw(JsonSerializer.Serialize(Model.Viewer, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
            }
        </div>
    }
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/dms-explorer.js" asp-append-version="true"></script>
}

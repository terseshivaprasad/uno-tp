@page "/Classic"
@model UnoTp.Pages.Desktop.ClassicIndexModel
@namespace UnoTp.Pages.Desktop
@using UnoTp.Models
@{
    ViewData["Title"] = "E-Sarathi Console (classic)";
    ViewData["FirstNavLabel"] = "E-Sarathi Portal";
    ViewData["FirstNavPage"] = "/Desktop/ClassicIndex";
    ViewData["FirstNavActive"] = true;
    ViewData["ShowAppFooter"] = true;

    // The old WA_FD_ESARATHI_CONSOLE/Default as it stands today: the profile down
    // the left, and one panel on the right holding the message-centre heading and
    // a flat grey tile per provisioned application. Nothing else is on the page.
    var profileLinks = new (string Icon, string Label, bool Menu)[]
    {
        ("phone", "Change of Mobile Number", false),
        ("mail", "Change of Email Id", false),
        ("lock", "Change Password", false),
        ("call", "Book a Service Call", false),
        ("play", "E-Sarathi Live Demo", true),
    };

    // One glyph for both tiles, as the old console draws them: a three-unit rack
    // with a gear on the bottom unit. Line art, no fill, in the tiles' slate.
    const string rack = "<g stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\">"
        + "<rect x=\"2.5\" y=\"2.5\" width=\"23\" height=\"6\" rx=\"1.5\"></rect>"
        + "<rect x=\"2.5\" y=\"11\" width=\"23\" height=\"6\" rx=\"1.5\"></rect>"
        + "<rect x=\"2.5\" y=\"19.5\" width=\"23\" height=\"6\" rx=\"1.5\"></rect>"
        + "<path d=\"M6 5.5h.01M9 5.5h.01M12 5.5h.01M6 14h.01M9 14h.01M12 14h.01M6 22.5h.01M9 22.5h.01M12 22.5h.01\" stroke-width=\"2.2\"></path>"
        + "<path d=\"M21.5 4.2v2.6M19.5 5.5h4M21.5 12.7v2.6M19.5 14h4\"></path>"
        + "</g>"
        // The gear sits over the foot of the rack, so it is filled white first.
        + "<circle cx=\"21.5\" cy=\"24\" r=\"5.4\" fill=\"#fff\"></circle>"
        + "<g stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" fill=\"none\">"
        + "<circle cx=\"21.5\" cy=\"24\" r=\"3.4\"></circle><circle cx=\"21.5\" cy=\"24\" r=\"1.1\"></circle>"
        + "<path d=\"M21.5 18.9v1.7M21.5 27.4v1.7M16.4 24h1.7M24.9 24h1.7M17.9 20.4l1.2 1.2M23.9 26.4l1.2 1.2M25.1 20.4l-1.2 1.2M19.1 26.4l-1.2 1.2\"></path>"
        + "</g>";

    // Only what this entity is provisioned for. Both open the classic pages.
    var apps = new (string Title, string Page)[]
    {
        ("Uno TP", "/Apps/UnoTp/Desktop/ClassicDashboard"),
        ("DMS Explorer", "/Apps/DmsExplorer/Index"),
    };

    // The line under the heading counts the tiles, spelled out to the handful a
    // partner is ever provisioned for; past that it falls back to the figure.
    var numbers = new[] { "No", "One", "Two", "Three", "Four", "Five", "Six" };
    var count = apps.Length < numbers.Length ? numbers[apps.Length] : apps.Length.ToString();
    var appsSub = $"{count} application{(apps.Length == 1 ? "" : "s")} entity {MockData.EntityCode} is provisioned for";
}

<partial name="_ViewSwitch" model="@("classic")" />

<div class="console-grid">
    <aside class="profile-card">
        <div class="profile-card__top">
            <div class="profile-avatar">PHOTO</div>
            <div>
                <div class="profile-card__name">@MockData.BrokerName</div>
                <div class="profile-card__sub">Channel partner &middot; head office</div>
            </div>
        </div>
        <dl class="profile-fact-row">
            <div class="profile-fact"><dt>Entity Code</dt><dd>@MockData.EntityCode</dd></div>
            <div class="profile-fact"><dt>Entity Type</dt><dd style="font-weight:500">1033</dd></div>
            <div class="profile-fact"><dt>Entity Main CP</dt><dd style="font-weight:500;line-height:1.45">Mahindra &amp; Mahindra Financial Services Limited</dd></div>
        </dl>
        @foreach (var link in profileLinks)
        {
            <button type="button" class="profile-link-row btn-reset js-stub">
                <partial name="_AppIcon" model="new AppIcon(link.Icon, 17)" />
                <span class="profile-link-row__label">@link.Label</span>
                @if (link.Menu)
                {
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#9AA1AB" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l7 7 7-7"></path></svg>
                }
            </button>
        }
    </aside>

    <section class="cconsole">
        <header class="cconsole__head">
            <div>
                <h1 class="cconsole__title">Applications</h1>
                <p class="cconsole__sub">@appsSub</p>
            </div>
            <button type="button" class="btn btn-secondary btn-sm cconsole__docs" id="openRequiredDocs" aria-haspopup="dialog">
                <partial name="_AppIcon" model='new AppIcon("doc", 14, "#6B7080")' />
                Required documents
            </button>
        </header>
        <form role="search" class="cconsole__search" onsubmit="return false">
            <div class="search-box search-box--sm">
                <partial name="_AppIcon" model='new AppIcon("search", 12, "#9AA1AB")' />
                <input class="js-classic-search" type="search" name="app" placeholder="Find an application" aria-label="Find an application" />
            </div>
        </form>
        <div class="classic-tiles cconsole__apps" data-classic-tile-scope>
            @foreach (var app in apps)
            {
                <a class="classic-tile" asp-page="@app.Page" data-search="@app.Title.ToLowerInvariant()">
                    <span class="classic-tile__icon"><svg width="48" height="48" viewBox="0 0 28 30" fill="none" aria-hidden="true">@Html.Raw(rack)</svg></span>
                    <span class="classic-tile__title">@app.Title</span>
                </a>
            }
            <p class="cconsole__none js-classic-empty" hidden>No application here goes by that name.</p>
        </div>
    </section>
</div>

<partial name="_RequiredDocs" />

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@* On a phone the profile card is not beside the panel - there is no beside -
   so what it holds goes into the menu behind the hamburger, under the links the
   bar carries. The card itself is hidden at that width by site.css. *@
@section MenuExtra {
    <div class="app-menu__group">
        <p class="app-menu__label">Entity</p>
        <dl class="app-menu__facts">
            <div><dt>Code</dt><dd>@MockData.EntityCode</dd></div>
            <div><dt>Type</dt><dd>1033</dd></div>
            <div><dt>Main CP</dt><dd>Mahindra &amp; Mahindra Financial Services Limited</dd></div>
        </dl>
    </div>

    <div class="app-menu__group">
        <p class="app-menu__label">Your account</p>
        @foreach (var link in profileLinks)
        {
            <button type="button" class="app-menu__row btn-reset js-stub">
                <partial name="_AppIcon" model="new AppIcon(link.Icon, 15)" />
                <span class="app-menu__row-label">@link.Label</span>
                @if (link.Menu)
                {
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#9AA1AB" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l7 7 7-7"></path></svg>
                }
            </button>
        }
    </div>
}

@section Scripts {
    <script src="~/js/console.js" asp-append-version="true"></script>
    <script src="~/js/required-docs.js" asp-append-version="true"></script>
}

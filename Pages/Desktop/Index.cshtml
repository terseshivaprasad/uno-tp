@page "/"
@model UnoTp.Pages.Desktop.IndexModel
@namespace UnoTp.Pages.Desktop
@{
    ViewData["Title"] = "E-Sarathi Console";
    ViewData["FirstNavLabel"] = "E-Sarathi Portal";
    ViewData["FirstNavPage"] = "/Desktop/Index";
}

<div class="console-grid">
    <aside class="profile-card">
        <div class="profile-card__top">
            <div class="profile-avatar">PHOTO</div>
            <div>
                <div class="profile-card__name">Shivaprasad Terse</div>
                <div class="profile-card__sub">Channel partner &middot; head office</div>
            </div>
        </div>
        <dl class="profile-fact-row">
            <div class="profile-fact"><dt>Entity code</dt><dd>100002225</dd></div>
            <div class="profile-fact"><dt>Entity type</dt><dd>1033 &middot; broker</dd></div>
            <div class="profile-fact"><dt>Main CP</dt><dd>Mahindra &amp; Mahindra Financial Services Limited</dd></div>
        </dl>
        <button type="button" class="profile-link-row js-stub" style="text-decoration:none;background:none;border:0;width:100%;text-align:left;cursor:pointer;font:inherit">Change of mobile number</button>
        <button type="button" class="profile-link-row js-stub" style="text-decoration:none;background:none;border:0;width:100%;text-align:left;cursor:pointer;font:inherit">Change of e-mail ID</button>
        <button type="button" class="profile-link-row js-stub" style="text-decoration:none;background:none;border:0;width:100%;text-align:left;cursor:pointer;font:inherit">Change password</button>
        <button type="button" class="profile-link-row js-stub" style="text-decoration:none;background:none;border:0;width:100%;text-align:left;cursor:pointer;font:inherit">Book a service call</button>
        <button type="button" class="profile-link-row js-stub" style="text-decoration:none;background:none;border:0;width:100%;text-align:left;cursor:pointer;font:inherit">E-Sarathi live demo</button>
    </aside>

    <div style="display:flex;flex-direction:column;gap:14px">
        <div class="card" style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap">
            <div style="min-width:0;flex:1">
                <div style="font-size:17px;font-weight:600;color:var(--ink)">Good morning, Shivaprasad</div>
                <div style="font-size:12px;color:var(--muted);padding-top:4px;line-height:1.5">Tuesday 15 September &middot; 14 applications in flight &middot; 5 need you, and the oldest has been waiting three days</div>
            </div>
            <div class="kpi-row">
                <div class="kpi"><div class="kpi__value">&#8377; 84.2 L</div><div class="kpi__label">booked this month</div></div>
                <div class="kpi"><div class="kpi__value">14</div><div class="kpi__label">in flight</div></div>
                <div class="kpi"><div class="kpi__value" style="color:var(--red-dark)">5</div><div class="kpi__label">need you</div></div>
                <div class="kpi"><div class="kpi__value" style="color:var(--amber)">6</div><div class="kpi__label">with Operations</div></div>
                <div class="kpi"><div class="kpi__value" style="color:var(--blue)">3</div><div class="kpi__label">awaiting realisation</div></div>
            </div>
        </div>

        <div class="card">
            <div class="card__header">
                <div>
                    <div class="card__title">Applications</div>
                    <div class="card__subtitle">Twelve provisioned for entity 100002225 &middot; two more available on request</div>
                </div>
                <div style="display:flex;align-items:center;gap:10px">
                    <form role="search" class="search-box" style="width:190px;padding:0" onsubmit="return false">
                        <input id="appSearch" type="search" name="q" placeholder="Find an application" aria-label="Find an application" style="border:0;outline:0;background:transparent;font:inherit;color:inherit;width:100%;padding:0 11px;height:34px" />
                    </form>
                    <button id="editPinnedBtn" type="button" class="action-link" style="background:none;border:0;padding:0;cursor:pointer;white-space:nowrap;font-weight:600;color:var(--text)">Edit pinned</button>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:18px">
                <div style="display:flex;align-items:baseline;gap:9px">
                    <div class="section-label" style="flex:1">Pinned &middot; what you open every day</div>
                    <div style="font-size:10.5px;color:var(--muted-2)">drag to reorder</div>
                </div>
                <div class="app-tile-grid">
                    @foreach (var app in Model.PinnedApps)
                    {
                        var isUnoTp = app.Title == "Uno TP";
                        @if (isUnoTp)
                        {
                            <a class="app-tile app-tile--pinned" style="text-decoration:none" asp-page="/Apps/UnoTp/Desktop/Dashboard">
                                <div class="app-tile__head">
                                    <div class="app-tile__icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E31837" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"></rect><rect x="3" y="14" width="18" height="6" rx="1"></rect></svg>
                                    </div>
                                    <div style="min-width:0;flex:1">
                                        <div class="app-tile__title">@app.Title</div>
                                        <div class="app-tile__desc">@app.Description</div>
                                    </div>
                                    @if (app.Badge is not null)
                                    {
                                        <div class="app-tile__badge">@app.Badge</div>
                                    }
                                </div>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="app-tile js-stub" style="text-align:left;border-color:var(--border)">
                                <div class="app-tile__head">
                                    <div class="app-tile__icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"></rect><rect x="3" y="14" width="18" height="6" rx="1"></rect></svg>
                                    </div>
                                    <div style="min-width:0;flex:1">
                                        <div class="app-tile__title">@app.Title</div>
                                        <div class="app-tile__desc">@app.Description</div>
                                    </div>
                                </div>
                            </button>
                        }
                    }
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:9px">
                <div class="section-label">Sourcing &amp; servicing</div>
                <div class="app-tile-grid">
                    @foreach (var app in Model.SourcingApps)
                    {
                        <button type="button" class="app-tile js-stub" style="text-align:left">
                            <div class="app-tile__head">
                                <div class="app-tile__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle></svg></div>
                                <div style="min-width:0;flex:1">
                                    <div class="app-tile__title">@app.Title</div>
                                    <div class="app-tile__desc">@app.Description</div>
                                </div>
                                @if (app.Badge is not null)
                                {
                                    <div class="app-tile__badge">@app.Badge</div>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:9px">
                <div class="section-label">Compliance, reporting &amp; admin</div>
                <div class="app-tile-grid">
                    @foreach (var app in Model.ComplianceApps)
                    {
                        <button type="button" class="app-tile js-stub" style="text-align:left">
                            <div class="app-tile__head">
                                <div class="app-tile__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z"></path></svg></div>
                                <div style="min-width:0;flex:1">
                                    <div class="app-tile__title">@app.Title</div>
                                    <div class="app-tile__desc">@app.Description</div>
                                </div>
                                @if (app.Badge is not null)
                                {
                                    <div class="app-tile__badge">@app.Badge</div>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:18px;border-top:1px solid var(--divider-2);padding-top:13px">
                <div class="section-label">Available on request</div>
                <div class="app-tile-grid">
                    @foreach (var app in Model.RequestableApps)
                    {
                        <div class="app-tile app-tile--disabled" style="cursor:default">
                            <div class="app-tile__head">
                                <div class="app-tile__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect></svg></div>
                                <div style="min-width:0;flex:1">
                                    <div class="app-tile__title">@app.Title</div>
                                    <div class="app-tile__desc">@app.Description</div>
                                </div>
                            </div>
                            <button type="button" class="js-stub" style="margin-top:auto;font-size:10px;color:var(--red);background:none;border:0;padding:0;cursor:pointer;text-align:left;font-weight:600">Not provisioned &middot; request access</button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card" style="display:flex;flex-direction:column;gap:14px">
                <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
                    <div style="min-width:0;flex:1"><div style="font-size:14.5px;font-weight:600">Applications in flight</div><div style="font-size:11px;color:var(--muted);padding-top:3px">Sorted by what is waiting longest &middot; each row opens the application at the step that is blocked</div></div>
                </div>

                <div id="statusPills" style="display:flex;gap:7px;flex-wrap:wrap">
                    <button type="button" class="status-pill status-pill--active" data-status="all">In flight <span class="status-pill__count">14</span></button>
                    <button type="button" class="status-pill" data-status="needs-you">Needs you <span class="status-pill__count" style="color:var(--red-dark)">5</span></button>
                    <button type="button" class="status-pill" data-status="operations">With Operations <span class="status-pill__count" style="color:var(--amber)">6</span></button>
                    <button type="button" class="status-pill" data-status="realisation">Awaiting realisation <span class="status-pill__count" style="color:var(--blue)">3</span></button>
                    <button type="button" class="status-pill js-stub" data-status="booked">Booked <span class="status-pill__count" style="color:var(--green)">38</span></button>
                    <button type="button" class="status-pill js-stub" data-status="lapsed">Lapsed <span class="status-pill__count" style="color:var(--red-dark)">2</span></button>
                    <button type="button" class="status-pill js-stub" data-status="every">All <span class="status-pill__count" style="color:var(--muted-2)">54</span></button>
                </div>

                <table class="data-table">
                    <thead><tr><th>Application</th><th>What is waiting</th><th>Amount</th><th>Step</th><th>Waiting</th><th></th></tr></thead>
                    <tbody id="applicationsTbody">
                    @foreach (var a in Model.Applications)
                    {
                        <tr class="attention" data-status="@a.StatusKey" data-search="@($"{a.AppNo} {a.HolderMask} {a.Status} {a.Step}".ToLowerInvariant())">
                            <td><strong>@a.AppNo</strong><div style="font-size:9.5px;color:var(--muted-2);padding-top:2px">@a.HolderMask</div></td>
                            <td><span class="@a.StatusClass">@a.Status</span> &mdash; @a.StatusDetail</td>
                            <td><strong>@a.Amount</strong></td>
                            <td>@a.Step</td>
                            <td class="@a.WaitingClass">@a.Waiting</td>
                            <td><a class="action-link" asp-page="/Apps/UnoTp/Application/HolderIdentification">@a.Action</a></td>
                        </tr>
                    }
                    </tbody>
                    <tbody id="applicationsEmpty" hidden>
                        <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:22px 13px">No applications match this filter on the current page.</td></tr>
                    </tbody>
                </table>
                <div style="border:1px solid var(--border);border-top:none;border-radius:0 0 8px 8px;background:#FAFBFC;padding:10px 13px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:-1px">
                    <div id="tableSummary" style="min-width:0;flex:1;font-size:11px;color:var(--muted)">Showing 1&ndash;7 of 14 in flight &middot; 5 need you, 6 with Operations, 3 awaiting realisation</div>
                    <div style="display:flex;align-items:center;gap:14px;flex:none;font-size:11px;font-weight:600;color:var(--text)">
                        <button type="button" class="js-stub" style="background:none;border:0;padding:0;cursor:pointer;font:inherit;color:inherit">Rows 7 &#9662;</button>
                        <button type="button" class="js-stub" style="background:none;border:0;padding:0;cursor:pointer;color:var(--muted-2)" aria-label="Previous page">&lsaquo;</button>
                        <button type="button" class="js-page js-page--active" data-page="1" style="background:none;border:0;padding:0;cursor:pointer;color:var(--ink);font-weight:700">1</button>
                        <button type="button" class="js-page" data-page="2" style="background:none;border:0;padding:0;cursor:pointer;color:var(--text)">2</button>
                        <button type="button" class="js-stub" style="background:none;border:0;padding:0;cursor:pointer;color:var(--text)" aria-label="Next page">&rsaquo;</button>
                    </div>
                </div>
                <div style="font-size:11px;color:var(--muted);line-height:1.55">The first seven of fourteen, longest-waiting first. Rows the broker can act on are tinted; rows with Operations or the bank are not, so a long list still reads as a to-do list rather than a log.</div>
        </div>

        <div class="card" style="display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap">
            <div style="min-width:0;flex:1">
                <div style="font-size:13px;font-weight:600;color:var(--ink)">Notices</div>
                <div style="font-size:11.5px;color:var(--text);padding-top:5px;line-height:1.55">Card rates revised with effect from 12 September &mdash; 36-month public deposits now 7.85%. Applications submitted before the revision keep the rate they were priced at, provided the cheque realises within 48 hours.</div>
            </div>
            <button type="button" id="rateCardBtn" class="action-link" style="flex:none;background:none;border:0;cursor:pointer">Rate card</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="rateCardModal" hidden>
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="rateCardTitle">
        <div id="rateCardTitle" style="font-size:16px;font-weight:600;color:var(--ink)">FD card rates &middot; effective 12 September 2026</div>
        <table class="data-table" style="margin-top:16px">
            <thead><tr><th>Tenure</th><th>General</th><th>Senior citizen</th></tr></thead>
            <tbody>
                <tr><td>12 months</td><td>7.25%</td><td>7.50%</td></tr>
                <tr><td>24 months</td><td>7.60%</td><td>7.85%</td></tr>
                <tr><td>36 months</td><td>7.85%</td><td>8.10%</td></tr>
                <tr><td>60 months</td><td>7.75%</td><td>8.00%</td></tr>
            </tbody>
        </table>
        <div style="font-size:11.5px;color:var(--muted);padding-top:12px;line-height:1.55">Applications submitted before the revision keep the rate they were priced at, provided the cheque realises within 48 hours.</div>
        <div style="display:flex;justify-content:flex-end;padding-top:20px">
            <button type="button" class="btn btn-primary" id="rateCardCloseBtn">Close</button>
        </div>
    </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/console.js"></script>
}

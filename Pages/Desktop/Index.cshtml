@page "/New"
@model UnoTp.Pages.Desktop.IndexModel
@namespace UnoTp.Pages.Desktop
@using UnoTp.Models
@{
    ViewData["Title"] = "E-Sarathi Console";
    ViewData["FirstNavLabel"] = "E-Sarathi Portal";
    ViewData["FirstNavPage"] = "/Desktop/Index";
    ViewData["ShowAppFooter"] = true;

    var profileLinks = new (string Icon, string Label)[]
    {
        ("phone", "Change of mobile number"),
        ("mail", "Change of e-mail ID"),
        ("lock", "Change password"),
        ("call", "Book a service call"),
        ("play", "E-Sarathi live demo"),
    };

    // Board 00 - Mobile colours the leading dot by how urgent the blocker is,
    // not by the text colour, so amber reads warmer here than in the table.
    static string DotColor(string statusClass) => statusClass switch
    {
        "text-danger" => "#E31837",
        "text-amber" => "#E8A700",
        "text-success" => "#1E9E52",
        _ => "#9AA1AB",
    };
}

@* Board 00 - Laptop *@
<div class="view-laptop">
    <partial name="_ViewSwitch" model="@("new")" />

    <div class="console-grid" data-tile-scope>
        <aside class="profile-card">
            <div class="profile-card__top">
                <div class="profile-avatar">PHOTO</div>
                <div>
                    <div class="profile-card__name">@MockData.BrokerName</div>
                    <div class="profile-card__sub">Channel partner &middot; head office</div>
                </div>
            </div>
            <dl class="profile-fact-row">
                <div class="profile-fact"><dt>Entity code</dt><dd>@MockData.EntityCode</dd></div>
                <div class="profile-fact"><dt>Entity type</dt><dd style="font-weight:500">1033 &middot; broker</dd></div>
                <div class="profile-fact"><dt>Main CP</dt><dd style="font-weight:500;line-height:1.45">Mahindra &amp; Mahindra Financial Services Limited</dd></div>
            </dl>
            @foreach (var link in profileLinks)
            {
                <button type="button" class="profile-link-row btn-reset js-stub">
                    <partial name="_AppIcon" model="new AppIcon(link.Icon, 17)" />
                    <span class="profile-link-row__label">@link.Label</span>
                    <partial name="_AppIcon" model='new AppIcon("chevron", 13, "#9AA1AB")' />
                </button>
            }
        </aside>

        <div class="card-stack">
            <div class="card" style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap">
                <div style="min-width:0;flex:1">
                    <div style="font-size:17px;font-weight:600;color:var(--ink)">Good morning, Shivaprasad</div>
                    <div style="font-size:12px;color:var(--muted);padding-top:4px;line-height:1.5">Tuesday 15 September &middot; 14 applications in flight &middot; 5 need you, and the oldest has been waiting three days</div>
                </div>
                <div class="kpi-row">
                    <div class="kpi"><div class="kpi__value">&#8377; 84.2 L</div><div class="kpi__label">booked this month</div></div>
                    <div class="kpi"><div class="kpi__value">14</div><div class="kpi__label">in flight</div></div>
                    <div class="kpi"><div class="kpi__value" style="color:var(--red-dark)">5</div><div class="kpi__label">need you</div></div>
                    <div class="kpi"><div class="kpi__value" style="color:var(--amber)">6</div><div class="kpi__label">with Operations</div></div>
                    <div class="kpi"><div class="kpi__value" style="color:var(--blue)">3</div><div class="kpi__label">awaiting realisation</div></div>
                </div>
            </div>

            <div class="card card--console" style="display:flex;flex-direction:column;gap:14px">
                <div class="card__header" style="margin-bottom:0">
                    <div style="min-width:0;flex:1">
                        <div class="card__title">Applications</div>
                        <div class="card__subtitle">Twelve provisioned for entity @MockData.EntityCode &middot; two more available on request</div>
                    </div>
                    <div class="card__header-actions">
                        <form role="search" class="search-box search-box--sm" style="width:190px" onsubmit="return false">
                            <partial name="_AppIcon" model='new AppIcon("search", 12, "#9AA1AB")' />
                            <input class="js-tile-search" type="search" name="app" placeholder="Find an application" aria-label="Find an application" />
                        </form>
                        <button id="editPinnedBtn" type="button" class="btn-reset" style="font-size:11.5px;font-weight:600;color:var(--text);white-space:nowrap">Edit pinned</button>
                    </div>
                </div>

                <div class="tile-section">
                    <div style="display:flex;align-items:baseline;gap:9px">
                        <div class="section-label" style="flex:1;min-width:0">Pinned &middot; what you open every day</div>
                        <div style="font-size:10.5px;color:var(--muted-2)">drag to reorder</div>
                    </div>
                    <div class="app-tile-grid">
                        @foreach (var app in Model.PinnedApps)
                        {
                            var search = $"{app.Title} {app.Description}".ToLowerInvariant();
                            @if (app.Title == "Uno TP")
                            {
                                <a class="app-tile app-tile--pinned" data-search="@search" asp-page="/Apps/UnoTp/Desktop/Dashboard">
                                    <div class="app-tile__head">
                                        <div class="app-tile__icon"><partial name="_AppIcon" model='new AppIcon(app.Icon, 18, "#E31837")' /></div>
                                        <div style="min-width:0;flex:1">
                                            <div class="app-tile__title">@app.Title</div>
                                            <div class="app-tile__desc">@app.Description</div>
                                        </div>
                                        @if (app.Badge is not null)
                                        {
                                            <div class="app-tile__badge">@app.Badge</div>
                                        }
                                    </div>
                                </a>
                            }
                            else if (app.PageLink is not null)
                            {
                                <a class="app-tile" data-search="@search" asp-page="@app.PageLink">
                                    <div class="app-tile__head">
                                        <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon)" /></div>
                                        <div style="min-width:0;flex:1">
                                            <div class="app-tile__title">@app.Title</div>
                                            <div class="app-tile__desc">@app.Description</div>
                                        </div>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <button type="button" class="app-tile btn-reset js-stub" data-search="@search">
                                    <div class="app-tile__head">
                                        <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon)" /></div>
                                        <div style="min-width:0;flex:1">
                                            <div class="app-tile__title">@app.Title</div>
                                            <div class="app-tile__desc">@app.Description</div>
                                        </div>
                                    </div>
                                </button>
                            }
                        }
                    </div>
                </div>

                @foreach (var group in new[] { ("Sourcing & servicing", Model.SourcingApps), ("Compliance, reporting & admin", Model.ComplianceApps) })
                {
                    <div class="tile-section">
                        <div class="section-label">@group.Item1</div>
                        <div class="app-tile-grid">
                            @foreach (var app in group.Item2)
                            {
                                <button type="button" class="app-tile btn-reset js-stub" data-search="@($"{app.Title} {app.Description}".ToLowerInvariant())">
                                    <div class="app-tile__head">
                                        <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon)" /></div>
                                        <div style="min-width:0;flex:1">
                                            <div class="app-tile__title">@app.Title</div>
                                            <div class="app-tile__desc">@app.Description</div>
                                        </div>
                                        @if (app.Badge is not null)
                                        {
                                            <div class="app-tile__badge">@app.Badge</div>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="tile-section tile-section--divided">
                    <div class="section-label">Available on request</div>
                    <div class="app-tile-grid">
                        @foreach (var app in Model.RequestableApps)
                        {
                            <div class="app-tile app-tile--disabled" data-search="@($"{app.Title} {app.Description}".ToLowerInvariant())">
                                <div class="app-tile__head">
                                    <div class="app-tile__icon"><partial name="_AppIcon" model='new AppIcon(app.Icon, 18, "#9AA1AB")' /></div>
                                    <div style="min-width:0;flex:1">
                                        <div class="app-tile__title">@app.Title</div>
                                        <div class="app-tile__desc">@app.Description</div>
                                    </div>
                                </div>
                                <button type="button" class="btn-reset js-stub" style="margin-top:auto;font-size:10px;color:var(--muted-2)">Not provisioned &middot; request access</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="js-tile-empty section-label" style="text-transform:none;letter-spacing:0;font-weight:500;color:var(--muted)" hidden>No application matches that name.</div>
            </div>

            <div class="card card--console" style="display:flex;flex-direction:column;gap:13px">
                <div class="card__header card__header--plain">
                    <div style="min-width:0;flex:1">
                        <div class="card__title">Applications in flight</div>
                        <div class="card__subtitle">Sorted by what is waiting longest &middot; each row opens the application at the step that is blocked</div>
                    </div>
                    <div class="card__header-actions">
                        <form role="search" class="search-box" style="width:210px" onsubmit="return false">
                            <partial name="_AppIcon" model='new AppIcon("search", 13, "#9AA1AB")' />
                            <input id="appSearch" type="search" name="q" placeholder="Application no, PAN or name" aria-label="Search applications in flight" />
                        </form>
                        <button type="button" class="select-box btn-reset js-stub">This month <span class="select-box__caret">&#9662;</span></button>
                        <button type="button" class="btn-reset js-stub" style="font-size:11.5px;font-weight:600;color:var(--text);white-space:nowrap">Export</button>
                    </div>
                </div>

                <div id="statusPills" style="display:flex;gap:7px;flex-wrap:wrap">
                    <button type="button" class="status-pill status-pill--active" data-status="all">In flight <span class="status-pill__count">14</span></button>
                    <button type="button" class="status-pill" data-status="needs-you">Needs you <span class="status-pill__count" style="color:var(--red-dark)">5</span></button>
                    <button type="button" class="status-pill" data-status="operations">With Operations <span class="status-pill__count" style="color:var(--amber)">6</span></button>
                    <button type="button" class="status-pill" data-status="realisation">Awaiting realisation <span class="status-pill__count" style="color:var(--blue)">3</span></button>
                    <button type="button" class="status-pill js-stub" data-status="booked">Booked <span class="status-pill__count" style="color:var(--green)">38</span></button>
                    <button type="button" class="status-pill js-stub" data-status="lapsed">Lapsed <span class="status-pill__count" style="color:var(--red-dark)">2</span></button>
                    <button type="button" class="status-pill js-stub" data-status="every">All <span class="status-pill__count" style="color:var(--muted-2)">54</span></button>
                </div>

                <div class="table-frame">
                    <table class="data-table">
                        <thead><tr><th>Application</th><th>What is waiting</th><th>Amount</th><th>Step</th><th>Waiting</th><th></th></tr></thead>
                        <tbody id="applicationsTbody">
                        @foreach (var a in Model.Applications)
                        {
                            // Board 00 tints only the rows whose blocker is red. The amber
                            // "incomplete" rows stay white so the tint keeps meaning "act now".
                            <tr class="@(a.StatusClass == "text-danger" ? "attention" : null)" data-status="@a.StatusKey" data-search="@($"{a.AppNo} {a.HolderMask} {a.Status} {a.Step}".ToLowerInvariant())">
                                <td style="font-size:11px;font-weight:600;color:var(--ink);overflow-wrap:anywhere;line-height:1.4">@a.AppNo<div style="font-size:9.5px;font-weight:500;color:var(--muted-2);padding-top:2px">@a.HolderMask</div></td>
                                <td style="font-size:11px;color:var(--text);line-height:1.5"><span class="@a.StatusClass">@a.Status</span> &mdash; @a.StatusDetail</td>
                                <td style="font-weight:600">@a.Amount</td>
                                <td style="font-size:10.5px;color:var(--text);line-height:1.45">@a.Step</td>
                                <td class="@a.WaitingClass" style="font-size:10.5px">@a.Waiting</td>
                                <td><a class="action-link" asp-page="/Apps/UnoTp/Application/HolderIdentification">@a.Action</a></td>
                            </tr>
                        }
                        </tbody>
                        <tbody id="applicationsEmpty" hidden>
                            <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:22px 13px">No applications match this filter on the current page.</td></tr>
                        </tbody>
                    </table>
                    <div class="table-foot">
                        <div id="tableSummary" class="table-foot__summary">Showing 1&ndash;7 of 14 in flight &middot; 5 need you, 6 with Operations, 3 awaiting realisation</div>
                        <div class="table-foot__pager">
                            <button type="button" class="btn-reset js-stub">Rows 7 &#9662;</button>
                            <button type="button" class="btn-reset js-stub" style="color:var(--muted-2)" aria-label="Previous page">&lsaquo;</button>
                            <button type="button" class="btn-reset js-page js-page--active" data-page="1">1</button>
                            <button type="button" class="btn-reset js-page" data-page="2">2</button>
                            <button type="button" class="btn-reset js-stub" aria-label="Next page">&rsaquo;</button>
                        </div>
                    </div>
                </div>
                <div style="font-size:11px;color:var(--muted);line-height:1.55">The first seven of fourteen, longest-waiting first. Rows the broker can act on are tinted; rows with Operations or the bank are not, so a long list still reads as a to-do list rather than a log.</div>
            </div>

            <div class="card" style="padding:16px 20px;display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap">
                <div style="min-width:0;flex:1">
                    <div style="font-size:13px;font-weight:600;color:var(--ink)">Notices</div>
                    <div style="font-size:11.5px;color:var(--text);padding-top:5px;line-height:1.55">Card rates revised with effect from 12 September &mdash; 36-month public deposits now 7.85%. Applications submitted before the revision keep the rate they were priced at, provided the cheque realises within 48 hours.</div>
                </div>
                <button type="button" id="rateCardBtn" class="btn-reset" style="flex:none;font-size:11.5px;font-weight:600;color:var(--red)">Rate card</button>
            </div>
        </div>
    </div>
</div>

@* Board 00 - Mobile: a different design, not a narrower laptop page *@
<div class="view-phone">
    <partial name="_ViewSwitch" model="@("new")" />

    <div class="card-stack card-stack--sm" data-tile-scope>
        <div class="card" style="border-radius:10px;padding:14px;display:flex;align-items:center;gap:12px">
            <div class="profile-avatar" style="width:44px;height:44px;font-size:7.5px;flex:none">PHOTO</div>
            <div style="min-width:0;flex:1">
                <div style="font-size:13.5px;font-weight:700">@MockData.BrokerName</div>
                <div style="font-size:10px;color:var(--muted);padding-top:2px">@MockData.EntityCode &middot; type 1033 &middot; head office</div>
            </div>
        </div>

        <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:11px">
            <div style="font-size:13.5px;font-weight:600">Good morning, Shivaprasad</div>
            <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;border-top:1px solid #F2F4F7;padding-top:11px">
                <div><div style="font-size:15px;font-weight:600">&#8377; 84.2 L</div><div style="font-size:9px;color:var(--muted-2);padding-top:2px">booked this month</div></div>
                <div><div style="font-size:15px;font-weight:600">14</div><div style="font-size:9px;color:var(--muted-2);padding-top:2px">in flight</div></div>
                <div><div style="font-size:15px;font-weight:600;color:var(--red-dark)">5</div><div style="font-size:9px;color:var(--muted-2);padding-top:2px">need you</div></div>
            </div>
        </div>

        <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:11px">
            <div style="display:flex;align-items:baseline;gap:8px">
                <div style="font-size:13px;font-weight:700;flex:1;min-width:0">Applications <span style="font-weight:500;color:var(--muted-2)">&middot; 12</span></div>
                <button type="button" class="btn-reset js-stub" style="font-size:10.5px;font-weight:600;color:var(--red)">See all</button>
            </div>
            <form role="search" class="search-box" style="font-size:11px" onsubmit="return false">
                <partial name="_AppIcon" model='new AppIcon("search", 12, "#9AA1AB")' />
                <input class="js-tile-search" type="search" name="app" placeholder="Find an application" aria-label="Find an application" />
            </form>

            <div class="tile-section">
                <div class="section-label" style="font-size:9.5px;letter-spacing:.05em">Pinned</div>
                <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px">
                    @foreach (var app in Model.PinnedApps)
                    {
                        var search = $"{app.Title} {app.MobileDescription ?? app.Description}".ToLowerInvariant();
                        @if (app.Title == "Uno TP")
                        {
                            <a class="app-tile app-tile--sm app-tile--pinned" data-search="@search" asp-page="/Apps/UnoTp/Desktop/Dashboard">
                                <div style="display:flex;align-items:flex-start;gap:6px">
                                    <div class="app-tile__icon"><partial name="_AppIcon" model='new AppIcon(app.Icon, 14, "#E31837")' /></div>
                                    @if (app.Badge is not null)
                                    {
                                        <div class="app-tile__badge" style="margin-left:auto">@app.Badge</div>
                                    }
                                </div>
                                <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                            </a>
                        }
                        else if (app.PageLink is not null)
                        {
                            <a class="app-tile app-tile--sm" data-search="@search" asp-page="@app.PageLink">
                                <div style="display:flex;align-items:flex-start;gap:6px">
                                    <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon, 14)" /></div>
                                </div>
                                <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="app-tile app-tile--sm btn-reset js-stub" data-search="@search">
                                <div style="display:flex;align-items:flex-start;gap:6px">
                                    <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon, 14)" /></div>
                                </div>
                                <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="tile-section">
                <div class="section-label" style="font-size:9.5px;letter-spacing:.05em">Also provisioned</div>
                <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px">
                    @foreach (var app in Model.AlsoProvisioned)
                    {
                        <button type="button" class="app-tile app-tile--sm btn-reset js-stub" data-search="@($"{app.Title} {app.MobileDescription ?? app.Description}".ToLowerInvariant())">
                            <div style="display:flex;align-items:flex-start;gap:6px">
                                <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon, 14)" /></div>
                                @if (app.Badge is not null)
                                {
                                    <div class="app-tile__badge" style="margin-left:auto">@app.Badge</div>
                                }
                            </div>
                            <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                        </button>
                    }
                </div>
            </div>

            <div class="js-tile-empty" style="font-size:10.5px;color:var(--muted);line-height:1.5" hidden>No application matches that name.</div>
            <div style="font-size:10.5px;color:var(--muted);line-height:1.5">@Model.MoreCountWord more &mdash; calculator, Investor 360, consent register, circulars, training, sub-broker admin &mdash; under See all.</div>
        </div>

        <div class="card" style="border-radius:10px;padding:14px">
            <div style="display:flex;align-items:baseline;gap:8px;padding-bottom:10px">
                <div style="font-size:13px;font-weight:700;flex:1;min-width:0">Needs you <span style="font-weight:500;color:var(--muted-2)">&middot; @Model.NeedsYou.Count</span></div>
                <button type="button" class="btn-reset js-stub" style="font-size:10.5px;font-weight:600;color:var(--red)">Filter</button>
            </div>
            @foreach (var a in Model.NeedsYou)
            {
                <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-top:1px solid #F2F4F7">
                    <div style="width:6px;height:6px;border-radius:50%;background:@DotColor(a.StatusClass);flex:none;margin-top:5px"></div>
                    <div style="min-width:0;flex:1">
                        <div style="font-size:11.5px;font-weight:600">@a.AppNo &middot; @a.Amount</div>
                        <div style="font-size:10.5px;padding-top:2px;line-height:1.5;color:@(a.StatusClass == "text-danger" ? "var(--red-dark)" : "var(--amber)")">@a.Status &middot; @a.ShortDetail</div>
                    </div>
                </div>
            }
            <div style="padding:11px 0 2px;border-top:1px solid #F2F4F7;font-size:11px;font-weight:700;color:var(--red)">See all 14 in flight &rarr;</div>
        </div>

        <div class="card" style="border-radius:10px;padding:14px">
            <div style="font-size:13px;font-weight:700;padding-bottom:10px">With Operations <span style="font-weight:500;color:var(--muted-2)">&middot; 6, no action from you</span></div>
            @foreach (var a in Model.WithOperations)
            {
                <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-top:1px solid #F2F4F7">
                    <div style="width:6px;height:6px;border-radius:50%;background:@DotColor(a.StatusClass);flex:none;margin-top:5px"></div>
                    <div style="min-width:0;flex:1">
                        <div style="font-size:11.5px;font-weight:600">@a.AppNo &middot; @a.Amount</div>
                        <div class="@a.StatusClass" style="font-size:10.5px;font-weight:400;padding-top:2px;line-height:1.5">@a.Status @(a.StatusClass == "text-amber" ? "—" : "·") @a.ShortDetail</div>
                    </div>
                </div>
            }
        </div>

        <div class="card" style="border-radius:10px;padding:14px">
            <div style="font-size:12.5px;font-weight:600">Notices</div>
            <div style="font-size:10.5px;color:var(--text);padding-top:4px;line-height:1.55">Card rates revised from 12 September &mdash; 36-month public deposits now 7.85%.</div>
        </div>

        <div class="card" style="border-radius:10px;padding:4px 14px">
            @foreach (var label in new[] { "Change of mobile number", "Change of e-mail ID", "Change password", "Book a service call" })
            {
                <button type="button" class="profile-link-row btn-reset js-stub" style="padding:12px 0;font-size:12px;border-top-color:#F2F4F7">
                    <span class="profile-link-row__label">@label</span>
                    <partial name="_AppIcon" model='new AppIcon("chevron", 13, "#9AA1AB")' />
                </button>
            }
        </div>
    </div>
</div>


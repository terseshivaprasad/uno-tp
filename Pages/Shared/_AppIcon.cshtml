@model UnoTp.Models.AppIcon
@{
    // The hairline strokes of Board 00's app/profile glyphs vs the heavier
    // chevron and magnifier that sit next to text.
    var heavy = Model.Key is "chevron" or "search";
    var width = heavy ? "2" : "1.6";
}
<svg width="@Model.Size" height="@Model.Size" viewBox="0 0 24 24" fill="none" stroke="@Model.Stroke" stroke-width="@width" stroke-linecap="round" stroke-linejoin="round" style="flex:none" aria-hidden="true" focusable="false">
    @switch (Model.Key)
    {
        case "uno-tp":
            <rect x="3" y="4" width="18" height="6" rx="1"></rect><rect x="3" y="14" width="18" height="6" rx="1"></rect>
            break;
        case "folder":
            <path d="M4 7h16v13H4z"></path><path d="M4 7l3-3h6l3 3"></path>
            break;
        case "id-card":
            <rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="11" r="2"></circle><path d="M14 10h4M14 14h4"></path>
            break;
        case "bars":
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>
            break;
        case "rupee":
            <path d="M7 5h10M7 9h10M15 5c0 4-3 4-8 4l8 6"></path>
            break;
        case "calculator":
            <rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M8 7h8M8 12h3M13 12h3M8 16h3M13 16h3"></path>
            break;
        case "people":
            <circle cx="9" cy="8" r="3"></circle><path d="M3 20a6 6 0 0112 0M17 11a3 3 0 100-6M18 20a5 5 0 00-2-4"></path>
            break;
        case "ticket":
            <path d="M4 8h16v3a2 2 0 000 4v3H4v-3a2 2 0 000-4z"></path><path d="M12 8v8"></path>
            break;
        case "shield-check":
            <path d="M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z"></path><path d="M9 12l2 2 4-4"></path>
            break;
        case "bell":
            <path d="M6 9a6 6 0 1112 0c0 5 2 6 2 6H4s2-1 2-6z"></path><path d="M10 19a2 2 0 004 0"></path>
            break;
        case "book":
            <path d="M4 5h7v15H4z"></path><path d="M13 5h7v15h-7z"></path>
            break;
        case "doc":
            <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7z"></path><path d="M14 3v4h4"></path><path d="M9 12h6M9 16h6"></path>
            break;
        case "gear":
            <circle cx="12" cy="12" r="3"></circle><path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M18 6l-2 2M8 16l-2 2"></path>
            break;
        case "phone":
            <rect x="7" y="3" width="10" height="18" rx="2"></rect><path d="M11 18h2"></path>
            break;
        case "mail":
            <rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M3 8l9 6 9-6"></path>
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 018 0v3"></path>
            break;
        case "call":
            <path d="M5 4h4l2 5-3 2a10 10 0 005 5l2-3 5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z"></path>
            break;
        case "play":
            <circle cx="12" cy="12" r="9"></circle><path d="M10 9l5 3-5 3z"></path>
            break;
        case "chevron":
            <path d="M10 6l6 6-6 6"></path>
            break;
        case "search":
            <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
            break;
    }
</svg>

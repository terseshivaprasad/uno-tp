@page "/Mobile"
@model UnoTp.Pages.Mobile.IndexModel
@namespace UnoTp.Pages.Mobile
@{
    ViewData["Title"] = "E-Sarathi Console";
    ViewData["FirstNavLabel"] = "E-Sarathi Portal";
    ViewData["FirstNavPage"] = "/Mobile/Index";
}

<div style="display:flex;flex-direction:column;gap:14px">
    <div class="card" style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;align-items:center;gap:12px">
            <div class="profile-avatar" style="width:44px;height:44px;font-size:8px">PHOTO</div>
            <div style="min-width:0;flex:1">
                <div class="profile-card__name" style="font-size:13.5px">Shivaprasad Terse</div>
                <div class="profile-card__sub">Channel partner &middot; head office</div>
            </div>
        </div>
        <div style="font-size:11px;color:var(--muted);line-height:1.5">Tuesday 15 September &middot; 14 applications in flight &middot; 5 need you</div>
        <div class="kpi-row" style="gap:16px;flex-wrap:wrap">
            <div class="kpi"><div class="kpi__value">&#8377; 84.2 L</div><div class="kpi__label">booked</div></div>
            <div class="kpi"><div class="kpi__value">14</div><div class="kpi__label">in flight</div></div>
            <div class="kpi"><div class="kpi__value" style="color:var(--red-dark)">5</div><div class="kpi__label">need you</div></div>
        </div>
    </div>

    <div class="card">
        <div class="card__title" style="margin-bottom:10px">Pinned</div>
        <div style="display:flex;flex-direction:column;gap:9px">
        @foreach (var app in Model.PinnedApps)
        {
            var isUnoTp = app.Title == "Uno TP";
            @if (isUnoTp)
            {
                <a class="app-tile app-tile--pinned" style="text-decoration:none;flex-direction:row;align-items:center" asp-page="/Apps/UnoTp/Mobile/Dashboard">
                    <div class="app-tile__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E31837" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"></rect><rect x="3" y="14" width="18" height="6" rx="1"></rect></svg>
                    </div>
                    <div style="min-width:0;flex:1">
                        <div class="app-tile__title">@app.Title</div>
                        <div class="app-tile__desc">@app.Description</div>
                    </div>
                    @if (app.Badge is not null)
                    {
                        <div class="app-tile__badge">@app.Badge</div>
                    }
                </a>
            }
            else
            {
                <button type="button" class="app-tile js-stub" style="flex-direction:row;align-items:center;text-align:left">
                    <div class="app-tile__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1"></rect><rect x="3" y="14" width="18" height="6" rx="1"></rect></svg>
                    </div>
                    <div style="min-width:0;flex:1">
                        <div class="app-tile__title">@app.Title</div>
                        <div class="app-tile__desc">@app.Description</div>
                    </div>
                </button>
            }
        }
        </div>
    </div>

    <div class="card">
        <div class="card__header" style="align-items:center">
            <div class="card__title">Applications</div>
        </div>
        <form role="search" class="search-box" style="width:100%;margin-bottom:12px" onsubmit="return false">
            <input id="appSearch" type="search" name="q" placeholder="Find an application" aria-label="Find an application" style="border:0;outline:0;background:transparent;font:inherit;color:inherit;width:100%;padding:0" />
        </form>
        <div id="statusPills" style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px">
            <button type="button" class="status-pill status-pill--active" data-status="all">In flight <span class="status-pill__count">14</span></button>
            <button type="button" class="status-pill" data-status="needs-you">Needs you <span class="status-pill__count" style="color:var(--red-dark)">5</span></button>
            <button type="button" class="status-pill" data-status="operations">Operations <span class="status-pill__count" style="color:var(--amber)">6</span></button>
        </div>
        <div id="applicationsTbody" style="display:flex;flex-direction:column;gap:10px">
        @foreach (var a in Model.Applications)
        {
            <div class="attention" data-status="@a.StatusKey" data-search="@($"{a.AppNo} {a.HolderMask} {a.Status} {a.Step}".ToLowerInvariant())" style="border:1px solid var(--border);border-radius:8px;padding:12px 13px;display:flex;flex-direction:column;gap:6px">
                <div style="display:flex;justify-content:space-between;gap:8px">
                    <strong style="font-size:12.5px">@a.AppNo</strong>
                    <strong style="font-size:12.5px">@a.Amount</strong>
                </div>
                <div style="font-size:10.5px;color:var(--muted-2)">@a.HolderMask</div>
                <div style="font-size:11px"><span class="@a.StatusClass">@a.Status</span> &mdash; @a.StatusDetail</div>
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:11px">
                    <span>@a.Step &middot; <span class="@a.WaitingClass">@a.Waiting</span></span>
                    <a class="action-link" asp-page="/Apps/UnoTp/Application/HolderIdentification">@a.Action</a>
                </div>
            </div>
        }
        </div>
        <div id="applicationsEmpty" hidden style="text-align:center;color:var(--muted);padding:22px 13px;font-size:12px">No applications match this filter.</div>
    </div>

    <div class="card" style="display:flex;flex-direction:column;gap:8px">
        <div style="font-size:13px;font-weight:600;color:var(--ink)">Notices</div>
        <div style="font-size:11.5px;color:var(--text);line-height:1.55">Card rates revised from 12 September &mdash; 36-month public deposits now 7.85%.</div>
        <button type="button" id="rateCardBtn" class="action-link" style="align-self:flex-start;background:none;border:0;cursor:pointer;padding:0">Rate card</button>
    </div>
</div>

<div class="modal-overlay" id="rateCardModal" hidden>
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="rateCardTitle">
        <div id="rateCardTitle" style="font-size:15px;font-weight:600;color:var(--ink)">FD card rates &middot; effective 12 September 2026</div>
        <table class="data-table" style="margin-top:16px;font-size:10px">
            <thead><tr><th>Tenure</th><th>General</th><th>Senior citizen</th></tr></thead>
            <tbody>
                <tr><td>12 months</td><td>7.25%</td><td>7.50%</td></tr>
                <tr><td>24 months</td><td>7.60%</td><td>7.85%</td></tr>
                <tr><td>36 months</td><td>7.85%</td><td>8.10%</td></tr>
                <tr><td>60 months</td><td>7.75%</td><td>8.00%</td></tr>
            </tbody>
        </table>
        <div style="display:flex;justify-content:flex-end;padding-top:20px">
            <button type="button" class="btn btn-primary" id="rateCardCloseBtn">Close</button>
        </div>
    </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/console.js"></script>
}

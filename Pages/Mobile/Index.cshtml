@page "/Mobile"
@model UnoTp.Pages.Mobile.IndexModel
@namespace UnoTp.Pages.Mobile
@using UnoTp.Models
@{
    ViewData["Title"] = "E-Sarathi Console";
    ViewData["FirstNavLabel"] = "E-Sarathi Portal";
    ViewData["FirstNavPage"] = "/Mobile/Index";

    // Board 00 - Mobile colours the leading dot by how urgent the blocker is,
    // not by the text colour, so amber reads warmer here than in the table.
    static string DotColor(string statusClass) => statusClass switch
    {
        "text-danger" => "#E31837",
        "text-amber" => "#E8A700",
        "text-success" => "#1E9E52",
        _ => "#9AA1AB",
    };
}

<div class="card-stack card-stack--sm">
    <div class="card" style="border-radius:10px;padding:14px;display:flex;align-items:center;gap:12px">
        <div class="profile-avatar" style="width:44px;height:44px;font-size:7.5px;flex:none">PHOTO</div>
        <div style="min-width:0;flex:1">
            <div style="font-size:13.5px;font-weight:700">@MockData.BrokerName</div>
            <div style="font-size:10px;color:var(--muted);padding-top:2px">@MockData.EntityCode &middot; type 1033 &middot; head office</div>
        </div>
    </div>

    <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:11px">
        <div style="font-size:13.5px;font-weight:600">Good morning, Shivaprasad</div>
        <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;border-top:1px solid #F2F4F7;padding-top:11px">
            <div><div style="font-size:15px;font-weight:600">&#8377; 84.2 L</div><div style="font-size:9px;color:var(--muted-2);padding-top:2px">booked this month</div></div>
            <div><div style="font-size:15px;font-weight:600">14</div><div style="font-size:9px;color:var(--muted-2);padding-top:2px">in flight</div></div>
            <div><div style="font-size:15px;font-weight:600;color:var(--red-dark)">5</div><div style="font-size:9px;color:var(--muted-2);padding-top:2px">need you</div></div>
        </div>
    </div>

    <div class="card" style="border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:11px">
        <div style="display:flex;align-items:baseline;gap:8px">
            <div style="font-size:13px;font-weight:700;flex:1;min-width:0">Applications <span style="font-weight:500;color:var(--muted-2)">&middot; 12</span></div>
            <button type="button" class="btn-reset js-stub" style="font-size:10.5px;font-weight:600;color:var(--red)">See all</button>
        </div>
        <form role="search" class="search-box" style="font-size:11px" onsubmit="return false">
            <partial name="_AppIcon" model='new AppIcon("search", 12, "#9AA1AB")' />
            <input id="appTileSearch" type="search" name="app" placeholder="Find an application" aria-label="Find an application" />
        </form>

        <div class="tile-section">
            <div class="section-label" style="font-size:9.5px;letter-spacing:.05em">Pinned</div>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px">
                @foreach (var app in Model.PinnedApps)
                {
                    var search = $"{app.Title} {app.MobileDescription ?? app.Description}".ToLowerInvariant();
                    @if (app.Title == "Uno TP")
                    {
                        <a class="app-tile app-tile--sm app-tile--pinned" data-search="@search" asp-page="/Apps/UnoTp/Mobile/Dashboard">
                            <div style="display:flex;align-items:flex-start;gap:6px">
                                <div class="app-tile__icon"><partial name="_AppIcon" model='new AppIcon(app.Icon, 14, "#E31837")' /></div>
                                @if (app.Badge is not null)
                                {
                                    <div class="app-tile__badge" style="margin-left:auto">@app.Badge</div>
                                }
                            </div>
                            <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                        </a>
                    }
                    else
                    {
                        <button type="button" class="app-tile app-tile--sm btn-reset js-stub" data-search="@search">
                            <div style="display:flex;align-items:flex-start;gap:6px">
                                <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon, 14)" /></div>
                            </div>
                            <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="tile-section">
            <div class="section-label" style="font-size:9.5px;letter-spacing:.05em">Also provisioned</div>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px">
                @foreach (var app in Model.AlsoProvisioned)
                {
                    <button type="button" class="app-tile app-tile--sm btn-reset js-stub" data-search="@($"{app.Title} {app.MobileDescription ?? app.Description}".ToLowerInvariant())">
                        <div style="display:flex;align-items:flex-start;gap:6px">
                            <div class="app-tile__icon"><partial name="_AppIcon" model="new AppIcon(app.Icon, 14)" /></div>
                            @if (app.Badge is not null)
                            {
                                <div class="app-tile__badge" style="margin-left:auto">@app.Badge</div>
                            }
                        </div>
                        <div style="min-width:0"><div class="app-tile__title">@app.Title</div><div class="app-tile__desc">@(app.MobileDescription ?? app.Description)</div></div>
                    </button>
                }
            </div>
        </div>

        <div id="appTileEmpty" style="font-size:10.5px;color:var(--muted);line-height:1.5" hidden>No application matches that name.</div>
        <div style="font-size:10.5px;color:var(--muted);line-height:1.5">@Model.MoreCountWord more &mdash; calculator, Investor 360, consent register, circulars, training, sub-broker admin &mdash; under See all.</div>
    </div>

    <div class="card" style="border-radius:10px;padding:14px">
        <div style="display:flex;align-items:baseline;gap:8px;padding-bottom:10px">
            <div style="font-size:13px;font-weight:700;flex:1;min-width:0">Needs you <span style="font-weight:500;color:var(--muted-2)">&middot; @Model.NeedsYou.Count</span></div>
            <button type="button" class="btn-reset js-stub" style="font-size:10.5px;font-weight:600;color:var(--red)">Filter</button>
        </div>
        @foreach (var a in Model.NeedsYou)
        {
            <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-top:1px solid #F2F4F7">
                <div style="width:6px;height:6px;border-radius:50%;background:@DotColor(a.StatusClass);flex:none;margin-top:5px"></div>
                <div style="min-width:0;flex:1">
                    <div style="font-size:11.5px;font-weight:600">@a.AppNo &middot; @a.Amount</div>
                    <div style="font-size:10.5px;padding-top:2px;line-height:1.5;color:@(a.StatusClass == "text-danger" ? "var(--red-dark)" : "var(--amber)")">@a.Status &middot; @a.ShortDetail</div>
                </div>
            </div>
        }
        <div style="padding:11px 0 2px;border-top:1px solid #F2F4F7;font-size:11px;font-weight:700;color:var(--red)">See all 14 in flight &rarr;</div>
    </div>

    <div class="card" style="border-radius:10px;padding:14px">
        <div style="font-size:13px;font-weight:700;padding-bottom:10px">With Operations <span style="font-weight:500;color:var(--muted-2)">&middot; 6, no action from you</span></div>
        @foreach (var a in Model.WithOperations)
        {
            <div style="display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-top:1px solid #F2F4F7">
                <div style="width:6px;height:6px;border-radius:50%;background:@DotColor(a.StatusClass);flex:none;margin-top:5px"></div>
                <div style="min-width:0;flex:1">
                    <div style="font-size:11.5px;font-weight:600">@a.AppNo &middot; @a.Amount</div>
                    <div class="@a.StatusClass" style="font-size:10.5px;font-weight:400;padding-top:2px;line-height:1.5">@a.Status @(a.StatusClass == "text-amber" ? "—" : "·") @a.ShortDetail</div>
                </div>
            </div>
        }
    </div>

    <div class="card" style="border-radius:10px;padding:14px">
        <div style="font-size:12.5px;font-weight:600">Notices</div>
        <div style="font-size:10.5px;color:var(--text);padding-top:4px;line-height:1.55">Card rates revised from 12 September &mdash; 36-month public deposits now 7.85%.</div>
    </div>

    <div class="card" style="border-radius:10px;padding:4px 14px">
        @foreach (var label in new[] { "Change of mobile number", "Change of e-mail ID", "Change password", "Book a service call" })
        {
            <button type="button" class="profile-link-row btn-reset js-stub" style="padding:12px 0;font-size:12px;border-top-color:#F2F4F7">
                <span class="profile-link-row__label">@label</span>
                <partial name="_AppIcon" model='new AppIcon("chevron", 13, "#9AA1AB")' />
            </button>
        }
    </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/console.js"></script>
}
